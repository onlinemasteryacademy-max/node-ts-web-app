        function copyProductLink() {
            if (!currentModalProduct) return;
            const url = window.location.origin + window.location.pathname + '?product=' + currentModalProduct.id;
            const btn = document.getElementById('copyProductLinkBtn');

            // 1. Web Share API (native on mobile Safari, Chrome, etc.)
            if (navigator.share) {
                navigator.share({
                    title: currentModalProduct.title,
                    text: `Order ${currentModalProduct.title} from ${storeData.store_name}:`,
                    url: url
                }).then(() => {
                    if (btn) btn.innerHTML = '<span>✓ Shared!</span>';
                    setTimeout(() => { if (btn) btn.innerHTML = '<span>🔗 Share Product</span>'; }, 2000);
                }).catch(() => {
                    doFallbackCopy(url, btn);
                });
                return;
            }

            // 2. Android Bridge in Mobile App
            if (window.AndroidBridge && typeof window.AndroidBridge.shareStoreLink === 'function') {
                window.AndroidBridge.shareStoreLink(currentModalProduct.title, url);
                if (btn) btn.innerHTML = '<span>✓ Shared!</span>';
                setTimeout(() => { if (btn) btn.innerHTML = '<span>🔗 Share Product</span>'; }, 2000);
                return;
            }

            // 3. Clipboard API / Fallback
            doFallbackCopy(url, btn);
        }

        function doFallbackCopy(url, btn) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(() => {
                    onLinkCopiedSuccess(btn);
                }).catch(() => {
                    execFallbackCopy(url, btn);
                });
            } else {
                execFallbackCopy(url, btn);
            }
        }

        function execFallbackCopy(text, btn) {
            try {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.focus();
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                onLinkCopiedSuccess(btn);
            } catch(e) {
                prompt('Copy product link:', text);
            }
        }

        function onLinkCopiedSuccess(btn) {
            if (btn) {
                btn.innerHTML = '<span>✓ Copied Link!</span>';
                setTimeout(() => { if (btn) btn.innerHTML = '<span>🔗 Share Product</span>'; }, 2000);
            }
            showToast('Product link copied to clipboard!');
        }

