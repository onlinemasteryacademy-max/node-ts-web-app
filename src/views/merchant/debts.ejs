<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Debt Tracker — <%= store.store_name %> | zlik</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        zlikDark: '#08110D',
                        zlikGreen: '#19D98B',
                        zlikDeep: '#087A50',
                        zlikBg: '#F8FAF8',
                        zlikWhite: '#FFFFFF',
                        zlikMuted: '#6B756F',
                        zlikBorder: '#E3E9E5'
                    },
                    fontFamily: {
                        display: ['Montserrat', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8FAF8; color: #08110D; }
        .font-display { font-family: 'Montserrat', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .pb-safe { padding-bottom: max(0.875rem, env(safe-area-inset-bottom, 0.875rem)); }
        .pt-safe { padding-top: max(0.75rem, env(safe-area-inset-top, 0.75rem)); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

    <!-- Merchant Header (Universal Component) -->
    <%- include('components/header_nav.ejs', { activeTab: 'debts', pageTitle: 'Debt Tracker' }) %>

    <main class="max-w-5xl mx-auto px-3 sm:px-4 py-4 sm:py-6 pb-28 sm:pb-8 flex-1 w-full space-y-5 sm:space-y-6">

        <div class="flex items-center justify-between gap-3 border-b border-[#E3E9E5]/60 pb-3">
            <div>
                <h2 class="text-base sm:text-lg font-extrabold text-[#08110D] font-display">Customer Debt Tracker</h2>
                <p class="text-xs text-[#6B756F]">Track pending customer credit, due dates, and send 1-click WhatsApp reminders</p>
            </div>
            <button onclick="openNewDebtModal()" class="bg-[#08110D] hover:bg-black text-[#19D98B] text-xs font-semibold px-3.5 py-2 rounded-xl transition shadow-2xs flex items-center gap-1.5 shrink-0">
                <span class="text-sm leading-none">+</span>
                <span>Record Debt</span>
            </button>
        </div>



        <!-- Debt KPI Summary Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Total Outstanding</span>
                <div class="text-lg font-bold text-red-600 mt-1 font-mono" id="statOutstanding">
                    ₦<%= (stats.total_outstanding || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                </div>
                <span class="text-[10px] text-[#6B756F]"><%= stats.active_count || 0 %> active debtor(s)</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Total Recovered</span>
                <div class="text-lg font-bold text-[#087A50] mt-1 font-mono" id="statRecovered">
                    ₦<%= (stats.total_recovered || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                </div>
                <span class="text-[10px] text-[#6B756F]"><%= stats.paid_count || 0 %> settled debt(s)</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Recovery Rate</span>
                <% 
                    const totalAll = (stats.total_outstanding || 0) + (stats.total_recovered || 0);
                    const recoveryPct = totalAll > 0 ? Math.round(((stats.total_recovered || 0) / totalAll) * 100) : 100;
                %>
                <div class="text-lg font-bold text-[#08110D] mt-1 font-mono">
                    <%= recoveryPct %>%
                </div>
                <span class="text-[10px] text-[#6B756F]">Settled vs Unsettled</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Plan Allowance</span>
                <div class="text-lg font-bold text-[#08110D] mt-1">
                    <%= isPro ? 'Unlimited' : '3 Active' %>
                </div>
                <span class="text-[10px] text-[#6B756F]"><%= isPro ? 'Pro Merchant Tier' : 'Free Tier' %></span>
            </div>
        </div>

        <!-- Debts List Container -->
        <div class="bg-white rounded-3xl border border-[#E3E9E5] p-4 sm:p-6 shadow-xs space-y-3.5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 border-b border-[#E3E9E5] pb-3">
                <div>
                    <h3 class="font-extrabold text-sm text-[#08110D] font-display">Customer Debts</h3>
                    <p class="text-[11px] text-[#6B756F]">Track unpaid balances, due dates, and send 1-click WhatsApp payment reminders.</p>
                </div>
                <!-- Filter Pills -->
                <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 text-xs font-semibold">
                    <button onclick="filterDebts('all')" id="debtFilter-all" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-[#08110D] text-white transition whitespace-nowrap">All</button>
                    <button onclick="filterDebts('pending')" id="debtFilter-pending" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-[#6B756F] border border-[#E3E9E5] hover:text-[#08110D] transition whitespace-nowrap">Pending</button>
                    <button onclick="filterDebts('paid')" id="debtFilter-paid" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-[#6B756F] border border-[#E3E9E5] hover:text-[#08110D] transition whitespace-nowrap">Settled</button>
                </div>
            </div>

            <!-- Instant Search Bar -->
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#6B756F]">
                    <svg class="w-4 h-4 text-[#6B756F]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
                <input type="text" id="debtSearchInput" oninput="filterDebtsList()" placeholder="Search debtor by name, phone, or item note..." class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl pl-9 pr-8 py-2.5 text-xs text-[#08110D] placeholder-[#6B756F]/60 outline-none focus:border-[#08110D] shadow-2xs transition">
                <button type="button" onclick="clearDebtSearch()" id="clearDebtSearchBtn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#6B756F] hover:text-[#08110D] text-xs hidden">✕</button>
            </div>

            <div id="debtsContainer" class="space-y-3">
                <% if (!debts || debts.length === 0) { %>
                    <div class="p-8 sm:p-12 text-center text-[#6B756F] text-xs space-y-2.5">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#087A50] flex items-center justify-center mx-auto border border-emerald-200">
                            <svg class="w-6 h-6 text-[#087A50]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <h4 class="font-bold text-sm text-[#08110D]">No outstanding debts recorded</h4>
                        <p class="text-[11px] max-w-sm mx-auto text-[#6B756F]">Click "Record Debt" to track a customer credit, installment, or pay-later balance.</p>
                    </div>
                <% } else { %>
                    <% debts.forEach(debt => { 
                        const isPending = debt.status === 'pending';
                    %>
                        <div class="debt-card p-3.5 sm:p-4 rounded-xl border border-[#E3E9E5] bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs hover:border-[#08110D] shadow-2xs transition" 
                             data-status="<%= debt.status %>"
                             data-customer-name="<%= (debt.customer_name || '').toLowerCase() %>"
                             data-customer-phone="<%= (debt.customer_phone || '').toLowerCase() %>"
                             data-description="<%= (debt.description || '').toLowerCase() %>"
                             data-notes="<%= (debt.notes || '').toLowerCase() %>">
                            <div class="space-y-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h4 class="font-bold text-sm text-[#08110D] truncate"><%= debt.customer_name %></h4>
                                    <span class="text-[9.5px] font-bold uppercase px-2 py-0.5 rounded-full <%= isPending ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-emerald-50 text-emerald-800 border border-emerald-200' %>">
                                        ● <%= isPending ? 'Pending' : 'Settled' %>
                                    </span>
                                </div>
                                <div class="text-[#6B756F] flex flex-wrap items-center gap-2 text-[11px]">
                                    <span class="font-mono"><%= debt.customer_phone %></span>
                                    <% if (debt.customer_phone) { %>
                                        <a href="tel:<%= debt.customer_phone %>" title="Call customer" class="w-5 h-5 rounded-md bg-[#F8FAF8] border border-[#E3E9E5] text-[#087A50] flex items-center justify-center hover:bg-[#E3E9E5] transition">
                                            <svg class="w-3 h-3 text-[#087A50]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                        </a>
                                    <% } %>
                                    <% if (debt.description) { %>
                                        <span>&bull; Item: <strong><%= debt.description %></strong></span>
                                    <% } %>
                                    <% if (debt.due_date) { %>
                                        <span>&bull; Due: <strong class="font-mono"><%= debt.due_date %></strong></span>
                                    <% } %>
                                </div>
                                <% if (debt.notes) { %>
                                    <p class="text-[10.5px] text-[#6B756F] italic">Note: <%= debt.notes %></p>
                                <% } %>
                            </div>

                            <div class="flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-[#E3E9E5]/60">
                                <div class="text-left sm:text-right">
                                    <div class="text-base font-extrabold font-mono <%= isPending ? 'text-red-600' : 'text-[#087A50]' %>">
                                        ₦<%= Number(debt.amount).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                                    </div>
                                    <span class="text-[10px] text-[#6B756F]"><%= new Date(debt.created_at).toLocaleDateString() %></span>
                                </div>

                                <div class="flex items-center gap-1.5 shrink-0">
                                    <% if (isPending) { %>
                                        <button type="button" onclick="sendWhatsAppReminder(<%= debt.id %>)" class="min-h-[34px] bg-emerald-50 hover:bg-emerald-100 text-[#087A50] border border-emerald-200 font-bold text-xs px-2.5 sm:px-3 py-1.5 rounded-xl transition flex items-center gap-1.5 shadow-2xs" title="Send WhatsApp Payment Reminder">
                                            <svg class="w-3.5 h-3.5 text-[#087A50]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                                            <span class="hidden sm:inline">WhatsApp</span>
                                        </button>
                                        <button type="button" onclick="markDebtPaid(<%= debt.id %>)" class="min-h-[34px] bg-[#08110D] hover:bg-black text-[#19D98B] font-bold text-xs px-3 py-1.5 rounded-xl transition shadow-2xs flex items-center gap-1" title="Mark as Paid">
                                            <svg class="w-3.5 h-3.5 text-[#19D98B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                            <span>Paid</span>
                                        </button>
                                    <% } %>
                                    <button type="button" onclick="deleteDebt(<%= debt.id %>)" class="min-h-[34px] text-[#6B756F] hover:text-red-700 p-2 rounded-xl hover:bg-red-50 transition" title="Delete Record">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>

                <!-- Empty Search Results Notice -->
                <div id="noDebtsSearchNotice" class="hidden p-8 text-center text-[#6B756F] text-xs">
                    No debts match your search query or filter.
                </div>
            </div>
        </div>
    </main>

    <!-- Record New Debt Modal (Mobile Bottom Sheet Pattern) -->
    <div id="newDebtModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 hidden">
        <div class="bg-white rounded-t-3xl sm:rounded-2xl max-w-md w-full p-5 sm:p-6 space-y-4 border border-[#E3E9E5] shadow-2xl text-xs max-h-[90vh] overflow-y-auto pb-safe sm:pb-6">
            <!-- Mobile Drag Handle -->
            <div class="w-10 h-1 bg-gray-300 rounded-full mx-auto my-2 sm:hidden shrink-0"></div>
            <div class="flex items-center justify-between pb-3 border-b border-[#E3E9E5]">
                <h3 class="font-extrabold text-sm text-[#08110D] font-display">Record Customer Debt</h3>
                <button type="button" onclick="closeNewDebtModal()" class="text-[#6B756F] font-bold text-sm hover:text-black p-1">✕</button>
            </div>

            <form id="newDebtForm" onsubmit="handleCreateDebt(event)" class="space-y-3.5">
                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Customer Full Name *</label>
                    <input type="text" id="debtCustomerName" required placeholder="e.g. John Okoro" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                </div>

                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Customer WhatsApp Phone Number *</label>
                    <input type="tel" id="debtCustomerPhone" required placeholder="08012345678" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-medium text-[#08110D] mb-1">Debt Amount (₦) *</label>
                        <input type="number" step="0.01" id="debtAmount" required placeholder="5000" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D] font-mono">
                    </div>
                    <div>
                        <label class="block font-medium text-[#08110D] mb-1">Due Date (Optional)</label>
                        <input type="date" id="debtDueDate" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                    </div>
                </div>

                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Item / Reason for Debt (Optional)</label>
                    <input type="text" id="debtDescription" placeholder="e.g. 2x Vintage Polo Shirts balance" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                </div>

                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Internal Note (Optional)</label>
                    <textarea id="debtNotes" rows="2" placeholder="e.g. Promised to transfer on Friday by 2PM" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]"></textarea>
                </div>

                <div class="flex items-center gap-2 pt-2 border-t border-[#E3E9E5]">
                    <button type="button" onclick="closeNewDebtModal()" class="w-1/2 bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] font-medium text-xs py-2.5 rounded-xl border border-[#E3E9E5] transition">
                        Cancel
                    </button>
                    <button type="submit" id="saveDebtBtn" class="w-1/2 bg-[#08110D] hover:bg-black text-[#19D98B] font-semibold text-xs py-2.5 rounded-xl transition shadow-2xs">
                        Save Debt Record
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const isProStore = <%= isPro ? 'true' : 'false' %>;
        const activeDebtsCount = <%= stats.active_count || 0 %>;

        function openNewDebtModal() {
            if (!isProStore && activeDebtsCount >= 3) {
                openProUpgradeModal('Unlimited Debt Tracker (3 Active Debts Allowance)');
                return;
            }
            document.getElementById('newDebtModal').classList.remove('hidden');
        }

        function closeNewDebtModal() {
            document.getElementById('newDebtModal').classList.add('hidden');
            document.getElementById('newDebtForm').reset();
        }

        async function handleCreateDebt(e) {
            e.preventDefault();
            const btn = document.getElementById('saveDebtBtn');
            btn.disabled = true;
            btn.textContent = 'Saving...';

            const payload = {
                customer_name: document.getElementById('debtCustomerName').value,
                customer_phone: document.getElementById('debtCustomerPhone').value,
                amount: document.getElementById('debtAmount').value,
                due_date: document.getElementById('debtDueDate').value,
                description: document.getElementById('debtDescription').value,
                notes: document.getElementById('debtNotes').value
            };

            try {
                const res = await fetch('/api/merchant/debts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error || 'Failed to record debt.');
                    btn.disabled = false;
                    btn.textContent = 'Save Debt Record';
                }
            } catch (err) {
                alert('Network error while saving debt record.');
                btn.disabled = false;
                btn.textContent = 'Save Debt Record';
            }
        }

        async function markDebtPaid(debtId) {
            if (!confirm('Mark this debt as fully settled?')) return;
            try {
                const res = await fetch('/api/merchant/debts/mark-paid', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ debt_id: debtId })
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error || 'Failed to update debt.');
                }
            } catch (e) {
                alert('Network error.');
            }
        }

        async function deleteDebt(debtId) {
            if (!confirm('Delete this debt record?')) return;
            try {
                const res = await fetch('/api/merchant/debts/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ debt_id: debtId })
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error || 'Failed to delete record.');
                }
            } catch (e) {
                alert('Network error.');
            }
        }

        async function sendWhatsAppReminder(debtId) {
            try {
                const res = await fetch(`/api/merchant/debts/${debtId}/reminder-link`);
                const data = await res.json();
                if (data.success && data.url) {
                    window.open(data.url, '_blank');
                } else {
                    alert(data.error || 'Failed to generate reminder link.');
                }
            } catch (e) {
                alert('Network error.');
            }
        }

        let currentDebtFilter = 'all';

        function filterDebts(status) {
            currentDebtFilter = status;
            ['all', 'pending', 'paid'].forEach(s => {
                const btn = document.getElementById(`debtFilter-${s}`);
                if (btn) {
                    if (s === status) {
                        btn.className = 'px-3 py-1.5 rounded-xl text-xs font-bold bg-[#08110D] text-white transition whitespace-nowrap';
                    } else {
                        btn.className = 'px-3 py-1.5 rounded-xl text-xs font-semibold bg-white text-[#6B756F] border border-[#E3E9E5] hover:text-[#08110D] transition whitespace-nowrap';
                    }
                }
            });
            filterDebtsList();
        }

        function clearDebtSearch() {
            const input = document.getElementById('debtSearchInput');
            if (input) {
                input.value = '';
                filterDebtsList();
            }
        }

        function filterDebtsList() {
            const searchInput = document.getElementById('debtSearchInput');
            const clearBtn = document.getElementById('clearDebtSearchBtn');
            const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
            if (clearBtn) {
                clearBtn.classList.toggle('hidden', query.length === 0);
            }

            const cards = document.querySelectorAll('.debt-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const status = card.getAttribute('data-status') || '';
                const custName = card.getAttribute('data-customer-name') || '';
                const custPhone = card.getAttribute('data-customer-phone') || '';
                const desc = card.getAttribute('data-description') || '';
                const notes = card.getAttribute('data-notes') || '';

                const matchesStatus = (currentDebtFilter === 'all' || status === currentDebtFilter);
                let matchesSearch = true;
                if (query.length > 0) {
                    matchesSearch = custName.includes(query) || custPhone.includes(query) || desc.includes(query) || notes.includes(query);
                }

                if (matchesStatus && matchesSearch) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            const noSearchNotice = document.getElementById('noDebtsSearchNotice');
            if (noSearchNotice) {
                noSearchNotice.classList.toggle('hidden', visibleCount > 0 || cards.length === 0);
            }
        }
    </script>
    <%- include('components/upgrade_modal.ejs') %>
    <%- include('components/bottom_nav.ejs', { activeTab: 'debts' }) %>
</body>
</html>
