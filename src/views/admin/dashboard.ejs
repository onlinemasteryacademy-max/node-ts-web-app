    // ==========================================
    // SUPER ADMIN BULK STORE ACTIONS
    // ==========================================
    function getSelectedStoreIds() {
      const cbs = document.querySelectorAll('.merchant-select-cb:checked');
      return Array.from(cbs).map(cb => Number(cb.value)).filter(id => id > 0);
    }

    function handleMerchantSelectChange() {
      const selected = getSelectedStoreIds();
      const bulkBar = document.getElementById('merchantBulkBar');
      const countLabel = document.getElementById('selectedStoresCount');
      const selectAllCb = document.getElementById('selectAllMerchants');
      const allCbs = document.querySelectorAll('.merchant-select-cb');

      if (countLabel) countLabel.textContent = selected.length;

      if (selected.length > 0) {
        if (bulkBar) bulkBar.classList.remove('hidden');
      } else {
        if (bulkBar) bulkBar.classList.add('hidden');
      }

      if (selectAllCb) {
        selectAllCb.checked = (allCbs.length > 0 && selected.length === allCbs.length);
      }

      // Visual highlight for selected rows
      allCbs.forEach(cb => {
        const row = document.getElementById(`merchant-row-${cb.value}`);
        if (row) {
          if (cb.checked) {
            row.classList.add('bg-purple-950/20');
          } else {
            row.classList.remove('bg-purple-950/20');
          }
        }
      });
    }

    function toggleSelectAllMerchants(checked) {
      const rows = document.querySelectorAll('.merchant-row');
      rows.forEach(row => {
        if (row.style.display !== 'none') {
          const cb = row.querySelector('.merchant-select-cb');
          if (cb) cb.checked = checked;
        }
      });
      handleMerchantSelectChange();
    }

    function clearMerchantSelection() {
      const allCbs = document.querySelectorAll('.merchant-select-cb');
      allCbs.forEach(cb => { cb.checked = false; });
      const selectAllCb = document.getElementById('selectAllMerchants');
      if (selectAllCb) selectAllCb.checked = false;
      handleMerchantSelectChange();
    }

    function handleBulkTierChange(tier) {
      if (!tier) return;
      confirmBulkStoreAction('change_tier', tier);
      const tierSelect = document.getElementById('bulkTierSelect');
      if (tierSelect) tierSelect.value = '';
    }

    async function confirmBulkStoreAction(operation, tier = null) {
      const selectedIds = getSelectedStoreIds();
      if (selectedIds.length === 0) {
        alert('Please select at least one store.');
        return;
      }

      let confirmMsg = '';
      if (operation === 'deactivate' || operation === 'suspend') {
        confirmMsg = `Are you sure you want to SUSPEND / DEACTIVATE ${selectedIds.length} selected store(s)? Their storefronts will be disabled immediately.`;
      } else if (operation === 'activate') {
        confirmMsg = `Activate ${selectedIds.length} selected store(s)?`;
      } else if (operation === 'verify') {
        confirmMsg = `Grant Verified Badges to ${selectedIds.length} selected store(s)?`;
      } else if (operation === 'unverify') {
        confirmMsg = `Revoke Verified Badges from ${selectedIds.length} selected store(s)?`;
      } else if (operation === 'change_tier') {
        confirmMsg = `Change plan tier of ${selectedIds.length} selected store(s) to '${(tier || '').toUpperCase()}'?`;
      } else if (operation === 'delete') {
        confirmMsg = `⚠️ CRITICAL: Are you sure you want to DELETE ${selectedIds.length} selected store(s)? This action will release their slugs and archive store data.`;
      }

      if (!confirm(confirmMsg)) return;

      try {
        const res = await fetch('/api/admin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'bulk_store_action',
            store_ids: selectedIds,
            operation,
            tier
          })
        });
        const data = await res.json();
        if (data.success) {
          alert(`✅ ${data.message || 'Bulk operation completed successfully.'}`);
          window.location.reload();
        } else {
          alert(`❌ Error: ${data.error || 'Failed to complete bulk action'}`);
        }
      } catch (err) {
        alert('Network error executing bulk action.');
      }
    }
  </script>
