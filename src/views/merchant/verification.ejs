<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Trust & Identity Verification — <%= store.store_name %> | Zlik Merchant</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            DEFAULT: '#084C38',
                            hover: '#063b2c',
                            mint: '#EDF5F1'
                        }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #F8FAF9; color: #111827; }
        .pb-safe { padding-bottom: max(0.875rem, env(safe-area-inset-bottom, 0.875rem)); }
        .pt-safe { padding-top: max(0.75rem, env(safe-area-inset-top, 0.75rem)); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased bg-[#F8FAF9]">

    <!-- Merchant Header (Universal Component) -->
    <%- include('components/header_nav.ejs', { activeTab: 'verification', pageTitle: 'Trust & Verification', backUrl: '/merchant' }) %>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-4 py-6 pb-28 sm:pb-8 flex-1 w-full space-y-6">

        <!-- Banner / Overview Card -->
        <div class="bg-[#084C38] rounded-3xl p-6 sm:p-7 text-white shadow-xs space-y-5 relative overflow-hidden">
            <div class="flex items-start justify-between gap-4">
                <div class="space-y-1.5">
                    <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-2xl bg-white/10 flex items-center justify-center text-white shrink-0">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        </div>
                        <h1 class="text-base sm:text-lg font-bold text-white">Marketplace Listing & ID Verification</h1>
                    </div>
                    <p class="text-xs text-white/80 max-w-2xl leading-relaxed">
                        Publish your store to the official Zlik Marketplace directory and earn the Verified Merchant badge to boost buyer confidence. Verification is exclusive to Pro and Business subscribers.
                    </p>
                </div>
                <div class="hidden sm:block text-right shrink-0">
                    <div class="text-[10px] text-white/60 uppercase font-bold font-mono">Marketplace Status</div>
                    <div class="text-xs font-bold font-mono text-white mt-0.5">
                        <% if (Number(store.is_verified) === 1 || (sellerProfile && sellerProfile.composite_verification_status === 'verified')) { %>
                            <span class="inline-flex items-center gap-1.5 bg-white/20 text-white px-2.5 py-1 rounded-full text-[10px]">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <span>PUBLISHED & VERIFIED</span>
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center gap-1 bg-amber-400/20 text-amber-200 px-2.5 py-1 rounded-full text-[10px]">
                                <span>PENDING VERIFICATION</span>
                            </span>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Steps Matrix -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 border-t border-white/10 text-xs">
                <!-- Step 1: Identity -->
                <div class="p-3.5 rounded-2xl bg-white/10 border border-white/10 space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono font-bold text-white/60">Step 1</span>
                        <span class="text-[10px] font-bold font-mono px-2.5 py-0.5 rounded-full <%= sellerProfile && sellerProfile.identity_status === 'verified' ? 'bg-white/20 text-white' : 'bg-amber-400/20 text-amber-200' %>">
                            <%= sellerProfile ? sellerProfile.identity_status.toUpperCase() : 'PENDING' %>
                        </span>
                    </div>
                    <div class="font-bold text-white">Identity (BVN / NIN)</div>
                    <div class="text-[10.5px] text-white/70">Verified with official database</div>
                </div>

                <!-- Step 2: Bank -->
                <div class="p-3.5 rounded-2xl bg-white/10 border border-white/10 space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono font-bold text-white/60">Step 2</span>
                        <span class="text-[10px] font-bold font-mono px-2.5 py-0.5 rounded-full <%= sellerProfile && sellerProfile.bank_status === 'verified' ? 'bg-white/20 text-white' : 'bg-amber-400/20 text-amber-200' %>">
                            <%= sellerProfile ? sellerProfile.bank_status.toUpperCase() : 'PENDING' %>
                        </span>
                    </div>
                    <div class="font-bold text-white">Payout Bank</div>
                    <div class="text-[10.5px] text-white/70">Name matches verified identity</div>
                </div>

                <!-- Step 3: Marketplace Discovery -->
                <div class="p-3.5 rounded-2xl bg-white/10 border border-white/10 space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono font-bold text-white/60">Step 3</span>
                        <span class="text-[10px] font-bold font-mono px-2.5 py-0.5 rounded-full <%= (Number(store.is_verified) === 1 || (sellerProfile && sellerProfile.composite_verification_status === 'verified')) ? 'bg-white/20 text-white' : 'bg-white/10 text-white/50' %>">
                            <%= (Number(store.is_verified) === 1 || (sellerProfile && sellerProfile.composite_verification_status === 'verified')) ? 'PUBLISHED' : 'PENDING' %>
                        </span>
                    </div>
                    <div class="font-bold text-white">Marketplace Discovery</div>
                    <div class="text-[10.5px] text-white/70">Published on zlik.store/marketplace</div>
                </div>
            </div>
        </div>

        <% if (store.plan_tier === 'free') { %>
            <!-- Free Plan Notice: Verification & Marketplace Exclusivity -->
            <div class="bg-white rounded-3xl border border-[#EAEFEB] p-6 sm:p-8 shadow-xs text-center space-y-4">
                <div class="w-14 h-14 rounded-2xl bg-[#EDF5F1] text-[#084C38] flex items-center justify-center text-2xl mx-auto shadow-2xs">
                    💎
                </div>
                <div class="max-w-md mx-auto space-y-2">
                    <h2 class="text-base sm:text-lg font-bold text-[#111827] font-display">Marketplace Verification is Exclusive to Pro & Business</h2>
                    <p class="text-xs text-[#6B7280] leading-relaxed">
                        Your store on the Free Starter plan is <strong>100% operational</strong> — you can share your store link, list products, and accept customer orders anytime without identity verification.
                    </p>
                    <p class="text-xs text-[#6B7280] leading-relaxed">
                        Verification and publication to the public <strong>Zlik Marketplace</strong> directory is exclusive to Pro and Business plan members. Upgrade to get listed in the marketplace and unlock verified badges.
                    </p>
                </div>
                <div class="pt-2">
                    <a href="/merchant/settings" class="inline-flex items-center gap-2 bg-[#084C38] hover:bg-[#063b2c] text-white px-6 py-3 rounded-full font-bold text-xs transition shadow-xs">
                        <span>Upgrade to Pro / Business</span>
                        <span>&rarr;</span>
                    </a>
                </div>
            </div>
        <% } %>

        <!-- Section 1: Individual Identity Verification (BVN / NIN) -->
        <div class="bg-white rounded-3xl border border-[#EAEFEB] p-6 sm:p-7 shadow-xs space-y-5 text-xs">
            <div class="flex items-center justify-between border-b border-[#EAEFEB] pb-3.5">
                <div>
                    <h2 class="text-sm font-bold text-[#111827]">1. Personal Identity Verification</h2>
                    <p class="text-[11px] text-[#6B7280] mt-0.5">Verify your Bank Verification Number (BVN) or National Identification Number (NIN).</p>
                </div>
                <% if (sellerProfile && sellerProfile.identity_status === 'verified') { %>
                    <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 flex items-center gap-1.5 font-mono">
                        <svg class="w-3.5 h-3.5 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        <span>VERIFIED</span>
                    </span>
                <% } else { %>
                    <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200 flex items-center gap-1.5 font-mono">
                        <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>ACTION REQUIRED</span>
                    </span>
                <% } %>
            </div>

            <% if (sellerProfile && sellerProfile.identity_status === 'verified') { %>
                <div class="p-4 rounded-2xl bg-[#EDF5F1] border border-[#084C38]/20 text-[#084C38] space-y-2">
                    <div class="font-bold text-xs flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        <span>Identity Successfully Verified</span>
                    </div>
                    <p class="text-[11px] text-[#084C38]/90">
                        Your identity has been authenticated against regulatory authorities. Consent was recorded on <%= sellerProfile.consent_timestamp || 'file' %>.
                    </p>
                </div>
            <% } else { %>
                <form onsubmit="handleIdentitySubmit(event)" class="space-y-4">
                    <!-- NDPA 2023 Consent Notice -->
                    <div class="p-4 rounded-2xl bg-[#F8FAF9] border border-[#EAEFEB] space-y-2.5">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                            <span class="font-bold text-xs text-[#111827]">Nigeria Data Protection Act (NDPA) 2023 Compliance</span>
                        </div>
                        <p class="text-[11px] text-[#6B7280] leading-relaxed">
                            Under the NDPA 2023 and CBN privacy directives, your 11-digit credential is used strictly for identity confirmation via Monnify and is <strong>NEVER stored in plaintext</strong> or logged on Zlik servers.
                        </p>
                        <label class="flex items-start gap-2.5 pt-1 cursor-pointer">
                            <input type="checkbox" id="identityConsentCheck" required class="mt-0.5 w-4 h-4 accent-[#084C38] cursor-pointer">
                            <span class="text-[11px] font-semibold text-[#111827]">
                                I hereby consent to Zlik verifying my identity details with official regulatory databases in accordance with the NDPA 2023. *
                            </span>
                        </label>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">Credential Type *</label>
                            <select id="identityType" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-medium text-xs text-[#111827]">
                                <option value="bvn">Bank Verification Number (BVN)</option>
                                <option value="nin">National Identification Number (NIN)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">11-Digit Number *</label>
                            <input type="text" id="identityNumber" maxlength="11" placeholder="22222222222" required class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-sm tracking-wider text-[#111827] placeholder-[#6B7280]/60">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">Legal First Name (Optional)</label>
                            <input type="text" id="idFirstName" placeholder="e.g. Chinedu" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] text-xs text-[#111827] placeholder-[#6B7280]/60">
                        </div>
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">Legal Last Name (Optional)</label>
                            <input type="text" id="idLastName" placeholder="e.g. Eze" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] text-xs text-[#111827] placeholder-[#6B7280]/60">
                        </div>
                    </div>

                    <div id="identityFeedbackBox" class="hidden p-3 rounded-2xl text-xs font-medium"></div>

                    <button type="submit" id="submitIdentityBtn" class="bg-[#084C38] hover:bg-[#063b2c] text-white font-bold text-xs px-6 py-3 rounded-full transition shadow-xs flex items-center justify-center gap-2">
                        <span>Verify Identity Securely</span>
                        <span>&rarr;</span>
                    </button>
                </form>
            <% } %>
        </div>

        <!-- Section 2: Payout Bank Account Verification -->
        <div class="bg-white rounded-3xl border border-[#EAEFEB] p-6 sm:p-7 shadow-xs space-y-4 text-xs">
            <div class="flex items-center justify-between border-b border-[#EAEFEB] pb-3.5">
                <div>
                    <h2 class="text-sm font-bold text-[#111827]">2. Payout Bank Details & Protection</h2>
                    <p class="text-[11px] text-[#6B7280] mt-0.5">Where direct transfer customer payments will be deposited.</p>
                </div>
                <% if (sellerProfile && sellerProfile.bank_status === 'verified') { %>
                    <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 flex items-center gap-1.5 font-mono">
                        <svg class="w-3.5 h-3.5 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        <span>VERIFIED BANK</span>
                    </span>
                <% } else { %>
                    <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200 flex items-center gap-1.5 font-mono">
                        <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>PENDING</span>
                    </span>
                <% } %>
            </div>

            <div class="p-4 rounded-2xl bg-[#F8FAF9] border border-[#EAEFEB] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="space-y-1">
                    <div class="text-xs font-bold text-[#111827]">
                        <%= store.bank_name || 'No Bank Configured' %>
                    </div>
                    <div class="text-[11px] text-[#6B7280] font-mono">
                        Account: <%= store.bank_account_number ? (store.bank_account_number.slice(0, 4) + '••••' + store.bank_account_number.slice(-2)) : 'Not set' %> 
                        &bull; Name: <%= store.bank_account_name || 'Not set' %>
                    </div>
                </div>
                <a href="/merchant/settings" class="bg-[#084C38] hover:bg-[#063b2c] text-white font-bold text-xs px-4 py-2.5 rounded-full transition shadow-xs shrink-0">
                    <%= store.bank_account_number ? 'Update Payout Bank (with OTP) ↗' : 'Add Payout Bank ↗' %>
                </a>
            </div>
        </div>

        <!-- Section 3: Registered Business (CAC) Verification -->
        <div class="bg-white rounded-3xl border border-[#EAEFEB] p-6 sm:p-7 shadow-xs space-y-4 text-xs">
            <div class="flex items-center justify-between border-b border-[#EAEFEB] pb-3.5">
                <div>
                    <h2 class="text-sm font-bold text-[#111827]">3. Registered Business (CAC) Verification</h2>
                    <p class="text-[11px] text-[#6B7280] mt-0.5">For registered enterprises, limited liability companies (Ltd), and incorporated entities.</p>
                </div>
                <% if (sellerProfile && sellerProfile.business_status === 'verified') { %>
                    <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 flex items-center gap-1.5 font-mono">
                        <svg class="w-3.5 h-3.5 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        <span>VERIFIED BUSINESS (CAC)</span>
                    </span>
                <% } else if (sellerProfile && sellerProfile.business_status === 'pending') { %>
                    <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200 flex items-center gap-1.5 font-mono">
                        <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>PENDING COMPLIANCE REVIEW</span>
                    </span>
                <% } else if (sellerProfile && sellerProfile.business_status === 'rejected') { %>
                    <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-red-50 text-red-700 border border-red-200 flex items-center gap-1.5 font-mono">
                        <svg class="w-3.5 h-3.5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        <span>REJECTED</span>
                    </span>
                <% } else { %>
                    <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-[#F8FAF9] text-[#6B7280] border border-[#EAEFEB] font-mono">
                        INDIVIDUAL SELLER (OPTIONAL)
                    </span>
                <% } %>
            </div>

            <% if (sellerProfile && sellerProfile.business_status === 'verified' && businessProfile) { %>
                <div class="p-4 rounded-2xl bg-[#EDF5F1] border border-[#084C38]/20 text-[#084C38] space-y-2">
                    <div class="font-bold text-xs flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        <span>Corporate Affairs Commission (CAC) Verified</span>
                    </div>
                    <div class="text-[11px] text-[#084C38] grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1 font-mono">
                        <div>Registered Name: <strong><%= businessProfile.registered_name %></strong></div>
                        <div>CAC Number: <strong><%= businessProfile.registration_number %></strong></div>
                        <div>Business Type: <strong><%= businessProfile.business_type %></strong></div>
                        <div>Representative: <strong><%= businessProfile.representative_name %> (<%= businessProfile.representative_role %>)</strong></div>
                    </div>
                </div>
            <% } else if (sellerProfile && sellerProfile.business_status === 'pending' && businessProfile) { %>
                <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-950 space-y-2">
                    <div class="font-bold text-xs flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>Under Compliance Review</span>
                    </div>
                    <p class="text-[11px] text-amber-800 leading-relaxed">
                        Your registered business details (<strong><%= businessProfile.registered_name %></strong>, RC/BN: <strong><%= businessProfile.registration_number %></strong>) have been submitted to Zlik Trust & Compliance. You will receive an update once records are cross-checked with official registries.
                    </p>
                </div>
            <% } else { %>
                <p class="text-[11px] text-[#6B7280] leading-relaxed">
                    Personal sellers are not required to provide CAC documents. If your business is legally registered with the CAC (RC or BN number) or you wish to use corporate suffixes (Ltd, Plc, Holdings), complete business verification below.
                </p>

                <form onsubmit="handleBusinessSubmit(event)" class="space-y-4 pt-1">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">Registered Company Name *</label>
                            <input type="text" id="busRegisteredName" placeholder="e.g. Adeola & Sons Trading Ltd" required class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] text-xs text-[#111827] placeholder-[#6B7280]/60">
                        </div>
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">CAC Registration Number (RC/BN) *</label>
                            <input type="text" id="busRegNumber" placeholder="e.g. RC123456 or BN987654" required class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs uppercase text-[#111827] placeholder-[#6B7280]/60">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">Business Structure *</label>
                            <select id="busType" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-medium text-xs text-[#111827]">
                                <option value="sole_proprietorship">Sole Proprietorship / Enterprise (BN)</option>
                                <option value="limited_liability">Private Limited Company (Ltd)</option>
                                <option value="public_limited">Public Limited Company (Plc)</option>
                                <option value="incorporated_trustee">Incorporated Trustee / NGO (IT)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">Authorized Representative *</label>
                            <input type="text" id="busRepName" value="<%= sellerProfile.legal_name || store.owner_name || '' %>" placeholder="e.g. John Doe" required class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] text-xs text-[#111827] placeholder-[#6B7280]/60">
                        </div>
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">Representative Role *</label>
                            <select id="busRepRole" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-medium text-xs text-[#111827]">
                                <option value="Director">Director</option>
                                <option value="Proprietor">Proprietor / Owner</option>
                                <option value="Managing Partner">Managing Partner</option>
                                <option value="Authorized Officer">Authorized Officer</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">Representative Phone *</label>
                            <input type="text" id="busRepPhone" value="<%= store.whatsapp_number || '' %>" placeholder="e.g. 08012345678" required class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs text-[#111827] placeholder-[#6B7280]/60">
                        </div>
                        <div>
                            <label class="block font-semibold text-[#111827] mb-1">Tax Identification Number (TIN - Optional)</label>
                            <input type="text" id="busTin" placeholder="e.g. 12345678-0001" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs text-[#111827] placeholder-[#6B7280]/60">
                        </div>
                    </div>

                    <div>
                        <label class="block font-semibold text-[#111827] mb-1">Registered Business Address (Optional)</label>
                        <input type="text" id="busAddress" placeholder="e.g. 15 Broad Street, Marina, Lagos" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] text-xs text-[#111827] placeholder-[#6B7280]/60">
                    </div>

                    <div id="businessFeedbackBox" class="hidden p-3 rounded-2xl text-xs font-medium"></div>

                    <button type="submit" id="submitBusinessBtn" class="bg-[#084C38] hover:bg-[#063b2c] text-white font-bold text-xs px-6 py-3 rounded-full transition shadow-xs flex items-center justify-center gap-2">
                        <span>Submit CAC Business Verification</span>
                        <span>&rarr;</span>
                    </button>
                </form>
            <% } %>
        </div>

    </main>

    <%- include('components/bottom_nav.ejs', { activeTab: 'settings' }) %>

    <script>
        async function handleIdentitySubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('submitIdentityBtn');
            const feedback = document.getElementById('identityFeedbackBox');
            const consent = document.getElementById('identityConsentCheck').checked;
            const type = document.getElementById('identityType').value;
            const identifier = document.getElementById('identityNumber').value.trim();
            const firstName = document.getElementById('idFirstName')?.value?.trim();
            const lastName = document.getElementById('idLastName')?.value?.trim();

            if (!consent) {
                alert('NDPA 2023 Consent is legally required.');
                return;
            }

            if (identifier.length !== 11) {
                alert('Please enter an exact 11-digit number.');
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Verifying with Regulatory Authority...';
            feedback.className = 'p-3.5 rounded-2xl text-xs font-medium bg-blue-50 text-blue-900 border border-blue-200 block';
            feedback.innerHTML = '<span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 animate-spin text-blue-700" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Querying official identity database...</span></span>';

            try {
                const res = await fetch('/api/merchant/verification/submit-identity', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        type,
                        identifier,
                        consent_given: consent,
                        first_name: firstName,
                        last_name: lastName
                    })
                });
                const data = await res.json();
                if (data.success) {
                    feedback.className = 'p-3.5 rounded-2xl text-xs font-medium bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 block';
                    feedback.innerHTML = `<span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>${data.message || 'Identity verified!'}</span></span>`;
                    setTimeout(() => location.reload(), 1200);
                } else {
                    feedback.className = 'p-3.5 rounded-2xl text-xs font-medium bg-amber-50 text-amber-900 border border-amber-200 block';
                    feedback.innerHTML = `<span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg><span>${data.error || 'Verification pending review.'}</span></span>`;
                }
            } catch (err) {
                feedback.className = 'p-3.5 rounded-2xl text-xs font-medium bg-red-50 text-red-900 border border-red-200 block';
                feedback.innerHTML = '<span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg><span>Network error during verification.</span></span>';
            } finally {
                btn.disabled = false;
                btn.textContent = 'Verify Identity Securely →';
            }
        }

        async function handleBusinessSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('submitBusinessBtn');
            const feedback = document.getElementById('businessFeedbackBox');
            const registeredName = document.getElementById('busRegisteredName')?.value?.trim();
            const registrationNumber = document.getElementById('busRegNumber')?.value?.trim();
            const businessType = document.getElementById('busType')?.value;
            const representativeName = document.getElementById('busRepName')?.value?.trim();
            const representativeRole = document.getElementById('busRepRole')?.value;
            const representativePhone = document.getElementById('busRepPhone')?.value?.trim();
            const tin = document.getElementById('busTin')?.value?.trim();
            const registeredAddress = document.getElementById('busAddress')?.value?.trim();

            if (!registeredName || !registrationNumber || !representativeName || !representativePhone) {
                alert('Please complete all required fields.');
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Submitting CAC Verification...';
            feedback.className = 'p-3.5 rounded-2xl text-xs font-medium bg-blue-50 text-blue-900 border border-blue-200 block';
            feedback.innerHTML = '<span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 animate-spin text-blue-700" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Submitting business details for compliance check...</span></span>';

            try {
                const res = await fetch('/api/merchant/verification/submit-business', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        registered_name: registeredName,
                        registration_number: registrationNumber,
                        business_type: businessType,
                        representative_name: representativeName,
                        representative_role: representativeRole,
                        representative_phone: representativePhone,
                        tin,
                        registered_address: registeredAddress
                    })
                });
                const data = await res.json();
                if (data.success) {
                    feedback.className = 'p-3.5 rounded-2xl text-xs font-medium bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 block';
                    feedback.innerHTML = `<span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>${data.message || 'Business verification submitted successfully!'}</span></span>`;
                    setTimeout(() => location.reload(), 1400);
                } else {
                    feedback.className = 'p-3.5 rounded-2xl text-xs font-medium bg-amber-50 text-amber-900 border border-amber-200 block';
                    feedback.innerHTML = `<span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg><span>${data.error || 'Submission could not be completed.'}</span></span>`;
                }
            } catch (err) {
                feedback.className = 'p-3.5 rounded-2xl text-xs font-medium bg-red-50 text-red-900 border border-red-200 block';
                feedback.innerHTML = '<span class="inline-flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg><span>Network error during submission.</span></span>';
            } finally {
                btn.disabled = false;
                btn.textContent = 'Submit CAC Business Verification →';
            }
        }
    </script>
</body>
</html>
