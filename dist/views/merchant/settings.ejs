                    <% if (isPro) { %>
                        <button type="button" onclick="openAddStaffModal()" class="bg-[#084C38] hover:bg-[#063b2c] text-white font-semibold text-[11px] px-3.5 py-1.5 rounded-xl transition shadow-xs">
