        // Variant Matrix & Variant Photo Upload
        function generateFashionVariantMatrix() {
            const sizesStr = document.getElementById('fashionSizes')?.value || '';
            const colorsStr = document.getElementById('fashionColors')?.value || '';
            const sizes = sizesStr.split(',').map(s => s.trim()).filter(Boolean);
            const colors = colorsStr.split(',').map(c => c.trim()).filter(Boolean);
            const basePrice = parseFloat(document.getElementById('prodPrice')?.value || 0);

            const existingMap = {};
            customVariantsList.forEach(v => { existingMap[v.id || v.name] = v; });

            customVariantsList = [];
            if (sizes.length > 0 && colors.length > 0) {
                sizes.forEach(s => {
                    colors.forEach(c => {
                        const id = `${s}-${c}`.toLowerCase().replace(/\s+/g, '-');
                        const prev = existingMap[id];
                        customVariantsList.push({
                            id,
                            name: `${s} / ${c}`,
                            size: s,
                            color: c,
                            price: prev?.price || basePrice,
                            stock: prev?.stock || 50,
                            image_url: prev?.image_url || null
                        });
                    });
                });
            } else if (sizes.length > 0) {
                sizes.forEach(s => {
                    const id = s.toLowerCase();
                    const prev = existingMap[id];
                    customVariantsList.push({
                        id,
                        name: `Size: ${s}`,
                        size: s,
                        price: prev?.price || basePrice,
                        stock: prev?.stock || 50,
                        image_url: prev?.image_url || null
                    });
                });
            } else if (colors.length > 0) {
                colors.forEach(c => {
                    const id = c.toLowerCase();
                    const prev = existingMap[id];
                    customVariantsList.push({
                        id,
                        name: `Color: ${c}`,
                        color: c,
                        price: prev?.price || basePrice,
                        stock: prev?.stock || 50,
                        image_url: prev?.image_url || null
                    });
                });
            }
            renderVariantMatrix();
        }

