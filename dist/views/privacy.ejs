<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Privacy Policy | zlik - Selling, Made Slick</title>
  <meta name="description" content="Privacy Policy for zlik. Learn how we collect, protect, and process merchant and buyer information in compliance with NDPR and modern data privacy standards.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Space+Grotesk:wght@500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            display: ['"Plus Jakarta Sans"', 'sans-serif'],
            body: ['"Inter"', 'sans-serif'],
            mono: ['"Space Grotesk"', 'monospace']
          },
          colors: {
            brand: {
              black: '#08110D',
              green: '#19D98B',
              'green-dark': '#087A50',
              surface: '#F8FAF8',
              border: '#E3E9E5',
              subtle: '#6B756F'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-[#F8FAF8] text-[#08110D] font-body antialiased selection:bg-[#19D98B] selection:text-[#08110D] min-h-screen flex flex-col justify-between">

  <!-- Main Top Navigation -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-[#E3E9E5]">
    <div class="max-w-[1240px] mx-auto px-6 h-16 sm:h-20 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2 group">
          <span class="font-display font-bold text-2xl tracking-tight text-[#08110D] group-hover:text-[#087A50] transition-colors">zlik</span>
          <span class="text-[10px] uppercase font-bold tracking-widest bg-[#19D98B]/20 text-[#087A50] px-2 py-0.5 rounded-full">Legal</span>
        </a>
        <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-[#6B756F]">
          <a href="/#features" class="hover:text-[#08110D] transition-colors">Features</a>
          <a href="/#pricing" class="hover:text-[#08110D] transition-colors">Pricing</a>
          <a href="/marketplace" class="hover:text-[#08110D] transition-colors">Stores Directory</a>
          <a href="/terms" class="hover:text-[#08110D] transition-colors">Terms of Service</a>
        </nav>
      </div>

      <div class="flex items-center gap-3">
        <a href="/merchant/login" class="text-xs font-semibold text-[#08110D] hover:text-[#087A50] px-3.5 py-2 rounded-lg transition-colors">
          Sign In
        </a>
        <a href="/#create-store" class="bg-[#08110D] hover:bg-black text-white text-xs font-semibold font-display px-4 py-2.5 rounded-lg transition shadow-xs flex items-center gap-1.5">
          <span>Create Store</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Header -->
  <section class="bg-white border-b border-[#E3E9E5] py-12 sm:py-16">
    <div class="max-w-[1000px] mx-auto px-6 text-center space-y-4">
      <div class="inline-flex items-center gap-2 bg-[#F8FAF8] border border-[#E3E9E5] px-3.5 py-1.5 rounded-full text-xs font-medium text-[#6B756F]">
        <span>🔒</span>
        <span>NDPA / NDPR Compliant &bull; Last Revised: October 2026</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display tracking-tight text-[#08110D]">
        Privacy Policy
      </h1>
      <p class="text-sm sm:text-base text-[#6B756F] max-w-2xl mx-auto leading-relaxed">
        Your privacy is paramount. This Privacy Policy details how zlik collects, uses, protects, and handles personal data from merchants, shoppers, and visitors.
      </p>
    </div>
  </section>

  <!-- Privacy Content with Sticky Sidebar -->
  <main class="max-w-[1100px] mx-auto px-6 py-12 flex-1 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">

      <!-- Table of Contents (Desktop Sticky) -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-28 bg-white border border-[#E3E9E5] rounded-2xl p-6 shadow-2xs space-y-4">
        <div class="text-xs font-bold uppercase tracking-wider text-[#6B756F] font-display">
          Table of Contents
        </div>
        <nav class="space-y-1.5 text-xs">
          <a href="#overview" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">1. Privacy Overview & NDPA</a>
          <a href="#info-collect" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">2. Information We Collect</a>
          <a href="#how-we-use" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">3. How We Use Data</a>
          <a href="#sharing" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">4. Sharing & Disclosures</a>
          <a href="#pixels-cookies" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">5. Cookies & Tracking Pixels</a>
          <a href="#security" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">6. Data Security & Storage</a>
          <a href="#retention" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">7. Data Retention & Deletion</a>
          <a href="#your-rights" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">8. Your NDPR Data Rights</a>
          <a href="#third-parties" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">9. Merchant Storefronts</a>
          <a href="#contact-dpo" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">10. Data Protection Officer</a>
        </nav>

        <div class="pt-4 border-t border-[#E3E9E5]">
          <div class="text-[11px] text-[#6B756F]">
            Data privacy questions? <br>
            <a href="mailto:privacy@zlik.store" class="text-[#087A50] font-semibold hover:underline">privacy@zlik.store</a>
          </div>
        </div>
      </aside>

      <!-- Main Legal Privacy Document -->
      <article class="lg:col-span-8 bg-white border border-[#E3E9E5] rounded-2xl p-6 sm:p-10 shadow-2xs space-y-10 text-[#2D3748] leading-relaxed text-sm">

        <!-- 1. Overview & NDPA Compliance -->
        <section id="overview" class="space-y-3 pt-2">
          <h2 class="text-xl font-bold font-display text-[#08110D] tracking-tight flex items-center gap-2">
            <span class="text-[#19D98B]">1.</span> Privacy Overview & NDPA Compliance
          </h2>
          <p>
            <strong>zlik</strong> (“we”, “our”, or “us”) provides e-commerce storefront technology, catalog management, order processing, and customer communication tools for independent merchants.
          </p>
          <p>
            We are dedicated to safeguarding your personal data in full compliance with the <strong>Nigeria Data Protection Act (NDPA 2023)</strong> and the <strong>Nigeria Data Protection Regulation (NDPR)</strong>, as well as international data protection principles.
          </p>
        </section>

        <!-- 2. Information We Collect -->
        <section id="info-collect" class="space-y-3 pt-6 border-t border-[#E3E9E5]">
          <h2 class="text-xl font-bold font-display text-[#08110D] tracking-tight flex items-center gap-2">
            <span class="text-[#19D98B]">2.</span> Information We Collect
          </h2>
          <p>We collect information across two categories of users:</p>
          
          <div class="space-y-4">
            <div class="bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-4 space-y-2">
              <div class="font-bold text-[#08110D] font-display text-xs sm:text-sm">A. Merchant Account Information</div>
              <ul class="list-disc pl-5 space-y-1 text-xs sm:text-sm text-[#4A5550]">
                <li><strong>Identity & Contact:</strong> Full name, store name, phone/WhatsApp number, email address, password hash.</li>
                <li><strong>Banking Details:</strong> Bank Name, Account Number, Account Name (stored strictly to display payment instructions to your customers on checkout).</li>
                <li><strong>Marketing Credentials:</strong> Meta Pixel ID, Google Tag ID, TikTok Pixel ID (optionally provided by the merchant).</li>
                <li><strong>Store Data:</strong> Products, photos, prices, descriptions, discount coupons, sales ledger, and debt records.</li>
              </ul>
            </div>

            <div class="bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-4 space-y-2">
              <div class="font-bold text-[#08110D] font-display text-xs sm:text-sm">B. Customer & Storefront Shopper Information</div>
              <ul class="list-disc pl-5 space-y-1 text-xs sm:text-sm text-[#4A5550]">
                <li><strong>Order Placement:</strong> Customer name, phone number, delivery address, notes, selected delivery/pickup preferences.</li>
                <li><strong>Real-Time Chat:</strong> Messages exchanged with the store merchant via the built-in live chat.</li>
                <li><strong>Device & Analytics:</strong> IP address, device type, browser user agent, referring URL, and page timestamps (for anonymous store visitor metrics).</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- 3. How We Use Data -->
        <section id="how-we-use" class="space-y-3 pt-6 border-t border-[#E3E9E5]">
          <h2 class="text-xl font-bold font-display text-[#08110D] tracking-tight flex items-center gap-2">
            <span class="text-[#19D98B]">3.</span> How We Use Your Information
          </h2>
          <p>We use collected information solely for legitimate operational and business purposes, including:</p>
          <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-[#4A5550]">
            <li>Generating and hosting your customized storefront URL (e.g. <code>zlik.store/yourbrand</code>).</li>
            <li>Routing orders, receipts, and order tracking links (<code>/order/:ref</code>) to buyers and sellers.</li>
            <li>Facilitating real-time audio and visual order notifications and chat between merchants and buyers.</li>
            <li>Enabling merchants to view daily revenue analytics, visitor charts, and ledger exports.</li>
            <li>Preventing spam, fraudulent orders, automated bot scraping, and security attacks.</li>
          </ul>
        </section>

        <!-- 4. Sharing & Disclosures -->
        <section id="sharing" class="space-y-3 pt-6 border-t border-[#E3E9E5]">
          <h2 class="text-xl font-bold font-display text-[#08110D] tracking-tight flex items-center gap-2">
            <span class="text-[#19D98B]">4.</span> Sharing & Disclosures
          </h2>
          <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-xs sm:text-sm text-emerald-950 font-medium">
            🛡️ We never sell, rent, or trade your personal data to third-party data brokers or advertisers.
          </div>
          <p>We only share data with trusted service providers strictly necessary to operate the platform:</p>
          <ul class="list-disc pl-5 space-y-1 text-xs sm:text-sm text-[#4A5550]">
            <li><strong>Payment Gateways (e.g., Paystack):</strong> For processing subscription payments securely.</li>
            <li><strong>Transactional Email & SMS Providers:</strong> For delivering order receipts, verification codes, and alerts.</li>
            <li><strong>Law Enforcement & Regulatory Authorities:</strong> When strictly required by Nigerian law or court order.</li>
          </ul>
        </section>

        <!-- 5. Cookies & Tracking Pixels -->
        <section id="pixels-cookies" class="space-y-3 pt-6 border-t border-[#E3E9E5]">
          <h2 class="text-xl font-bold font-display text-[#08110D] tracking-tight flex items-center gap-2">
            <span class="text-[#19D98B]">5.</span> Cookies & Tracking Pixels
          </h2>
          <p>
            <strong>Platform Cookies:</strong> We use secure, HTTP-only session cookies to authenticate merchant logins and preserve shopping cart items across storefront visits.
          </p>
          <p>
            <strong>Merchant Advertising Pixels:</strong> If a merchant adds Meta Pixel, Google Tag, or TikTok Pixel IDs to their store settings, those scripts are executed on their storefront to track ad conversions. Those tracking tools are subject to the privacy policies of Meta, Google, and ByteDance respectively.
          </p>
        </section>

        <!-- 6. Data Security & Storage -->
        <section id="security" class="space-y-3 pt-6 border-t border-[#E3E9E5]">
          <h2 class="text-xl font-bold font-display text-[#08110D] tracking-tight flex items-center gap-2">
            <span class="text-[#19D98B]">6.</span> Data Security & Encryption
          </h2>
          <p>
            We implement industry-grade technical and organizational security measures:
          </p>
          <ul class="list-disc pl-5 space-y-1 text-xs sm:text-sm text-[#4A5550]">
            <li><strong>Encryption in Transit:</strong> All web traffic is encrypted via 256-bit TLS/SSL (HTTPS).</li>
            <li><strong>Password Protection:</strong> Passwords are cryptographically salted and hashed using modern algorithms.</li>
            <li><strong>High-Speed WAL Database:</strong> Data is persisted in transactional databases with automated daily snapshots and restricted administrative access.</li>
          </ul>
        </section>

        <!-- 7. Data Retention & Deletion -->
        <section id="retention" class="space-y-3 pt-6 border-t border-[#E3E9E5]">
          <h2 class="text-xl font-bold font-display text-[#08110D] tracking-tight flex items-center gap-2">
            <span class="text-[#19D98B]">7.</span> Data Retention & Account Deletion
          </h2>
          <p>
            We retain merchant and transaction data for as long as your store remains active. If you choose to delete your store or close your account, your products, settings, and personal identifiers will be permanently removed or anonymized within 30 days, except where retention is legally mandated for tax and accounting records.
          </p>
        </section>

        <!-- 8. Your NDPR Data Rights -->
        <section id="your-rights" class="space-y-3 pt-6 border-t border-[#E3E9E5]">
          <h2 class="text-xl font-bold font-display text-[#08110D] tracking-tight flex items-center gap-2">
            <span class="text-[#19D98B]">8.</span> Your Rights Under Nigerian Law
          </h2>
          <p>Under the NDPA 2023 and NDPR, you possess the right to:</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="border border-[#E3E9E5] bg-[#F8FAF8] p-3 rounded-xl">
              <strong class="text-[#08110D] block font-display">Right to Access</strong>
              <span>Request a copy of the personal data we hold about you.</span>
            </div>
            <div class="border border-[#E3E9E5] bg-[#F8FAF8] p-3 rounded-xl">
              <strong class="text-[#08110D] block font-display">Right to Rectification</strong>
              <span>Update or correct any inaccurate details in your merchant settings.</span>
            </div>
            <div class="border border-[#E3E9E5] bg-[#F8FAF8] p-3 rounded-xl">
              <strong class="text-[#08110D] block font-display">Right to Erasure</strong>
              <span>Request the deletion of your account and personal information.</span>
            </div>
            <div class="border border-[#E3E9E5] bg-[#F8FAF8] p-3 rounded-xl">
              <strong class="text-[#08110D] block font-display">Data Portability</strong>
              <span>Export your customer orders and sales history via CSV at any time.</span>
            </div>
          </div>
        </section>

        <!-- 9. Merchant Storefronts -->
        <section id="third-parties" class="space-y-3 pt-6 border-t border-[#E3E9E5]">
          <h2 class="text-xl font-bold font-display text-[#08110D] tracking-tight flex items-center gap-2">
            <span class="text-[#19D98B]">9.</span> Third-Party Links & Merchant Disclaimers
          </h2>
          <p>
            When customers interact with independent merchant stores hosted on zlik, the merchant acts as an independent data controller for the customer details collected to fulfill physical orders. Merchants are responsible for treating customer data respectfully in accordance with applicable privacy laws.
          </p>
        </section>

        <!-- 10. Data Protection Officer Contact -->
        <section id="contact-dpo" class="space-y-3 pt-6 border-t border-[#E3E9E5]">
          <h2 class="text-xl font-bold font-display text-[#08110D] tracking-tight flex items-center gap-2">
            <span class="text-[#19D98B]">10.</span> Data Protection Officer (DPO) Contact
          </h2>
          <p>
            To exercise your privacy rights or file an inquiry regarding your data, please contact our Data Protection Officer:
          </p>
          <div class="bg-[#F8FAF8] border border-[#E3E9E5] p-4 rounded-xl text-xs sm:text-sm space-y-1">
            <div><strong>Data Protection Officer:</strong> <a href="mailto:privacy@zlik.store" class="text-[#087A50] font-semibold">privacy@zlik.store</a></div>
            <div><strong>General Support:</strong> <a href="mailto:support@zlik.store" class="text-[#087A50] font-semibold">support@zlik.store</a></div>
            <div><strong>Platform:</strong> zlik (Selling, Made Slick)</div>
            <div><strong>Jurisdiction:</strong> Federal Republic of Nigeria</div>
          </div>
        </section>

      </article>
    </div>
  </main>

  <!-- Uniform Public Site Footer -->
  <footer class="bg-[#08110D] text-white border-t border-[#08110D] relative overflow-hidden font-body mt-16">
    <div class="max-w-[1240px] mx-auto px-6 py-12 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-8 border-b border-white/10">
        <div class="md:col-span-5 space-y-3">
          <a href="/" class="hover:opacity-90 transition inline-block">
            <span class="font-display font-semibold text-2xl text-white">zlik</span>
          </a>
          <p class="text-xs text-[#E3E9E5]/70 leading-relaxed font-normal max-w-sm">
            zlik is the easiest way to sell products and services online. One clean link for Instagram, TikTok, WhatsApp, Facebook, and the web.
          </p>
        </div>
        <div class="md:col-span-3 space-y-2 text-xs">
          <div class="uppercase tracking-wider font-semibold text-white/50 font-display">Navigation</div>
          <ul class="space-y-2 text-[#E3E9E5]/80">
            <li><a href="/#features" class="hover:text-white transition">Features</a></li>
            <li><a href="/#pricing" class="hover:text-white transition">Pricing</a></li>
            <li><a href="/marketplace" class="hover:text-white transition">Stores Directory</a></li>
          </ul>
        </div>
        <div class="md:col-span-4 space-y-2 text-xs">
          <div class="uppercase tracking-wider font-semibold text-white/50 font-display">Legal & Trust</div>
          <ul class="space-y-2 text-[#E3E9E5]/80">
            <li><a href="/terms" class="hover:text-white transition">Terms of Service</a></li>
            <li><a href="/privacy" class="hover:text-white text-[#19D98B] font-semibold transition">Privacy Policy</a></li>
            <li><a href="/merchant/login" class="hover:text-white transition">Merchant Sign In</a></li>
          </ul>
        </div>
      </div>

      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#E3E9E5]/50">
        <div>
          <span>&copy; <%= new Date().getFullYear() %> zlik. All rights reserved.</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="/terms" class="hover:text-white transition">Terms of Service</a>
          <span>&bull;</span>
          <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
          <span>&bull;</span>
          <span>zlik.store</span>
        </div>
      </div>
    </div>
  </footer>

</body>
</html>
