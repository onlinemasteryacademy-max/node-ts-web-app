        async function handleStartCustomerChat(e) {
            e.preventDefault();
            const btn = document.getElementById('zlikLeadSubmitBtn');
            const err = document.getElementById('zlikLeadError');
            const name = document.getElementById('zlikLeadName').value.trim();
            const phone = document.getElementById('zlikLeadPhone').value.trim();

            if (!name || name.length < 2) {
                err.textContent = 'Please enter your full name.';
                err.classList.remove('hidden');
                return;
            }
            if (!phone || phone.length < 8) {
                err.textContent = 'Please enter a valid WhatsApp phone number.';
                err.classList.remove('hidden');
                return;
            }

            err.classList.add('hidden');
            btn.disabled = true;
            btn.innerHTML = '<span>Connecting...</span>';

            try {
                localStorage.setItem('zlik_chat_cust_name_' + storeData.id, name);
                localStorage.setItem('zlik_chat_cust_phone_' + storeData.id, phone);

                document.getElementById('zlikChatLeadGate').classList.add('hidden');
                document.getElementById('zlikChatActiveView').classList.remove('hidden');

                await initCustomerChat(name, phone);
                setTimeout(() => document.getElementById('zlikChatInput')?.focus(), 200);
            } catch (error) {
                err.textContent = 'Could not initialize chat. Please try again.';
                err.classList.remove('hidden');
                document.getElementById('zlikChatLeadGate').classList.remove('hidden');
                document.getElementById('zlikChatActiveView').classList.add('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>Start Conversation</span> <span>💬</span>';
            }
        }

        async function initCustomerChat(custName, custPhone) {
            try {
                const loadingEl = document.getElementById('zlikChatLoadingState');
                if (loadingEl) loadingEl.textContent = 'Connecting to ' + (storeData.store_name || 'Store') + '...';

                const saved = getSavedCustomerChatInfo() || {};
                const name = custName || saved.name || 'Store Customer';
                const phone = custPhone || saved.phone || '';

                const res = await fetch('/api/chat/session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        store_id: storeData.id, 
                        session_token: sessionToken,
                        customer_name: name,
                        customer_phone: phone
                    })
                });
                const d = await res.json();
                if (d.success) {
                    conversationId = d.conversation_id;
                    sessionToken = d.session_token;
                    localStorage.setItem('zlik_chat_token_' + storeData.id, sessionToken);
                    await loadMessages();
                    connectChatStreams();
                } else {
                    if (loadingEl) loadingEl.textContent = 'Unable to connect to live chat. Please try again.';
                }
            } catch(e){
                console.error('Chat init error:', e);
            }
        }

        async function loadMessages() {
            if (!conversationId) return;
            try {
                const res = await fetch(`/api/chat/messages?conversation_id=${conversationId}`);
                const d = await res.json();
                if (d.success && Array.isArray(d.messages)) {
                    renderMessages(d.messages);
                }
            } catch(e){}
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function renderMessages(messages) {
            const stream = document.getElementById('zlikChatMessageStream');
            if (!stream) return;
            if (!messages || messages.length === 0) {
                stream.innerHTML = `<div class="text-center py-6 text-[#6B756F] text-xs">Hi! How can we help you today with ${storeData.store_name}?</div>`;
                return;
            }
            stream.innerHTML = messages.map(m => {
                const text = m.message || m.message_text || '';
                const isCustomer = m.sender_type === 'customer';
                const time = m.created_at ? new Date(m.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '';
                return `
                    <div class="flex ${isCustomer ? 'justify-end' : 'justify-start'}">
                        <div class="max-w-[80%] rounded-2xl px-3.5 py-2 text-xs ${isCustomer ? 'bg-[#08110D] text-white rounded-br-none' : 'bg-white border border-[#E3E9E5] text-[#08110D] rounded-bl-none shadow-2xs'}">
                            <div class="whitespace-pre-wrap leading-relaxed">${escapeHtml(text)}</div>
                            <div class="text-[9px] ${isCustomer ? 'text-white/60' : 'text-[#6B756F]'} text-right mt-0.5">${time}</div>
                        </div>
                    </div>
                `;
            }).join('');
            stream.scrollTop = stream.scrollHeight;
        }

        async function handleSendCustomerMessage(e) {
            e.preventDefault();
            const input = document.getElementById('zlikChatInput');
            const text = input.value.trim();
            if (!text) return;

            const saved = getSavedCustomerChatInfo();
            if (!saved) {
                toggleLiveChat(true);
                return;
            }

            if (!conversationId) {
                await initCustomerChat(saved.name, saved.phone);
                if (!conversationId) return;
            }

            input.value = '';

            // Optimistic rendering
            const stream = document.getElementById('zlikChatMessageStream');
            const optimisticMsg = document.createElement('div');
            optimisticMsg.className = 'flex justify-end';
            optimisticMsg.innerHTML = `
                <div class="max-w-[80%] rounded-2xl px-3.5 py-2 text-xs bg-[#08110D] text-white rounded-br-none">
                    <div class="whitespace-pre-wrap leading-relaxed">${escapeHtml(text)}</div>
                    <div class="text-[9px] text-white/60 text-right mt-0.5">Just now</div>
                </div>
            `;
            stream.appendChild(optimisticMsg);
            stream.scrollTop = stream.scrollHeight;

            try {
                await fetch('/api/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        conversation_id: conversationId,
                        sender_type: 'customer',
                        sender_id: sessionToken,
                        message_text: text
                    })
                });
                loadMessages();
            } catch(e){}
        }

        function connectChatStreams() {
            try {
                if (chatWs) { try { chatWs.close(); } catch(e){} }
                const wsProto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                chatWs = new WebSocket(`${wsProto}//${window.location.host}/ws/chat`);
                chatWs.onopen = () => {
                    chatWs.send(JSON.stringify({ type: 'auth', role: 'customer', session_token: sessionToken }));
                };
                chatWs.onmessage = () => {
                    loadMessages();
                };
            } catch(e){}

            // Polling fallback to guarantee continuous real-time messaging
            if (!window.chatPollTimer) {
                window.chatPollTimer = setInterval(() => {
                    if (chatOpen && conversationId) loadMessages();
                }, 3500);
            }
        }

        // Search & Category Filters
        function filterCategory(cat) {
            document.querySelectorAll('.cat-btn').forEach(b => {
                if (b.textContent === cat) {
                    b.className = 'cat-btn active px-3.5 py-1.5 rounded-lg bg-[#08110D] text-white transition';
                } else {
                    b.className = 'cat-btn px-3.5 py-1.5 rounded-lg bg-white border border-[#E3E9E5] text-[#6B756F] hover:text-[#08110D] transition';
                }
            });

            document.querySelectorAll('.product-card').forEach(card => {
                if (cat === 'All' || card.dataset.category === cat) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        function handleSearch(query) {
            const q = query.toLowerCase().trim();
            document.querySelectorAll('.product-card').forEach(card => {
                if (!q || card.dataset.title.includes(q)) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        // Store Share Modal
        let storeShareQr = null;
        function openStoreShareModal() {
            const modal = document.getElementById('storefrontShareModal');
            modal.classList.remove('hidden');
            const container = document.getElementById('storeShareQrContainer');
            if (!storeShareQr) {
                container.innerHTML = '';
                storeShareQr = new QRCode(container, {
                    text: 'https://zlik.store/' + storeData.slug,
                    width: 160,
                    height: 160,
                    colorDark: '#08110D',
                    colorLight: '#ffffff',
                    correctLevel: QRCode.CorrectLevel.H
                });
            }
        }

        function closeStoreShareModal() {
            document.getElementById('storefrontShareModal').classList.add('hidden');
        }

        function copyStorefrontUrl() {
            const fullUrl = 'https://zlik.store/' + storeData.slug;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(fullUrl).then(() => {
                    const btn = document.getElementById('storefrontCopyBtn');
                    btn.innerHTML = '<span>✓ Copied!</span>';
                    setTimeout(() => btn.innerHTML = '<span>📋 Copy Store Link</span>', 2000);
                });
            }
        }

        // URL Hash check for direct product link
        document.addEventListener('DOMContentLoaded', () => {
            const hash = window.location.hash;
            if (hash.startsWith('#product-')) {
                const pid = hash.replace('#product-', '');
                openProductModal(pid);
            }
        });
    </script>
</body>
</html>
