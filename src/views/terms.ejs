<body class="bg-[#F8FAF8] text-[#08110D] font-body antialiased selection:bg-[#19D98B] selection:text-[#08110D] min-h-screen flex flex-col justify-between">

  <!-- Main Top Navigation -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-[#E3E9E5]">
    <div class="max-w-[1240px] mx-auto px-6 h-16 sm:h-20 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2 group">
          <span class="font-display font-bold text-2xl tracking-tight text-[#08110D] group-hover:text-[#087A50] transition-colors">zlik</span>
          <span class="text-[10px] uppercase font-bold tracking-widest bg-[#19D98B]/20 text-[#087A50] px-2 py-0.5 rounded-full">Legal</span>
        </a>
        <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-[#6B756F]">
