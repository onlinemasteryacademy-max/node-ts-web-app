                    Close
                </button>
                <button type="button" id="tplModalApplyBtn" onclick="applyFromPreview()" class="w-1/2 bg-[#08110D] hover:bg-black text-[#19D98B] font-semibold text-xs py-3 rounded-xl transition shadow-2xs">
                    Select This Template
