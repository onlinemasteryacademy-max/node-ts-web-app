                            <div class="min-w-0">
                                <div class="font-bold text-xs text-[#08110D] truncate">${v.name}</div>
                                <div class="text-[10px] text-[#6B756F]">${v.image_url ? '✓ Photo Attached' : '+ Optional Photo'}</div>
