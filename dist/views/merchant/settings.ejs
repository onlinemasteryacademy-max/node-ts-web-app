            const removeBtn = document.getElementById('removeLogoBtn');
            if (removeBtn) removeBtn.classList.add('hidden');
            const fileInput = document.getElementById('logoFileInput');
            if (fileInput) fileInput.value = '';
        }

        async function handleCoverUpload(file) {
            if (!file) return;
            const currentTpl = allTemplatesData[selectedTemplateId];
            if (currentTpl && !currentTpl.is_pro) {
                openProUpgradeModal('Pro Storefront Covers');
                return;
            }
            if (file.size > 10 * 1024 * 1024) {
                alert('File exceeds 10MB limit. Please choose a smaller image.');
                return;
            }

            const formData = new FormData();
            formData.append('files', file);

            try {
                const res = await fetch('/api/upload', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.url) {
                    document.getElementById('coverUrl').value = data.url;
                    
                    const container = document.getElementById('coverPreviewContainer');
                    container.innerHTML = `<img id="coverPreviewImg" src="${data.url}" alt="Store Cover" class="w-full h-full object-cover">`;
                    
                    const removeBtn = document.getElementById('removeCoverBtn');
                    if (removeBtn) removeBtn.classList.remove('hidden');
                } else {
                    alert(data.error || 'Failed to upload cover image.');
                }
            } catch (err) {
                alert('Network error while uploading cover image.');
            }
        }

        function removeStoreCover() {
            document.getElementById('coverUrl').value = '';
            const defaultCover = (templateConfig && templateConfig.default_cover_image) || '/assets/images/templates/general_modern.svg';
            const container = document.getElementById('coverPreviewContainer');
            container.innerHTML = `<img id="coverPreviewImg" src="${defaultCover}" alt="Cover Preview" class="w-full h-full object-cover">`;
            const removeBtn = document.getElementById('removeCoverBtn');
            if (removeBtn) removeBtn.classList.add('hidden');
            const fileInput = document.getElementById('coverFileInput');
            if (fileInput) fileInput.value = '';
        }

        const originalBankAccountNumber = '<%= (store.bank_account_number || "").trim() %>';
        let bankOtpTimerInterval = null;
        let bankOtpSecondsRemaining = 300;
        let pendingSettingsPayload = null;
        let bankResolutionDebounceTimer = null;

        // ==========================================
        // Bank Account Selection & Real-Time Resolution
        // ==========================================
        function handleBankSelectChange(select) {
            const bankNameInput = document.getElementById('bankName');
            if (select.value && select.selectedIndex > 0) {
                const optText = select.options[select.selectedIndex].text;
                if (bankNameInput) {
                    bankNameInput.value = optText.replace(/\s*\(.*\)/, '').trim();
                }
            }
            triggerResolutionIfReady();
        }

        function handleAccountInput(val) {
            const cleanVal = (val || '').replace(/[^0-9]/g, '');
            const acctInput = document.getElementById('accountNumber');
            if (acctInput && acctInput.value !== cleanVal) {
                acctInput.value = cleanVal;
            }
            if (cleanVal.length === 10) {
                triggerResolutionIfReady();
            } else {
                const feedback = document.getElementById('accountResolutionFeedback');
                if (feedback) {
                    feedback.className = 'mt-1.5 text-[11px] hidden';
                    feedback.innerHTML = '';
                }
            }
        }

        async function triggerResolutionIfReady() {
            const bankSelect = document.getElementById('bankSelect');
            const bankCode = bankSelect ? bankSelect.value : '';
            const acctInput = document.getElementById('accountNumber');
            const acctNum = acctInput ? acctInput.value.trim().replace(/[^0-9]/g, '') : '';
            const feedback = document.getElementById('accountResolutionFeedback');
            if (!feedback) return;

            if (acctNum.length !== 10 || !bankCode) {
                feedback.className = 'mt-1.5 text-[11px] hidden';
                return;
            }

            feedback.className = 'mt-1.5 text-[11px] text-[#6B756F] flex items-center gap-1.5';
            feedback.innerHTML = '<svg class="w-3.5 h-3.5 animate-spin text-[#6B756F]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> <span>Querying verified CBN NUBAN directory...</span>';

            if (bankResolutionDebounceTimer) clearTimeout(bankResolutionDebounceTimer);
            bankResolutionDebounceTimer = setTimeout(async () => {
                try {
                    const res = await fetch('/api/merchant/bank/resolve', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ bank_code: bankCode, account_number: acctNum })
                    });
                    const data = await res.json();
                    if (data.success && data.account_name) {
                        const nameInput = document.getElementById('accountName');
                        if (nameInput) nameInput.value = data.account_name;

                        if (data.name_match && data.name_match.is_acceptable) {
                            feedback.className = 'mt-1.5 text-[11px] text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg p-2 font-medium flex items-center gap-1.5';
                            feedback.innerHTML = `<svg class="w-3.5 h-3.5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span><strong>${data.account_name}</strong> &bull; ${data.name_match.confidence || 'Identity verified'}</span>`;
                        } else {
                            feedback.className = 'mt-1.5 text-[11px] text-amber-800 bg-amber-50 border border-amber-200 rounded-lg p-2 font-medium flex items-start gap-1.5';
                            feedback.innerHTML = `<svg class="w-3.5 h-3.5 shrink-0 text-amber-600 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg> <span><strong>${data.account_name}</strong> &bull; Note: Account name differs from registered store name. Changing payout bank requires 6-digit email OTP authorization.</span>`;
                        }
                    } else {
                        feedback.className = 'mt-1.5 text-[11px] text-red-600 bg-red-50 border border-red-200 rounded-lg p-2 font-medium flex items-center gap-1.5';
                        feedback.innerHTML = `<svg class="w-3.5 h-3.5 shrink-0 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg> <span>${data.error || 'Could not verify account with selected bank. Check account number.'}</span>`;
                    }
                } catch (err) {
                    feedback.className = 'mt-1.5 text-[11px] text-red-600 bg-red-50 border border-red-200 rounded-lg p-2 font-medium';
                    feedback.innerHTML = '<span>Network error querying bank details.</span>';
                }
            }, 300);
        }

        function startBankOtpTimer(duration = 300) {
            if (bankOtpTimerInterval) clearInterval(bankOtpTimerInterval);
            bankOtpSecondsRemaining = duration;
            updateBankOtpTimerDisplay();

            const resendBtn = document.getElementById('resendBankOtpBtn');
            if (resendBtn) resendBtn.disabled = true;

            bankOtpTimerInterval = setInterval(() => {
                bankOtpSecondsRemaining--;
                if (bankOtpSecondsRemaining <= 0) {
                    clearInterval(bankOtpTimerInterval);
                    bankOtpSecondsRemaining = 0;
                    if (resendBtn) resendBtn.disabled = false;
                } else if (bankOtpSecondsRemaining <= 270) {
                    if (resendBtn) resendBtn.disabled = false;
                }
                updateBankOtpTimerDisplay();
            }, 1000);
        }

        function updateBankOtpTimerDisplay() {
            const text = document.getElementById('bankOtpCountdownText');
            if (!text) return;
            const min = Math.floor(bankOtpSecondsRemaining / 60);
            const sec = bankOtpSecondsRemaining % 60;
            text.textContent = `${String(min).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
        }

        function openBankOtpModal(maskedEmail) {
            if (maskedEmail) {
                document.getElementById('bankOtpMaskedEmail').textContent = maskedEmail;
            }
            document.getElementById('bankOtpInput').value = '';
            document.getElementById('bankOtpModal').classList.remove('hidden');
            startBankOtpTimer(300);
            setTimeout(() => document.getElementById('bankOtpInput')?.focus(), 150);
        }

        function closeBankOtpModal() {
            document.getElementById('bankOtpModal').classList.add('hidden');
            if (bankOtpTimerInterval) clearInterval(bankOtpTimerInterval);
            const btn = document.getElementById('saveBtn');
            if (btn) {
                btn.disabled = false;
                btn.textContent = 'Save Settings';
            }
        }

        async function requestBankOtp(isResend = false) {
            const newAccountNum = document.getElementById('accountNumber')?.value?.trim() || '';
            const newBankName = document.getElementById('bankName')?.value?.trim() || '';
            const newAccountName = document.getElementById('accountName')?.value?.trim() || '';
            const bankCode = document.getElementById('bankSelect')?.value || '';

            const resendBtn = document.getElementById('resendBankOtpBtn');
            if (resendBtn && isResend) {
                resendBtn.disabled = true;
                resendBtn.textContent = 'Sending...';
            }

            try {
                const res = await fetch('/api/merchant/bank/request-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        bank_code: bankCode,
                        bank_account_number: newAccountNum,
                        bank_name: newBankName,
                        bank_account_name: newAccountName
                    })
                });
                const data = await res.json();
                if (data.success) {
                    openBankOtpModal(data.masked_email);
                    if (isResend) alert(data.message || 'New verification code sent to your email.');
                } else {
                    alert(data.error || 'Failed to request security verification code.');
                    const btn = document.getElementById('saveBtn');
                    if (btn) {
                        btn.disabled = false;
                        btn.textContent = 'Save Settings';
                    }
                }
            } catch (err) {
                alert('Network error requesting verification code.');
            } finally {
                if (resendBtn && isResend) {
                    resendBtn.textContent = 'Resend Code';
                }
            }
        }

        async function handleVerifyAndSaveBankOtp(e) {
            e.preventDefault();
            const otpCode = document.getElementById('bankOtpInput')?.value?.trim();
            if (!otpCode || otpCode.length < 6) {
                alert('Please enter the full 6-digit verification code.');
                return;
            }

            const submitBtn = document.getElementById('verifyBankOtpSubmitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span>Verifying...</span>';

            const bankCode = document.getElementById('bankSelect')?.value || '';
            const newAccountNum = document.getElementById('accountNumber')?.value?.trim() || '';
            const newBankName = document.getElementById('bankName')?.value?.trim() || '';
            const newAccountName = document.getElementById('accountName')?.value?.trim() || '';

            // Verify via bank verification endpoint
            try {
                const vRes = await fetch('/api/merchant/bank/verify-and-update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        otp_code: otpCode,
                        bank_code: bankCode,
                        bank_name: newBankName,
                        account_number: newAccountNum,
                        account_name: newAccountName
                    })
                });
                const vData = await vRes.json();
                if (!vData.success) {
                    alert(vData.error || 'Failed to verify authorization code.');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = 'Approve & Save';
                    return;
                }
            } catch (err) {
                alert('Network error verifying authorization code.');
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Approve & Save';
                return;
            }

            if (pendingSettingsPayload) {
                pendingSettingsPayload.otp_code = otpCode;
                await submitSettingsPayload(pendingSettingsPayload, submitBtn);
            }
        }

        async function submitSettingsPayload(payload, triggerBtn = null) {
            const saveBtn = document.getElementById('saveBtn');
            try {
                const res = await fetch('/api/merchant/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const d = await res.json();
                if (d.success) {
                    if (triggerBtn) triggerBtn.innerHTML = 'Verified';
                    if (saveBtn) {
                        saveBtn.textContent = 'Saved Successfully';
                        saveBtn.classList.add('bg-emerald-600', 'text-white');
                    }
                    setTimeout(() => {
                        location.reload();
                    }, 500);
                } else {
                    alert(d.error || 'Failed to update settings');
                    if (triggerBtn) {
                        triggerBtn.disabled = false;
                        triggerBtn.innerHTML = 'Approve & Save';
                    }
                    if (saveBtn) {
                        saveBtn.disabled = false;
                        saveBtn.textContent = 'Save Settings';
                    }
                }
            } catch (err) {
                alert('Network error updating settings. Please try again.');
                if (triggerBtn) {
                    triggerBtn.disabled = false;
                    triggerBtn.innerHTML = 'Approve & Save';
                }
                if (saveBtn) {
                    saveBtn.disabled = false;
                    saveBtn.textContent = 'Save Settings';
                }
            }
        }

        async function handleSaveSettings(e) {
            e.preventDefault();
            const btn = document.getElementById('saveBtn');
            const originalText = btn ? btn.textContent : 'Save Settings';
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Saving Settings...';
            }

            const newAccountNum = document.getElementById('accountNumber')?.value?.trim() || '';
            const isAccountChanged = newAccountNum !== '' && newAccountNum !== originalBankAccountNumber;

            const payload = {
                template_slug: document.getElementById('selectedTemplateInput')?.value || 'general_clean',
                slug: document.getElementById('storeSlug')?.value?.trim() || '',
                store_name: document.getElementById('storeName')?.value?.trim() || '',
                bio: document.getElementById('storeBio')?.value?.trim() || '',
                logo_url: document.getElementById('logoUrl')?.value?.trim() || null,
                cover_url: document.getElementById('coverUrl')?.value?.trim() || null,
                cover_overlay_color: document.getElementById('coverOverlayColorHex')?.value?.trim() || '#08110D',
                receipt_custom_note: document.getElementById('receiptCustomNote')?.value?.trim() || null,
                receipt_show_logo: document.getElementById('receiptShowLogo')?.checked ? 1 : 0,
                meta_pixel_id: document.getElementById('metaPixelId')?.value?.trim() || null,
                google_tag_id: document.getElementById('googleTagId')?.value?.trim() || null,
                tiktok_pixel_id: document.getElementById('tiktokPixelId')?.value?.trim() || null,
                bank_name: document.getElementById('bankName')?.value?.trim() || null,
                bank_account_number: newAccountNum || null,
                bank_account_name: document.getElementById('accountName')?.value?.trim() || null,
                alert_sound: document.getElementById('alertSound')?.value || 'bell',
                delivery_fee: parseFloat(document.getElementById('deliveryFee')?.value || 0),
                allow_bank_transfer: document.getElementById('allowBankTransfer')?.checked ? 1 : 0,
                allow_pay_on_delivery: document.getElementById('allowPayOnDelivery')?.checked ? 1 : 0
            };

            if (isAccountChanged) {
                pendingSettingsPayload = payload;
                await requestBankOtp(false);
                return;
            }

            await submitSettingsPayload(payload);
        }

