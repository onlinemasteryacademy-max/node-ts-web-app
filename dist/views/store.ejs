        let pendingCheckoutPayload = null;

        async function submitCheckout(e, forceCreate = false) {
            if (e) e.preventDefault();
            const btn = document.getElementById('submitOrderBtn');
            const errDiv = document.getElementById('checkoutError');
            btn.disabled = true;
            errDiv.classList.add('hidden');

            const payload = {
                store_id: storeData.id,
                customer_name: document.getElementById('custName').value.trim(),
                customer_phone: document.getElementById('custPhone').value.trim(),
                fulfillment_type: document.getElementById('fulfillmentType').value,
                delivery_address: document.getElementById('custAddress')?.value.trim() || 'In-Store Pickup',
                payment_method: document.getElementById('paymentMethod').value,
                items: cart,
                delivery_fee: parseFloat(storeData.delivery_fee || 0),
                discount_code: appliedCouponCode,
                discount_amount: appliedDiscountAmount,
                force_create: forceCreate
            };

            try {
                const res = await fetch('/api/orders/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const d = await res.json();

                if (d.success) {
                    trackEvent('Purchase', {
                        value: d.order.total_amount,
                        currency: 'NGN',
                        order_id: d.order.order_ref
                    });

                    cart = [];
                    appliedCouponCode = null;
                    appliedDiscountAmount = 0;
                    renderCart();
                    closeCheckoutModal();
                    closeOpenOrderWarningModal();
                    window.location.href = '/receipt/' + d.order.order_ref;
                } else if (d.open_orders_exceeded) {
                    // Open order warning prompt
                    pendingCheckoutPayload = payload;
                    document.getElementById('openOrderWarningModal').classList.remove('hidden');
                } else {
                    errDiv.textContent = d.error || 'Failed to place order';
                    errDiv.classList.remove('hidden');
                }
            } catch (err) {
                errDiv.textContent = 'Network error placing order';
                errDiv.classList.remove('hidden');
            } finally {
                btn.disabled = false;
            }
        }

        function closeOpenOrderWarningModal() {
            document.getElementById('openOrderWarningModal').classList.add('hidden');
        }

        function confirmForceNewOrder() {
            if (pendingCheckoutPayload) {
                submitCheckout(null, true);
            }
        }

