                <div>
                    <label class="block font-medium text-[#111827] mb-1">Standard Delivery Fee (₦)</label>
                    <input type="number" id="deliveryFee" value="<%= store.delivery_fee || 0 %>" min="0" step="50" placeholder="0" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] text-xs font-medium">
                    <span class="text-[10px] text-[#6B7280] mt-1 block">Set to 0 for free delivery or custom checkout arrangements.</span>
                </div>
            </div>

            <!-- Notification Sounds -->
