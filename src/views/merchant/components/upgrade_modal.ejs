<!-- Contextual Pro Upgrade Modal Component -->
<div id="upgradePromptModal" class="fixed inset-0 bg-[#08110D]/70 backdrop-blur-xs z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 hidden" onclick="if(event.target === this) closeUpgradeModal();">
    <div class="bg-white max-w-lg w-full rounded-t-3xl sm:rounded-3xl p-6 sm:p-8 shadow-2xl border border-[#E3E9E5] relative space-y-6 transform transition-all scale-100 max-h-[90vh] overflow-y-auto">
        <button onclick="closeUpgradeModal()" class="absolute top-5 right-5 text-[#6B756F] hover:text-[#08110D] font-bold text-xl p-1 rounded-full hover:bg-[#F8FAF8] transition">✕</button>

        <!-- Dynamic Header -->
        <div class="text-center space-y-2">
            <div id="upgradeBadge" class="inline-flex items-center gap-1.5 bg-[#19D98B]/15 text-[#087A50] text-xs font-bold px-3.5 py-1.5 rounded-full border border-[#19D98B]/30 font-display">
                <span>⭐</span>
                <span id="upgradeBadgeText">Pro Feature</span>
            </div>
            <h3 id="upgradeTitle" class="text-xl sm:text-2xl font-extrabold text-[#08110D] tracking-tight font-display">Run your store like a high-growth brand</h3>
            <p id="upgradeDescription" class="text-xs text-[#6B756F] max-w-md mx-auto leading-relaxed">
                Upgrade to Zlik Pro to unlock multi-period sales analytics, custom domains, 500 products, and all 15 storefront templates.
            </p>
        </div>

        <!-- Pro Feature Perks -->
        <div class="bg-[#F8FAF8] p-4 rounded-2xl border border-[#E3E9E5] space-y-2 text-xs text-[#08110D]">
            <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-[#19D98B]/20 text-[#087A50] font-bold flex items-center justify-center text-[10px]">✓</span>
                <span><strong>Full Sales Ledger & Multi-Period Analytics</strong> (Month, 3M, 6M, Year, Lifetime)</span>
            </div>
            <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-[#19D98B]/20 text-[#087A50] font-bold flex items-center justify-center text-[10px]">✓</span>
                <span><strong>500 Products Allowance</strong> (5 photos/item + CSV import)</span>
            </div>
            <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-[#19D98B]/20 text-[#087A50] font-bold flex items-center justify-center text-[10px]">✓</span>
                <span><strong>All 15 Industry Storefront Designs</strong> & Custom Branding</span>
            </div>
            <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-[#19D98B]/20 text-[#087A50] font-bold flex items-center justify-center text-[10px]">✓</span>
                <span><strong>CSV Ledger Export & White-Label Clean Receipts</strong></span>
            </div>
        </div>

        <!-- Billing Options (Monthly vs Annual) -->
        <div class="grid grid-cols-2 gap-3 text-xs">
            <div onclick="selectBillingCycle('monthly')" id="cycleCard-monthly" class="cursor-pointer border-2 border-[#08110D] bg-[#F8FAF8] p-3.5 sm:p-4 rounded-2xl text-center transition flex flex-col justify-between shadow-xs">
                <div>
                    <div class="text-[10px] uppercase font-bold text-[#6B756F]">Monthly Plan</div>
                    <div class="text-base sm:text-lg font-extrabold text-[#08110D] mt-0.5 font-display">₦5,000</div>
                </div>
                <span class="text-[10px] text-[#6B756F] mt-1">Billed monthly</span>
            </div>

            <div onclick="selectBillingCycle('yearly')" id="cycleCard-yearly" class="cursor-pointer border border-[#E3E9E5] bg-white p-3.5 sm:p-4 rounded-2xl text-center transition relative flex flex-col justify-between">
                <span class="absolute -top-2.5 right-2 bg-[#19D98B] text-[#08110D] text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full font-display">
                    Save ₦10,000
                </span>
                <div>
                    <div class="text-[10px] uppercase font-bold text-[#087A50]">Annual Plan</div>
                    <div class="text-base sm:text-lg font-extrabold text-[#087A50] mt-0.5 font-display">₦50,000</div>
                </div>
                <span class="text-[10px] text-[#087A50] font-bold mt-1">₦4,166 / mo equivalent</span>
            </div>
        </div>

        <!-- Direct Upgrade CTA Actions -->
        <div class="space-y-2 pt-1">
            <button type="button" id="upgradeCheckoutBtn" onclick="handleUpgradeDirectPayment()" class="w-full bg-[#08110D] hover:bg-black text-[#19D98B] font-extrabold text-xs uppercase tracking-wider py-3.5 sm:py-4 rounded-2xl shadow-md transition duration-200 flex items-center justify-center gap-2 font-display">
                <span>Unlock Pro (₦5,000/mo)</span>
                <span>→</span>
            </button>
            <button type="button" onclick="closeUpgradeModal()" class="w-full text-center text-xs font-semibold text-[#6B756F] hover:text-[#08110D] py-2 transition">
                Not now, continue with Free plan
            </button>
        </div>

        <div class="text-center text-[10px] text-[#6B756F] pb-safe">
            🔒 Direct Instant Activation • Cancel anytime • Zero hidden fees
        </div>
    </div>
</div>

<script>
    let selectedCycle = 'monthly';

    function selectBillingCycle(cycle) {
        selectedCycle = cycle;
        const monthlyCard = document.getElementById('cycleCard-monthly');
        const yearlyCard = document.getElementById('cycleCard-yearly');
        const btn = document.getElementById('upgradeCheckoutBtn');

        if (cycle === 'monthly') {
            monthlyCard.className = 'cursor-pointer border-2 border-[#08110D] bg-[#F8FAF8] p-3.5 sm:p-4 rounded-2xl text-center transition flex flex-col justify-between shadow-xs';
            yearlyCard.className = 'cursor-pointer border border-[#E3E9E5] bg-white p-3.5 sm:p-4 rounded-2xl text-center transition relative flex flex-col justify-between';
            btn.innerHTML = '<span>Unlock Pro (₦5,000/mo)</span> <span>→</span>';
        } else {
            monthlyCard.className = 'cursor-pointer border border-[#E3E9E5] bg-white p-3.5 sm:p-4 rounded-2xl text-center transition flex flex-col justify-between';
            yearlyCard.className = 'cursor-pointer border-2 border-[#19D98B] bg-emerald-50/50 p-3.5 sm:p-4 rounded-2xl text-center transition relative flex flex-col justify-between shadow-xs';
            btn.innerHTML = '<span>Unlock Annual Pro (₦50,000/yr - Save ₦10,000)</span> <span>→</span>';
        }
    }

    function triggerUpgradeModal(feature = 'general') {
        const modal = document.getElementById('upgradePromptModal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeUpgradeModal() {
        const modal = document.getElementById('upgradePromptModal');
        if (modal) modal.classList.add('hidden');
    }

    async function handleUpgradeDirectPayment() {
        const btn = document.getElementById('upgradeCheckoutBtn');
        btn.disabled = true;
        btn.innerHTML = '<span>Processing upgrade...</span>';

        try {
            const res = await fetch('/api/merchant/upgrade_plan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cycle: selectedCycle, plan: 'pro' })
            });
            const data = await res.json();
            if (data.success) {
                alert('🎉 Pro plan successfully activated! You now have full access to all multi-period analytics, ledger history, and unlimited features.');
                location.reload();
            } else {
                alert(data.error || 'Failed to activate plan');
            }
        } catch (e) {
            alert('Network error activating upgrade');
        } finally {
            btn.disabled = false;
        }
    }
</script>
