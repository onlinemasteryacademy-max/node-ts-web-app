                            <div class="font-bold text-[#111827] text-xs flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/></svg>
                                <span>Direct Bank Transfer</span>
                            </div>
                            <p class="text-[11px] text-[#6B7280]">Customers view your bank account and submit payment proof with receipt.</p>
                        </div>
                        <input type="checkbox" id="allowBankTransfer" <%= store.allow_bank_transfer !== 0 ? 'checked' : '' %> class="w-4 h-4 mt-1 accent-[#084C38]">
                    </label>

                    <!-- Pay on Delivery Toggle -->
