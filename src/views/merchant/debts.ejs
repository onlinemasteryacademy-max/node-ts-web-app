<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Debt Tracker — <%= store.store_name %> | zlik</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        zlikDark: '#08110D',
                        zlikGreen: '#19D98B',
                        zlikDeep: '#087A50',
                        zlikBg: '#F8FAF8',
                        zlikWhite: '#FFFFFF',
                        zlikMuted: '#6B756F',
                        zlikBorder: '#E3E9E5'
                    },
                    fontFamily: {
                        display: ['Montserrat', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8FAF8; color: #08110D; }
        .font-display { font-family: 'Montserrat', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0.5rem); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-[#E3E9E5] shadow-2xs">
        <div class="max-w-7xl mx-auto px-3 sm:px-4 py-2.5 sm:py-3.5 flex items-center justify-between gap-2 sm:gap-4">
            <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <a href="/merchant" class="text-xs font-medium text-[#6B756F] hover:text-[#08110D] flex items-center gap-1 transition shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    <span class="hidden sm:inline">Dashboard</span>
                </a>
                <span class="text-gray-300 hidden sm:inline">/</span>
                <h1 class="text-xs sm:text-sm font-semibold text-[#08110D] truncate">Debt Tracker</h1>
            </div>
            <div class="flex items-center gap-1.5 sm:gap-2">
                <button onclick="openNewDebtModal()" class="bg-[#08110D] hover:bg-black text-[#19D98B] text-xs font-semibold px-3 sm:px-3.5 py-2 rounded-xl transition shadow-2xs flex items-center gap-1">
                    <span class="text-sm leading-none">+</span>
                    <span>Record</span>
                    <span class="hidden sm:inline">Debt</span>
                </button>
            </div>
        </div>

        <div class="hidden sm:flex max-w-7xl mx-auto px-4 items-center gap-2 overflow-x-auto text-xs font-medium border-t border-[#E3E9E5]/60 pt-2 pb-2">
            <a href="/merchant" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Orders</a>
            <a href="/merchant/items" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Products</a>
            <a href="/merchant/ledger" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Sales Ledger</a>
            <a href="/merchant/debts" class="px-3.5 py-1.5 rounded-xl bg-[#08110D] text-white font-semibold">Debts</a>
            <a href="/merchant/messages" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Live Chat</a>
            <a href="/merchant/settings" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Settings</a>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-3 sm:px-4 py-4 sm:py-6 pb-24 sm:pb-8 flex-1 w-full space-y-5 sm:space-y-6">



        <!-- Debt KPI Summary Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Total Outstanding</span>
                <div class="text-lg font-bold text-red-600 mt-1 font-mono" id="statOutstanding">
                    ₦<%= (stats.total_outstanding || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                </div>
                <span class="text-[10px] text-[#6B756F]"><%= stats.active_count || 0 %> active debtor(s)</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Total Recovered</span>
                <div class="text-lg font-bold text-[#087A50] mt-1 font-mono" id="statRecovered">
                    ₦<%= (stats.total_recovered || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                </div>
                <span class="text-[10px] text-[#6B756F]"><%= stats.paid_count || 0 %> settled debt(s)</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Recovery Rate</span>
                <% 
                    const totalAll = (stats.total_outstanding || 0) + (stats.total_recovered || 0);
                    const recoveryPct = totalAll > 0 ? Math.round(((stats.total_recovered || 0) / totalAll) * 100) : 100;
                %>
                <div class="text-lg font-bold text-[#08110D] mt-1 font-mono">
                    <%= recoveryPct %>%
                </div>
                <span class="text-[10px] text-[#6B756F]">Settled vs Unsettled</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Plan Allowance</span>
                <div class="text-lg font-bold text-[#08110D] mt-1">
                    <%= isPro ? 'Unlimited' : '3 Active' %>
                </div>
                <span class="text-[10px] text-[#6B756F]"><%= isPro ? 'Pro Merchant Tier' : 'Free Tier' %></span>
            </div>
        </div>

        <!-- Debts List -->
        <div class="bg-white rounded-3xl border border-[#E3E9E5] p-5 sm:p-6 shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b border-[#E3E9E5] pb-3">
                <div>
                    <h3 class="font-semibold text-sm text-[#08110D]">Customer Debts</h3>
                    <p class="text-[11px] text-[#6B756F]">Track unpaid balances and send WhatsApp payment reminders.</p>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="filterDebts('all')" id="debtFilter-all" class="px-3 py-1 rounded-xl text-xs font-semibold bg-[#08110D] text-white transition">All</button>
                    <button onclick="filterDebts('pending')" id="debtFilter-pending" class="px-3 py-1 rounded-xl text-xs font-medium text-[#6B756F] hover:bg-gray-100 transition">Pending</button>
                    <button onclick="filterDebts('paid')" id="debtFilter-paid" class="px-3 py-1 rounded-xl text-xs font-medium text-[#6B756F] hover:bg-gray-100 transition">Settled</button>
                </div>
            </div>

            <div id="debtsContainer" class="space-y-3">
                <% if (!debts || debts.length === 0) { %>
                    <div class="p-12 text-center text-[#6B756F] text-xs space-y-2">
                        <p class="text-base">🎉 No outstanding debts recorded.</p>
                        <p class="text-[11px]">Click "Record New Debt" to track a customer credit or pay-later balance.</p>
                    </div>
                <% } else { %>
                    <% debts.forEach(debt => { 
                        const isPending = debt.status === 'pending';
                    %>
                        <div class="debt-card p-4 rounded-2xl border border-[#E3E9E5] bg-[#F8FAF8] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs hover:border-[#08110D] transition" data-status="<%= debt.status %>">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <h4 class="font-bold text-sm text-[#08110D]"><%= debt.customer_name %></h4>
                                    <span class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded-full <%= isPending ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-800' %>">
                                        ● <%= isPending ? 'Pending' : 'Settled' %>
                                    </span>
                                </div>
                                <div class="text-[#6B756F] flex flex-wrap items-center gap-3 text-[11px]">
                                    <span>📞 <%= debt.customer_phone %></span>
                                    <% if (debt.description) { %>
                                        <span>&bull; Item: <strong><%= debt.description %></strong></span>
                                    <% } %>
                                    <% if (debt.due_date) { %>
                                        <span>&bull; Due: <strong class="font-mono"><%= debt.due_date %></strong></span>
                                    <% } %>
                                </div>
                                <% if (debt.notes) { %>
                                    <p class="text-[11px] text-[#6B756F] italic">Note: <%= debt.notes %></p>
                                <% } %>
                            </div>

                            <div class="flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-[#E3E9E5]/60">
                                <div class="text-right">
                                    <div class="text-base font-bold font-mono <%= isPending ? 'text-red-600' : 'text-[#087A50]' %>">
                                        ₦<%= Number(debt.amount).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                                    </div>
                                    <span class="text-[10px] text-[#6B756F]"><%= new Date(debt.created_at).toLocaleDateString() %></span>
                                </div>

                                <div class="flex items-center gap-1.5 shrink-0">
                                    <% if (isPending) { %>
                                        <button type="button" onclick="sendWhatsAppReminder(<%= debt.id %>)" class="bg-[#19D98B]/20 hover:bg-[#19D98B]/30 text-[#087A50] font-semibold text-xs px-3 py-2 rounded-xl transition flex items-center gap-1" title="Send WhatsApp Payment Reminder">
                                            <span>💬</span> <span class="hidden sm:inline">WhatsApp</span>
                                        </button>
                                        <button type="button" onclick="markDebtPaid(<%= debt.id %>)" class="bg-[#08110D] hover:bg-black text-[#19D98B] font-semibold text-xs px-3 py-2 rounded-xl transition shadow-2xs" title="Mark as Paid">
                                            <span>✓ Paid</span>
                                        </button>
                                    <% } %>
                                    <button type="button" onclick="deleteDebt(<%= debt.id %>)" class="text-[#6B756F] hover:text-red-700 p-2 rounded-lg hover:bg-red-50 transition" title="Delete Record">
                                        🗑
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Record New Debt Modal -->
    <div id="newDebtModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-end sm:items-center justify-center p-0 sm:p-4 hidden">
        <div class="bg-white rounded-t-3xl sm:rounded-3xl max-w-md w-full p-6 space-y-4 border border-[#E3E9E5] shadow-2xl text-xs max-h-[90vh] overflow-y-auto pb-safe sm:pb-6">
            <div class="flex items-center justify-between pb-3 border-b border-[#E3E9E5]">
                <h3 class="font-semibold text-sm text-[#08110D]">Record Customer Debt</h3>
                <button type="button" onclick="closeNewDebtModal()" class="text-[#6B756F] font-bold text-sm hover:text-black p-1">✕</button>
            </div>

            <form id="newDebtForm" onsubmit="handleCreateDebt(event)" class="space-y-3.5">
                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Customer Full Name *</label>
                    <input type="text" id="debtCustomerName" required placeholder="e.g. John Okoro" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                </div>

                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Customer WhatsApp Phone Number *</label>
                    <input type="tel" id="debtCustomerPhone" required placeholder="08012345678" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-medium text-[#08110D] mb-1">Debt Amount (₦) *</label>
                        <input type="number" step="0.01" id="debtAmount" required placeholder="5000" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D] font-mono">
                    </div>
                    <div>
                        <label class="block font-medium text-[#08110D] mb-1">Due Date (Optional)</label>
                        <input type="date" id="debtDueDate" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                    </div>
                </div>

                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Item / Reason for Debt (Optional)</label>
                    <input type="text" id="debtDescription" placeholder="e.g. 2x Vintage Polo Shirts balance" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                </div>

                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Internal Note (Optional)</label>
                    <textarea id="debtNotes" rows="2" placeholder="e.g. Promised to transfer on Friday by 2PM" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]"></textarea>
                </div>

                <div class="flex items-center gap-2 pt-2 border-t border-[#E3E9E5]">
                    <button type="button" onclick="closeNewDebtModal()" class="w-1/2 bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] font-medium text-xs py-2.5 rounded-xl border border-[#E3E9E5] transition">
                        Cancel
                    </button>
                    <button type="submit" id="saveDebtBtn" class="w-1/2 bg-[#08110D] hover:bg-black text-[#19D98B] font-semibold text-xs py-2.5 rounded-xl transition shadow-2xs">
                        Save Debt Record
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const isProStore = <%= isPro ? 'true' : 'false' %>;
        const activeDebtsCount = <%= stats.active_count || 0 %>;

        function openNewDebtModal() {
            if (!isProStore && activeDebtsCount >= 3) {
                openProUpgradeModal('Unlimited Debt Tracker (3 Active Debts Allowance)');
                return;
            }
            document.getElementById('newDebtModal').classList.remove('hidden');
        }

        function closeNewDebtModal() {
            document.getElementById('newDebtModal').classList.add('hidden');
            document.getElementById('newDebtForm').reset();
        }

        async function handleCreateDebt(e) {
            e.preventDefault();
            const btn = document.getElementById('saveDebtBtn');
            btn.disabled = true;
            btn.textContent = 'Saving...';

            const payload = {
                customer_name: document.getElementById('debtCustomerName').value,
                customer_phone: document.getElementById('debtCustomerPhone').value,
                amount: document.getElementById('debtAmount').value,
                due_date: document.getElementById('debtDueDate').value,
                description: document.getElementById('debtDescription').value,
                notes: document.getElementById('debtNotes').value
            };

            try {
                const res = await fetch('/api/merchant/debts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error || 'Failed to record debt.');
                    btn.disabled = false;
                    btn.textContent = 'Save Debt Record';
                }
            } catch (err) {
                alert('Network error while saving debt record.');
                btn.disabled = false;
                btn.textContent = 'Save Debt Record';
            }
        }

        async function markDebtPaid(debtId) {
            if (!confirm('Mark this debt as fully settled?')) return;
            try {
                const res = await fetch('/api/merchant/debts/mark-paid', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ debt_id: debtId })
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error || 'Failed to update debt.');
                }
            } catch (e) {
                alert('Network error.');
            }
        }

        async function deleteDebt(debtId) {
            if (!confirm('Delete this debt record?')) return;
            try {
                const res = await fetch('/api/merchant/debts/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ debt_id: debtId })
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error || 'Failed to delete record.');
                }
            } catch (e) {
                alert('Network error.');
            }
        }

        async function sendWhatsAppReminder(debtId) {
            try {
                const res = await fetch(`/api/merchant/debts/${debtId}/reminder-link`);
                const data = await res.json();
                if (data.success && data.url) {
                    window.open(data.url, '_blank');
                } else {
                    alert(data.error || 'Failed to generate reminder link.');
                }
            } catch (e) {
                alert('Network error.');
            }
        }

        function filterDebts(status) {
            const cards = document.querySelectorAll('.debt-card');
            cards.forEach(card => {
                if (status === 'all' || card.dataset.status === status) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });

            ['all', 'pending', 'paid'].forEach(s => {
                const btn = document.getElementById(`debtFilter-${s}`);
                if (btn) {
                    if (s === status) {
                        btn.className = 'px-3 py-1 rounded-xl text-xs font-semibold bg-[#08110D] text-white transition';
                    } else {
                        btn.className = 'px-3 py-1 rounded-xl text-xs font-medium text-[#6B756F] hover:bg-gray-100 transition';
                    }
                }
            });
        }
    </script>
    <%- include('components/upgrade_modal.ejs') %>
    <%- include('components/bottom_nav.ejs', { activeTab: 'debts' }) %>
</body>
</html>
