                        <div id="accountResolutionFeedback" class="mt-1.5 text-[11px] hidden"></div>
                    </div>
                </div>

                <div>
                    <label class="block font-medium text-[#111827] mb-1">Account Holder Name</label>
                    <input type="text" id="accountName" value="<%= store.bank_account_name || '' %>" placeholder="e.g. John Doe Enterprises" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] text-xs font-medium">
                    <span class="text-[10.5px] text-[#6B7280] mt-1.5 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-[#084C38] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        <span>Bank accounts must match your verified identity. Changing account numbers requires 6-digit email OTP authorization.</span>
                    </span>
                </div>
            </div>

            <!-- Delivery Fee Setting -->
            <div class="bg-white rounded-3xl border border-[#EAEFEB] p-5 sm:p-6 shadow-xs space-y-4 text-xs">
