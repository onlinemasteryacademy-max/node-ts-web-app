    <script>
        const storeSlug = '<%= store.slug %>';
        const isMerchantPro = <%= Boolean(isPro) %>;
        const allTemplatesData = <%- JSON.stringify(allTemplates || {}) %>;
        const storeCategoriesData = <%- JSON.stringify(storeCategories || {}) %>;
        let selectedTemplateId = '<%= store.template_slug || "general_clean" %>';
        let currentCategoryId = '<%= (templateConfig && templateConfig.category_id) || "general" %>';
        let previewingTplId = null;
        let settingsQr = null;

        function handleCategorySelect(catId) {
            if (!storeCategoriesData[catId]) catId = 'general';
            currentCategoryId = catId;

            const catSelect = document.getElementById('categorySelect');
            if (catSelect && catSelect.value !== catId) {
                catSelect.value = catId;
            }

            renderTemplatesForCategory(catId);
        }

        function renderTemplatesForCategory(catId) {
            const container = document.getElementById('templatesGrid');
            if (!container) return;

            const categoryTemplates = Object.values(allTemplatesData).filter(t => t.category_id === catId);
            if (categoryTemplates.length === 0) {
                container.innerHTML = '<div class="col-span-3 text-center py-6 text-[#6B756F]">No templates found for this category.</div>';
                return;
            }

            container.innerHTML = categoryTemplates.map(tpl => {
                const isSelected = selectedTemplateId === tpl.id;
                const isProTemplate = Boolean(tpl.is_pro);
                const isLocked = isProTemplate && !isMerchantPro;
                const coverImage = tpl.preview_image || ('/assets/images/templates/' + tpl.id + '.png');

                let badgeHtml = '';
                if (isProTemplate) {
                    badgeHtml = '<span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-[#08110D]/90 text-[#19D98B] border border-[#19D98B]/40 shadow-sm backdrop-blur-xs">PRO</span>';
                } else {
                    badgeHtml = '<span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-white/90 text-[#087A50] border border-[#19D98B]/40 shadow-sm backdrop-blur-xs">FREE</span>';
                }

                // Exactly ONE action button below the card
                let singleActionBtn = '';
                if (isSelected) {
                    singleActionBtn = '<button type="button" disabled class="w-full text-xs font-semibold py-2.5 rounded-xl bg-[#08110D] text-white cursor-default">Selected</button>';
                } else if (isLocked) {
                    singleActionBtn = `<button type="button" onclick="event.stopPropagation(); openProUpgradeModal('${tpl.name}')" class="w-full text-xs font-semibold py-2.5 rounded-xl bg-[#08110D] hover:bg-black text-[#19D98B] transition shadow-2xs">Upgrade to Pro</button>`;
                } else {
                    singleActionBtn = `<button type="button" onclick="event.stopPropagation(); selectTemplate('${tpl.id}')" class="w-full text-xs font-semibold py-2.5 rounded-xl bg-gray-100 hover:bg-[#08110D] text-[#08110D] hover:text-white transition">Select</button>`;
                }

                const cardBorder = isSelected 
                    ? 'border-[#08110D] bg-[#F8FAF8] ring-2 ring-[#08110D] shadow-sm' 
                    : 'border-[#E3E9E5] bg-white hover:border-[#08110D]/40 hover:shadow-xs';

                return `
                    <div onclick="previewTemplateDetails('${tpl.id}')" id="tplCard-${tpl.id}" class="template-option-card group relative p-3.5 rounded-2xl border cursor-pointer transition-all duration-200 flex flex-col justify-between w-[84vw] sm:w-[320px] md:w-auto shrink-0 md:shrink snap-center ${cardBorder}">
                        <div class="space-y-2.5">
                            <!-- Theme Front View Cover Photo with Dark Overlay -->
                            <div class="relative w-full aspect-[16/10] h-40 sm:h-44 rounded-xl overflow-hidden border border-[#E3E9E5] bg-[#08110D] shadow-xs group-hover:border-[#08110D]/30 transition">
                                <img src="${coverImage}" onerror="this.onerror=null; this.src='/assets/images/templates/${tpl.id}.svg';" alt="${tpl.name} Screenshot" class="w-full h-full object-cover object-top filter brightness-50 contrast-125 transition-transform duration-300 group-hover:scale-105" loading="lazy">
                                
                                <!-- Very dark overlay so preview is veiled until opened -->
