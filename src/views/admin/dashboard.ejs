<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            zlikDark: '#08110D',
            zlikGreen: '#19D98B',
            zlikDeepGreen: '#087A50',
            zlikBg: '#F8FAF8',
            zlikWhite: '#FFFFFF',
            zlikSecondary: '#6B756F',
            zlikBorder: '#E3E9E5'
          },
          fontFamily: {
            display: ['Montserrat', 'sans-serif'],
            body: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
            sans: ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #08110D; color: #FFFFFF; }
    .font-display { font-family: 'Montserrat', sans-serif; }
    .nav-tab.active { background-color: rgba(25, 217, 139, 0.15); color: #19D98B; border-color: #19D98B; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
  </style>
</head>
<body class="bg-[#08110D] text-white min-h-screen selection:bg-[#19D98B] selection:text-[#08110D]">

  <!-- Top Navbar -->
  <header class="border-b border-white/10 bg-[#08110D]/90 sticky top-0 z-40 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-6">
        <a href="/<%= typeof adminPath !== 'undefined' ? adminPath : 'admin' %>" class="text-2xl font-extrabold font-display tracking-tight text-white flex items-center gap-1">
          zlik<span class="text-[#19D98B]">.</span>
          <span class="text-xs uppercase px-2 py-0.5 ml-2 bg-[#19D98B]/20 text-[#19D98B] font-bold rounded tracking-wider">Console</span>
        </a>
      </div>

      <div class="flex items-center space-x-4">
        <div class="text-right hidden sm:block">
          <div class="text-xs font-bold text-white"><%= currentAdmin ? currentAdmin.name : 'Administrator' %></div>
          <div class="text-[11px] text-[#19D98B] uppercase font-semibold tracking-wider"><%= currentAdmin && currentAdmin.role_info ? currentAdmin.role_info.name : 'Super Admin' %></div>
        </div>
        <a href="/<%= typeof adminPath !== 'undefined' ? adminPath : 'admin' %>/logout" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-white/20 text-white/80 hover:text-white hover:border-white/40 transition">
          Sign out
        </a>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Tabs Navigation -->
    <div class="flex items-center space-x-2 border-b border-white/10 pb-4 mb-8 overflow-x-auto text-xs font-semibold">
      <button onclick="switchTab('overview')" id="tab-btn-overview" class="nav-tab active px-4 py-2 rounded-lg border border-transparent hover:text-[#19D98B] transition whitespace-nowrap">
        📊 Cockpit Overview
      </button>
      <a href="/<%= typeof adminPath !== 'undefined' ? adminPath : 'admin' %>/security" class="px-4 py-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 transition whitespace-nowrap flex items-center gap-1.5 font-bold">
        🛡️ Security & Trust
      </a>
      <button onclick="switchTab('merchants')" id="tab-btn-merchants" class="nav-tab px-4 py-2 rounded-lg border border-transparent hover:text-[#19D98B] transition whitespace-nowrap">
        🏪 Merchants CRM (<%= stores.length %>)
      </button>
      <button onclick="switchTab('catalog')" id="tab-btn-catalog" class="nav-tab px-4 py-2 rounded-lg border border-transparent hover:text-[#19D98B] transition whitespace-nowrap">
        📦 Global Catalog
      </button>
      <button onclick="switchTab('pricing')" id="tab-btn-pricing" class="nav-tab px-4 py-2 rounded-lg border border-transparent hover:text-[#19D98B] transition whitespace-nowrap">
        💳 Plans & Limits
      </button>
      <button onclick="switchTab('integrations')" id="tab-btn-integrations" class="nav-tab px-4 py-2 rounded-lg border border-transparent hover:text-[#19D98B] transition whitespace-nowrap">
        ⚙️ Gateways & SMTP
      </button>
      <button onclick="switchTab('team')" id="tab-btn-team" class="nav-tab px-4 py-2 rounded-lg border border-transparent hover:text-[#19D98B] transition whitespace-nowrap">
        👥 Admin Team
      </button>
      <button onclick="switchTab('leads')" id="tab-btn-leads" class="nav-tab px-4 py-2 rounded-lg border border-transparent hover:text-[#19D98B] transition whitespace-nowrap">
        🏢 Enterprise Leads (<%= metrics.totalLeads %>)
      </button>
      <button onclick="switchTab('affiliates')" id="tab-btn-affiliates" class="nav-tab px-4 py-2 rounded-lg border border-transparent hover:text-[#19D98B] transition whitespace-nowrap flex items-center gap-1.5">
        🤝 Affiliates & Payouts (<%= (typeof affiliates !== 'undefined' ? affiliates.length : 0) %>)
        <% if (typeof metrics !== 'undefined' && metrics.pendingPayoutsCount > 0) { %>
          <span class="px-1.5 py-0.5 rounded-full bg-amber-400 text-black font-extrabold text-[10px]"><%= metrics.pendingPayoutsCount %></span>
        <% } %>
      </button>
      <button onclick="switchTab('audit')" id="tab-btn-audit" class="nav-tab px-4 py-2 rounded-lg border border-transparent hover:text-[#19D98B] transition whitespace-nowrap">
        📜 Logs & Maintenance
      </button>
    </div>

    <!-- TAB 1: OVERVIEW -->
    <div id="tab-overview" class="tab-content active space-y-8">
      <!-- Metric Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <div class="text-xs text-white/60 font-semibold mb-1">TOTAL PLATFORM STORES</div>
          <div class="text-3xl font-extrabold font-display text-white"><%= metrics.totalStores %></div>
          <div class="text-xs text-[#19D98B] mt-2 font-medium">● <%= metrics.activeStores %> Active Storefronts</div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <div class="text-xs text-white/60 font-semibold mb-1">TOTAL ORDERS PROCESSED</div>
          <div class="text-3xl font-extrabold font-display text-white"><%= metrics.totalOrders %></div>
          <div class="text-xs text-white/60 mt-2 font-medium">+<%= metrics.todayOrders %> orders today</div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <div class="text-xs text-white/60 font-semibold mb-1">PLATFORM GMV</div>
          <div class="text-3xl font-extrabold font-display text-[#19D98B]">₦<%= Number(metrics.totalGmv || 0).toLocaleString() %></div>
          <div class="text-xs text-white/60 mt-2 font-medium">₦<%= Number(metrics.todayGmv || 0).toLocaleString() %> today</div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <div class="text-xs text-white/60 font-semibold mb-1">ESTIMATED MRR</div>
          <div class="text-3xl font-extrabold font-display text-white">₦<%= Number(metrics.estimatedMrr || 0).toLocaleString() %></div>
          <div class="text-xs text-amber-400 mt-2 font-medium"><%= metrics.proCount %> Pro &bull; <%= metrics.businessCount %> Business</div>
        </div>
      </div>

      <!-- Plan Breakdown & Quick Info -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <h3 class="text-sm font-bold font-display uppercase tracking-wider text-white mb-4">Subscription Distribution</h3>
          <div class="space-y-3 text-xs">
            <div class="flex justify-between items-center py-2 border-b border-white/5">
              <span class="text-white/70">Free Starter Tier</span>
              <span class="font-bold text-white"><%= metrics.totalStores - metrics.proCount - metrics.businessCount - metrics.enterpriseCount %></span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/5">
              <span class="text-white/70">Active 7-Day Trials</span>
              <span class="font-bold text-amber-400"><%= metrics.trialCount %></span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/5">
              <span class="text-white/70">Pro Plan (₦<%= Number(settings.pro_monthly_price || 5000).toLocaleString() %>/mo)</span>
              <span class="font-bold text-[#19D98B]"><%= metrics.proCount %></span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-white/5">
              <span class="text-white/70">Business Tier (₦<%= Number(settings.business_monthly_price || 9000).toLocaleString() %>/mo)</span>
              <span class="font-bold text-blue-400"><%= metrics.businessCount %></span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span class="text-white/70">Enterprise Tier</span>
              <span class="font-bold text-purple-400"><%= metrics.enterpriseCount %></span>
            </div>
          </div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 lg:col-span-2">
          <h3 class="text-sm font-bold font-display uppercase tracking-wider text-white mb-4">Recent Merchant Activity</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="text-white/50 border-b border-white/10 pb-2">
                  <th class="py-2">Store</th>
                  <th class="py-2">Owner</th>
                  <th class="py-2">WhatsApp</th>
                  <th class="py-2">Tier</th>
                  <th class="py-2 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5">
                <% if (stores.length === 0) { %>
                  <tr>
                    <td colspan="5" class="py-8 text-center text-white/40 text-xs">
                      No merchant stores registered yet. Platform is fresh.
                    </td>
                  </tr>
                <% } else { %>
                  <% stores.slice(0, 5).forEach(s => { %>
                    <tr>
                      <td class="py-3 font-semibold text-white"><%= s.store_name %></td>
                      <td class="py-3 text-white/70"><%= s.owner_name %></td>
                      <td class="py-3 text-white/70"><%= s.whatsapp_number %></td>
                      <td class="py-3">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= s.plan_tier === 'pro' ? 'bg-[#19D98B]/20 text-[#19D98B]' : (s.plan_tier === 'business' ? 'bg-blue-500/20 text-blue-400' : 'bg-white/10 text-white/70') %>">
                          <%= s.plan_tier || 'free' %>
                        </span>
                      </td>
                      <td class="py-3 text-right">
                        <button onclick="impersonateMerchant(<%= s.id %>)" class="text-xs text-[#19D98B] hover:underline font-semibold">
                          Impersonate &rarr;
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: MERCHANTS CRM -->
    <div id="tab-merchants" class="tab-content space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold font-display text-white">Merchant Directory</h2>
          <p class="text-xs text-white/60">Manage store subscriptions, verification badges, and execute bulk operational actions</p>
        </div>
        <div class="flex items-center gap-3">
          <input type="text" id="merchantSearch" onkeyup="filterMerchants()" placeholder="Search stores, owners, slugs..." class="px-4 py-2 rounded-lg bg-white/10 border border-white/15 text-xs text-white placeholder-white/40 outline-none focus:border-[#19D98B] w-full sm:w-72">
        </div>
      </div>

      <!-- Bulk Actions Toolbar (Visible when stores are selected) -->
      <div id="merchantBulkBar" class="hidden bg-gradient-to-r from-purple-950/80 via-black/80 to-[#08110D]/90 border border-purple-500/30 rounded-2xl p-4 shadow-xl flex flex-wrap items-center justify-between gap-4 transition-all duration-300">
        <div class="flex items-center gap-3">
          <span class="w-8 h-8 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center font-bold text-sm">
            ⚡
          </span>
          <div>
            <div class="text-xs font-bold text-white"><span id="selectedStoresCount">0</span> Store(s) Selected</div>
            <div class="text-[11px] text-white/60">Choose an administrative action to apply in bulk</div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <!-- Bulk Deactivate / Suspend -->
          <button type="button" onclick="confirmBulkStoreAction('deactivate')" class="px-3 py-1.5 rounded-lg bg-rose-500/20 hover:bg-rose-500/30 border border-rose-500/30 text-rose-300 hover:text-rose-200 font-semibold text-xs transition flex items-center gap-1.5">
            <span>⏸️</span>
            <span>Suspend / Deactivate</span>
          </button>

          <!-- Bulk Activate -->
          <button type="button" onclick="confirmBulkStoreAction('activate')" class="px-3 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/30 text-emerald-300 hover:text-emerald-200 font-semibold text-xs transition flex items-center gap-1.5">
            <span>▶️</span>
            <span>Activate</span>
          </button>

          <!-- Bulk Verification -->
          <button type="button" onclick="confirmBulkStoreAction('verify')" class="px-3 py-1.5 rounded-lg bg-[#19D98B]/20 hover:bg-[#19D98B]/30 border border-[#19D98B]/30 text-[#19D98B] font-semibold text-xs transition flex items-center gap-1.5">
            <span>✓</span>
            <span>Add Badge</span>
          </button>
          <button type="button" onclick="confirmBulkStoreAction('unverify')" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 border border-white/10 text-white/70 hover:text-white font-semibold text-xs transition flex items-center gap-1.5">
            <span>✕</span>
            <span>Remove Badge</span>
          </button>

          <!-- Bulk Tier Change Dropdown -->
          <div class="relative inline-block">
            <select id="bulkTierSelect" onchange="handleBulkTierChange(this.value)" class="px-3 py-1.5 rounded-lg bg-white/10 border border-white/20 text-white text-xs font-semibold outline-none hover:bg-white/20 transition cursor-pointer">
              <option value="" disabled selected>💎 Set Tier...</option>
              <option value="free" class="bg-[#08110D] text-white">Free Starter</option>
              <option value="pro" class="bg-[#08110D] text-white">Pro Plan</option>
              <option value="business" class="bg-[#08110D] text-white">Business Plan</option>
              <option value="enterprise" class="bg-[#08110D] text-white">Enterprise Plan</option>
            </select>
          </div>

          <!-- Bulk Delete -->
          <button type="button" onclick="confirmBulkStoreAction('delete')" class="px-3 py-1.5 rounded-lg bg-red-600/20 hover:bg-red-600/40 border border-red-500/40 text-red-300 hover:text-red-100 font-semibold text-xs transition flex items-center gap-1.5">
            <span>🗑️</span>
            <span>Delete</span>
          </button>

          <!-- Clear Selection -->
          <button type="button" onclick="clearMerchantSelection()" class="px-2.5 py-1.5 text-xs text-white/50 hover:text-white transition">
            Deselect
          </button>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs" id="merchantsTable">
            <thead class="bg-white/5 border-b border-white/10 text-white/60 font-semibold">
              <tr>
                <th class="p-4 w-10 text-center">
                  <input type="checkbox" id="selectAllMerchants" onchange="toggleSelectAllMerchants(this.checked)" class="w-4 h-4 rounded bg-white/10 border-white/20 text-[#19D98B] focus:ring-0 cursor-pointer accent-[#19D98B]">
                </th>
                <th class="p-4">Store / Slug</th>
                <th class="p-4">Owner & Contact</th>
                <th class="p-4">Tier / Status</th>
                <th class="p-4">Verification</th>
                <th class="p-4 text-right">Administrative Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <% if (stores.length === 0) { %>
                <tr>
                  <td colspan="6" class="p-12 text-center text-white/40">
                    <div class="text-3xl mb-2">🏪</div>
                    <div class="font-bold text-white text-sm">No registered merchant stores yet</div>
                    <div class="text-xs text-white/50 mt-1">Platform is fresh. When real merchants register on zlik.store, their stores will appear here.</div>
                  </td>
                </tr>
              <% } else { %>
                <% stores.forEach(s => { %>
                  <tr class="merchant-row hover:bg-white/5 transition" id="merchant-row-<%= s.id %>" data-search="<%= (s.store_name + ' ' + s.owner_name + ' ' + s.slug + ' ' + s.whatsapp_number).toLowerCase() %>">
                    <td class="p-4 text-center">
                      <input type="checkbox" class="merchant-select-cb w-4 h-4 rounded bg-white/10 border-white/20 text-[#19D98B] focus:ring-0 cursor-pointer accent-[#19D98B]" value="<%= s.id %>" onchange="handleMerchantSelectChange()">
                    </td>
                    <td class="p-4">
                      <div class="font-bold text-white text-sm"><%= s.store_name %></div>
                      <a href="/<%= s.slug %>" target="_blank" class="text-xs text-[#19D98B] hover:underline font-mono">/<%= s.slug %></a>
                    </td>
                    <td class="p-4">
                      <div class="font-semibold text-white"><%= s.owner_name %></div>
                      <div class="text-white/60 text-[11px]"><%= s.whatsapp_number %> &bull; <%= s.email || 'No email' %></div>
                    </td>
                    <td class="p-4">
                      <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= s.plan_tier === 'pro' ? 'bg-[#19D98B]/20 text-[#19D98B]' : (s.plan_tier === 'business' ? 'bg-blue-500/20 text-blue-400' : (s.plan_tier === 'enterprise' ? 'bg-purple-500/20 text-purple-300' : 'bg-white/10 text-white/70')) %>">
                          <%= s.plan_tier || 'free' %>
                        </span>
                        <span class="text-[11px] font-semibold <%= s.status === 'active' ? 'text-emerald-400' : 'text-rose-400' %>">
                          ● <%= s.status || 'active' %>
                        </span>
                      </div>
                    </td>
                    <td class="p-4">
                      <button onclick="toggleVerification(<%= s.id %>, <%= s.is_verified ? 0 : 1 %>)" class="px-2.5 py-1 rounded text-[11px] font-semibold border <%= s.is_verified ? 'bg-[#19D98B]/10 border-[#19D98B] text-[#19D98B]' : 'bg-white/5 border-white/10 text-white/50 hover:text-white' %>">
                        <%= s.is_verified ? '✓ Verified' : '+ Add Badge' %>
                      </button>
                    </td>
                    <td class="p-4 text-right space-x-2">
                      <button onclick="openAdminTemplateModal(<%= s.id %>, '<%= s.store_name.replace(/'/g, "\\'") %>', '<%= s.template_slug || 'general_clean' %>')" class="px-3 py-1.5 rounded bg-white/10 hover:bg-white/20 text-[#19D98B] font-medium text-xs transition">
                        🎨 Theme
                      </button>
                      <button onclick="openPlanModal(<%= s.id %>, '<%= s.store_name.replace(/'/g, "\\'") %>', '<%= s.plan_tier %>')" class="px-3 py-1.5 rounded bg-white/10 hover:bg-white/20 text-white font-medium text-xs transition">
                        Set Tier
                      </button>
                      <button onclick="toggleStoreStatus(<%= s.id %>, '<%= s.status === 'active' ? 'suspended' : 'active' %>')" class="px-3 py-1.5 rounded <%= s.status === 'active' ? 'bg-rose-500/10 hover:bg-rose-500/20 text-rose-400' : 'bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400' %> font-medium text-xs transition">
                        <%= s.status === 'active' ? 'Suspend' : 'Activate' %>
                      </button>
                      <button onclick="impersonateMerchant(<%= s.id %>)" class="px-3 py-1.5 rounded bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] font-bold text-xs transition shadow-sm">
                        Login &rarr;
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 3: GLOBAL CATALOG -->
    <div id="tab-catalog" class="tab-content space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-bold font-display text-white">Global Product Catalog</h2>
          <p class="text-xs text-white/60">Search and moderate inventory across all seller stores</p>
        </div>
        <input type="text" id="catalogSearch" onkeyup="filterCatalog()" placeholder="Search products, titles, stores..." class="px-4 py-2 rounded-lg bg-white/10 border border-white/15 text-xs text-white placeholder-white/40 outline-none focus:border-[#19D98B] w-full sm:w-72">
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs" id="catalogTable">
            <thead class="bg-white/5 border-b border-white/10 text-white/60 font-semibold">
              <tr>
                <th class="p-4">Product</th>
                <th class="p-4">Price</th>
                <th class="p-4">Category</th>
                <th class="p-4">Status</th>
                <th class="p-4 text-right">Moderation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <% items.forEach(it => { %>
                <tr class="catalog-row hover:bg-white/5 transition" data-search="<%= (it.title + ' ' + (it.category || '')).toLowerCase() %>">
                  <td class="p-4">
                    <div class="font-bold text-white text-sm"><%= it.title %></div>
                    <div class="text-[11px] text-white/50">Store ID #<%= it.store_id %></div>
                  </td>
                  <td class="p-4 font-bold text-white">₦<%= Number(it.price).toLocaleString() %></td>
                  <td class="p-4 text-white/70"><%= it.category || 'General' %></td>
                  <td class="p-4">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= it.is_available ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400' %>">
                      <%= it.is_available ? 'Live' : 'Hidden' %>
                    </span>
                  </td>
                  <td class="p-4 text-right">
                    <button onclick="moderateItem(<%= it.id %>, <%= it.is_available ? 0 : 1 %>)" class="px-3 py-1.5 rounded <%= it.is_available ? 'bg-rose-500/10 hover:bg-rose-500/20 text-rose-400' : 'bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400' %> font-semibold text-xs transition">
                      <%= it.is_available ? 'Hide Product' : 'Approve Live' %>
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- TAB 4: PRICING & LIMITS -->
