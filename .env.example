SESSION_SECRET=e7b9148dc823485fa712948e9123847fa1029384756bca9283746152435476a8

# Master Super Admin Credentials & Secret URL Path (Obfuscated & Hard to Guess)
SUPER_ADMIN_EMAIL=admin@zlik.store
SUPER_ADMIN_PASSWORD=Zlik#SuperAdmin!2026@Secure#
SUPER_ADMIN_NAME="Platform Super Administrator"
ADMIN_SECRET_PATH=zlik-ops-9x7q2m8b

# Set to 'true' if you need to force-rotate the super admin password on next boot
RESET_SUPER_ADMIN_PASSWORD=false

# Paystack API Configuration (Can also be managed inside Super Admin Dashboard)
