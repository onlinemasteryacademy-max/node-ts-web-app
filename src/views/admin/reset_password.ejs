<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Set New Admin Password — zlik</title>
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            zlikDark: '#08110D',
            zlikGreen: '#19D98B',
            zlikDeep: '#087A50',
            zlikBg: '#F8FAF8',
            zlikWhite: '#FFFFFF',
            zlikMuted: '#6B756F',
            zlikBorder: '#E3E9E5'
          },
          fontFamily: {
            display: ['Montserrat', 'sans-serif'],
            body: ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #08110D; color: #FFFFFF; }
    .font-display { font-family: 'Montserrat', sans-serif; }
  </style>
</head>
<body class="bg-[#08110D] text-white antialiased flex items-center justify-center min-h-screen p-4">

  <div class="max-w-md w-full bg-white/5 rounded-2xl border border-white/10 p-8 sm:p-10 shadow-2xl backdrop-blur-md">
    <div class="text-center mb-8">
      <a href="/" class="text-3xl font-bold font-display tracking-tight text-white inline-block mb-3">
        zlik
      </a>
      <h1 class="text-xl font-bold font-display text-white">Choose New Password</h1>
      <p class="text-xs text-[#E3E9E5]/70 mt-1">Set a new strong password for your admin account</p>
    </div>

    <form onsubmit="handleResetPassword(event)" class="space-y-4 text-xs">
      <input type="hidden" id="resetToken" value="<%= token || '' %>">

      <div>
        <label class="block font-semibold text-[#E3E9E5]/90 mb-1.5">New Password</label>
        <input type="password" id="newPass" required placeholder="••••••••" minlength="6" class="w-full px-3.5 py-3 rounded-lg bg-white/10 border border-white/15 text-sm text-white placeholder-white/40 outline-none focus:border-[#19D98B] transition">
      </div>

      <div>
        <label class="block font-semibold text-[#E3E9E5]/90 mb-1.5">Confirm New Password</label>
        <input type="password" id="confirmPass" required placeholder="••••••••" minlength="6" class="w-full px-3.5 py-3 rounded-lg bg-white/10 border border-white/15 text-sm text-white placeholder-white/40 outline-none focus:border-[#19D98B] transition">
      </div>

      <div id="statusMsg" class="text-xs font-medium hidden"></div>

      <button type="submit" id="submitBtn" class="w-full bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] font-bold font-display text-sm py-3.5 rounded-lg shadow-sm transition duration-200 mt-2">
        Update Password
      </button>
    </form>

    <div class="mt-6 text-center text-xs">
      <a href="/<%= typeof adminPath !== 'undefined' ? adminPath : 'admin' %>/login" class="text-[#19D98B] hover:underline">&larr; Back to Admin Sign In</a>
    </div>
  </div>

  <script>
    const currentAdminPath = '<%= typeof adminPath !== "undefined" ? adminPath : "admin" %>';

    async function handleResetPassword(e) {
      e.preventDefault();
      const p1 = document.getElementById('newPass').value;
      const p2 = document.getElementById('confirmPass').value;
      const msg = document.getElementById('statusMsg');
      const btn = document.getElementById('submitBtn');

      if (p1 !== p2) {
        msg.textContent = 'Passwords do not match.';
        msg.className = 'text-xs font-medium p-3 rounded-lg bg-rose-500/20 text-rose-400';
        msg.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Updating...';

      try {
        const res = await fetch('/' + currentAdminPath + '/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            token: document.getElementById('resetToken').value,
            new_password: p1
          })
        });
        const result = await res.json();
        if (result.success) {
          msg.textContent = result.message;
          msg.className = 'text-xs font-medium p-3 rounded-lg bg-[#19D98B]/20 text-[#19D98B]';
          msg.classList.remove('hidden');
          setTimeout(() => { window.location.href = '/' + currentAdminPath + '/login'; }, 1500);
        } else {
          msg.textContent = result.error || 'Failed to reset password';
          msg.className = 'text-xs font-medium p-3 rounded-lg bg-rose-500/20 text-rose-400';
          msg.classList.remove('hidden');
        }
      } catch (err) {
        msg.textContent = 'Error processing request.';
        msg.className = 'text-xs font-medium p-3 rounded-lg bg-rose-500/20 text-rose-400';
        msg.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Update Password';
      }
    }
  </script>
</body>
</html>
