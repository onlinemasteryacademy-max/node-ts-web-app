                    <div>
                        <h3 class="font-bold text-sm text-[#111827]">Store Trust & Verification</h3>
                        <p class="text-[11px] text-[#6B7280] mt-0.5">Show a verified merchant checkmark on your storefront.</p>
                    </div>
                    <% if (store.is_verified) { %>
                        <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 flex items-center gap-1.5 font-mono">
                            <svg class="w-3.5 h-3.5 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>VERIFIED</span>
                        </span>
                    <% } else if (store.verification_requested) { %>
                        <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-amber-100 text-amber-900 font-mono">
                            UNDER REVIEW
                        </span>
                    <% } else { %>
                        <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 font-mono">
                            UNVERIFIED
                        </span>
                    <% } %>
                </div>

                <div class="space-y-3">
                    <p class="text-xs text-[#6B7280]">
