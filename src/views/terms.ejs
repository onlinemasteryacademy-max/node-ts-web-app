  <!-- Hero Header -->
  <section class="bg-white border-b border-[#E3E9E5] py-12 sm:py-16">
    <div class="max-w-[1000px] mx-auto px-6 text-center space-y-4">
      <div class="inline-flex items-center gap-2 bg-[#F8FAF8] border border-[#E3E9E5] px-3.5 py-1.5 rounded-full text-xs font-medium text-[#6B756F]">
        <span>📜</span>
        <span>Effective Date: October 9, 2026 &bull; Last Revised: October 2026</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-display tracking-tight text-[#08110D]">
        Terms of Service
      </h1>
      <p class="text-sm sm:text-base text-[#6B756F] max-w-2xl mx-auto leading-relaxed">
        Welcome to zlik. These Terms govern your access to and use of zlik websites, merchant store engines, APIs, and e-commerce services.
      </p>
    </div>
  </section>

  <!-- Terms Content with Sticky Sidebar -->
  <main class="max-w-[1100px] mx-auto px-6 py-12 flex-1 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">

      <!-- Table of Contents (Desktop Sticky) -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-28 bg-white border border-[#E3E9E5] rounded-2xl p-6 shadow-2xs space-y-4">
        <div class="text-xs font-bold uppercase tracking-wider text-[#6B756F] font-display">
          Table of Contents
        </div>
        <nav class="space-y-1.5 text-xs">
          <a href="#acceptance" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">1. Acceptance of Terms</a>
          <a href="#eligibility" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">2. Account Registration & Eligibility</a>
          <a href="#store-operations" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">3. Storefronts & Prohibited Goods</a>
          <a href="#pricing-billing" class="block py-1 px-2 rounded-md text-[#4A5550] hover:text-[#08110D] hover:bg-[#F8FAF8] transition">4. Pricing, Subscriptions & Limits</a>
