<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Store Settings — <%= store.store_name %> | zlik</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        forest: '#084C38',
                        forestHover: '#063b2c',
                        mint: '#EDF5F1',
                        slateMuted: '#6B7280',
                        charcoal: '#111827',
                        borderLight: '#EAEFEB',
                        zlikDark: '#08110D',
                        zlikGreen: '#19D98B',
                        zlikDeep: '#087A50',
                        zlikBg: '#F8FAF9',
                        zlikWhite: '#FFFFFF',
                        zlikMuted: '#6B7280',
                        zlikBorder: '#EAEFEB'
                    },
                    fontFamily: {
                        display: ['Montserrat', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8FAF9; color: #111827; }
        .font-display { font-family: 'Montserrat', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .pb-safe { padding-bottom: max(0.875rem, env(safe-area-inset-bottom, 0.875rem)); }
        .pt-safe { padding-top: max(0.75rem, env(safe-area-inset-top, 0.75rem)); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

    <!-- Merchant Header (Universal Component) -->
    <%- include('components/header_nav.ejs', { activeTab: 'settings', pageTitle: 'Store Settings', backUrl: '/merchant' }) %>

    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-4 sm:py-6 pb-28 sm:pb-8 flex-1 w-full space-y-5 sm:space-y-6">
        <!-- Header with Profile Title and Share ↗ Action (Matching Screenshot 4) -->
        <div class="flex items-center justify-between pt-1 pb-1">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#111827] tracking-tight">Profile</h1>
            <button type="button" onclick="shareStoreProfile()" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#084C38] hover:text-[#063b2c] transition">
                <span>Share</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </button>
        </div>

        <!-- Store Profile Hero Card -->
        <div class="bg-white rounded-3xl p-5 border border-[#EAEFEB] shadow-xs flex items-center gap-4">
            <div class="relative w-16 h-16 rounded-2xl bg-[#F8FAF9] border border-[#EAEFEB] flex items-center justify-center shrink-0 overflow-hidden">
                <% if (store.logo_url) { %>
                    <img src="<%= store.logo_url %>" alt="Store Logo" class="w-full h-full object-cover">
                <% } else { %>
                    <span class="text-2xl font-bold text-[#084C38] font-display"><%= (store.store_name || 'S').charAt(0).toUpperCase() %></span>
                <% } %>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                    <h2 class="text-base sm:text-lg font-bold text-[#111827] truncate"><%= store.store_name %></h2>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold font-mono tracking-wide uppercase <%= isPro ? 'bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20' : 'bg-gray-100 text-gray-700' %>">
                        <%= store.plan_tier ? store.plan_tier.toUpperCase() : 'FREE' %>
                    </span>
                </div>
                <p class="text-xs text-[#6B7280] font-mono mt-0.5 truncate">zlik.store/<%= store.slug %></p>
                <p class="text-[11px] text-[#084C38] font-medium mt-1">Manage store profile, designs, payouts & preferences</p>
            </div>
        </div>

        <!-- Grouped Quick Actions (Matching Screenshot 4) -->
        <div class="space-y-2.5">
            <a href="/merchant/ledger" class="flex items-center justify-between p-4 rounded-2xl bg-[#F8FAF9] hover:bg-[#EDF5F1]/70 border border-[#EAEFEB] transition group">
                <div class="flex items-center gap-3.5">
                    <div class="w-9 h-9 rounded-xl bg-white border border-[#EAEFEB] flex items-center justify-center text-[#111827] shadow-2xs group-hover:text-[#084C38] transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    </div>
                    <span class="text-sm font-semibold text-[#111827]">Insights & Sales Ledger</span>
                </div>
                <svg class="w-4 h-4 text-[#9CA3AF] group-hover:text-[#084C38] transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>

            <a href="/merchant/reviews" class="flex items-center justify-between p-4 rounded-2xl bg-[#F8FAF9] hover:bg-[#EDF5F1]/70 border border-[#EAEFEB] transition group">
                <div class="flex items-center gap-3.5">
                    <div class="w-9 h-9 rounded-xl bg-white border border-[#EAEFEB] flex items-center justify-center text-[#111827] shadow-2xs group-hover:text-[#084C38] transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                    </div>
                    <span class="text-sm font-semibold text-[#111827]">Customer Reviews</span>
                </div>
                <svg class="w-4 h-4 text-[#9CA3AF] group-hover:text-[#084C38] transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>

            <a href="/merchant/debts" class="flex items-center justify-between p-4 rounded-2xl bg-[#F8FAF9] hover:bg-[#EDF5F1]/70 border border-[#EAEFEB] transition group">
                <div class="flex items-center gap-3.5">
                    <div class="w-9 h-9 rounded-xl bg-white border border-[#EAEFEB] flex items-center justify-center text-[#111827] shadow-2xs group-hover:text-[#084C38] transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
                    </div>
                    <span class="text-sm font-semibold text-[#111827]">Debt & Credit Tracker</span>
                </div>
                <svg class="w-4 h-4 text-[#9CA3AF] group-hover:text-[#084C38] transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>

            <a href="/merchant/verification" class="flex items-center justify-between p-4 rounded-2xl bg-[#F8FAF9] hover:bg-[#EDF5F1]/70 border border-[#EAEFEB] transition group">
                <div class="flex items-center gap-3.5">
                    <div class="w-9 h-9 rounded-xl bg-white border border-[#EAEFEB] flex items-center justify-center text-[#111827] shadow-2xs group-hover:text-[#084C38] transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </div>
                    <div>
                        <span class="text-sm font-semibold text-[#111827]">Marketplace & ID Verification</span>
                        <p class="text-[10.5px] text-[#6B7280]">Get published to Marketplace (Pro & Business)</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full font-mono <%= store.is_verified ? 'bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20' : (store.plan_tier === 'pro' || store.plan_tier === 'business' ? 'bg-amber-100 text-amber-900' : 'bg-gray-100 text-gray-700') %>">
                        <%= store.is_verified ? 'VERIFIED' : (store.plan_tier === 'pro' || store.plan_tier === 'business' ? 'PENDING' : 'PRO ONLY') %>
                    </span>
                    <svg class="w-4 h-4 text-[#9CA3AF] group-hover:text-[#084C38] transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </div>
            </a>
        </div>
        <form id="settingsForm" onsubmit="handleSaveSettings(event)" class="space-y-6">
            
            <!-- Store Category & Templates Card -->
            <div class="bg-white rounded-3xl border border-[#EAEFEB] p-5 sm:p-6 shadow-xs space-y-5 text-xs">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#EAEFEB] pb-4">
                    <div>
                        <h3 class="font-bold text-sm text-[#111827]">Store Category & Templates</h3>
                        <p class="text-[11px] text-[#6B7280] mt-0.5">Select your industry category and template design.</p>
                    </div>
                    <div>
                        <span id="activeTemplateBadge" class="bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 font-bold text-[11px] px-3 py-1 rounded-full uppercase tracking-wider font-mono">
                            Active: <%= templateConfig ? templateConfig.name : 'Classic Grid' %>
                        </span>
                    </div>
                    <input type="hidden" id="selectedTemplateInput" value="<%= store.template_slug || 'general_clean' %>">
                </div>

                <!-- Category Selector (Dropdown Only) -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <label for="categorySelect" class="font-semibold text-[#111827] text-xs">Industry Category</label>
                        <span class="text-[11px] text-[#6B7280]">1 Free + 2 Pro designs per category</span>
                    </div>

                    <!-- Category Dropdown -->
                    <select id="categorySelect" onchange="handleCategorySelect(this.value)" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] focus:border-[#084C38] rounded-2xl p-3.5 text-xs font-medium text-[#111827] outline-none transition cursor-pointer">
                        <% Object.values(storeCategories || {}).forEach(cat => { 
                            const isCurrentCat = (templateConfig && templateConfig.category_id === cat.id) || (!templateConfig && cat.id === 'general');
                        %>
                            <option value="<%= cat.id %>" <%= isCurrentCat ? 'selected' : '' %>>
                                <%= cat.name %> — <%= cat.tagline %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <!-- 3-Template Cards (Horizontal swipe/slide on mobile, 3-column grid on desktop) -->
                <div class="space-y-1.5">
                    <div id="templatesGrid" class="flex md:grid md:grid-cols-3 gap-3.5 pt-1 overflow-x-auto md:overflow-x-visible no-scrollbar snap-x snap-mandatory pb-2 md:pb-0">
                        <!-- Injected dynamically via JS with swipeable cards on mobile -->
                    </div>
                    <div class="flex items-center justify-between md:hidden text-[10.5px] text-[#6B7280] px-1 pt-1">
                        <span class="flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 text-[#6B7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                            <span>Swipe to view templates</span>
                        </span>
                        <span class="font-semibold text-[#111827]">Slide</span>
                    </div>
                </div>
            </div>

            <!-- Storefront URL & QR Code -->
            <div class="bg-white rounded-3xl border border-[#EAEFEB] p-5 sm:p-6 shadow-xs space-y-4 text-xs">
                <div class="flex items-center justify-between border-b border-[#EAEFEB] pb-3">
                    <div>
                        <h3 class="font-bold text-sm text-[#111827]">Storefront URL & QR Code</h3>
                        <p class="text-[11px] text-[#6B7280] mt-0.5">Your store web address and scan code.</p>
                    </div>
                    <a href="/<%= store.slug %>" target="_blank" class="bg-[#084C38] hover:bg-[#063b2c] text-white font-semibold text-[11px] px-3.5 py-1.5 rounded-xl transition shadow-xs flex items-center gap-1">
                        <span>Open Store</span>
                        <span>↗</span>
                    </a>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-start pt-1">
                    <!-- Slug Input -->
                    <div class="sm:col-span-2 space-y-3">
                        <div>
                            <label class="block font-medium text-[#111827] mb-1">Store Username (URL)</label>
                            <div class="flex items-center rounded-2xl border border-[#EAEFEB] bg-[#F8FAF9] overflow-hidden focus-within:border-[#084C38]">
                                <span class="px-3.5 text-[#6B7280] font-mono text-xs bg-gray-50 border-r border-[#EAEFEB] py-2.5 select-none">zlik.store/</span>
                                <input type="text" id="storeSlug" value="<%= store.slug %>" required pattern="[a-z0-9_-]{3,30}" placeholder="yourbrand" class="flex-1 bg-transparent p-2.5 outline-none font-mono text-xs text-[#111827]">
                            </div>
                            <p class="text-[10px] text-[#6B7280] mt-1">
                                3-30 lowercase characters, numbers, and hyphens.
                            </p>
                        </div>

                        <div class="flex items-center gap-2 pt-1">
                            <button type="button" onclick="copySettingsStoreUrl()" id="settingsCopyUrlBtn" class="bg-[#F8FAF9] hover:bg-[#EDF5F1] text-[#111827] font-medium text-xs px-3.5 py-2 rounded-xl border border-[#EAEFEB] transition">
                                Copy Store Link
                            </button>
                            <a href="https://wa.me/?text=Order%20directly%20from%20our%20official%20store:%20https://zlik.store/<%= store.slug %>" target="_blank" class="bg-[#EDF5F1] hover:bg-[#EDF5F1]/80 text-[#084C38] font-medium text-xs px-3.5 py-2 rounded-xl border border-[#084C38]/20 transition">
                                Share on WhatsApp
                            </a>
                        </div>
                    </div>

                    <!-- Embedded QR Code Box -->
                    <div class="bg-[#F8FAF9] p-4 rounded-2xl border border-[#EAEFEB] flex flex-col items-center justify-center space-y-2.5 text-center">
                        <div id="settingsQrContainer" class="p-2.5 bg-white rounded-2xl shadow-xs border border-[#EAEFEB] flex items-center justify-center min-h-[120px] min-w-[120px]"></div>
                        <button type="button" onclick="downloadSettingsQrCode()" class="w-full bg-[#084C38] hover:bg-[#063b2c] text-white font-semibold text-[11px] py-2 rounded-xl transition shadow-xs">
                            Download QR Code
                        </button>
                    </div>
                </div>
            </div>

            <!-- Store Profile -->
            <div class="bg-white rounded-3xl border border-[#EAEFEB] p-5 sm:p-6 shadow-xs space-y-4 text-xs">
                <h3 class="font-bold text-sm text-[#111827]">Store Profile Details</h3>
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Store Name</label>
                    <input type="text" id="storeName" value="<%= store.store_name %>" required class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38]">
                </div>
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Store Bio / Tagline</label>
                    <textarea id="storeBio" rows="2" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38]"><%= store.bio || '' %></textarea>
                </div>
                <div class="space-y-2">
                    <label class="block font-medium text-[#111827]">Store Logo</label>
                    <div class="flex items-center gap-4">
                        <div id="logoPreviewContainer" class="w-16 h-16 rounded-2xl border border-[#EAEFEB] bg-[#F8FAF9] flex items-center justify-center overflow-hidden shrink-0 shadow-xs">
                            <% if (store.logo_url) { %>
                                <img id="logoPreviewImg" src="<%= store.logo_url %>" alt="Store Logo" class="w-full h-full object-cover">
                            <% } else { %>
                                <span id="logoPreviewPlaceholder" class="text-xl font-bold text-[#084C38] font-display"><%= (store.store_name || 'S').charAt(0).toUpperCase() %></span>
                            <% } %>
                        </div>
                        <div class="flex-1 space-y-1.5">
                            <div class="flex items-center gap-2">
                                <label class="cursor-pointer bg-[#084C38] hover:bg-[#063b2c] text-white font-semibold text-xs px-3.5 py-2 rounded-xl transition shadow-xs">
                                    <span>Upload Logo</span>
                                    <input type="file" id="logoFileInput" accept="image/*" onchange="handleLogoUpload(this.files[0])" class="hidden">
                                </label>
                                <button type="button" onclick="removeStoreLogo()" id="removeLogoBtn" class="bg-[#F8FAF9] hover:bg-red-50 hover:text-red-700 text-[#6B7280] font-medium text-xs px-3 py-2 rounded-xl border border-[#EAEFEB] transition <%= store.logo_url ? '' : 'hidden' %>">
                                    Remove
                                </button>
                            </div>
                            <p class="text-[10px] text-[#6B7280]">Supports JPG, PNG, WebP, SVG (up to 10MB).</p>
                        </div>
                    </div>
                    <input type="hidden" id="logoUrl" value="<%= store.logo_url || '' %>">
                </div>

                <% 
                    const isCurrentTemplatePro = Boolean(templateConfig && templateConfig.is_pro);
                %>
                <!-- Store Cover Image & Banner Overlay (Pro Feature) -->
                <div id="coverCustomizationSection" class="space-y-3 pt-3 border-t border-[#EAEFEB]">
                    <div class="flex items-center justify-between">
                        <div>
                            <label class="block font-medium text-[#111827]">Store Cover Image & Banner Tint</label>
                            <span class="text-[10px] text-[#6B7280]">Shown on storefront hero banner (Included in Pro & Business templates)</span>
                        </div>
                    </div>

                    <div class="relative rounded-2xl overflow-hidden">
                        <div id="coverControlsWrapper" class="space-y-4 <%= isCurrentTemplatePro ? '' : 'blur-[1px] opacity-60 pointer-events-none select-none' %>">
                            <div class="space-y-2">
                                <div class="space-y-3">
                                    <div id="coverPreviewContainer" class="w-full aspect-[21/9] sm:aspect-[24/8] max-h-40 rounded-2xl border border-[#EAEFEB] bg-[#084C38] flex items-center justify-center overflow-hidden relative shadow-xs">
                                        <img id="coverPreviewImg" src="<%= store.cover_url || (templateConfig ? templateConfig.default_cover_image : '') || '/assets/images/templates/general_modern.png' %>" alt="Cover Preview" class="w-full h-full object-cover">
                                    </div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <label id="coverUploadBtn" class="cursor-pointer bg-[#084C38] hover:bg-[#063b2c] text-white font-semibold text-xs px-3.5 py-2 rounded-xl transition shadow-xs">
                                            <span>Upload Cover</span>
                                            <input type="file" id="coverFileInput" accept="image/*" onchange="handleCoverUpload(this.files[0])" class="hidden" <%= isCurrentTemplatePro ? '' : 'disabled' %>>
                                        </label>
                                        <button type="button" onclick="removeStoreCover()" id="removeCoverBtn" class="bg-[#F8FAF9] hover:bg-red-50 hover:text-red-700 text-[#6B7280] font-medium text-xs px-3 py-2 rounded-xl border border-[#EAEFEB] transition <%= store.cover_url ? '' : 'hidden' %>">
                                            Reset to Default
                                        </button>
                                    </div>
                                </div>
                                <input type="hidden" id="coverUrl" value="<%= store.cover_url || '' %>">
                            </div>

                            <!-- Cover Overlay Color (Customizable for Overlay CTA Templates) -->
                            <div class="space-y-2 pt-3 border-t border-[#EAEFEB]">
                                <div class="flex items-center justify-between">
                                    <label for="coverOverlayColor" class="block font-medium text-[#111827]">Banner Overlay Color</label>
                                    <span class="text-[10px] text-[#6B7280]">Customizable dark tint for hero banner text</span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <input type="color" id="coverOverlayColor" value="<%= store.cover_overlay_color || '#084C38' %>" onchange="document.getElementById('coverOverlayColorHex').value = this.value" class="w-10 h-10 rounded-xl border border-[#EAEFEB] cursor-pointer p-0.5 bg-white" <%= isCurrentTemplatePro ? '' : 'disabled' %>>
                                    <input type="text" id="coverOverlayColorHex" value="<%= store.cover_overlay_color || '#084C38' %>" oninput="document.getElementById('coverOverlayColor').value = this.value" class="flex-1 bg-[#F8FAF9] border border-[#EAEFEB] rounded-xl p-2.5 outline-none font-mono text-xs text-[#111827]" <%= isCurrentTemplatePro ? '' : 'disabled' %>>
                                </div>
                            </div>
                        </div>

                        <% if (!isCurrentTemplatePro) { %>
                            <div class="absolute inset-0 bg-white/40 backdrop-blur-[2px] rounded-2xl flex items-center justify-center p-4 z-10">
                                <button type="button" onclick="openProUpgradeModal('Pro Storefront Covers')" class="inline-flex items-center gap-1.5 bg-[#084C38] hover:bg-[#063b2c] text-white px-3.5 py-1.5 rounded-xl text-[10.5px] font-semibold font-display shadow-xs hover:scale-105 transition-all">
                                    <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                    <span>Upgrade to Pro</span>
                                </button>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Accepted Payment Methods -->
