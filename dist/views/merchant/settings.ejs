                        </div>

                        <div class="flex items-center justify-between pt-1">
                            <div>
                                <span class="font-medium text-[#111827] block">Display Store Logo on Receipt</span>
                                <span class="text-[10px] text-[#6B7280]">Show store logo in receipt header</span>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="receiptShowLogo" class="sr-only peer" <%= store.receipt_show_logo !== 0 ? 'checked' : '' %> <%= isPro ? '' : 'disabled' %>>
                                <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[#084C38]"></div>
                            </label>
                        </div>
                    </div>

                    <% if (!isPro) { %>
                        <div class="absolute inset-0 bg-white/40 backdrop-blur-[2px] rounded-2xl flex items-center justify-center p-4 z-10">
                            <button type="button" onclick="openProUpgradeModal('Seller-Branded Receipts')" class="inline-flex items-center gap-1.5 bg-[#084C38] hover:bg-[#063b2c] text-white px-3.5 py-1.5 rounded-xl text-[10.5px] font-semibold font-display shadow-xs hover:scale-105 transition-all">
                                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                <span>Upgrade to Pro</span>
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Marketing Pixels & Ads Tracking (Meta, Google, TikTok) -->
            <div class="bg-white rounded-3xl border border-[#EAEFEB] p-5 sm:p-6 shadow-xs space-y-4 text-xs">
                <div class="flex items-center justify-between border-b border-[#EAEFEB] pb-3">
                    <div>
                        <h3 class="font-bold text-sm text-[#111827]">Marketing Pixels & Ads Tracking</h3>
                        <p class="text-[11px] text-[#6B7280] mt-0.5">Track page views, add to cart, and checkout conversion events for paid ad campaigns.</p>
                    </div>
                </div>

                <div class="space-y-3">
                    <div>
                        <label class="block font-medium text-[#111827] mb-1">Meta Pixel ID (Facebook & Instagram)</label>
                        <input type="text" id="metaPixelId" value="<%= store.meta_pixel_id || '' %>" placeholder="e.g. 123456789012345" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs">
                        <span class="text-[10px] text-[#6B7280] mt-1 block">Fires PageView, ViewContent, AddToCart, InitiateCheckout & Purchase events.</span>
                    </div>

                    <div>
                        <label class="block font-medium text-[#111827] mb-1">Google Tag / Measurement ID (Analytics & Ads)</label>
                        <input type="text" id="googleTagId" value="<%= store.google_tag_id || '' %>" placeholder="e.g. G-XXXXXXX or AW-XXXXXXX" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs">
                    </div>

                    <div>
                        <label class="block font-medium text-[#111827] mb-1">TikTok Pixel ID</label>
                        <input type="text" id="tiktokPixelId" value="<%= store.tiktok_pixel_id || '' %>" placeholder="e.g. CXXXXXXXXXXXXXXX" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs">
                    </div>
                </div>
            </div>
            <!-- Store Trust & Verification Badge -->
