                                    <div class="font-bold text-xs text-[#08110D] flex items-center gap-1.5">
                                        <span>${b.name}</span>
                                        ${b.is_main ? '<span class="text-[9px] bg-blue-100 text-blue-900 font-bold px-1.5 py-0.2 rounded">MAIN BRANCH</span>' : ''}
                                    </div>
                                    <div class="text-[10.5px] text-[#6B756F]">${b.address || 'Address not specified'} ${b.city ? '(' + b.city + ')' : ''}</div>
                                </div>
                                <button type="button" onclick="deleteBranchLocation(${b.id})" class="text-[#6B756F] hover:text-red-600 p-1 transition-colors" title="Delete branch" aria-label="Delete branch">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                </button>
                            </div>
                        `).join('');
                    } else {
                        container.innerHTML = `<div class="p-3 bg-[#F8FAF8] rounded-2xl border border-dashed border-[#E3E9E5] text-center text-[#6B756F] text-[11px]">No branch locations added yet. Click "+ Add Branch" to configure physical stores.</div>`;
                    }
                }
            } catch (e) {}
        }

        function openAddBranchModal() {
            document.getElementById('addBranchModal').classList.remove('hidden');
        }

        function closeAddBranchModal() {
            document.getElementById('addBranchModal').classList.add('hidden');
        }

        async function handleAddBranch(e) {
            e.preventDefault();
            const btn = document.getElementById('saveBranchBtn');
            btn.disabled = true;

            const name = document.getElementById('branchName').value.trim();
            const address = document.getElementById('branchAddress').value.trim();
            const city = document.getElementById('branchCity').value.trim();
            const phone = document.getElementById('branchPhone').value.trim();
            const is_main = document.getElementById('branchIsMain').checked;

            try {
                const res = await fetch('/api/merchant/branches', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, address, city, phone, is_main })
                });
                const data = await res.json();
                if (data.success) {
                    closeAddBranchModal();
                    loadBranchesList();
                } else {
                    alert(data.error || 'Failed to add branch');
                }
            } catch (e) {
                alert('Network error adding branch');
            } finally {
                btn.disabled = false;
            }
        }

        async function deleteBranchLocation(id) {
            if (!confirm('Delete this branch location?')) return;
            try {
                const res = await fetch('/api/merchant/branches/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id })
                });
                const data = await res.json();
                if (data.success) loadBranchesList();
            } catch (e) {}
        }

        // ==========================================
        // Custom Domain Mapping
        // ==========================================
        async function saveCustomDomain() {
            const domain = document.getElementById('customDomainInput').value.trim();
            if (!domain) {
                alert('Please enter a domain name (e.g. shop.mybrand.com).');
                return;
            }

            try {
                const res = await fetch('/api/merchant/custom-domain', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ domain })
                });
                const data = await res.json();
                if (data.success) {
                    const statusBox = document.getElementById('domainStatusBox');
                    statusBox.className = 'p-3 bg-emerald-50 text-emerald-900 rounded-xl border border-emerald-200 text-[11px] font-bold flex items-center gap-2';
                    statusBox.innerHTML = `<svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Domain ${data.domain} connected! Point your DNS CNAME to <span class="font-mono">${data.cname_target}</span></span>`;
                } else {
                    alert(data.error || 'Failed to connect domain');
                }
            } catch (e) {
                alert('Network error connecting custom domain');
            }
        }

        async function initiateSettingsUpgrade(plan = 'pro', cycle = 'monthly') {
            const btn = document.getElementById('settingsUpgradeBtn');
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Initializing...';
            }

            try {
                const res = await fetch('/api/billing/initiate_upgrade', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ plan_tier: plan, billing_cycle: cycle })
                });
                const data = await res.json();
                if (!data.success) {
                    alert(data.error || 'Failed to initiate upgrade.');
                    if (btn) { btn.disabled = false; btn.textContent = 'Upgrade to Pro'; }
                    return;
                }

                if (typeof PaystackPop === 'undefined') {
                    alert('Paystack gateway is loading. Please try again in a few seconds.');
                    if (btn) { btn.disabled = false; btn.textContent = 'Upgrade to Pro'; }
                    return;
                }

                const handler = PaystackPop.setup({
                    key: data.paystack_public_key || 'pk_test_sample',
                    email: data.email || '<%= store.email || "merchant@zlik.store" %>',
                    amount: data.amount_kobo,
                    ref: data.reference,
                    currency: 'NGN',
                    callback: async function(response) {
                        if (btn) btn.textContent = 'Verifying upgrade...';
                        const vRes = await fetch('/api/billing/verify_subscription', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ reference: response.reference })
                        });
                        const vData = await vRes.json();
                        if (vData.success) {
                            alert('Upgrade successful! Your store is now on Zlik ' + plan.toUpperCase());
                            location.reload();
                        } else {
                            alert(vData.error || 'Upgrade verification error. Please reload.');
                        }
                    },
                    onClose: function() {
                        if (btn) { btn.disabled = false; btn.textContent = 'Upgrade to Pro'; }
                    }
                });
                handler.openIframe();
            } catch (err) {
                alert('Network error initiating payment.');
                if (btn) { btn.disabled = false; btn.textContent = 'Upgrade to Pro'; }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initSettingsQr();
            handleCategorySelect(currentCategoryId);
            loadMyStores();
            loadStaffList();
            loadBranchesList();
        });
    </script>
    <script src="https://js.paystack.co/v1/inline.js"></script>

    <!-- Create Store Modal -->
    <div id="createStoreModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-0 shadow-2xl border border-[#EAEFEB] overflow-hidden flex flex-col text-xs">
            <div class="px-6 py-4 border-b border-[#EAEFEB] flex items-center justify-between bg-[#F8FAF9]">
                <h3 class="font-bold text-sm text-[#111827]">Add New Store Brand</h3>
                <button type="button" onclick="closeCreateStoreModal()" class="w-8 h-8 rounded-full bg-white border border-[#EAEFEB] text-[#6B7280] flex items-center justify-center font-bold hover:text-black">✕</button>
            </div>
            <form onsubmit="handleCreateStore(event)" class="p-6 space-y-4">
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Store Name *</label>
                    <input type="text" id="newStoreName" required placeholder="e.g. Luxe Streetwear" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-bold text-xs text-[#111827]">
                </div>
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Store Username (URL Slug) *</label>
                    <input type="text" id="newStoreSlug" placeholder="e.g. luxestreet" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs text-[#111827]">
                </div>
                <div>
                    <label class="block font-medium text-[#111827] mb-1">WhatsApp Phone *</label>
                    <input type="text" id="newStoreWhatsapp" value="<%= store.whatsapp_number %>" required class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs text-[#111827]">
                </div>
                <div class="flex items-center gap-2 pt-2 border-t border-[#EAEFEB]">
                    <button type="button" onclick="closeCreateStoreModal()" class="w-1/2 bg-[#F8FAF9] hover:bg-[#EDF5F1] py-3 rounded-2xl border border-[#EAEFEB] font-medium text-[#111827] transition">Cancel</button>
                    <button type="submit" id="saveStoreBtn" class="w-1/2 bg-[#084C38] hover:bg-[#063b2c] text-white py-3 rounded-2xl font-bold transition shadow-xs">Create Store</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add Staff Modal -->
    <div id="addStaffModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-0 shadow-2xl border border-[#EAEFEB] overflow-hidden flex flex-col text-xs">
            <div class="px-6 py-4 border-b border-[#EAEFEB] flex items-center justify-between bg-[#F8FAF9]">
                <h3 class="font-bold text-sm text-[#111827]">Add Team Member</h3>
                <button type="button" onclick="closeAddStaffModal()" class="w-8 h-8 rounded-full bg-white border border-[#EAEFEB] text-[#6B7280] flex items-center justify-center font-bold hover:text-black">✕</button>
            </div>
            <form onsubmit="handleAddStaff(event)" class="p-6 space-y-4">
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Full Name *</label>
                    <input type="text" id="staffName" required placeholder="e.g. John Doe" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-bold text-xs text-[#111827]">
                </div>
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Phone Number *</label>
                    <input type="text" id="staffPhone" required placeholder="e.g. 08012345678" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs text-[#111827]">
                </div>
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Role</label>
                    <select id="staffRole" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-medium text-xs text-[#111827]">
                        <option value="sales_rep">Sales Representative</option>
                        <option value="inventory_clerk">Inventory Clerk</option>
                        <option value="manager">Store Manager</option>
                    </select>
                </div>
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Staff Access PIN (4 Digits)</label>
                    <input type="text" id="staffPin" value="1234" maxlength="4" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono font-bold text-xs text-[#111827]">
                </div>
                <div class="flex items-center gap-2 pt-2 border-t border-[#EAEFEB]">
                    <button type="button" onclick="closeAddStaffModal()" class="w-1/2 bg-[#F8FAF9] hover:bg-[#EDF5F1] py-3 rounded-2xl border border-[#EAEFEB] font-medium text-[#111827] transition">Cancel</button>
                    <button type="submit" id="saveStaffBtn" class="w-1/2 bg-[#084C38] hover:bg-[#063b2c] text-white py-3 rounded-2xl font-bold transition shadow-xs">Add Staff</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add Branch Modal -->
    <div id="addBranchModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-0 shadow-2xl border border-[#EAEFEB] overflow-hidden flex flex-col text-xs">
            <div class="px-6 py-4 border-b border-[#EAEFEB] flex items-center justify-between bg-[#F8FAF9]">
                <h3 class="font-bold text-sm text-[#111827]">Add Store Branch Location</h3>
                <button type="button" onclick="closeAddBranchModal()" class="w-8 h-8 rounded-full bg-white border border-[#EAEFEB] text-[#6B7280] flex items-center justify-center font-bold hover:text-black">✕</button>
            </div>
            <form onsubmit="handleAddBranch(event)" class="p-6 space-y-4">
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Branch Name *</label>
                    <input type="text" id="branchName" required placeholder="e.g. Lekki Phase 1 Outlet" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-bold text-xs text-[#111827]">
                </div>
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Street Address</label>
                    <input type="text" id="branchAddress" placeholder="e.g. 14 Admiralty Way" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] text-xs text-[#111827]">
                </div>
                <div>
                    <label class="block font-medium text-[#111827] mb-1">City / State</label>
                    <input type="text" id="branchCity" placeholder="e.g. Lekki, Lagos" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] text-xs text-[#111827]">
                </div>
                <div>
                    <label class="block font-medium text-[#111827] mb-1">Branch Phone</label>
                    <input type="text" id="branchPhone" placeholder="e.g. 08099887766" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs text-[#111827]">
                </div>
                <label class="flex items-center gap-2 font-medium text-[#111827] cursor-pointer">
                    <input type="checkbox" id="branchIsMain" class="rounded accent-[#084C38]">
                    <span>Set as Primary / Main Branch</span>
                </label>
                <div class="flex items-center gap-2 pt-2 border-t border-[#EAEFEB]">
                    <button type="button" onclick="closeAddBranchModal()" class="w-1/2 bg-[#F8FAF9] hover:bg-[#EDF5F1] py-3 rounded-2xl border border-[#EAEFEB] font-medium text-[#111827] transition">Cancel</button>
                    <button type="submit" id="saveBranchBtn" class="w-1/2 bg-[#084C38] hover:bg-[#063b2c] text-white py-3 rounded-2xl font-bold transition shadow-xs">Save Branch</button>
                </div>
            </form>
        </div>
    </div>
    <%- include('components/bottom_nav.ejs', { activeTab: 'settings' }) %>
</body>
</html>
