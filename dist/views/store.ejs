        // Promo Code Handlers
        async function applyPromoCode(codeOverride = null) {
            const codeInput = document.getElementById('promoCodeInput');
            const statusSpan = document.getElementById('promoCodeStatus');
            const discountRow = document.getElementById('discountSummaryRow');
            const discountText = document.getElementById('discountAmountText');
            const code = (codeOverride || codeInput?.value || '').trim().toUpperCase();

            if (!code) {
                alert('Please enter a promo code');
                return;
            }

            const subtotal = cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
            if (subtotal <= 0) {
                alert('Your cart is empty');
                return;
            }

            try {
                const res = await fetch('/api/coupons/validate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ store_id: storeData.id, code, subtotal })
                });
                const d = await res.json();
                if (d.success) {
                    appliedCouponCode = d.code;
                    appliedDiscountAmount = d.discount_amount;
                    if (statusSpan) {
                        statusSpan.textContent = `✓ ${d.discount_type === 'percentage' ? d.discount_value + '% OFF' : '₦' + d.discount_value + ' OFF'}`;
                        statusSpan.className = 'text-[10px] font-bold text-[#087A50] block';
                    }
                    if (discountRow) discountRow.classList.remove('hidden');
                    if (discountText) discountText.textContent = `-₦${appliedDiscountAmount.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
                    
                    const drawerStatus = document.getElementById('cartDrawerPromoStatus');
                    if (drawerStatus) drawerStatus.classList.remove('hidden');

                    renderCart();
                } else {
                    alert(d.error || 'Invalid promo code');
                }
            } catch (err) {
                alert('Error validating promo code');
            }
        }

        function applyPromoCodeFromDrawer() {
            const input = document.getElementById('cartPromoInput');
            if (input && input.value.trim()) {
                const code = input.value.trim();
                const mainInput = document.getElementById('promoCodeInput');
                if (mainInput) mainInput.value = code;
                applyPromoCode(code);
            }
        }

        function renderCart() {
            const list = document.getElementById('cartItemsList');
            const totalCount = cart.reduce((sum, i) => sum + i.quantity, 0);
            const subtotal = cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
            const deliveryFee = document.getElementById('fulfillmentType')?.value === 'pickup' ? 0 : parseFloat(storeData.delivery_fee || 0);
            const finalSubtotal = Math.max(0, subtotal - appliedDiscountAmount);
            const total = finalSubtotal + deliveryFee;

            document.getElementById('cartCountBadge').textContent = totalCount;
            document.getElementById('cartDrawerBadge').textContent = totalCount;
            document.getElementById('cartSubtotalText').textContent = '₦' + subtotal.toLocaleString('en-US', {minimumFractionDigits: 2});
            
            const cartDiscountRow = document.getElementById('cartDiscountRow');
            const cartDiscountLabel = document.getElementById('cartDiscountCodeLabel');
            const cartDiscountAmount = document.getElementById('cartDiscountAmountText');
            if (appliedDiscountAmount > 0) {
                if (cartDiscountRow) cartDiscountRow.classList.remove('hidden');
                if (cartDiscountLabel) cartDiscountLabel.textContent = appliedCouponCode;
                if (cartDiscountAmount) cartDiscountAmount.textContent = '-₦' + appliedDiscountAmount.toLocaleString('en-US', {minimumFractionDigits: 2});
            } else {
                if (cartDiscountRow) cartDiscountRow.classList.add('hidden');
            }

            document.getElementById('cartTotalText').textContent = '₦' + total.toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('modalTotalSpan').textContent = total.toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('checkoutBtn').disabled = cart.length === 0;

            if (cart.length === 0) {
                list.innerHTML = `<div class="p-8 text-center text-[#6B756F]">Your cart is empty.</div>`;
                return;
            }

            list.innerHTML = cart.map((i, idx) => `
                <div class="flex items-center justify-between gap-3 p-2.5 bg-[#F8FAF8] rounded-xl border border-[#E3E9E5]">
                    <div class="min-w-0 flex-1">
                        <h4 class="font-bold text-xs text-[#08110D] truncate">${i.title}</h4>
                        ${i.variant ? `<div class="text-[10px] text-purple-700 font-bold">${i.variant}</div>` : ''}
                        ${i.selected_options ? i.selected_options.map(o => `<div class="text-[10px] text-[#6B756F]">+ ${o.name} (${o.price > 0 ? '₦' + o.price : 'Free'})</div>`).join('') : ''}
                        ${i.notes ? `<div class="text-[10px] text-amber-700 italic font-semibold">Note: ${i.notes}</div>` : ''}
                        <div class="font-bold font-mono text-[#087A50] text-xs mt-0.5">₦${(i.price * i.quantity).toLocaleString('en-US', {minimumFractionDigits: 2})}</div>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                        <button type="button" onclick="updateCartQty(${idx}, -1)" class="w-6 h-6 rounded-lg bg-white border border-[#E3E9E5] text-xs font-bold hover:bg-gray-100">-</button>
                        <span class="w-6 text-center font-bold font-mono text-xs">${i.quantity}</span>
                        <button type="button" onclick="updateCartQty(${idx}, 1)" class="w-6 h-6 rounded-lg bg-white border border-[#E3E9E5] text-xs font-bold hover:bg-gray-100">+</button>
                        <button type="button" onclick="removeCartItem(${idx})" class="text-red-500 hover:text-red-700 font-bold text-xs p-1 ml-1">🗑️</button>
                    </div>
                </div>
            `).join('');
        }

