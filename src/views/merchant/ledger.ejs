<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Sales Ledger — <%= store.store_name %> | zlik</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        zlikDark: '#08110D',
                        zlikGreen: '#19D98B',
                        zlikDeep: '#087A50',
                        zlikBg: '#F8FAF8',
                        zlikWhite: '#FFFFFF',
                        zlikMuted: '#6B756F',
                        zlikBorder: '#E3E9E5'
                    },
                    fontFamily: {
                        display: ['Montserrat', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8FAF8; color: #08110D; }
        .font-display { font-family: 'Montserrat', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .pb-safe { padding-bottom: max(0.875rem, env(safe-area-inset-bottom, 0.875rem)); }
        .pt-safe { padding-top: max(0.75rem, env(safe-area-inset-top, 0.75rem)); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

    <!-- Merchant Header (Universal Component) -->
    <%- include('components/header_nav.ejs', { activeTab: 'ledger', pageTitle: 'Sales Ledger', backUrl: '/merchant' }) %>

    <main class="max-w-6xl mx-auto px-3 sm:px-4 py-4 sm:py-6 pb-28 sm:pb-8 flex-1 w-full space-y-5 sm:space-y-6">

        <!-- Header & Actions -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
            <div class="space-y-0.5">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-[#111827] font-display">Wallet & Sales</h1>
                <p class="text-xs text-[#6B7280]">Real-time balance, payout destination, and transactions history</p>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button" onclick="openDailySalesRecapModal()" title="Daily Sales Recap" class="bg-white hover:bg-gray-50 text-[#111827] border border-[#EAEFEB] text-xs font-semibold px-3.5 py-2 rounded-full transition flex items-center gap-1.5 shadow-xs">
                    <svg class="w-4 h-4 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    <span>Daily Recap</span>
                </button>
                <button type="button" onclick="openCustomerBroadcastModal()" title="Customer Broadcasts" class="bg-white hover:bg-gray-50 text-[#111827] border border-[#EAEFEB] text-xs font-semibold px-3.5 py-2 rounded-full transition flex items-center gap-1.5 shadow-xs">
                    <svg class="w-4 h-4 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
                    <span>Broadcasts</span>
                </button>
                <% if (isPro) { %>
                    <a href="/api/merchant/ledger/export" title="Export CSV" class="bg-[#084C38] hover:bg-[#063e2e] text-white text-xs font-semibold px-4 py-2 rounded-full transition shadow-xs flex items-center gap-1.5 active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                        <span>Export CSV</span>
                    </a>
                <% } else { %>
                    <button onclick="openProUpgradeModal('CSV Sales Ledger Export')" title="Export CSV (Pro)" class="bg-[#F8FAF9] hover:bg-gray-100 text-[#6B7280] text-xs font-medium px-3.5 py-2 rounded-full border border-[#EAEFEB] transition flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-[#6B7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        <span>Export (Pro)</span>
                    </button>
                <% } %>
            </div>
        </div>

        <!-- Hero Wallet Card (Screenshot 3 Reference) -->
        <div class="bg-[#EDF5F1] rounded-3xl p-5 sm:p-6 border border-[#D5E6DC] shadow-xs text-[#084C38] space-y-4">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-[#084C38]/80 font-mono">Confirmed Revenue Balance</span>
                <button type="button" onclick="toggleBalanceVisibility()" id="balanceVisibilityBtn" class="w-8 h-8 rounded-full bg-white/70 hover:bg-white text-[#084C38] flex items-center justify-center transition shadow-2xs" title="Hide/Show Balance">
                    <svg id="eyeOpenIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    <svg id="eyeClosedIcon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                </button>
            </div>

            <div>
                <div id="heroBalanceDisplay" class="text-3xl sm:text-4xl font-extrabold text-[#111827] tracking-tight font-display">
                    ₦<%= (summary.total_revenue || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                </div>
                
                <!-- Linked Payout Bank Badge (Screenshot 3 Reference) -->
                <% if (store.bank_account_number) { %>
                    <div class="inline-flex items-center gap-2 bg-white/90 backdrop-blur-xs px-3.5 py-1.5 rounded-full border border-[#D5E6DC] text-xs shadow-2xs mt-2 select-none">
                        <span class="font-semibold text-[#111827]"><%= (store.bank_name || 'Bank') %> • <%= store.bank_account_number %></span>
                        <button type="button" onclick="navigator.clipboard.writeText('<%= store.bank_account_number %>'); alert('Bank account copied to clipboard!');" class="text-[#084C38] hover:text-[#063e2e] transition" title="Copy Account Number">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        </button>
                    </div>
                <% } else { %>
                    <a href="/merchant/settings#bank" class="inline-flex items-center gap-1.5 bg-amber-100/90 text-amber-900 border border-amber-300 px-3.5 py-1.5 rounded-full text-xs font-semibold mt-2">
                        <span>⚠ Set up your payout bank account</span>
                        <span>&rarr;</span>
                    </a>
                <% } %>
            </div>

            <!-- Quick Action 3-Button Row (Screenshot 3 Reference) -->
            <div class="grid grid-cols-3 gap-2.5 pt-2 border-t border-[#D5E6DC]/80 text-xs">
                <button type="button" onclick="openDailySalesRecapModal()" class="flex flex-col items-center justify-center p-2.5 rounded-2xl bg-white/80 hover:bg-white text-[#111827] transition shadow-2xs text-center group">
                    <div class="w-10 h-10 rounded-full bg-[#084C38] text-white flex items-center justify-center mb-1 group-hover:scale-105 transition shadow-2xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    </div>
                    <span class="text-[11px] font-semibold text-[#111827]">Daily Recap</span>
                </button>

                <a href="/merchant/debts" class="flex flex-col items-center justify-center p-2.5 rounded-2xl bg-white/80 hover:bg-white text-[#111827] transition shadow-2xs text-center group">
                    <div class="w-10 h-10 rounded-full bg-white text-[#084C38] border border-[#D5E6DC] flex items-center justify-center mb-1 group-hover:scale-105 transition shadow-2xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <span class="text-[11px] font-semibold text-[#111827]">Debt Records</span>
                </a>

                <a href="/merchant/settings#bank" class="flex flex-col items-center justify-center p-2.5 rounded-2xl bg-white/80 hover:bg-white text-[#111827] transition shadow-2xs text-center group">
                    <div class="w-10 h-10 rounded-full bg-white text-[#084C38] border border-[#D5E6DC] flex items-center justify-center mb-1 group-hover:scale-105 transition shadow-2xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    </div>
                    <span class="text-[11px] font-semibold text-[#111827]">Bank Setup</span>
                </a>
            </div>
        </div>

        <!-- Cash Flow 2-Column Metrics (Screenshot 3 Reference) -->
        <div class="space-y-2.5">
            <h2 class="text-base sm:text-lg font-extrabold text-[#111827] font-display">Cash Flow</h2>
            <div class="grid grid-cols-2 gap-3">
                <!-- Card 1: Inflow -->
                <div class="bg-white rounded-3xl p-4 sm:p-5 border border-[#EAEFEB] shadow-xs space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-[#6B7280]">Inflow</span>
                        <div class="w-6 h-6 rounded-full bg-emerald-50 text-[#00A86B] flex items-center justify-center font-bold text-xs">↑</div>
                    </div>
                    <div class="text-lg sm:text-2xl font-extrabold text-[#00A86B] font-mono" id="sumTotalRevenue">
                        ₦<%= (summary.total_revenue || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                    </div>
                    <p class="text-[10.5px] text-[#6B7280]"><span id="sumPaidCount"><%= summary.paid_orders_count || 0 %></span> paid orders</p>
                </div>

                <!-- Card 2: Outflow / Pending -->
                <div class="bg-white rounded-3xl p-4 sm:p-5 border border-[#EAEFEB] shadow-xs space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-[#6B7280]">Pending Verification</span>
                        <div class="w-6 h-6 rounded-full bg-amber-50 text-amber-700 flex items-center justify-center font-bold text-xs">↓</div>
                    </div>
                    <div class="text-lg sm:text-2xl font-extrabold text-[#111827] font-mono">
                        <span id="sumPendingCount"><%= summary.pending_orders_count || 0 %></span> orders
                    </div>
                    <p class="text-[10.5px] text-[#6B7280]">Awaiting payment verification</p>
                </div>
            </div>
        </div>

        <!-- Hidden elements to preserve ID bindings for summary update scripts -->
        <div class="hidden" id="sumAov">₦<%= (summary.average_order_value || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %></div>
        <div class="hidden" id="sumTotalOrders"><%= summary.total_orders || 0 %></div>
        <div class="hidden" id="sumWindowLabel"><%= isPro ? 'Lifetime' : 'Up to Last Month' %></div>

        <!-- Timeframe Filter Tabs (Screenshot 2 Reference) -->
        <div class="bg-white rounded-3xl border border-[#EAEFEB] p-3 sm:p-3.5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2">
                <span class="text-[10px] uppercase font-bold text-[#6B7280] tracking-wider font-mono">Period:</span>
            </div>
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 sm:pb-0 font-medium">
                <button type="button" onclick="switchLedgerPeriod('today')" id="ltab-today" class="ledger-tab-btn px-3.5 py-1.5 rounded-full text-[#6B7280] hover:text-[#111827] transition whitespace-nowrap">Today</button>
                <button type="button" onclick="switchLedgerPeriod('yesterday')" id="ltab-yesterday" class="ledger-tab-btn px-3.5 py-1.5 rounded-full text-[#6B7280] hover:text-[#111827] transition whitespace-nowrap">Yesterday</button>
                <button type="button" onclick="switchLedgerPeriod('this_week')" id="ltab-this_week" class="ledger-tab-btn px-3.5 py-1.5 rounded-full text-[#6B7280] hover:text-[#111827] transition whitespace-nowrap">This Week</button>
                <button type="button" onclick="switchLedgerPeriod('this_month')" id="ltab-this_month" class="ledger-tab-btn px-3.5 py-1.5 rounded-full text-[#6B7280] hover:text-[#111827] transition whitespace-nowrap">This Month</button>
                <button type="button" onclick="switchLedgerPeriod('last_month')" id="ltab-last_month" class="ledger-tab-btn px-3.5 py-1.5 rounded-full text-[#6B7280] hover:text-[#111827] transition whitespace-nowrap">Last Month</button>
                <button type="button" onclick="switchLedgerPeriod('3months')" id="ltab-3months" data-locked="<%= !isPro ? 'true' : 'false' %>" class="ledger-tab-btn px-3.5 py-1.5 rounded-full <%= isPro ? 'text-[#6B7280] hover:text-[#111827]' : 'text-gray-400 bg-gray-50' %> transition whitespace-nowrap inline-flex items-center gap-1">
                    <span>Last 3 Months</span>
                    <% if (!isPro) { %><svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg><% } %>
                </button>
                <button type="button" onclick="switchLedgerPeriod('6months')" id="ltab-6months" data-locked="<%= !isPro ? 'true' : 'false' %>" class="ledger-tab-btn px-3.5 py-1.5 rounded-full <%= isPro ? 'text-[#6B7280] hover:text-[#111827]' : 'text-gray-400 bg-gray-50' %> transition whitespace-nowrap inline-flex items-center gap-1">
                    <span>Last 6 Months</span>
                    <% if (!isPro) { %><svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg><% } %>
                </button>
                <button type="button" onclick="switchLedgerPeriod('yearly')" id="ltab-yearly" data-locked="<%= !isPro ? 'true' : 'false' %>" class="ledger-tab-btn px-3.5 py-1.5 rounded-full <%= isPro ? 'text-[#6B7280] hover:text-[#111827]' : 'text-gray-400 bg-gray-50' %> transition whitespace-nowrap inline-flex items-center gap-1">
                    <span>This Year</span>
                    <% if (!isPro) { %><svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg><% } %>
                </button>
                <button type="button" onclick="switchLedgerPeriod('lifetime')" id="ltab-lifetime" data-locked="<%= !isPro ? 'true' : 'false' %>" class="ledger-tab-btn px-4 py-1.5 rounded-full <%= isPro ? 'bg-[#084C38] text-white font-semibold shadow-xs' : 'text-gray-400 bg-gray-50' %> transition whitespace-nowrap inline-flex items-center gap-1">
                    <span>Lifetime</span>
                    <% if (!isPro) { %><svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg><% } %>
                </button>
            </div>
        </div>

        <!-- Ledger Table Card (Screenshot 2 Reference) -->
        <div class="bg-white rounded-3xl border border-[#EAEFEB] p-4 sm:p-5 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#EAEFEB] pb-4">
                <div>
                    <h3 class="font-bold text-sm sm:text-base text-[#111827]">Transactions Ledger</h3>
                    <p class="text-[11px] text-[#6B7280]">Itemized history of customer payments and order receipts</p>
                </div>
                <div class="flex items-center gap-2">
                    <input type="text" id="ledgerSearchInput" onkeyup="filterLedgerTable()" placeholder="Search customer, ref..." class="bg-[#F8FAF9] border border-[#EAEFEB] rounded-full px-3.5 py-1.5 text-xs text-[#111827] outline-none focus:border-[#084C38] shadow-2xs">
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse font-body" id="ledgerTable">
                    <thead>
                        <tr class="border-b border-[#EAEFEB] text-[10px] font-bold uppercase text-[#6B7280] bg-[#F8FAF9]">
                            <th class="p-3 rounded-l-2xl">Order Ref</th>
                            <th class="p-3">Date</th>
                            <th class="p-3">Customer</th>
                            <th class="p-3">Fulfillment</th>
                            <th class="p-3 text-right">Amount</th>
                            <th class="p-3 text-center">Payment</th>
                            <th class="p-3 text-center">Status</th>
                            <th class="p-3 text-right rounded-r-2xl">Receipt</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#EAEFEB]">
                        <% if (!orders || orders.length === 0) { %>
                            <tr>
                                <td colspan="8" class="p-10 text-center">
                                    <!-- Minimal Empty State (Screenshot 2 Reference) -->
                                    <div class="w-12 h-12 rounded-2xl bg-gray-50 border border-[#EAEFEB] text-gray-400 flex items-center justify-center mx-auto mb-2.5">
                                        <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                    </div>
                                    <h4 class="font-bold text-sm text-[#111827]">No transactions</h4>
                                    <p class="text-xs text-[#6B7280] mt-0.5 max-w-xs mx-auto">No transactions match your selected timeframe.</p>
                                </td>
                            </tr>
                        <% } else { %>
                            <% orders.forEach(o => { 
                                const isPaid = o.payment_status === 'paid';
                            %>
                                <tr class="hover:bg-[#F8FAF8]/60 transition ledger-row">
                                    <td class="p-3 font-mono font-bold text-[#08110D]">
                                        #<%= o.order_ref %>
                                    </td>
                                    <td class="p-3 text-[#6B756F] whitespace-nowrap">
                                        <%= new Date(o.created_at).toLocaleDateString() %> <span class="text-[10px] opacity-75"><%= new Date(o.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                                    </td>
                                    <td class="p-3">
                                        <div class="font-semibold text-[#08110D]"><%= o.customer_name %></div>
