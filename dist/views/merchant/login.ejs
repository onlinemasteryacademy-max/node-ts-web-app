<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Sign in — zlik</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            DEFAULT: '#084C38',
                            hover: '#063b2c',
                            mint: '#EDF5F1'
                        }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #F8FAF9; color: #111827; }
        .pb-safe { padding-bottom: max(0.875rem, env(safe-area-inset-bottom, 0.875rem)); }
        .pt-safe { padding-top: max(0.75rem, env(safe-area-inset-top, 0.75rem)); }
        html.is-mobile-app header { padding-top: max(1.125rem, env(safe-area-inset-top, 1.125rem)) !important; }
        html.is-mobile-app body { padding-bottom: max(1.25rem, env(safe-area-inset-bottom, 1.25rem)) !important; }
    </style>
    <script>
        (function() {
            try {
                var isApp = <%= (typeof isMobileApp !== 'undefined' && isMobileApp) ? 'true' : 'false' %> ||
                            (typeof navigator !== 'undefined' && navigator.userAgent && navigator.userAgent.indexOf('ZlikMerchantApp') !== -1) ||
                            (typeof window !== 'undefined' && !!window.AndroidBridge);
                if (isApp) {
                    document.documentElement.classList.add('is-mobile-app');
                }
            } catch(e) {}
        })();
    </script>
</head>
<body class="bg-[#F8FAF9] text-[#111827] antialiased min-h-screen flex flex-col justify-between pb-safe">

    <!-- Header Navigation -->
    <header class="border-b border-[#EAEFEB] bg-white/95 backdrop-blur-md sticky top-0 z-40 transition-colors pt-safe">
        <div class="max-w-[1240px] mx-auto px-6 h-18 flex items-center justify-between">
            <a href="/" class="hover:opacity-90 transition inline-flex items-center gap-1">
                <span class="font-bold text-2xl text-[#084C38]">zlik</span>
            </a>
            <div class="flex items-center gap-3">
                <a href="/#pricing" class="bg-[#084C38] hover:bg-[#063b2c] text-white text-xs font-bold px-5 py-2.5 rounded-full transition-all shadow-xs">
                    Create store
                </a>
            </div>
        </div>
    </header>

    <!-- Main Login Area -->
    <main class="flex-1 flex items-center justify-center px-4 py-16">
        <div class="max-w-md w-full bg-white rounded-3xl border border-[#EAEFEB] p-8 sm:p-10 shadow-xs">
            <div class="mb-8 text-center">
                <h1 class="text-2xl font-bold tracking-tight text-[#111827]">Seller sign in</h1>
                <p class="text-xs text-[#6B7280] mt-1.5">Manage your orders, products, and online store.</p>
            </div>

            <form onsubmit="handleMerchantLogin(event)" class="space-y-4 text-xs">
                <div>
                    <label class="block font-semibold text-[#111827] mb-1.5">Email address or WhatsApp phone</label>
                    <input type="text" id="merchantIdentifier" required placeholder="name@store.com or 08012345678" class="w-full px-4 py-3 rounded-2xl bg-[#F8FAF9] border border-[#EAEFEB] text-xs text-[#111827] outline-none focus:border-[#084C38] transition">
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block font-semibold text-[#111827]">5-Digit Security PIN</label>
                    </div>
                    <input type="password" id="merchantPin" required maxlength="5" pattern="[0-9]{5}" inputmode="numeric" placeholder="•••••" class="w-full px-4 py-3 rounded-2xl bg-[#F8FAF9] border border-[#EAEFEB] text-sm text-[#111827] outline-none focus:border-[#084C38] font-mono tracking-widest transition">
                </div>

                <div id="loginError" class="text-xs text-red-600 font-medium hidden"></div>

                <button type="submit" id="loginBtn" class="w-full bg-[#084C38] hover:bg-[#063b2c] text-white font-bold text-xs py-3.5 rounded-full shadow-xs transition duration-200 mt-2">
                    Sign in to dashboard
                </button>
            </form>

            <div class="mt-8 pt-6 border-t border-[#EAEFEB] text-center text-xs text-[#6B7280]">
                <span>Don't have an account?</span>
                <a href="/#pricing" class="font-bold text-[#084C38] hover:underline ml-1">Create free store &rarr;</a>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white text-[#6B7280] border-t border-[#EAEFEB] py-6 text-xs text-center">
        <div class="max-w-[1240px] mx-auto px-6">
            &copy; <%= new Date().getFullYear() %> zlik. All rights reserved. &bull; Selling, Made Slick
        </div>
    </footer>

    <script>
        async function handleMerchantLogin(e) {
            e.preventDefault();
            const btn = document.getElementById('loginBtn');
            const err = document.getElementById('loginError');
            const pinVal = document.getElementById('merchantPin').value.trim();

            if (!/^\d{5}$/.test(pinVal)) {
                err.textContent = 'Please enter your 5-digit PIN (numbers only)';
                err.classList.remove('hidden');
                return;
            }

            btn.disabled = true;
            btn.textContent = 'Signing in...';
            err.classList.add('hidden');

            const payload = {
                identifier: document.getElementById('merchantIdentifier').value.trim(),
                pin: pinVal,
                password: pinVal
            };

            try {
                const res = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                if (result.success) {
                    window.location.href = result.redirect || '/merchant';
                } else {
                    err.textContent = result.error || 'Invalid credentials';
                    err.classList.remove('hidden');
                    btn.disabled = false;
                    btn.textContent = 'Sign in to dashboard';
                }
            } catch (e) {
                err.textContent = 'Connection error. Please try again.';
                err.classList.remove('hidden');
                btn.disabled = false;
                btn.textContent = 'Sign in to dashboard';
            }
        }
    </script>
</body>
</html>
