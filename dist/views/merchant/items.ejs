        // Direct Multi-File Upload Handler (Up to 10MB each)
        async function handleProductFilesUpload(files) {
            if (!files || files.length === 0) return;

            const maxFileSize = 10 * 1024 * 1024; // 10MB
            for (let i = 0; i < files.length; i++) {
                if (files[i].size > maxFileSize) {
                    alert(`"${files[i].name}" exceeds 10MB limit (${(files[i].size / (1024 * 1024)).toFixed(1)}MB). Please choose a file under 10MB.`);
                    return;
                }
            }

            const statusBox = document.getElementById('uploadStatusBox');
            const statusText = document.getElementById('uploadStatusText');
            statusBox.classList.remove('hidden');
            statusText.textContent = `Uploading ${files.length} photo(s)...`;

            const formData = new FormData();
            for (let i = 0; i < files.length; i++) {
                formData.append('files', files[i]);
            }

            try {
                const res = await fetch('/api/upload', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.urls) {
                    data.urls.forEach(u => uploadedProductGallery.push(u));
                    renderGalleryThumbnails();
                    statusBox.classList.add('hidden');
                } else {
                    alert(data.error || 'Failed to upload images');
                    statusBox.classList.add('hidden');
                }
            } catch (err) {
                alert('Network error uploading images');
                statusBox.classList.add('hidden');
            }
        }

        function renderGalleryThumbnails() {
            const container = document.getElementById('productGalleryContainer');
            if (!container) return;

            // Sync hidden inputs
            const primaryUrl = uploadedProductGallery.length > 0 ? uploadedProductGallery[0] : '';
            document.getElementById('prodImageUrl').value = primaryUrl;
            document.getElementById('prodGalleryJson').value = JSON.stringify(uploadedProductGallery);

            if (uploadedProductGallery.length === 0) {
                container.innerHTML = '<div class="col-span-full text-center py-2 text-[#6B756F] text-[11px] italic">No photos uploaded yet.</div>';
                return;
            }

            container.innerHTML = uploadedProductGallery.map((imgUrl, idx) => `
                <div class="relative group/thumb aspect-square rounded-xl overflow-hidden border-2 ${idx === 0 ? 'border-[#087A50] ring-2 ring-[#19D98B]' : 'border-[#E3E9E5]'} bg-gray-100 shadow-2xs">
                    <img src="${imgUrl}" alt="Product Photo" class="w-full h-full object-cover">
                    
                    ${idx === 0 ? `
                        <span class="absolute top-1.5 left-1.5 bg-[#08110D]/90 text-[#19D98B] text-[8.5px] font-extrabold px-1.5 py-0.5 rounded-md shadow-xs">
                            COVER
                        </span>
                    ` : `
                        <button type="button" onclick="setAsPrimaryImage(${idx})" title="Set as main cover photo" class="absolute top-1.5 left-1.5 bg-[#08110D]/80 hover:bg-black text-white text-[8.5px] font-bold px-1.5 py-0.5 rounded-md opacity-0 group-hover/thumb:opacity-100 transition shadow-xs">
                            ★ Make Cover
                        </button>
                    `}

                    <button type="button" onclick="removeGalleryImage(${idx})" title="Remove photo" class="absolute top-1.5 right-1.5 bg-red-600/90 hover:bg-red-700 text-white w-5 h-5 rounded-md flex items-center justify-center text-[10px] font-bold opacity-0 group-hover/thumb:opacity-100 transition shadow-xs">
                        ✕
                    </button>
                </div>
            `).join('');
        }

        function setAsPrimaryImage(idx) {
            if (idx <= 0 || idx >= uploadedProductGallery.length) return;
            const chosen = uploadedProductGallery.splice(idx, 1)[0];
            uploadedProductGallery.unshift(chosen);
            renderGalleryThumbnails();
