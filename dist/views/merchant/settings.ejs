<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store Settings — <%= store.store_name %> | zlik</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        zlikDark: '#08110D',
                        zlikGreen: '#19D98B',
                        zlikDeep: '#087A50',
                        zlikBg: '#F8FAF8',
                        zlikWhite: '#FFFFFF',
                        zlikMuted: '#6B756F',
                        zlikBorder: '#E3E9E5'
                    },
                    fontFamily: {
                        display: ['Montserrat', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8FAF8; color: #08110D; }
        .font-display { font-family: 'Montserrat', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0.5rem); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-[#E3E9E5] shadow-2xs">
        <div class="max-w-7xl mx-auto px-3 sm:px-4 py-2.5 sm:py-3.5 flex items-center justify-between gap-2 sm:gap-4">
            <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <a href="/merchant" class="text-xs font-medium text-[#6B756F] hover:text-[#08110D] flex items-center gap-1 transition shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    <span class="hidden sm:inline">Dashboard</span>
                </a>
                <span class="text-gray-300 hidden sm:inline">/</span>
                <h1 class="text-xs sm:text-sm font-semibold text-[#08110D] truncate">Settings</h1>
            </div>
            <div class="flex items-center gap-2">
                <a href="/<%= store.slug %>" target="_blank" title="View Public Storefront" class="bg-[#08110D] text-[#19D98B] font-medium text-xs p-2 sm:px-3.5 sm:py-2 rounded-xl transition flex items-center gap-1 shadow-2xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                    <span class="hidden sm:inline">Storefront ↗</span>
                </a>
            </div>
        </div>

        <div class="hidden sm:flex max-w-7xl mx-auto px-4 items-center gap-2 overflow-x-auto text-xs font-medium border-t border-[#E3E9E5]/60 pt-2 pb-2">
            <a href="/merchant" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Orders</a>
            <a href="/merchant/items" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Products</a>
            <a href="/merchant/ledger" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Sales Ledger</a>
            <a href="/merchant/debts" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Debts</a>
            <a href="/merchant/messages" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Live Chat</a>
            <a href="/merchant/settings" class="px-3.5 py-1.5 rounded-xl bg-[#08110D] text-white font-semibold">Settings</a>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-3 sm:px-4 py-4 sm:py-6 pb-24 sm:pb-8 flex-1 w-full space-y-5 sm:space-y-6">
        <form id="settingsForm" onsubmit="handleSaveSettings(event)" class="space-y-6">
            
            <!-- Store Category & Templates Card -->
            <div class="bg-white rounded-3xl border border-[#E3E9E5] p-5 sm:p-6 shadow-xs space-y-5 text-xs">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#E3E9E5] pb-4">
                    <div>
                        <h3 class="font-semibold text-sm text-[#08110D]">Store Category & Templates</h3>
                        <p class="text-[11px] text-[#6B756F] mt-0.5">Select your industry category and template design.</p>
                    </div>
                    <div>
                        <span id="activeTemplateBadge" class="bg-[#19D98B]/15 text-[#087A50] font-semibold text-[11px] px-3 py-1 rounded-full uppercase tracking-wider font-mono">
                            Active: <%= templateConfig ? templateConfig.name : 'Classic Grid' %>
                        </span>
                    </div>
                    <input type="hidden" id="selectedTemplateInput" value="<%= store.template_slug || 'general_clean' %>">
                </div>

                <!-- Category Selector (Dropdown Only) -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <label for="categorySelect" class="font-semibold text-[#08110D] text-xs">Industry Category</label>
                        <span class="text-[11px] text-[#6B756F]">1 Free + 2 Pro designs per category</span>
                    </div>

                    <!-- Category Dropdown -->
                    <select id="categorySelect" onchange="handleCategorySelect(this.value)" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] focus:border-[#08110D] rounded-xl p-3 text-xs font-medium text-[#08110D] outline-none transition cursor-pointer">
                        <% Object.values(storeCategories || {}).forEach(cat => { 
                            const isCurrentCat = (templateConfig && templateConfig.category_id === cat.id) || (!templateConfig && cat.id === 'general');
                        %>
                            <option value="<%= cat.id %>" <%= isCurrentCat ? 'selected' : '' %>>
                                <%= cat.name %> — <%= cat.tagline %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <!-- 3-Template Cards (Horizontal swipe/slide on mobile, 3-column grid on desktop) -->
                <div class="space-y-1.5">
                    <div id="templatesGrid" class="flex md:grid md:grid-cols-3 gap-3.5 pt-1 overflow-x-auto md:overflow-x-visible no-scrollbar snap-x snap-mandatory pb-2 md:pb-0">
                        <!-- Injected dynamically via JS with swipeable cards on mobile -->
                    </div>
                    <div class="flex items-center justify-between md:hidden text-[10.5px] text-[#6B756F] px-1 pt-1">
                        <span class="flex items-center gap-1"><span>👆</span> <span>Swipe to view templates</span></span>
                        <span class="font-semibold text-[#08110D]">← Slide →</span>
                    </div>
                </div>
            </div>

            <!-- Storefront URL & QR Code -->
            <div class="bg-white rounded-3xl border border-[#E3E9E5] p-5 shadow-xs space-y-4 text-xs">
                <div class="flex items-center justify-between border-b border-[#E3E9E5] pb-3">
                    <div>
                        <h3 class="font-semibold text-sm text-[#08110D]">Storefront URL & QR Code</h3>
                        <p class="text-[11px] text-[#6B756F] mt-0.5">Your store web address and scan code.</p>
                    </div>
                    <a href="/<%= store.slug %>" target="_blank" class="bg-[#08110D] hover:bg-black text-[#19D98B] font-medium text-[11px] px-3 py-1.5 rounded-xl transition shadow-2xs">
                        Open Store ↗
                    </a>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-start pt-1">
                    <!-- Slug Input -->
                    <div class="sm:col-span-2 space-y-3">
                        <div>
                            <label class="block font-medium text-[#08110D] mb-1">Store Username (URL)</label>
                            <div class="flex items-center rounded-xl border border-[#E3E9E5] bg-[#F8FAF8] overflow-hidden focus-within:border-[#08110D]">
                                <span class="px-3 text-[#6B756F] font-mono text-xs bg-[#E3E9E5]/40 border-r border-[#E3E9E5] py-2.5 select-none">zlik.store/</span>
                                <input type="text" id="storeSlug" value="<%= store.slug %>" required pattern="[a-z0-9_-]{3,30}" placeholder="yourbrand" class="flex-1 bg-transparent p-2.5 outline-none font-mono text-xs text-[#08110D]">
                            </div>
                            <p class="text-[10px] text-[#6B756F] mt-1">
                                3-30 lowercase characters, numbers, and hyphens.
                            </p>
                        </div>

                        <div class="flex items-center gap-2 pt-1">
                            <button type="button" onclick="copySettingsStoreUrl()" id="settingsCopyUrlBtn" class="bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] font-medium text-xs px-3 py-2 rounded-xl border border-[#E3E9E5] transition">
                                Copy Store Link
                            </button>
                            <a href="https://wa.me/?text=Order%20directly%20from%20our%20official%20store:%20https://zlik.store/<%= store.slug %>" target="_blank" class="bg-[#19D98B]/15 hover:bg-[#19D98B]/25 text-[#087A50] font-medium text-xs px-3 py-2 rounded-xl border border-[#19D98B]/30 transition">
                                Share on WhatsApp
                            </a>
                        </div>
                    </div>

                    <!-- Embedded QR Code Box -->
                    <div class="bg-[#F8FAF8] p-3.5 rounded-2xl border border-[#E3E9E5] flex flex-col items-center justify-center space-y-2 text-center">
                        <div id="settingsQrContainer" class="p-2 bg-white rounded-xl shadow-2xs border border-[#E3E9E5] flex items-center justify-center min-h-[120px] min-w-[120px]"></div>
                        <button type="button" onclick="downloadSettingsQrCode()" class="w-full bg-[#08110D] hover:bg-black text-[#19D98B] font-medium text-[10px] py-2 rounded-lg transition shadow-2xs">
                            Download QR Code
                        </button>
                    </div>
                </div>
            </div>

            <!-- Store Profile -->
            <div class="bg-white rounded-3xl border border-[#E3E9E5] p-5 shadow-xs space-y-4 text-xs">
                <h3 class="font-semibold text-sm text-[#08110D]">Store Profile</h3>
                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Store Name</label>
                    <input type="text" id="storeName" value="<%= store.store_name %>" required class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-3 outline-none focus:border-[#08110D]">
                </div>
                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Store Bio / Tagline</label>
                    <textarea id="storeBio" rows="2" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-3 outline-none focus:border-[#08110D]"><%= store.bio || '' %></textarea>
                </div>
                <div class="space-y-2">
                    <label class="block font-medium text-[#08110D]">Store Logo</label>
                    <div class="flex items-center gap-4">
                        <div id="logoPreviewContainer" class="w-16 h-16 rounded-2xl border border-[#E3E9E5] bg-[#F8FAF8] flex items-center justify-center overflow-hidden shrink-0 shadow-2xs">
                            <% if (store.logo_url) { %>
                                <img id="logoPreviewImg" src="<%= store.logo_url %>" alt="Store Logo" class="w-full h-full object-cover">
                            <% } else { %>
                                <span id="logoPreviewPlaceholder" class="text-xl font-semibold text-[#6B756F] font-display"><%= (store.store_name || 'S').charAt(0).toUpperCase() %></span>
                            <% } %>
                        </div>
                        <div class="flex-1 space-y-1.5">
                            <div class="flex items-center gap-2">
                                <label class="cursor-pointer bg-[#08110D] hover:bg-black text-[#19D98B] font-medium text-xs px-3.5 py-2 rounded-xl transition shadow-2xs">
                                    <span>Upload Logo</span>
                                    <input type="file" id="logoFileInput" accept="image/*" onchange="handleLogoUpload(this.files[0])" class="hidden">
                                </label>
                                <button type="button" onclick="removeStoreLogo()" id="removeLogoBtn" class="bg-[#F8FAF8] hover:bg-red-50 hover:text-red-700 text-[#6B756F] font-medium text-xs px-3 py-2 rounded-xl border border-[#E3E9E5] transition <%= store.logo_url ? '' : 'hidden' %>">
                                    Remove
                                </button>
                            </div>
                            <p class="text-[10px] text-[#6B756F]">Supports JPG, PNG, WebP, SVG (up to 10MB).</p>
                        </div>
                    </div>
                    <input type="hidden" id="logoUrl" value="<%= store.logo_url || '' %>">
                </div>

                <% 
                    const isCurrentTemplatePro = Boolean(templateConfig && templateConfig.is_pro);
                %>
                <!-- Store Cover Image & Banner Overlay (Pro Feature) -->
                <div id="coverCustomizationSection" class="space-y-3 pt-3 border-t border-[#E3E9E5]/60">
                    <div class="flex items-center justify-between">
                        <div>
                            <label class="block font-medium text-[#08110D]">Store Cover Image & Banner Tint</label>
                            <span class="text-[10px] text-[#6B756F]">Shown on storefront hero banner (Included in Pro & Business templates)</span>
                        </div>
                    </div>

                    <div class="relative rounded-2xl overflow-hidden">
                        <div id="coverControlsWrapper" class="space-y-4 <%= isCurrentTemplatePro ? '' : 'blur-[1px] opacity-60 pointer-events-none select-none' %>">
                            <div class="space-y-2">
                                <div class="space-y-3">
                                    <div id="coverPreviewContainer" class="w-full aspect-[21/9] sm:aspect-[24/8] max-h-40 rounded-2xl border border-[#E3E9E5] bg-[#08110D] flex items-center justify-center overflow-hidden relative shadow-2xs">
                                        <img id="coverPreviewImg" src="<%= store.cover_url || (templateConfig ? templateConfig.default_cover_image : '') || '/assets/images/templates/general_modern.png' %>" alt="Cover Preview" class="w-full h-full object-cover">
                                    </div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <label id="coverUploadBtn" class="cursor-pointer bg-[#08110D] hover:bg-black text-[#19D98B] font-medium text-xs px-3.5 py-2 rounded-xl transition shadow-2xs">
                                            <span>Upload Cover</span>
                                            <input type="file" id="coverFileInput" accept="image/*" onchange="handleCoverUpload(this.files[0])" class="hidden" <%= isCurrentTemplatePro ? '' : 'disabled' %>>
                                        </label>
                                        <button type="button" onclick="removeStoreCover()" id="removeCoverBtn" class="bg-[#F8FAF8] hover:bg-red-50 hover:text-red-700 text-[#6B756F] font-medium text-xs px-3 py-2 rounded-xl border border-[#E3E9E5] transition <%= store.cover_url ? '' : 'hidden' %>">
                                            Reset to Default
                                        </button>
                                    </div>
                                </div>
                                <input type="hidden" id="coverUrl" value="<%= store.cover_url || '' %>">
                            </div>

                            <!-- Cover Overlay Color (Customizable for Overlay CTA Templates) -->
                            <div class="space-y-2 pt-3 border-t border-[#E3E9E5]/60">
                                <div class="flex items-center justify-between">
                                    <label for="coverOverlayColor" class="block font-medium text-[#08110D]">Banner Overlay Color</label>
                                    <span class="text-[10px] text-[#6B756F]">Customizable dark tint for hero banner text</span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <input type="color" id="coverOverlayColor" value="<%= store.cover_overlay_color || '#08110D' %>" onchange="document.getElementById('coverOverlayColorHex').value = this.value" class="w-10 h-10 rounded-xl border border-[#E3E9E5] cursor-pointer p-0.5 bg-white" <%= isCurrentTemplatePro ? '' : 'disabled' %>>
                                    <input type="text" id="coverOverlayColorHex" value="<%= store.cover_overlay_color || '#08110D' %>" oninput="document.getElementById('coverOverlayColor').value = this.value" class="flex-1 bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none font-mono text-xs text-[#08110D]" <%= isCurrentTemplatePro ? '' : 'disabled' %>>
                                </div>
                            </div>
                        </div>

                        <% if (!isCurrentTemplatePro) { %>
                            <div class="absolute inset-0 bg-white/40 backdrop-blur-[2px] rounded-2xl flex items-center justify-center p-4 z-10">
                                <button type="button" onclick="openProUpgradeModal('Pro Storefront Covers')" class="inline-flex items-center gap-1.5 bg-[#08110D] hover:bg-black text-[#19D98B] border border-[#19D98B]/30 px-3 py-1.5 rounded-lg text-[10.5px] font-semibold font-display shadow-xs hover:scale-105 transition-all">
                                    <span>🔒</span>
                                    <span>Upgrade to Pro</span>
                                </button>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Accepted Payment Methods -->
            <div class="bg-white rounded-3xl border border-[#E3E9E5] p-5 shadow-xs space-y-4 text-xs">
                <div>
                    <h3 class="font-semibold text-sm text-[#08110D]">Accepted Payment Methods</h3>
                    <p class="text-[11px] text-[#6B756F] mt-0.5">Control which payment methods your customers can select at checkout.</p>
                </div>
                <div class="space-y-3 pt-1">
                    <!-- Direct Bank Transfer Toggle -->
                    <label class="flex items-start justify-between p-3.5 rounded-2xl border border-[#E3E9E5] hover:border-[#08110D] transition cursor-pointer bg-[#F8FAF8]">
                        <div class="space-y-0.5 pr-4">
                            <div class="font-bold text-[#08110D] text-xs flex items-center gap-1.5">
                                <span>🏦</span> <span>Direct Bank Transfer</span>
                            </div>
                            <p class="text-[11px] text-[#6B756F]">Customers view your bank account and submit payment proof with receipt.</p>
                        </div>
                        <input type="checkbox" id="allowBankTransfer" <%= store.allow_bank_transfer !== 0 ? 'checked' : '' %> class="w-4 h-4 mt-1 accent-[#08110D]">
                    </label>

                    <!-- Pay on Delivery Toggle -->
                    <label class="flex items-start justify-between p-3.5 rounded-2xl border border-[#E3E9E5] hover:border-[#08110D] transition cursor-pointer bg-[#F8FAF8]">
                        <div class="space-y-0.5 pr-4">
                            <div class="font-bold text-[#08110D] text-xs flex items-center gap-1.5">
                                <span>💵</span> <span>Pay on Delivery (POD)</span>
                            </div>
                            <p class="text-[11px] text-[#6B756F]">Customers pay upon physical arrival. Bank account details are hidden at checkout.</p>
                        </div>
                        <input type="checkbox" id="allowPayOnDelivery" <%= store.allow_pay_on_delivery === 1 ? 'checked' : '' %> class="w-4 h-4 mt-1 accent-[#08110D]">
                    </label>
                </div>
            </div>

            <!-- Bank Transfer Details -->
            <div class="bg-white rounded-3xl border border-[#E3E9E5] p-5 shadow-xs space-y-4 text-xs">
                <h3 class="font-semibold text-sm text-[#08110D]">Bank Transfer Details</h3>
                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Bank Name</label>
                    <input type="text" id="bankName" value="<%= store.bank_name || '' %>" placeholder="e.g. Zenith Bank, GTBank, Kuda" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-3 outline-none focus:border-[#08110D]">
                </div>
                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Account Number</label>
                    <input type="text" id="accountNumber" value="<%= store.bank_account_number || '' %>" placeholder="0123456789" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-3 outline-none focus:border-[#08110D]">
                    <span class="text-[10.5px] text-[#6B756F] mt-1 flex items-center gap-1">
                        <span>🔒</span> <span>A security OTP verification code will be sent to your email when changing account numbers.</span>
                    </span>
                </div>
                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Account Name</label>
                    <input type="text" id="accountName" value="<%= store.bank_account_name || '' %>" placeholder="e.g. John Doe Enterprises" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-3 outline-none focus:border-[#08110D]">
                </div>
            </div>

            <!-- Delivery Fee Setting -->
            <div class="bg-white rounded-3xl border border-[#E3E9E5] p-5 shadow-xs space-y-4 text-xs">
                <h3 class="font-semibold text-sm text-[#08110D]">Delivery Fee</h3>
                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Standard Delivery Fee (₦)</label>
                    <input type="number" id="deliveryFee" value="<%= store.delivery_fee || 0 %>" min="0" step="50" placeholder="0" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-3 outline-none focus:border-[#08110D]">
                    <span class="text-[10px] text-[#6B756F] mt-1 block">Set to 0 for free delivery or custom checkout arrangements.</span>
                </div>
            </div>

            <!-- Notification Sounds -->
            <div class="bg-white rounded-3xl border border-[#E3E9E5] p-5 shadow-xs space-y-4 text-xs">
                <h3 class="font-semibold text-sm text-[#08110D]">Order & Chat Notification Sounds</h3>
                <div>
                    <label class="block font-medium text-[#08110D] mb-1">Alert Sound Style</label>
                    <select id="alertSound" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-3 outline-none font-medium">
                        <option value="chime" <%= store.alert_sound === 'chime' ? 'selected' : '' %>>Classic Chime</option>
                        <option value="bell" <%= store.alert_sound === 'bell' ? 'selected' : '' %>>Service Bell</option>
                        <option value="cash_register" <%= store.alert_sound === 'cash_register' ? 'selected' : '' %>>Cash Register</option>
                    </select>
                </div>
            </div>

            <!-- Seller-Branded Receipts Customization (Pro Feature) -->
            <div class="bg-white rounded-3xl border border-[#E3E9E5] p-5 shadow-xs space-y-4 text-xs">
                <div class="flex items-center justify-between border-b border-[#E3E9E5] pb-3">
                    <div>
                        <h3 class="font-semibold text-sm text-[#08110D]">Seller-Branded Digital Receipts</h3>
                        <p class="text-[11px] text-[#6B756F] mt-0.5">Customize PDF/printable receipts sent to customers.</p>
                    </div>
                </div>

                <div class="relative rounded-2xl overflow-hidden">
                    <div class="space-y-4 <%= isPro ? '' : 'blur-[1px] opacity-60 pointer-events-none select-none' %>">
                        <div>
                            <label class="block font-medium text-[#08110D] mb-1">Receipt Custom Note / Payment Policy</label>
                            <input type="text" id="receiptCustomNote" value="<%= store.receipt_custom_note || '' %>" placeholder="e.g. Thank you for your order! Goods once sold are not refundable." class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-3 outline-none focus:border-[#08110D]" <%= isPro ? '' : 'disabled' %>>
                            <span class="text-[10px] text-[#6B756F] mt-1 block">Printed on printable digital receipts & invoices.</span>
                        </div>

                        <div class="flex items-center justify-between pt-1">
                            <div>
                                <span class="font-medium text-[#08110D] block">Display Store Logo on Receipt</span>
