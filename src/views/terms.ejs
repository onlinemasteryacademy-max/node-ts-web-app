        </nav>

        <div class="pt-4 border-t border-[#E3E9E5]">
          <div class="text-[11px] text-[#6B756F]">
            Need legal clarification? <br>
            <a href="mailto:legal@zlik.store" class="text-[#087A50] font-semibold hover:underline">legal@zlik.store</a>
          </div>
        </div>
