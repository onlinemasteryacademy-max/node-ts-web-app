<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Customer Live Chat Desk — <%= store.store_name %> | zlik</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            DEFAULT: '#084C38',
                            hover: '#063b2c',
                            mint: '#EDF5F1'
                        }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #F8FAF9; color: #111827; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .pb-safe { padding-bottom: max(0.875rem, env(safe-area-inset-bottom, 0.875rem)); }
        .pt-safe { padding-top: max(0.75rem, env(safe-area-inset-top, 0.75rem)); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased bg-[#F8FAF9]">

    <!-- Merchant Header (Universal Component) -->
    <%- include('components/header_nav.ejs', { activeTab: 'chat', pageTitle: 'Live Chat' }) %>

    <!-- Main Chat Workspace (3-Column Responsive Layout) -->
    <main class="max-w-7xl mx-auto px-2 sm:px-4 py-2 sm:py-4 pb-28 sm:pb-4 flex-1 w-full flex flex-col h-[calc(100dvh-135px)] sm:h-[calc(100vh-65px)]">
        <div class="flex-1 bg-white rounded-3xl border border-[#EAEFEB] shadow-xs grid grid-cols-1 md:grid-cols-12 overflow-hidden">

            <!-- Col 1: Conversations List (Inbox) -->
            <div id="conversationsCol" class="col-span-12 md:col-span-4 border-r border-[#EAEFEB] flex flex-col h-full bg-white">
                <div class="p-4 border-b border-[#EAEFEB] space-y-2.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-[#111827]">Customer Threads</span>
                        <div class="flex items-center gap-1.5">
                            <span id="monthlyChatUsageBadge" class="hidden text-[10px] font-bold px-2 py-0.5 rounded-full border"></span>
                            <span id="convCountBadge" class="text-[10px] font-bold bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 px-2.5 py-0.5 rounded-full">0 chats</span>
                        </div>
                    </div>
                    <!-- Monthly Chat Limit Alert Banner if reached -->
                    <div id="monthlyChatLimitAlert" class="hidden p-3 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-[11px] leading-tight space-y-1.5">
                        <div class="flex items-center gap-1.5 font-bold">
                            <svg class="w-3.5 h-3.5 text-amber-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                            <span>Monthly Chat Quota Reached</span>
                        </div>
                        <p class="text-amber-800 text-[10px]">
                            You've used all 20 storefront live chats for this month. New storefront visitors are given a 1-click button to contact you directly on WhatsApp.
                        </p>
                        <a href="/merchant/settings" class="inline-flex items-center gap-1 text-[10px] font-bold text-[#084C38] hover:underline">
                            Upgrade to Pro for Unlimited Live Chat &rarr;
                        </a>
                    </div>
                    <div class="relative">
                        <input type="text" id="convSearchInput" oninput="handleSearchConversations(this.value)" placeholder="Search customer name, phone, message..." class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-full pl-3.5 pr-8 py-2 text-xs text-[#111827] placeholder-[#6B7280]/60 outline-none focus:border-[#084C38] transition">
                        <span class="absolute right-3 top-2.5 text-[#6B7280]">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </span>
                    </div>
                </div>

                <div id="conversationsListContainer" class="flex-1 overflow-y-auto divide-y divide-[#EAEFEB]/60 text-xs">
                    <div class="p-8 text-center text-[#6B7280]">Loading conversations...</div>
                </div>
            </div>

            <!-- Col 2: Active Message Thread -->
            <div id="chatThreadCol" class="hidden md:flex col-span-12 md:col-span-5 flex-col h-full bg-[#F8FAF9] border-r border-[#EAEFEB]">
                <!-- Chat Top Header with Lead Contact Actions & Mobile Back Arrow -->
                <div id="activeChatHeader" class="p-3 sm:p-3.5 bg-white border-b border-[#EAEFEB] flex items-center justify-between shrink-0">
                    <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                        <button type="button" onclick="backToConversationsList()" class="md:hidden w-8 h-8 rounded-full bg-[#F8FAF9] border border-[#EAEFEB] text-[#111827] flex items-center justify-center font-bold text-sm shrink-0 hover:bg-[#EDF5F1] transition" title="Back to Inbox">
                            <svg class="w-4 h-4 text-[#111827]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 19l-7-7 7-7"/></svg>
                        </button>
                        <div id="activeChatAvatar" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 font-bold text-xs flex items-center justify-center shrink-0 shadow-xs">
                            C
                        </div>
                        <div class="min-w-0">
                            <h3 id="activeChatName" class="text-xs font-bold text-[#111827] truncate">Select Conversation</h3>
                            <p id="activeChatPhone" class="text-[10px] sm:text-[11px] text-[#6B7280] truncate">Direct Storefront Channel</p>
                        </div>
                    </div>

                    <div id="activeChatActions" class="flex items-center gap-1.5 shrink-0 hidden">
                        <a id="activeChatWhatsAppBtn" href="#" target="_blank" class="bg-[#EDF5F1] hover:bg-[#084C38]/10 text-[#084C38] border border-[#084C38]/20 px-3 py-1.5 rounded-full text-[10px] sm:text-[11px] font-bold transition flex items-center gap-1.5 shadow-xs">
                            <svg class="w-3.5 h-3.5 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                            <span>WhatsApp</span>
                        </a>
                        <a id="activeChatCallBtn" href="#" class="bg-white hover:bg-gray-50 text-[#111827] border border-[#EAEFEB] px-3 py-1.5 rounded-full text-[10px] sm:text-[11px] font-bold transition flex items-center gap-1.5 shadow-xs">
                            <svg class="w-3.5 h-3.5 text-[#111827]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            <span>Call</span>
                        </a>
                    </div>
                </div>

                <!-- Messages Stream -->
                <div id="messagesThreadStream" class="flex-1 p-4 overflow-y-auto space-y-3 text-xs">
                    <div class="p-12 text-center text-[#6B7280]">Select a conversation on the left to start messaging.</div>
                </div>

                <!-- Quick Replies Bar -->
                <div class="px-3.5 py-2.5 bg-white border-t border-[#EAEFEB] flex items-center gap-1.5 overflow-x-auto no-scrollbar shrink-0 text-[11px]">
                    <button onclick="sendQuickReply('Thanks for contacting us! How can we assist you?')" class="bg-[#F8FAF9] hover:bg-[#EDF5F1] hover:text-[#084C38] border border-[#EAEFEB] px-3 py-1 rounded-full shrink-0 transition text-[#111827] font-medium">Welcome Reply</button>
                    <button onclick="sendQuickReply('Yes! This item is currently available in stock and ready for delivery.')" class="bg-[#F8FAF9] hover:bg-[#EDF5F1] hover:text-[#084C38] border border-[#EAEFEB] px-3 py-1 rounded-full shrink-0 transition text-[#111827] font-medium">In Stock</button>
                    <button onclick="sendQuickReply('Your order has been confirmed and is being packaged for dispatch.')" class="bg-[#F8FAF9] hover:bg-[#EDF5F1] hover:text-[#084C38] border border-[#EAEFEB] px-3 py-1 rounded-full shrink-0 transition text-[#111827] font-medium">Order Processing</button>
                </div>

                <!-- Message Input -->
                <form id="merchantChatForm" onsubmit="handleSendMerchantMessage(event)" class="p-3 bg-white border-t border-[#EAEFEB] flex items-center gap-2 shrink-0">
                    <input type="text" id="merchantMsgInput" placeholder="Type a reply..." autocomplete="off" class="flex-1 bg-[#F8FAF9] border border-[#EAEFEB] text-xs text-[#111827] placeholder-[#6B7280]/60 rounded-full px-4 py-2.5 outline-none focus:border-[#084C38] transition">
                    <button type="submit" id="merchantSendBtn" class="bg-[#084C38] hover:bg-[#063b2c] text-white font-bold text-xs px-4 py-2.5 rounded-full transition shadow-xs shrink-0 flex items-center gap-1.5">
                        <span>Send</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </button>
                </form>
            </div>

            <!-- Col 3: Customer Context & Orders Sidebar (3 cols) -->
            <div class="hidden md:flex md:col-span-3 flex-col h-full bg-white p-4 overflow-y-auto space-y-4">
                <div>
                    <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider mb-3">Customer Lead Profile</h4>
                    <div class="p-3.5 bg-[#F8FAF9] rounded-2xl border border-[#EAEFEB] space-y-2 text-xs">
                        <div class="font-bold text-[#111827]" id="contextCustName">Customer</div>
                        <div class="text-[11px] text-[#6B7280] font-mono" id="contextCustPhone">No phone specified</div>
                        <div class="text-[11px] text-[#6B7280]" id="contextCustEmail"></div>

                        <div id="contextActionButtons" class="pt-2 flex flex-col gap-1.5 hidden">
                            <a id="contextWhatsAppLink" href="#" target="_blank" class="w-full bg-[#084C38] hover:bg-[#063b2c] text-white text-center py-2.5 rounded-full text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-xs">
                                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                                <span>Reach out on WhatsApp</span>
                            </a>
                            <a id="contextCallLink" href="#" class="w-full bg-white hover:bg-gray-50 border border-[#EAEFEB] text-[#111827] text-center py-2 rounded-full text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-xs">
                                <svg class="w-3.5 h-3.5 text-[#111827]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                <span>Direct Phone Call</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div>
                    <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider mb-3">Customer Lifetime</h4>
                    <div class="grid grid-cols-2 gap-2 text-center">
                        <div class="p-3 bg-[#F8FAF9] rounded-2xl border border-[#EAEFEB]">
                            <div class="text-base font-extrabold text-[#111827]" id="contextTotalOrders">0</div>
                            <div class="text-[10px] text-[#6B7280] uppercase font-bold">Orders</div>
                        </div>
                        <div class="p-3 bg-[#F8FAF9] rounded-2xl border border-[#EAEFEB]">
                            <div class="text-xs font-extrabold text-[#084C38] font-mono truncate" id="contextTotalSpent">₦0.00</div>
                            <div class="text-[10px] text-[#6B7280] uppercase font-bold">Total Spent</div>
                        </div>
                    </div>
                </div>

                <div class="flex-1">
                    <h4 class="text-xs font-bold text-[#111827] uppercase tracking-wider mb-3">Recent Orders</h4>
                    <div id="contextOrdersList" class="space-y-2 text-xs">
                        <div class="p-3 text-center text-[#6B7280] text-[11px] bg-[#F8FAF9] rounded-2xl border border-[#EAEFEB]">No orders placed yet.</div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script src="/assets/js/sound_engine.js"></script>
    <script>
        const storeData = <%- JSON.stringify(store) %>;
        let currentConvId = 0;
        let lastMessageId = 0;
        let activeConversations = [];
        let audioEnabled = true;
        let chatWs = null;
        let chatSSE = null;

        function playMessageAudio() {
            if (!audioEnabled) return;
            try {
                const soundType = storeData.alert_sound || 'chime';
                const customUrl = storeData.custom_sound_url || '';
                playNotificationSound(soundType, customUrl);
            } catch (e) {}
        }

        function toggleAudio() {
            audioEnabled = !audioEnabled;
            const st = document.getElementById('soundToggle');
            if (st) {
                st.innerHTML = audioEnabled 
                    ? '<svg class="w-3.5 h-3.5 text-[#087A50]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg><span class="hidden sm:inline">Sound: ON</span>' 
                    : '<svg class="w-3.5 h-3.5 text-[#6B756F]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg><span class="hidden sm:inline">Sound: OFF</span>';
            }
        }

        let isMobileChatView = false;

        function showMobileChatView() {
            const listCol = document.getElementById('conversationsCol');
            const threadCol = document.getElementById('chatThreadCol');
            if (listCol && threadCol) {
                listCol.classList.add('hidden');
                listCol.classList.remove('flex');
                threadCol.classList.remove('hidden');
                threadCol.classList.add('flex');
                isMobileChatView = true;
            }
        }

        function backToConversationsList() {
            const listCol = document.getElementById('conversationsCol');
            const threadCol = document.getElementById('chatThreadCol');
            if (listCol && threadCol) {
                threadCol.classList.add('hidden');
                threadCol.classList.remove('flex');
                listCol.classList.remove('hidden');
                listCol.classList.add('flex');
                isMobileChatView = false;
            }
        }

        async function loadConversationsList(search = '') {
            try {
                const res = await fetch(`/api/chat?action=merchant_list_conversations&search=${encodeURIComponent(search)}`);
                const data = await res.json();
                if (data.success) {
                    activeConversations = data.conversations || [];
                    renderConversationsList(activeConversations);
                    updateTopUnreadBadges(data.total_unread_count || 0);
                    if (currentConvId === 0 && activeConversations.length > 0 && window.innerWidth >= 768) {
                        selectConversation(activeConversations[0].id);
                    }
                    loadMonthlyChatUsage();
                }
            } catch (e) {}
        }

        function renderConversationsList(convs) {
            const container = document.getElementById('conversationsListContainer');
            document.getElementById('convCountBadge').textContent = convs.length + ' chats';

            if (convs.length === 0) {
                container.innerHTML = `<div class="p-8 text-center text-[#6B7280]">No conversations found.</div>`;
                return;
            }

            container.innerHTML = convs.map(c => {
                const isSelected = (parseInt(c.id) === currentConvId);
                const unread = parseInt(c.unread_merchant_count || 0);
                const time = c.last_message_at ? new Date(c.last_message_at.replace(/-/g, '/')).toLocaleDateString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
                const initial = (c.customer_name || 'S').charAt(0).toUpperCase();

                return `
                    <div onclick="selectConversation(${c.id})" class="p-3.5 cursor-pointer transition flex items-start gap-3 ${isSelected ? 'bg-[#EDF5F1] border-l-4 border-[#084C38]' : 'hover:bg-[#F8FAF9]'}">
                        <div class="w-9 h-9 rounded-full ${unread > 0 ? 'bg-[#084C38] text-white' : 'bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20'} flex items-center justify-center font-bold text-xs shrink-0">
                            ${initial}
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between mb-0.5">
                                <h4 class="text-xs font-bold text-[#111827] truncate ${unread > 0 ? 'font-extrabold' : ''}">${escapeHtml(c.customer_name)}</h4>
                                <span class="text-[10px] text-[#6B7280] shrink-0">${time}</span>
                            </div>
                            <p class="text-[11px] text-[#6B7280] truncate ${unread > 0 ? 'font-semibold text-[#111827]' : ''}">
                                ${escapeHtml(c.last_message_preview || 'New message')}
                            </p>
                            <div class="flex items-center justify-between mt-1.5">
                                <div class="flex items-center gap-1.5 truncate">
                                    <span class="text-[9px] font-bold text-[#084C38] bg-[#EDF5F1] px-2 py-0.5 rounded-full">
                                        ${c.total_orders_count > 0 ? c.total_orders_count + ' Orders' : 'Storefront Inquiry'}
                                    </span>
                                    ${c.customer_phone ? `<span class="text-[9px] font-mono text-[#6B7280] bg-[#F8FAF9] border border-[#EAEFEB] px-1.5 py-0.5 rounded-md">${escapeHtml(c.customer_phone)}</span>` : ''}
                                </div>
                                ${unread > 0 ? `<span class="bg-[#084C38] text-white text-[9px] font-bold px-2 py-0.5 rounded-full shrink-0">${unread} new</span>` : ''}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function formatPhoneForWhatsApp(phone) {
            if (!phone) return '';
            let clean = String(phone).replace(/[^0-9]/g, '');
            if (clean.startsWith('0')) clean = '234' + clean.slice(1);
            if (!clean.startsWith('234') && clean.length === 10) clean = '234' + clean;
            return clean;
        }

        async function selectConversation(convId) {
            currentConvId = parseInt(convId);
            lastMessageId = 0;
            if (window.innerWidth < 768) {
                showMobileChatView();
            }
            const conv = activeConversations.find(c => parseInt(c.id) === currentConvId);

            if (conv) {
                document.getElementById('activeChatAvatar').textContent = (conv.customer_name || 'S').charAt(0).toUpperCase();
                document.getElementById('activeChatName').textContent = conv.customer_name;
                document.getElementById('activeChatPhone').textContent = conv.customer_phone ? conv.customer_phone : (conv.customer_email || 'Direct Storefront Channel');

                const actionsBar = document.getElementById('activeChatActions');
                if (conv.customer_phone) {
                    const waNum = formatPhoneForWhatsApp(conv.customer_phone);
                    document.getElementById('activeChatWhatsAppBtn').href = `https://wa.me/${waNum}?text=${encodeURIComponent('Hello ' + (conv.customer_name || '') + ', thanks for reaching out to ' + storeData.store_name + '!')}`;
                    document.getElementById('activeChatCallBtn').href = `tel:${conv.customer_phone}`;
                    actionsBar.classList.remove('hidden');
                } else {
                    actionsBar.classList.add('hidden');
                }
            }

            renderConversationsList(activeConversations);
            await loadMessages(true);
            await loadCustomerContext();
            connectRealtimeStream();
        }

        async function loadMessages(initial = false) {
            if (!currentConvId) return;
            try {
                const res = await fetch(`/api/chat?action=get_messages&conversation_id=${currentConvId}&after_id=${lastMessageId}`);
                const data = await res.json();
                if (data.success && data.messages) {
                    if (initial) document.getElementById('messagesThreadStream').innerHTML = '';
                    if (data.messages.length > 0) renderThreadMessages(data.messages, initial);
                }
            } catch (e) {}
        }

        function renderThreadMessages(messages, initial = false) {
            const stream = document.getElementById('messagesThreadStream');
            let hasIncoming = false;

            messages.forEach(msg => {
                if (parseInt(msg.id) > lastMessageId) lastMessageId = parseInt(msg.id);
                if (msg.idempotency_key) {
                    const temp = document.getElementById('temp-merchant-msg-' + msg.idempotency_key);
                    if (temp) temp.remove();
                }
                if (document.getElementById('merchant-msg-' + msg.id)) return;

                const isMerchant = (msg.sender_type === 'merchant');
                if (!isMerchant) hasIncoming = true;

                const time = msg.created_at ? new Date(msg.created_at.replace(/-/g, '/')).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';

                const row = document.createElement('div');
                row.id = 'merchant-msg-' + msg.id;
                row.className = 'flex flex-col ' + (isMerchant ? 'items-end' : 'items-start') + ' space-y-1';
                row.innerHTML = `
                    <div class="max-w-[80%] px-4 py-2.5 rounded-2xl shadow-xs ${isMerchant ? 'bg-[#084C38] text-white rounded-br-xs' : 'bg-white border border-[#EAEFEB] text-[#111827] rounded-bl-xs'}">
                        <div class="leading-relaxed break-words whitespace-pre-line text-xs">${escapeHtml(msg.message)}</div>
                        <div class="text-[9px] mt-1 text-right ${isMerchant ? 'text-white/70' : 'text-[#6B7280]'} flex items-center justify-end gap-1">
                            <span>${time}</span>
                            ${isMerchant ? '<svg class="w-2.5 h-2.5 text-white/80" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>' : ''}
                        </div>
                    </div>
                `;
                stream.appendChild(row);
            });

            stream.scrollTop = stream.scrollHeight;
            if (hasIncoming && !initial) playMessageAudio();
        }

        async function loadCustomerContext() {
            if (!currentConvId) return;
            try {
                const res = await fetch(`/api/chat?action=merchant_get_customer_context&conversation_id=${currentConvId}`);
                const data = await res.json();
                if (data.success) {
                    const cust = data.customer || {};
                    document.getElementById('contextCustName').textContent = cust.name || 'Customer';
                    document.getElementById('contextCustPhone').textContent = cust.phone ? cust.phone : 'No phone specified';
                    document.getElementById('contextCustEmail').textContent = cust.email ? cust.email : '';
                    document.getElementById('contextTotalOrders').textContent = cust.total_orders || 0;
                    document.getElementById('contextTotalSpent').textContent = '₦' + (cust.total_spent || 0).toLocaleString('en-US', { minimumFractionDigits: 2 });

                    const actionBtns = document.getElementById('contextActionButtons');
                    if (cust.phone) {
                        const waNum = formatPhoneForWhatsApp(cust.phone);
                        document.getElementById('contextWhatsAppLink').href = `https://wa.me/${waNum}?text=${encodeURIComponent('Hello ' + (cust.name || '') + ', thanks for reaching out to ' + storeData.store_name + '!')}`;
                        document.getElementById('contextCallLink').href = `tel:${cust.phone}`;
                        actionBtns.classList.remove('hidden');
                    } else {
                        actionBtns.classList.add('hidden');
                    }

                    const ordersContainer = document.getElementById('contextOrdersList');
                    const orders = data.orders || [];
                    if (orders.length === 0) {
                        ordersContainer.innerHTML = `<div class="p-3 text-center text-[#6B7280] text-[11px] bg-[#F8FAF9] rounded-2xl border border-[#EAEFEB]">No orders placed yet.</div>`;
                    } else {
                        ordersContainer.innerHTML = orders.map(ord => `
                            <div class="p-3 bg-[#F8FAF9] rounded-2xl border border-[#EAEFEB] space-y-1">
                                <div class="flex items-center justify-between">
                                    <span class="font-bold text-[#111827]">#${ord.order_ref}</span>
                                    <span class="text-[9px] font-bold uppercase px-2 py-0.5 rounded-full bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20">${ord.order_status}</span>
                                </div>
                                <div class="text-[11px] text-[#6B7280] flex items-center justify-between">
                                    <span>₦${parseFloat(ord.total_amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})}</span>
                                    <span>${ord.payment_status === 'paid' ? '<span class="inline-flex items-center gap-1 text-[#084C38] font-bold"><span class="w-1.5 h-1.5 rounded-full bg-[#084C38]"></span>Paid</span>' : '<span class="inline-flex items-center gap-1 text-amber-700 font-bold"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Unpaid</span>'}</span>
                                </div>
                            </div>
                        `).join('');
                    }
                }
            } catch (e) {}
        }

        async function handleSendMerchantMessage(e) {
            e.preventDefault();
            const input = document.getElementById('merchantMsgInput');
            const text = input.value.trim();
            if (!text || !currentConvId) return;

            input.value = '';
            const key = 'mk_' + Date.now() + '_' + Math.random().toString(36).substring(2, 8);
            const nowTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            // Optimistic UI update (0ms lag)
            const stream = document.getElementById('messagesThreadStream');
            const temp = document.createElement('div');
            temp.id = 'temp-merchant-msg-' + key;
            temp.className = 'flex flex-col items-end space-y-1 opacity-90';
            temp.innerHTML = `
                <div class="max-w-[80%] px-4 py-2.5 rounded-2xl shadow-xs bg-[#084C38] text-white rounded-br-xs">
                    <div class="leading-relaxed break-words whitespace-pre-line text-xs">${escapeHtml(text)}</div>
                    <div class="text-[9px] mt-1 text-right text-white/70 flex items-center justify-end gap-1">
                        <span>${nowTime}</span>
                        <span class="text-white/80 animate-pulse flex items-center gap-1"><span>Sending...</span></span>
                    </div>
                </div>
            `;
            stream.appendChild(temp);
            stream.scrollTop = stream.scrollHeight;

            if (chatWs && chatWs.readyState === WebSocket.OPEN) {
                chatWs.send(JSON.stringify({
                    type: 'send_message',
                    conversation_id: currentConvId,
                    message: text,
                    idempotency_key: key
                }));
            } else {
                fetch('/api/chat?action=send_message', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ conversation_id: currentConvId, message: text, idempotency_key: key })
                }).then(r => r.json()).then(d => {
                    if (d.success && d.message) {
                        renderThreadMessages([d.message], true);
                        loadConversationsList();
                    }
                });
            }
        }

        function sendQuickReply(text) {
            document.getElementById('merchantMsgInput').value = text;
            document.getElementById('merchantChatForm').dispatchEvent(new Event('submit'));
        }

        function updateTopUnreadBadges(count) {
            const navBadge = document.getElementById('navUnreadBadge');
            if (navBadge) {
                if (count > 0) {
                    navBadge.textContent = count + ' new';
                    navBadge.classList.remove('hidden');
                } else {
                    navBadge.classList.add('hidden');
                }
            }
        }

        function handleSearchConversations(query) {
            loadConversationsList(query);
        }

        function connectRealtimeStream() {
            // 1. WebSocket
            try {
                const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                chatWs = new WebSocket(`${proto}//${window.location.host}/ws/chat`);
                chatWs.onopen = () => {
                    chatWs.send(JSON.stringify({ type: 'auth', role: 'merchant', store_id: storeData.id }));
                };
                chatWs.onmessage = (e) => {
                    try {
                        const payload = JSON.parse(e.data);
                        if (payload.event === 'chat_message' || payload.type === 'message_ack') {
                            const msg = payload.data || payload.message;
                            if (msg) {
                                renderThreadMessages([msg], false);
                                loadConversationsList();
                            }
                        }
                    } catch (err) {}
                };
                chatWs.onerror = () => connectSSEFallback();
            } catch (e) {
                connectSSEFallback();
            }
        }

        function connectSSEFallback() {
            if (chatSSE || typeof EventSource === 'undefined') return;
            chatSSE = new EventSource('/api/stream?channel=merchant');
            chatSSE.addEventListener('chat_message', (e) => {
                try {
                    const msg = JSON.parse(e.data);
                    renderThreadMessages([msg], false);
                    loadConversationsList();
                } catch (err) {}
            });
            chatSSE.addEventListener('notification', (e) => {
                try {
                    const notif = JSON.parse(e.data);
                    if (notif.event_type === 'chat_message') loadConversationsList();
                } catch (err) {}
            });
        }

        async function loadMonthlyChatUsage() {
            try {
                const res = await fetch('/api/merchant/chat/usage');
                const data = await res.json();
                if (data.success) {
                    const badge = document.getElementById('monthlyChatUsageBadge');
                    const alert = document.getElementById('monthlyChatLimitAlert');
                    if (data.is_unlimited) {
                        badge.className = 'text-[10px] font-bold px-2.5 py-0.5 rounded-full border bg-[#EDF5F1] text-[#084C38] border-[#084C38]/20';
                        badge.textContent = 'Unlimited (' + (data.plan || 'PRO').toUpperCase() + ')';
                        badge.classList.remove('hidden');
                        if (alert) alert.classList.add('hidden');
                    } else {
                        const used = data.used || 0;
                        const limit = data.limit || 20;
                        const reached = data.limit_reached;
                        badge.className = `text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${reached ? 'bg-red-50 text-red-700 border-red-200' : 'bg-[#EDF5F1] text-[#084C38] border-[#084C38]/20'}`;
                        badge.textContent = `${used}/${limit} chats this month`;
                        badge.classList.remove('hidden');
                        if (alert) {
                            if (reached) alert.classList.remove('hidden');
                            else alert.classList.add('hidden');
                        }
                    }
                }
            } catch (e) {}
        }

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadConversationsList();
            loadMonthlyChatUsage();
            connectRealtimeStream();
        });
    </script>
    <%- include('components/bottom_nav.ejs', { activeTab: 'chat' }) %>
</body>
</html>
