                    <label class="block font-medium text-[#111827] mb-1">Alert Sound Style</label>
                    <select id="alertSound" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-medium text-xs">
                        <option value="chime" <%= store.alert_sound === 'chime' ? 'selected' : '' %>>Classic Chime</option>
                        <option value="bell" <%= store.alert_sound === 'bell' ? 'selected' : '' %>>Service Bell</option>
                        <option value="cash_register" <%= store.alert_sound === 'cash_register' ? 'selected' : '' %>>Cash Register</option>
                    </select>
                </div>
            </div>

