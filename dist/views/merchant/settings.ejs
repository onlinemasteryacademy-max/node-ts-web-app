                            <span>⏱</span> <span id="bankOtpCountdownText">05:00</span>
                        </div>
                    </div>
                    <input type="text" id="bankOtpInput" maxlength="6" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" required placeholder="••••••" class="w-full text-center text-2xl font-bold tracking-[0.3em] font-mono border-2 border-[#08110D] rounded-2xl py-3 bg-[#F8FAF8] outline-none focus:bg-white focus:border-[#19D98B] transition">
                </div>

                <div class="flex items-center justify-between text-[11px] pt-1">
                    <span class="text-[#6B756F]">Didn't receive code?</span>
