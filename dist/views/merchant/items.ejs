        async function handleSaveProduct(e) {
            e.preventDefault();
            const btn = document.getElementById('saveProdBtn');
            btn.disabled = true;

            const id = document.getElementById('prodId').value;
            const basePrice = parseFloat(document.getElementById('prodPrice').value || 0);

            // Build template-specific payload
            const attributes = {};
            let optionGroups = [];
            let specs = [];

            if (currentTemplateCat === 'fashion') {
                attributes.sizes = document.getElementById('fashionSizes')?.value || '';
                attributes.colors = document.getElementById('fashionColors')?.value || '';
                attributes.material = document.getElementById('fashionMaterial')?.value || '';
                attributes.care = document.getElementById('fashionCare')?.value || '';
            } else if (currentTemplateCat === 'food') {
                attributes.prep_time = document.getElementById('foodPrepTime')?.value || '';
                attributes.dietary = document.getElementById('foodDietary')?.value || '';
                optionGroups = foodOptionGroups.filter(g => g.name && g.options.length > 0);
            } else if (currentTemplateCat === 'beauty') {
                attributes.formulation = document.getElementById('beautyFormulation')?.value || '';
                attributes.volumes = document.getElementById('beautyVolumes')?.value || '';
                attributes.shades = document.getElementById('beautyShades')?.value || '';
                attributes.concerns = document.getElementById('beautyConcerns')?.value || '';
                attributes.ingredients = document.getElementById('beautyIngredients')?.value || '';
            } else if (currentTemplateCat === 'electronics') {
                attributes.condition = document.getElementById('techCondition')?.value || 'Brand New';
                attributes.warranty = document.getElementById('techWarranty')?.value || '';
                attributes.configs = document.getElementById('techConfigs')?.value || '';
                attributes.box_contents = document.getElementById('techBoxContents')?.value || '';
                attributes.specs_text = document.getElementById('techSpecsText')?.value || '';
            }

            const primaryImageUrl = uploadedProductGallery.length > 0 ? uploadedProductGallery[0] : (document.getElementById('prodImageUrl').value.trim() || null);

            const isPreorderChecked = document.getElementById('prodIsPreorder')?.checked ? 1 : 0;
            const preorderDispatchDate = isPreorderChecked ? (document.getElementById('prodPreorderDispatchDate')?.value || null) : null;

            const payload = {
                id: id ? parseInt(id) : undefined,
                title: document.getElementById('prodTitle').value.trim(),
                category: document.getElementById('prodCategory').value.trim() || 'General',
                badge: document.getElementById('prodBadge').value.trim() || null,
                price: basePrice,
                compare_price: document.getElementById('prodComparePrice').value ? parseFloat(document.getElementById('prodComparePrice').value) : null,
                stock_quantity: parseInt(document.getElementById('prodStock').value || '0'),
                sku: document.getElementById('prodSku').value.trim() || null,
                is_preorder: isPreorderChecked,
                preorder_dispatch_date: preorderDispatchDate,
                video_url: document.getElementById('prodVideoUrl')?.value.trim() || null,
                image_url: primaryImageUrl,
                gallery_json: uploadedProductGallery.length > 0 ? uploadedProductGallery : null,
                description: document.getElementById('prodDesc').value.trim() || null,
                variants_json: customVariantsList.length > 0 ? customVariantsList : null,
                option_groups_json: optionGroups.length > 0 ? optionGroups : null,
                specs_json: specs.length > 0 ? specs : null,
                attributes_json: Object.keys(attributes).length > 0 ? attributes : null
            };

            try {
                const res = await fetch('/api/merchant/items', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const d = await res.json();
                if (d.success) {
                    location.reload();
                } else {
                    alert(d.error || 'Failed to save product');
                }
            } catch (err) {
                alert('Network error saving product');
            } finally {
                btn.disabled = false;
            }
        }

        async function deleteProduct(id) {
            if (!confirm('Are you sure you want to delete this product?')) return;
            try {
                const res = await fetch('/api/merchant/items?id=' + id, { method: 'DELETE' });
                const d = await res.json();
                if (d.success) location.reload();
            } catch (err) {}
        }

