<!-- Mobile Persistent 4-Item Bottom Navigation Bar (Batch 2 & 3) -->
<nav class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border-t border-[#E3E9E5] px-3 pt-2 pb-3.5 flex items-center justify-around shadow-[0_-4px_24px_rgba(8,17,13,0.06)] pb-safe font-body select-none"
     aria-label="Merchant Mobile Navigation">

    <!-- Destination 1: Orders (Dashboard) -->
    <a href="/merchant" 
       class="relative flex-1 flex flex-col items-center justify-center min-h-[52px] py-1.5 px-1 rounded-xl transition duration-150 active:scale-95 <%= (typeof activeTab !== 'undefined' && activeTab === 'orders') ? 'text-[#087A50]' : 'text-[#6B756F] hover:text-[#08110D]' %>"
       aria-label="Orders">
        <div class="relative">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= (typeof activeTab !== 'undefined' && activeTab === 'orders') ? '2.4' : '1.8' %>" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span id="mobileNavOrdersBadge" class="hidden absolute -top-1 -right-2 min-w-[16px] h-4 px-1 rounded-full bg-[#19D98B] text-[#08110D] text-[9px] font-extrabold flex items-center justify-center ring-2 ring-white font-mono"></span>
        </div>
        <span class="text-[11px] tracking-tight leading-tight <%= (typeof activeTab !== 'undefined' && activeTab === 'orders') ? 'font-bold text-[#08110D]' : 'font-medium' %>">Orders</span>
        <% if (typeof activeTab !== 'undefined' && activeTab === 'orders') { %>
            <span class="w-1.5 h-1.5 rounded-full bg-[#087A50] mt-0.5"></span>
        <% } %>
    </a>

    <!-- Destination 2: Products -->
    <a href="/merchant/items" 
       class="relative flex-1 flex flex-col items-center justify-center min-h-[52px] py-1.5 px-1 rounded-xl transition duration-150 active:scale-95 <%= (typeof activeTab !== 'undefined' && activeTab === 'products') ? 'text-[#087A50]' : 'text-[#6B756F] hover:text-[#08110D]' %>"
       aria-label="Products">
        <div class="relative">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= (typeof activeTab !== 'undefined' && activeTab === 'products') ? '2.4' : '1.8' %>" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
        </div>
        <span class="text-[11px] tracking-tight leading-tight <%= (typeof activeTab !== 'undefined' && activeTab === 'products') ? 'font-bold text-[#08110D]' : 'font-medium' %>">Products</span>
        <% if (typeof activeTab !== 'undefined' && activeTab === 'products') { %>
            <span class="w-1.5 h-1.5 rounded-full bg-[#087A50] mt-0.5"></span>
        <% } %>
    </a>

    <!-- Destination 3: Live Chat Inbox -->
    <a href="/merchant/messages" 
       class="relative flex-1 flex flex-col items-center justify-center min-h-[52px] py-1.5 px-1 rounded-xl transition duration-150 active:scale-95 <%= (typeof activeTab !== 'undefined' && activeTab === 'chat') ? 'text-[#087A50]' : 'text-[#6B756F] hover:text-[#08110D]' %>"
       aria-label="Chat">
        <div class="relative">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= (typeof activeTab !== 'undefined' && activeTab === 'chat') ? '2.4' : '1.8' %>" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            <span id="mobileNavChatBadge" class="hidden absolute -top-1 -right-2 min-w-[16px] h-4 px-1 rounded-full bg-[#19D98B] text-[#08110D] text-[9px] font-extrabold flex items-center justify-center ring-2 ring-white font-mono animate-pulse"></span>
        </div>
        <span class="text-[11px] tracking-tight leading-tight <%= (typeof activeTab !== 'undefined' && activeTab === 'chat') ? 'font-bold text-[#08110D]' : 'font-medium' %>">Chat</span>
        <% if (typeof activeTab !== 'undefined' && activeTab === 'chat') { %>
            <span class="w-1.5 h-1.5 rounded-full bg-[#087A50] mt-0.5"></span>
        <% } %>
    </a>

    <!-- Destination 4: Debt Tracker -->
    <a href="/merchant/debts" 
       class="relative flex-1 flex flex-col items-center justify-center min-h-[52px] py-1.5 px-1 rounded-xl transition duration-150 active:scale-95 <%= (typeof activeTab !== 'undefined' && activeTab === 'debts') ? 'text-[#087A50]' : 'text-[#6B756F] hover:text-[#08110D]' %>"
       aria-label="Debt">
        <div class="relative">
            <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= (typeof activeTab !== 'undefined' && activeTab === 'debts') ? '2.4' : '1.8' %>" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <span class="text-[11px] tracking-tight leading-tight <%= (typeof activeTab !== 'undefined' && activeTab === 'debts') ? 'font-bold text-[#08110D]' : 'font-medium' %>">Debt</span>
        <% if (typeof activeTab !== 'undefined' && activeTab === 'debts') { %>
            <span class="w-1.5 h-1.5 rounded-full bg-[#087A50] mt-0.5"></span>
        <% } %>
    </a>
</nav>

<!-- Automatic Inclusion of Secondary Navigation Drawer -->
<%- include('drawer_nav.ejs') %>
