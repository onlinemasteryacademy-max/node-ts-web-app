    async function confirmBulkStoreAction(operation, tier = null) {
      const selectedIds = getSelectedStoreIds();
      if (selectedIds.length === 0) {
        alert('Please select at least one store.');
        return;
      }

      let confirmMsg = '';
      if (operation === 'deactivate' || operation === 'suspend') {
        confirmMsg = `Are you sure you want to SUSPEND / DEACTIVATE ${selectedIds.length} selected store(s)? Their storefronts will be disabled immediately.`;
      } else if (operation === 'activate') {
        confirmMsg = `Activate ${selectedIds.length} selected store(s)?`;
      } else if (operation === 'verify') {
        confirmMsg = `Grant Verified Badges to ${selectedIds.length} selected store(s)?`;
      } else if (operation === 'unverify') {
        confirmMsg = `Revoke Verified Badges from ${selectedIds.length} selected store(s)?`;
      } else if (operation === 'change_tier') {
        confirmMsg = `Change plan tier of ${selectedIds.length} selected store(s) to '${(tier || '').toUpperCase()}'?`;
      } else if (operation === 'delete') {
        confirmMsg = `⚠️ CRITICAL: Are you sure you want to DELETE ${selectedIds.length} selected store(s)? This action will release their slugs and archive store data.`;
      }

      if (!confirm(confirmMsg)) return;

      try {
        const res = await fetch('/api/admin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'bulk_store_action',
            store_ids: selectedIds,
            operation,
            tier
          })
        });
        const data = await res.json();
        if (data.success) {
          alert(`✅ ${data.message || 'Bulk operation completed successfully.'}`);
          window.location.reload();
        } else {
          alert(`❌ Error: ${data.error || 'Failed to complete bulk action'}`);
        }
      } catch (err) {
        alert('Network error executing bulk action.');
      }
    }

    // ================= AFFILIATE PAYOUT ACTIONS =================
    function openApprovePayoutModal(id, amount, name, bank, accNum, accName) {
      document.getElementById('approvePayoutId').value = id;
      document.getElementById('approveModalAffiliateName').textContent = `Beneficiary: ${name}`;
      document.getElementById('approveModalAmount').textContent = `₦${Number(amount).toLocaleString()}`;
      document.getElementById('approveModalBank').textContent = bank;
      document.getElementById('approveModalAccountNum').textContent = accNum;
      document.getElementById('approveModalAccountName').textContent = accName;
      document.getElementById('approvePayoutTxRef').value = `TRF-${Date.now().toString().slice(-8)}`;
      document.getElementById('approvePayoutNotes').value = '';
      document.getElementById('approvePayoutModal').classList.remove('hidden');
    }

    function closeApprovePayoutModal() {
      document.getElementById('approvePayoutModal').classList.add('hidden');
    }

    async function submitApprovePayout() {
      const payoutId = document.getElementById('approvePayoutId').value;
      const txRef = document.getElementById('approvePayoutTxRef').value.trim();
      const notes = document.getElementById('approvePayoutNotes').value.trim();
      const btn = document.getElementById('confirmApproveBtn');

      btn.disabled = true;
      btn.innerText = 'Marking as Paid...';

      try {
        const res = await fetch('/api/admin/affiliates/payouts/approve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            payout_id: payoutId,
            transaction_reference: txRef,
            notes: notes
          })
        });
        const json = await res.json();
        if (json.success) {
          alert('✅ Payout marked as paid successfully!');
          window.location.reload();
        } else {
          alert('❌ ' + (json.error || 'Failed to approve payout'));
          btn.disabled = false;
          btn.innerText = 'Mark as Paid';
        }
      } catch (err) {
        alert('❌ Network error approving payout');
        btn.disabled = false;
        btn.innerText = 'Mark as Paid';
      }
    }

    function openRejectPayoutModal(id, amount, name) {
      document.getElementById('rejectPayoutId').value = id;
      document.getElementById('rejectModalAffiliateName').textContent = `Beneficiary: ${name}`;
      document.getElementById('rejectModalAmount').textContent = `₦${Number(amount).toLocaleString()}`;
      document.getElementById('rejectPayoutReason').value = '';
      document.getElementById('rejectPayoutModal').classList.remove('hidden');
    }

    function closeRejectPayoutModal() {
      document.getElementById('rejectPayoutModal').classList.add('hidden');
    }

    async function submitRejectPayout() {
      const payoutId = document.getElementById('rejectPayoutId').value;
      const reason = document.getElementById('rejectPayoutReason').value.trim();
      const btn = document.getElementById('confirmRejectBtn');

      if (!reason) {
        alert('Please provide a reason for rejection (this will be displayed to the affiliate partner).');
        return;
      }

      btn.disabled = true;
      btn.innerText = 'Rejecting & Refunding...';

      try {
        const res = await fetch('/api/admin/affiliates/payouts/reject', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            payout_id: payoutId,
            reason: reason
          })
        });
        const json = await res.json();
        if (json.success) {
          alert('✅ Payout request rejected and amount refunded back to affiliate wallet.');
          window.location.reload();
        } else {
          alert('❌ ' + (json.error || 'Failed to reject payout'));
          btn.disabled = false;
          btn.innerText = 'Reject & Refund';
        }
      } catch (err) {
        alert('❌ Network error rejecting payout');
        btn.disabled = false;
        btn.innerText = 'Reject & Refund';
      }
    }

    function showAffiliateReferralsModal(affName, referrals) {
      document.getElementById('affRefModalTitle').textContent = `${affName}'s Referred Stores (${referrals.length})`;
      const body = document.getElementById('affRefModalBody');
      body.innerHTML = '';

      if (!referrals || referrals.length === 0) {
        body.innerHTML = '<div class="p-6 text-center text-white/40">This affiliate partner has not referred any stores yet.</div>';
      } else {
        referrals.forEach(ref => {
          const nowMs = Date.now();
          const expiryMs = new Date(ref.commission_expires_at).getTime();
          const diffDays = Math.max(0, Math.ceil((expiryMs - nowMs) / (1000 * 60 * 60 * 24)));
          const isExpired = diffDays <= 0 || ref.status === 'expired';

          const card = document.createElement('div');
          card.className = 'p-3.5 bg-white/5 border border-white/10 rounded-xl space-y-2';
          card.innerHTML = `
            <div class="flex items-start justify-between">
              <div>
                <div class="font-bold text-white text-sm">${ref.store_name}</div>
                <div class="text-[11px] text-white/50 font-mono">zlik.store/${ref.store_slug}</div>
              </div>
              <div class="text-right">
                ${isExpired ? `
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-white/10 text-white/50">12 Mo. Expired</span>
                ` : `
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#19D98B]/20 text-[#19D98B] border border-[#19D98B]/30">
                    Active &bull; ${diffDays} days left
                  </span>
                `}
              </div>
            </div>
            <div class="grid grid-cols-2 gap-2 text-[11px] text-white/70 pt-1 border-t border-white/5">
              <div>Merchant: <strong class="text-white">${ref.owner_name}</strong></div>
              <div class="text-right">Commissions: <strong class="text-[#19D98B] font-mono">₦${Number(ref.total_commissions_generated || 0).toLocaleString()}</strong></div>
            </div>
            <div class="text-[10px] text-white/40 font-mono">Signed up: ${new Date(ref.created_at).toLocaleDateString()} &bull; Expires: ${new Date(ref.commission_expires_at).toLocaleDateString()}</div>
          `;
          body.appendChild(card);
        });
      }

      document.getElementById('affiliateReferralsModal').classList.remove('hidden');
    }

    function closeAffiliateReferralsModal() {
      document.getElementById('affiliateReferralsModal').classList.add('hidden');
    }

    function openAddAffiliateModal() {
      document.getElementById('addAffName').value = '';
      document.getElementById('addAffEmail').value = '';
      document.getElementById('addAffPhone').value = '';
      document.getElementById('addAffPassword').value = '';
      document.getElementById('addAffTier').value = 'pro';
      document.getElementById('customRateGroup').classList.add('hidden');
      document.getElementById('addAffCustomRate').value = '';
      document.getElementById('addAffiliateModal').classList.remove('hidden');
    }

    function closeAddAffiliateModal() {
      document.getElementById('addAffiliateModal').classList.add('hidden');
    }

    function onAffTierChange(tier) {
      const customGroup = document.getElementById('customRateGroup');
      if (tier === 'custom') {
        customGroup.classList.remove('hidden');
      } else {
        customGroup.classList.add('hidden');
      }
    }

    async function submitAddAffiliate() {
      const full_name = document.getElementById('addAffName').value.trim();
      const email = document.getElementById('addAffEmail').value.trim();
      const phone = document.getElementById('addAffPhone').value.trim();
      const password = document.getElementById('addAffPassword').value.trim();
      const tierVal = document.getElementById('addAffTier').value;
      const btn = document.getElementById('submitAddAffBtn');

      if (!full_name || !email) {
        alert('Please provide at least a Full Name and Email Address');
        return;
      }

      let tier = 'pro';
      let commission_rate = 0.70;

      if (tierVal === 'standard') {
        tier = 'standard';
        commission_rate = 0.30;
      } else if (tierVal === 'custom') {
        tier = 'pro';
        const customPct = parseFloat(document.getElementById('addAffCustomRate').value);
        if (isNaN(customPct) || customPct <= 0 || customPct > 100) {
          alert('Please enter a valid custom commission rate percentage between 1 and 100');
          return;
        }
        commission_rate = customPct / 100;
      }

      btn.disabled = true;
      btn.innerText = 'Creating & Sending Email...';

      try {
        const res = await fetch('/api/admin/affiliates/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            full_name,
            email,
            phone,
            password: password || undefined,
            tier,
            commission_rate
          })
        });
        const json = await res.json();
        if (json.success) {
          alert(`✅ Affiliate "${full_name}" created successfully!\nAn onboarding email has been sent to ${email} with their credentials and referral link.`);
          window.location.reload();
        } else {
          alert('❌ ' + (json.error || 'Failed to create affiliate'));
          btn.disabled = false;
          btn.innerText = 'Create & Email Affiliate';
        }
      } catch (err) {
        alert('❌ Network error creating affiliate');
        btn.disabled = false;
        btn.innerText = 'Create & Email Affiliate';
      }
    }

    function openBulkAffiliateModal() {
      document.getElementById('bulkAffTier').value = 'pro';
      document.getElementById('bulkAffRate').value = '70';
      document.getElementById('bulkAffCsvText').value = '';
      document.getElementById('bulkAffFile').value = '';
      const prog = document.getElementById('bulkAffProgress');
      prog.innerHTML = '';
      prog.classList.add('hidden');
      document.getElementById('bulkAffiliateModal').classList.remove('hidden');
    }

    function closeBulkAffiliateModal() {
      document.getElementById('bulkAffiliateModal').classList.add('hidden');
    }

    function onBulkTierChange(tier) {
      if (tier === 'pro') {
        document.getElementById('bulkAffRate').value = '70';
      } else {
        document.getElementById('bulkAffRate').value = '30';
      }
    }

    function handleCsvFileSelected(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('bulkAffCsvText').value = e.target.result;
      };
      reader.readAsText(file);
    }

    function downloadSampleCsv() {
      const csvContent = "full_name,email,phone,commission_rate\nJohn Doe,john@example.com,08012345678,0.70\nJane Smith,jane@example.com,08098765432,0.70\nMastery Marketer,partner@omastery.com,08123456789,0.70\n";
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', 'sample_affiliates_template.csv');
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    async function submitBulkAffiliates() {
      const csv = document.getElementById('bulkAffCsvText').value.trim();
      const tier = document.getElementById('bulkAffTier').value;
      const rateVal = parseFloat(document.getElementById('bulkAffRate').value) || (tier === 'pro' ? 70 : 30);
      const btn = document.getElementById('submitBulkAffBtn');
      const progressBox = document.getElementById('bulkAffProgress');

      if (!csv) {
        alert('Please choose a CSV file or paste CSV content.');
        return;
      }

      btn.disabled = true;
      btn.innerText = 'Uploading & Sending Emails...';
      progressBox.classList.remove('hidden');
      progressBox.innerHTML = '<div class="text-amber-300">⏳ Processing CSV, creating affiliate accounts, and dispatching welcome emails...</div>';

      try {
        const res = await fetch('/api/admin/affiliates/bulk-upload', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            csv_content: csv,
            tier: tier,
            commission_rate: rateVal / 100
          })
        });
        const json = await res.json();
        if (json.success) {
          let errHtml = '';
          if (json.errors && json.errors.length > 0) {
            errHtml = `<div class="text-red-400 mt-2 font-semibold">Skipped / Errors (${json.errors.length}):</div><ul class="list-disc pl-4 text-white/60 space-y-0.5">${json.errors.slice(0, 5).map(e => `<li>${e}</li>`).join('')}${json.errors.length > 5 ? `<li>...and ${json.errors.length - 5} more</li>` : ''}</ul>`;
          }
          progressBox.innerHTML = `
            <div class="text-emerald-400 font-bold">✅ Successfully registered ${json.createdCount} affiliate(s)!</div>
            <div class="text-white/70">All created affiliates have been assigned ${tier.toUpperCase()} tier (${rateVal}%) and sent welcome emails.</div>
            ${errHtml}
          `;
          btn.innerText = 'Completed!';
          setTimeout(() => {
            window.location.reload();
          }, 2500);
        } else {
          progressBox.innerHTML = `<div class="text-red-400 font-bold">❌ Error: ${json.error || 'Failed to process bulk upload'}</div>`;
          btn.disabled = false;
          btn.innerText = 'Upload & Send Emails';
        }
      } catch (err) {
        progressBox.innerHTML = `<div class="text-red-400 font-bold">❌ Network error during bulk upload</div>`;
        btn.disabled = false;
        btn.innerText = 'Upload & Send Emails';
      }
    }
  </script>
</body>
</html>
