<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verified Merchant Marketplace - Discover Independent Brands | zlik</title>
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            zlikDark: '#08110D',
            zlikGreen: '#19D98B',
            zlikDeepGreen: '#087A50',
            zlikBg: '#F8FAF8',
            zlikWhite: '#FFFFFF',
            zlikSecondary: '#6B756F',
            zlikBorder: '#E3E9E5'
          },
          fontFamily: {
            display: ['Montserrat', 'sans-serif'],
            body: ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #F8FAF8; color: #08110D; }
    .font-display { font-family: 'Montserrat', sans-serif; }
  </style>
</head>
<body class="bg-[#F8FAF8] text-[#08110D] antialiased min-h-screen flex flex-col justify-between">

  <!-- Header Navigation -->
  <header class="border-b border-[#E3E9E5] bg-[#F8FAF8]/95 backdrop-blur-md sticky top-0 z-40 transition-colors">
    <div class="max-w-[1240px] mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="hover:opacity-90 transition inline-flex items-center gap-1">
        <span class="inline-flex items-center font-display font-semibold text-2xl sm:text-[26px] tracking-[-0.03em] select-none leading-none text-[#08110D]">
          zlik
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-[#6B756F]">
        <a href="/#features" class="transition-colors hover:text-[#08110D]">Features</a>
        <a href="/#how-it-works" class="transition-colors hover:text-[#08110D]">How it works</a>
        <a href="/#pricing" class="transition-colors hover:text-[#08110D]">Pricing</a>
        <a href="/marketplace" class="text-[#08110D] font-semibold flex items-center gap-2">
          <span>Stores</span>
        </a>
      </nav>

      <div class="flex items-center gap-3 sm:gap-4">
        <a href="/merchant/login" class="text-sm font-semibold text-[#08110D] hover:opacity-75 transition-opacity px-3 py-2">
          Sign in
        </a>
        <a href="/#pricing" class="bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] text-sm font-semibold font-display px-5 py-2.5 rounded-lg transition-all shadow-xs">
          Create store
        </a>
      </div>
    </div>
  </header>

  <!-- Main Marketplace Content -->
  <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 w-full space-y-8">
    <!-- Marketplace Hero Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 bg-white text-[#087A50] text-xs font-semibold px-3.5 py-1.5 rounded-full border border-[#E3E9E5] shadow-xs">
        <span>🇳🇬</span>
        <span>Verified Independent Merchants</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#08110D] leading-tight font-display">
        Discover Verified Brands Across Nigeria
      </h1>
      <p class="font-body text-xs sm:text-sm text-[#6B756F] max-w-2xl mx-auto">
        Explore curated boutique sellers, food vendors, gadgets, fashion, and lifestyle creators. Order direct with guaranteed verified payment or chat instantly on WhatsApp.
      </p>
    </div>

    <!-- Interactive Category Filter Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap">
      <button type="button" onclick="selectCategory('all')" data-cat-pill="all" class="cat-pill active flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all duration-150 bg-[#08110D] text-white shadow-xs">
        <span>✨</span>
        <span>All Categories</span>
      </button>
      <button type="button" onclick="selectCategory('fashion')" data-cat-pill="fashion" class="cat-pill flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-all duration-150 bg-white text-[#6B756F] border border-[#E3E9E5] hover:border-gray-300 hover:text-[#08110D]">
        <span>👗</span>
        <span>Fashion & Apparel</span>
      </button>
      <button type="button" onclick="selectCategory('food')" data-cat-pill="food" class="cat-pill flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-all duration-150 bg-white text-[#6B756F] border border-[#E3E9E5] hover:border-gray-300 hover:text-[#08110D]">
        <span>🍔</span>
        <span>Food & Groceries</span>
      </button>
      <button type="button" onclick="selectCategory('beauty')" data-cat-pill="beauty" class="cat-pill flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-all duration-150 bg-white text-[#6B756F] border border-[#E3E9E5] hover:border-gray-300 hover:text-[#08110D]">
        <span>💄</span>
        <span>Beauty & Cosmetics</span>
      </button>
      <button type="button" onclick="selectCategory('electronics')" data-cat-pill="electronics" class="cat-pill flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-all duration-150 bg-white text-[#6B756F] border border-[#E3E9E5] hover:border-gray-300 hover:text-[#08110D]">
        <span>⚡</span>
        <span>Electronics & Tech</span>
      </button>
      <button type="button" onclick="selectCategory('home')" data-cat-pill="home" class="cat-pill flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-all duration-150 bg-white text-[#6B756F] border border-[#E3E9E5] hover:border-gray-300 hover:text-[#08110D]">
        <span>🛋️</span>
        <span>Home & Living</span>
      </button>
      <button type="button" onclick="selectCategory('services')" data-cat-pill="services" class="cat-pill flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-all duration-150 bg-white text-[#6B756F] border border-[#E3E9E5] hover:border-gray-300 hover:text-[#08110D]">
        <span>💼</span>
        <span>Services & Bookings</span>
      </button>
      <button type="button" onclick="selectCategory('digital')" data-cat-pill="digital" class="cat-pill flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-all duration-150 bg-white text-[#6B756F] border border-[#E3E9E5] hover:border-gray-300 hover:text-[#08110D]">
        <span>📱</span>
        <span>Digital & Creative</span>
      </button>
      <button type="button" onclick="selectCategory('general')" data-cat-pill="general" class="cat-pill flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-all duration-150 bg-white text-[#6B756F] border border-[#E3E9E5] hover:border-gray-300 hover:text-[#08110D]">
        <span>🛒</span>
        <span>General Retail</span>
      </button>
    </div>

    <!-- Search & Filter Station -->
    <div class="bg-white rounded-2xl border border-[#E3E9E5] p-4 sm:p-6 shadow-xs space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
        <!-- Search Input (6 cols) -->
        <div class="md:col-span-6 relative">
          <span class="absolute left-3.5 top-3 text-sm text-[#6B756F]">🔍</span>
          <input type="text" id="marketplaceSearch" oninput="sortAndFilterStores()" placeholder="Search stores, brands, categories, cities or products..." class="w-full pl-10 pr-4 py-2.5 bg-[#F8FAF8] rounded-lg border border-[#E3E9E5] text-xs sm:text-sm outline-none focus:border-[#19D98B] transition font-body">
        </div>
        
        <!-- State Selector (3 cols) -->
        <div class="md:col-span-3">
          <select id="stateSelect" onchange="sortAndFilterStores()" class="w-full px-3.5 py-2.5 bg-white rounded-lg border border-[#E3E9E5] text-xs sm:text-sm outline-none focus:border-[#19D98B] font-medium text-[#08110D]">
            <option value="">📍 All 36 States + FCT</option>
            <% (states || []).forEach(st => { %>
              <option value="<%= st %>">📍 <%= st %></option>
            <% }); %>
          </select>
        </div>

        <!-- Sort By Selector (3 cols) -->
        <div class="md:col-span-3">
          <select id="sortSelect" onchange="sortAndFilterStores()" class="w-full px-3.5 py-2.5 bg-white rounded-lg border border-[#E3E9E5] text-xs sm:text-sm outline-none focus:border-[#19D98B] font-medium text-[#08110D]">
            <option value="featured">✨ Sort: Featured & Verified</option>
            <option value="category">🏷️ Sort: Category (A - Z)</option>
            <option value="name-asc">🔤 Sort: Store Name (A - Z)</option>
            <option value="name-desc">🔤 Sort: Store Name (Z - A)</option>
          </select>
        </div>
      </div>

      <!-- Active Results Counter & Filter Tags -->
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs pt-3 border-t border-[#E3E9E5] text-[#6B756F]">
        <div class="flex items-center gap-2">
          <span>Showing <strong class="text-[#08110D] font-display font-semibold" id="resultsCount"><%= stores.length %></strong> verified merchants</span>
          <span id="activeCategoryTag" class="hidden text-[11px] font-medium px-2.5 py-0.5 rounded-md bg-[#F8FAF8] border border-[#E3E9E5] text-[#08110D]"></span>
        </div>
        <button type="button" id="resetBtn" onclick="resetFilters()" class="text-xs font-semibold text-[#087A50] hover:underline cursor-pointer hidden">
          Reset all filters
        </button>
      </div>
    </div>

    <!-- Store Showcase Grid -->
    <div id="storesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% stores.forEach(store => { %>
        <div class="store-card bg-white rounded-2xl border border-[#E3E9E5] hover:border-gray-300 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition duration-200" 
             data-category="<%= store.category_info ? store.category_info.id : 'general' %>"
             data-category-name="<%= (store.category_info ? store.category_info.name : 'General Retail').toLowerCase() %>"
             data-name="<%= (store.store_name || '').toLowerCase() %>"
             data-state="<%= (store.state || '').toLowerCase() %>"
             data-verified="<%= (store.plan_tier === 'pro' || store.plan_tier === 'business' || store.is_verified) ? '1' : '0' %>"
             data-search="<%= ((store.store_name || '') + ' ' + (store.bio || '') + ' ' + (store.city || '') + ' ' + (store.state || '') + ' ' + (store.category_info ? store.category_info.name : '')).toLowerCase() %>">
          <div class="space-y-3.5">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <% if (store.logo_url) { %>
                  <img src="<%= store.logo_url %>" alt="<%= store.store_name %>" class="w-12 h-12 rounded-xl object-cover border border-[#E3E9E5] bg-white shrink-0" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                  <div class="w-12 h-12 rounded-xl bg-[#08110D] text-white hidden items-center justify-center font-display font-bold text-lg shrink-0">
                    <%= store.store_name.charAt(0).toUpperCase() %>
                  </div>
                <% } else { %>
                  <div class="w-12 h-12 rounded-xl bg-[#08110D] text-white flex items-center justify-center font-display font-bold text-lg shrink-0">
                    <%= store.store_name.charAt(0).toUpperCase() %>
                  </div>
                <% } %>
                <div>
                  <h3 class="font-bold font-display text-[#08110D] text-base leading-snug"><%= store.store_name %></h3>
                  <p class="text-xs text-[#6B756F]">📍 <%= store.city ? `${store.city}, ` : '' %><%= store.state || 'Nigeria' %></p>
                </div>
              </div>
              <% if (store.plan_tier === 'pro' || store.plan_tier === 'business' || store.is_verified) { %>
                <span class="text-[10px] uppercase font-bold bg-[#19D98B]/20 text-[#087A50] px-2 py-0.5 rounded-full shrink-0">
                  Verified
                </span>
              <% } %>
            </div>

            <!-- Category Badge -->
            <% if (store.category_info) { %>
              <div class="pt-0.5">
                <span class="inline-flex items-center gap-1.5 text-[11px] font-medium px-2.5 py-1 rounded-md" style="background-color: <%= store.category_info.accent_bg %>; color: <%= store.category_info.accent_color %>;">
                  <span><%= store.category_info.icon %></span>
                  <span><%= store.category_info.name %></span>
                </span>
              </div>
            <% } %>

            <p class="text-xs text-[#6B756F] line-clamp-2 leading-relaxed font-normal">
              <%= store.bio || 'Premium products & fast fulfillment. Order online with direct payment verification.' %>
            </p>
          </div>

          <div class="pt-5 border-t border-[#E3E9E5] mt-4 flex items-center justify-between gap-3">
            <a href="https://wa.me/<%= store.whatsapp_number ? store.whatsapp_number.replace(/[^0-9]/g, '') : '' %>" target="_blank" class="text-xs font-semibold text-[#087A50] hover:underline flex items-center gap-1">
              <span>💬 WhatsApp</span>
            </a>
            <a href="/<%= store.slug %>" class="bg-[#08110D] hover:bg-[#19D98B] text-white hover:text-[#08110D] text-xs font-semibold font-display px-4 py-2 rounded-lg transition">
              Visit Store &rarr;
            </a>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Empty State Container -->
    <div id="emptyState" class="hidden text-center py-16 bg-white border border-[#E3E9E5] rounded-2xl p-8">
      <div class="text-4xl mb-3">📍</div>
      <h3 class="text-lg font-bold text-[#08110D] mb-1 font-display">No Verified Stores Found</h3>
      <p class="font-body text-xs text-[#6B756F] max-w-sm mx-auto mb-4">No merchants match your selected category or filters. Try choosing another category or resetting filters.</p>
      <button onclick="resetFilters()" class="bg-[#08110D] text-white text-xs font-semibold px-5 py-2.5 rounded-lg transition shadow-xs hover:bg-[#19D98B] hover:text-[#08110D]">
        Reset All Filters
      </button>
    </div>
  </main>

  <!-- Uniform Public Site Footer -->
  <footer class="bg-[#08110D] text-white border-t border-[#08110D] relative overflow-hidden font-body mt-16">
    <div class="max-w-[1240px] mx-auto px-6 py-12">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#E3E9E5]/50">
        <div>
          <span>&copy; <%= new Date().getFullYear() %> zlik. All rights reserved.</span>
        </div>
        <div class="flex items-center gap-6">
          <a href="/terms" class="hover:text-white transition underline-offset-4 hover:underline">Terms of Service</a>
          <span>&bull;</span>
          <a href="/privacy" class="hover:text-white transition underline-offset-4 hover:underline">Privacy Policy</a>
          <span>&bull;</span>
          <span>zlik.store</span>
        </div>
      </div>
    </div>
  </footer>

  <script>
    let currentCategory = 'all';

    function selectCategory(catId) {
      currentCategory = catId;
      
      // Update category pill styles
      document.querySelectorAll('.cat-pill').forEach(pill => {
        const pillCat = pill.getAttribute('data-cat-pill');
        if (pillCat === catId) {
          pill.className = 'cat-pill active flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all duration-150 bg-[#08110D] text-white shadow-xs';
        } else {
          pill.className = 'cat-pill flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-medium whitespace-nowrap transition-all duration-150 bg-white text-[#6B756F] border border-[#E3E9E5] hover:border-gray-300 hover:text-[#08110D]';
        }
      });

      sortAndFilterStores();
    }

    function sortAndFilterStores() {
      const q = (document.getElementById('marketplaceSearch')?.value || '').trim().toLowerCase();
      const state = (document.getElementById('stateSelect')?.value || '').trim().toLowerCase();
      const sortBy = document.getElementById('sortSelect')?.value || 'featured';
      const grid = document.getElementById('storesGrid');
      const cards = Array.from(document.querySelectorAll('.store-card'));
      
      let visibleCount = 0;
      const isFiltered = Boolean(q || state || currentCategory !== 'all');

      // Filter
      cards.forEach(card => {
        const searchData = card.getAttribute('data-search') || '';
        const stateData = card.getAttribute('data-state') || '';
        const cardCat = card.getAttribute('data-category') || 'general';

        const matchesQuery = !q || searchData.includes(q);
        const matchesState = !state || 
          stateData.includes(state) || 
          (stateData && state.includes(stateData)) ||
          (state.includes('abuja') && (stateData.includes('abuja') || stateData.includes('fct'))) ||
          (state.includes('fct') && (stateData.includes('abuja') || stateData.includes('fct')));
        const matchesCategory = currentCategory === 'all' || cardCat === currentCategory;

        if (matchesQuery && matchesState && matchesCategory) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Sort cards in DOM
      cards.sort((a, b) => {
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';
        const catA = a.getAttribute('data-category-name') || '';
        const catB = b.getAttribute('data-category-name') || '';
        const verA = Number(a.getAttribute('data-verified') || 0);
        const verB = Number(b.getAttribute('data-verified') || 0);

        if (sortBy === 'category') {
          if (catA !== catB) return catA.localeCompare(catB);
          return nameA.localeCompare(nameB);
        } else if (sortBy === 'name-asc') {
          return nameA.localeCompare(nameB);
        } else if (sortBy === 'name-desc') {
          return nameB.localeCompare(nameA);
        } else {
          // featured
          if (verB !== verA) return verB - verA;
          return nameA.localeCompare(nameB);
        }
      });

      // Re-append sorted cards to grid
      cards.forEach(card => grid.appendChild(card));

      // Update counts and active filters UI
      document.getElementById('resultsCount').textContent = visibleCount;
      const emptyEl = document.getElementById('emptyState');
      if (visibleCount === 0) {
        emptyEl.classList.remove('hidden');
      } else {
        emptyEl.classList.add('hidden');
      }

      const resetBtn = document.getElementById('resetBtn');
      if (resetBtn) {
        if (isFiltered) resetBtn.classList.remove('hidden');
        else resetBtn.classList.add('hidden');
      }

      const activeTag = document.getElementById('activeCategoryTag');
      if (activeTag) {
        if (currentCategory !== 'all') {
          const activePill = document.querySelector(`.cat-pill[data-cat-pill="${currentCategory}"]`);
          activeTag.textContent = `Category: ${activePill ? activePill.textContent.trim() : currentCategory}`;
          activeTag.classList.remove('hidden');
        } else {
          activeTag.classList.add('hidden');
        }
      }
    }

    function resetFilters() {
      const searchInput = document.getElementById('marketplaceSearch');
      const stateSelect = document.getElementById('stateSelect');
      const sortSelect = document.getElementById('sortSelect');
      if (searchInput) searchInput.value = '';
      if (stateSelect) stateSelect.value = '';
      if (sortSelect) sortSelect.value = 'featured';
      selectCategory('all');
    }
  </script>
</body>
</html>
