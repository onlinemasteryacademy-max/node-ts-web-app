                    <% if (store.plan_tier !== 'business') { %>
                        <div class="absolute inset-0 bg-white/40 backdrop-blur-[2px] rounded-2xl flex items-center justify-center p-4 z-10">
                            <button type="button" onclick="openBusinessUpgradeModal('Physical Store Branches')" class="inline-flex items-center gap-1.5 bg-[#084C38] hover:bg-[#063b2c] text-white px-3.5 py-1.5 rounded-xl text-[10.5px] font-semibold font-display shadow-xs hover:scale-105 transition-all">
                                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                <span>Upgrade to Business</span>
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Custom Domain Mapping (Business Feature) -->
            <div class="bg-white rounded-3xl border border-[#EAEFEB] p-5 sm:p-6 shadow-xs space-y-4 text-xs">
                <div class="flex items-center justify-between border-b border-[#EAEFEB] pb-3">
                    <div>
                        <h3 class="font-bold text-sm text-[#111827]">Custom Domain Mapping</h3>
                        <p class="text-[11px] text-[#6B7280] mt-0.5">Connect your own web domain (e.g. shop.yourbrand.com).</p>
                    </div>
                </div>

                <div class="relative rounded-2xl overflow-hidden">
                    <div class="space-y-3 <%= store.plan_tier === 'business' ? '' : 'blur-[1px] opacity-60 pointer-events-none select-none' %>">
                        <div>
                            <label class="block font-medium text-[#111827] mb-1">Your Custom Domain</label>
                            <div class="flex items-center gap-2">
                                <input type="text" id="customDomainInput" value="<%= store.custom_domain || '' %>" placeholder="shop.yourbrand.com" class="flex-1 bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] font-mono text-xs">
                                <button type="button" onclick="saveCustomDomain()" class="bg-[#084C38] hover:bg-[#063b2c] text-white font-semibold text-xs px-4 py-3 rounded-2xl transition shadow-xs">
                                    Connect Domain
                                </button>
                            </div>
                        </div>
                        <div id="domainStatusBox" class="p-3 bg-[#F8FAF9] rounded-xl border border-[#EAEFEB] text-[11px] text-[#6B7280]">
                            DNS Target: Point your CNAME record to <code class="font-mono font-bold text-[#111827]">cname.zlik.me</code>
                        </div>
                    </div>

                    <% if (store.plan_tier !== 'business') { %>
                        <div class="absolute inset-0 bg-white/40 backdrop-blur-[2px] rounded-2xl flex items-center justify-center p-4 z-10">
                            <button type="button" onclick="openBusinessUpgradeModal('Custom Domain Mapping')" class="inline-flex items-center gap-1.5 bg-[#084C38] hover:bg-[#063b2c] text-white px-3.5 py-1.5 rounded-xl text-[10.5px] font-semibold font-display shadow-xs hover:scale-105 transition-all">
                                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                <span>Upgrade to Business</span>
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>

            <button type="submit" id="saveBtn" class="w-full bg-[#084C38] hover:bg-[#063b2c] text-white font-bold text-sm py-3.5 rounded-2xl transition shadow-xs flex items-center justify-center gap-2">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Save Settings</span>
            </button>
        </form>

        <!-- Logout Action & Version Footer (Matching Screenshot 4) -->
        <div class="pt-2 pb-6 space-y-4">
            <a href="/logout" class="w-full border border-red-200 text-red-600 bg-white hover:bg-red-50 py-3.5 rounded-2xl flex items-center justify-center gap-2 font-medium text-sm transition shadow-2xs">
                <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                <span>Logout</span>
            </a>
            <div class="text-xs text-[#9CA3AF] text-center font-medium">v2.2.0 (Zlik Console)</div>
        </div>
    </main>

    <!-- Bank Account Security Authorization OTP Modal -->
    <div id="bankOtpModal" class="fixed inset-0 z-50 bg-[#08110D]/75 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 sm:p-7 space-y-5 border border-[#E3E9E5] shadow-2xl text-center font-body relative">
            <button type="button" onclick="closeBankOtpModal()" class="absolute top-4 right-4 text-[#6B756F] hover:text-[#08110D] font-bold text-lg w-8 h-8 rounded-full flex items-center justify-center hover:bg-[#F8FAF8] transition">✕</button>

            <!-- Modal Header Icon -->
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 border border-amber-200 flex items-center justify-center mx-auto shadow-2xs">
                <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>

            <div class="space-y-1.5">
                <h3 class="text-lg font-bold text-[#08110D] font-display">Authorize Bank Account Change</h3>
                <p class="text-xs text-[#6B756F] leading-relaxed">
                    For your store security, a 6-digit verification code has been sent to <strong id="bankOtpMaskedEmail" class="text-[#08110D] font-mono">your email</strong>.
                </p>
            </div>

            <!-- OTP Form -->
            <form id="bankOtpForm" onsubmit="handleVerifyAndSaveBankOtp(event)" class="space-y-4 text-left">
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-bold text-[#111827]">Enter 6-Digit Authorization Code</label>
                        <div id="bankOtpTimerBadge" class="inline-flex items-center gap-1.5 text-[11px] font-mono font-bold text-[#084C38]">
                            <svg class="w-3.5 h-3.5 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span id="bankOtpCountdownText">05:00</span>
                        </div>
                    </div>
                    <input type="text" id="bankOtpInput" maxlength="6" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" required placeholder="••••••" class="w-full text-center text-2xl font-bold tracking-[0.3em] font-mono border-2 border-[#084C38] rounded-2xl py-3 bg-[#F8FAF9] outline-none focus:bg-white focus:border-[#084C38] transition">
                </div>

                <div class="flex items-center justify-between text-[11px] pt-1">
                    <span class="text-[#6B7280]">Didn't receive code?</span>
                    <button type="button" id="resendBankOtpBtn" onclick="requestBankOtp(true)" class="font-bold text-[#084C38] hover:underline disabled:opacity-50 disabled:cursor-not-allowed">
                        Resend Code
                    </button>
                </div>

                <div class="flex items-center gap-2 pt-2 border-t border-[#EAEFEB]">
                    <button type="button" onclick="closeBankOtpModal()" class="w-1/3 bg-[#F8FAF9] hover:bg-[#EDF5F1] text-[#111827] font-medium text-xs py-3 rounded-2xl border border-[#EAEFEB] transition">
                        Cancel
                    </button>
                    <button type="submit" id="verifyBankOtpSubmitBtn" class="w-2/3 bg-[#084C38] hover:bg-[#063b2c] text-white font-bold text-xs py-3 rounded-2xl transition shadow-xs font-display flex items-center justify-center gap-1.5">
                        <span>Approve & Save</span>
                        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%- include('components/upgrade_modal.ejs') %>

    <!-- Template Details & Preview Modal -->
    <div id="templatePreviewModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-xl w-full p-6 space-y-4 border border-[#EAEFEB] shadow-2xl max-h-[90vh] overflow-y-auto text-xs">
            <div class="flex items-center justify-between pb-3 border-b border-[#EAEFEB]">
                <div>
                    <div class="flex items-center gap-2">
                        <h3 id="tplModalName" class="font-bold text-sm text-[#111827]">Template Name</h3>
                        <span id="tplModalTierBadge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-100 text-[#111827]">FREE</span>
                    </div>
                    <span id="tplModalCategory" class="text-[11px] text-[#6B7280]">Category</span>
                </div>
                <button type="button" onclick="closeTemplatePreviewModal()" class="text-[#6B7280] font-bold text-sm hover:text-black">✕</button>
            </div>

            <!-- Front View Cover Screenshot -->
            <div class="w-full rounded-2xl overflow-hidden border border-[#EAEFEB] bg-[#084C38]">
                <img id="tplModalCover" src="/assets/images/templates/general_clean.png" onerror="this.onerror=null; this.src='/assets/images/templates/general_clean.svg';" alt="Template Preview" class="w-full h-auto object-cover">
            </div>

            <div class="space-y-3">
                <div class="bg-[#F8FAF9] p-3.5 rounded-2xl border border-[#EAEFEB]">
                    <h4 class="text-[10px] font-bold uppercase tracking-wider text-[#6B7280] mb-1">Description</h4>
                    <p id="tplModalDesc" class="text-xs text-[#111827] leading-relaxed"></p>
                </div>

                <div class="space-y-1.5">
                    <h4 class="text-[10px] font-bold uppercase tracking-wider text-[#6B7280]">Key Capabilities</h4>
                    <ul id="tplModalFeatures" class="space-y-1 text-xs text-[#111827]"></ul>
                </div>

                <!-- Direct Live Demo Button -->
                <a id="tplModalDemoLink" href="/demo/general_clean" target="_blank" class="w-full bg-[#EDF5F1] hover:bg-[#EDF5F1]/80 text-[#084C38] font-bold text-xs py-2.5 rounded-xl border border-[#084C38]/20 transition flex items-center justify-center gap-1.5">
                    <span>Live Interactive Demo ↗</span>
                </a>
            </div>

            <div class="flex items-center gap-2 pt-2 border-t border-[#EAEFEB]">
                <button type="button" onclick="closeTemplatePreviewModal()" class="w-1/2 bg-[#F8FAF9] hover:bg-[#EDF5F1] text-[#111827] font-medium text-xs py-3 rounded-2xl border border-[#EAEFEB] transition">
                    Close
                </button>
                <button type="button" id="tplModalApplyBtn" onclick="applyFromPreview()" class="w-1/2 bg-[#084C38] hover:bg-[#063b2c] text-white font-bold text-xs py-3 rounded-2xl transition shadow-xs">
                    Select This Template
                </button>
            </div>
        </div>
    </div>

    <script>
        const storeSlug = '<%= store.slug %>';
        const isMerchantPro = <%= Boolean(isPro) %>;
        const allTemplatesData = <%- JSON.stringify(allTemplates || {}) %>;
        const storeCategoriesData = <%- JSON.stringify(storeCategories || {}) %>;
        let selectedTemplateId = '<%= store.template_slug || "general_clean" %>';
        let currentCategoryId = '<%= (templateConfig && templateConfig.category_id) || "general" %>';
        let previewingTplId = null;
        let settingsQr = null;

        function shareStoreProfile() {
            const fullUrl = 'https://zlik.store/' + storeSlug;
            if (navigator.share) {
                navigator.share({
                    title: '<%= store.store_name %>',
                    text: 'Order directly from our official store: ' + fullUrl,
                    url: fullUrl
                }).catch(() => {});
            } else {
                copySettingsStoreUrl();
            }
        }

        function handleCategorySelect(catId) {
            if (!storeCategoriesData[catId]) catId = 'general';
            currentCategoryId = catId;

            const catSelect = document.getElementById('categorySelect');
            if (catSelect && catSelect.value !== catId) {
                catSelect.value = catId;
            }

            renderTemplatesForCategory(catId);
        }

        function renderTemplatesForCategory(catId) {
            const container = document.getElementById('templatesGrid');
            if (!container) return;

            const categoryTemplates = Object.values(allTemplatesData).filter(t => t.category_id === catId);
            if (categoryTemplates.length === 0) {
                container.innerHTML = '<div class="col-span-3 text-center py-6 text-[#6B7280]">No templates found for this category.</div>';
                return;
            }

            container.innerHTML = categoryTemplates.map(tpl => {
                const isSelected = selectedTemplateId === tpl.id;
                const isProTemplate = Boolean(tpl.is_pro);
                const isLocked = isProTemplate && !isMerchantPro;
                const coverImage = tpl.preview_image || ('/assets/images/templates/' + tpl.id + '.png');

                let badgeHtml = '';
                if (isProTemplate) {
                    badgeHtml = '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#084C38] text-white shadow-xs">PRO</span>';
                } else {
                    badgeHtml = '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 shadow-xs">FREE</span>';
                }

                // Exactly ONE action button below the card
                let singleActionBtn = '';
                if (isSelected) {
                    singleActionBtn = '<button type="button" disabled class="w-full text-xs font-semibold py-2.5 rounded-xl bg-[#084C38] text-white cursor-default">Selected</button>';
                } else if (isLocked) {
                    singleActionBtn = `<button type="button" onclick="event.stopPropagation(); openProUpgradeModal('${tpl.name}')" class="w-full text-xs font-semibold py-2.5 rounded-xl bg-[#084C38] hover:bg-[#063b2c] text-white transition shadow-xs">Upgrade to Pro</button>`;
                } else {
                    singleActionBtn = `<button type="button" onclick="event.stopPropagation(); selectTemplate('${tpl.id}')" class="w-full text-xs font-semibold py-2.5 rounded-xl bg-gray-100 hover:bg-[#084C38] text-[#111827] hover:text-white transition">Select</button>`;
                }

                const cardBorder = isSelected 
                    ? 'border-[#084C38] bg-[#EDF5F1]/30 ring-2 ring-[#084C38] shadow-xs' 
                    : 'border-[#EAEFEB] bg-white hover:border-[#084C38]/40 hover:shadow-xs';

                return `
                    <div onclick="previewTemplateDetails('${tpl.id}')" id="tplCard-${tpl.id}" class="template-option-card group relative p-3.5 rounded-3xl border cursor-pointer transition-all duration-200 flex flex-col justify-between w-[84vw] sm:w-[320px] md:w-auto shrink-0 md:shrink snap-center ${cardBorder}">
                        <div class="space-y-2.5">
                            <!-- Theme Front View Cover Photo with Dark Overlay -->
                            <div class="relative w-full aspect-[16/10] h-40 sm:h-44 rounded-2xl overflow-hidden border border-[#EAEFEB] bg-[#084C38] shadow-xs group-hover:border-[#084C38]/30 transition">
                                <img src="${coverImage}" onerror="this.onerror=null; this.src='/assets/images/templates/${tpl.id}.svg';" alt="${tpl.name} Screenshot" class="w-full h-full object-cover object-top filter brightness-50 contrast-125 transition-transform duration-300 group-hover:scale-105" loading="lazy">
                                
                                <!-- Very dark overlay so preview is veiled until opened -->
                                <div class="absolute inset-0 bg-[#084C38]/85 backdrop-blur-[2px] flex flex-col items-center justify-center p-3 text-center transition-all duration-200 group-hover:bg-[#084C38]/75">
                                    <div class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center mb-1.5 border border-white/15">
                                        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                    </div>
                                    <span class="text-white font-medium text-[11px] tracking-wide">Click to Preview</span>
                                    <span class="text-[9px] text-[#EDF5F1] font-mono mt-0.5">Open Full Screenshot ↗</span>
                                </div>

                                <div class="absolute top-2 right-2 z-10">
                                    ${badgeHtml}
                                </div>
                            </div>

                            <div class="min-w-0 pt-0.5">
                                <h4 class="font-semibold text-xs text-[#08110D] truncate">${tpl.name}</h4>
                                <span class="text-[10px] text-[#6B756F] block truncate mt-0.5">${tpl.category}</span>
                            </div>

                            <p class="text-[11px] text-[#6B756F] line-clamp-2 leading-relaxed">${tpl.tagline}</p>
                        </div>

                        <!-- Exactly 1 single action button at bottom -->
                        <div class="pt-3 mt-3 border-t border-[#E3E9E5]/60">
                            ${singleActionBtn}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function updateCoverLockState(isPro) {
            const banner = document.getElementById('coverLockedBanner');
            const controls = document.getElementById('coverControlsWrapper');
            const fileInput = document.getElementById('coverFileInput');
            const colorInput = document.getElementById('coverOverlayColor');
            const hexInput = document.getElementById('coverOverlayColorHex');
            if (banner && controls) {
                if (isPro) {
                    banner.classList.add('hidden');
                    controls.classList.remove('opacity-40', 'pointer-events-none');
                    if (fileInput) fileInput.disabled = false;
                    if (colorInput) colorInput.disabled = false;
                    if (hexInput) hexInput.disabled = false;
                } else {
                    banner.classList.remove('hidden');
                    controls.classList.add('opacity-40', 'pointer-events-none');
                    if (fileInput) fileInput.disabled = true;
                    if (colorInput) colorInput.disabled = true;
                    if (hexInput) hexInput.disabled = true;
                }
            }
        }

        function selectTemplate(templateId) {
            const tpl = allTemplatesData[templateId];
            if (!tpl) return;

            if (tpl.is_pro && !isMerchantPro) {
                openProUpgradeModal(tpl.name);
                return;
            }

            selectedTemplateId = templateId;
            document.getElementById('selectedTemplateInput').value = templateId;

            const activeBadge = document.getElementById('activeTemplateBadge');
            if (activeBadge) {
                activeBadge.textContent = `Active: ${tpl.name}`;
            }

            updateCoverLockState(Boolean(tpl.is_pro));
            renderTemplatesForCategory(currentCategoryId);
        }

        function previewTemplateDetails(templateId) {
            const tpl = allTemplatesData[templateId];
            if (!tpl) return;
            previewingTplId = templateId;

            const coverImg = document.getElementById('tplModalCover');
            if (coverImg) {
                coverImg.src = tpl.preview_image || ('/assets/images/templates/' + tpl.id + '.png');
                coverImg.onerror = function() {
                    this.onerror = null;
                    this.src = '/assets/images/templates/' + tpl.id + '.svg';
                };
            }

            const demoLink = document.getElementById('tplModalDemoLink');
            if (demoLink) {
                demoLink.href = '/demo/' + templateId;
            }

            document.getElementById('tplModalName').textContent = tpl.name;
            document.getElementById('tplModalCategory').textContent = tpl.category;
            document.getElementById('tplModalDesc').textContent = tpl.description;

            const tierBadge = document.getElementById('tplModalTierBadge');
            if (tierBadge) {
                if (tpl.is_pro) {
                    tierBadge.className = 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-[#08110D] text-[#19D98B] border border-[#19D98B]/30';
                    tierBadge.textContent = 'PRO';
                } else {
                    tierBadge.className = 'text-[10px] font-semibold px-2 py-0.5 rounded-full bg-[#19D98B]/15 text-[#087A50] border border-[#19D98B]/30';
                    tierBadge.textContent = 'FREE';
                }
            }

            const featsList = document.getElementById('tplModalFeatures');
            featsList.innerHTML = (tpl.features || []).map(f => `
                <li class="flex items-center gap-2">
                    <span class="text-[#087A50] font-bold">•</span>
                    <span>${f}</span>
                </li>
            `).join('');

            document.getElementById('templatePreviewModal').classList.remove('hidden');
        }

        function closeTemplatePreviewModal() {
            document.getElementById('templatePreviewModal').classList.add('hidden');
            previewingTplId = null;
        }

        function applyFromPreview() {
            if (previewingTplId) {
                const tpl = allTemplatesData[previewingTplId];
                if (tpl && tpl.is_pro && !isMerchantPro) {
                    closeTemplatePreviewModal();
                    openProUpgradeModal(tpl.name);
                    return;
                }
                selectTemplate(previewingTplId);
                closeTemplatePreviewModal();
            }
        }

        function initSettingsQr() {
            const container = document.getElementById('settingsQrContainer');
            if (container) {
                container.innerHTML = '';
                settingsQr = new QRCode(container, {
                    text: 'https://zlik.store/' + storeSlug,
                    width: 120,
                    height: 120,
                    colorDark: '#08110D',
                    colorLight: '#ffffff',
                    correctLevel: QRCode.CorrectLevel.H
                });
            }
        }

        function downloadSettingsQrCode() {
            const img = document.querySelector('#settingsQrContainer img');
            const canvas = document.querySelector('#settingsQrContainer canvas');
            let dataUrl = '';
            if (img && img.src) {
                dataUrl = img.src;
            } else if (canvas) {
                dataUrl = canvas.toDataURL('image/png');
            }
            if (!dataUrl) return;

            const a = document.createElement('a');
            a.href = dataUrl;
            a.download = `${storeSlug}-zlik-store-qr.png`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        function copySettingsStoreUrl() {
            const fullUrl = 'https://zlik.store/' + storeSlug;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(fullUrl).then(() => {
                    const btn = document.getElementById('settingsCopyUrlBtn');
                    btn.textContent = 'Copied!';
                    setTimeout(() => btn.textContent = 'Copy Store Link', 2000);
                });
            }
        }

        async function handleLogoUpload(file) {
            if (!file) return;
            if (file.size > 10 * 1024 * 1024) {
                alert('File exceeds 10MB limit. Please choose a smaller image.');
                return;
            }

            const formData = new FormData();
            formData.append('files', file);

            try {
                const res = await fetch('/api/upload', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.url) {
                    document.getElementById('logoUrl').value = data.url;
                    
                    const container = document.getElementById('logoPreviewContainer');
                    container.innerHTML = `<img id="logoPreviewImg" src="${data.url}" alt="Store Logo" class="w-full h-full object-cover">`;
                    
                    const removeBtn = document.getElementById('removeLogoBtn');
                    if (removeBtn) removeBtn.classList.remove('hidden');
                } else {
                    alert(data.error || 'Failed to upload logo.');
                }
            } catch (err) {
                alert('Network error while uploading logo.');
            }
        }

        function removeStoreLogo() {
