    async function savePaystackSettings(e) {
      e.preventDefault();
      const mode = document.getElementById('paystackMode').value;
      const testPub = document.getElementById('paystackTestPub').value.trim();
      const testSec = document.getElementById('paystackTestSec').value.trim();
      const livePub = document.getElementById('paystackLivePub').value.trim();
      const liveSec = document.getElementById('paystackLiveSec').value.trim();
      const webhookSec = document.getElementById('paystackWebhookSec').value.trim();
      const isEnabled = document.getElementById('paystackEnabled').checked ? 1 : 0;

      // Friendly validation warnings
      if (mode === 'test') {
        if (testPub && !testPub.startsWith('pk_test_')) {
          alert('Note: Paystack Test Public Key usually begins with "pk_test_"');
        }
        if (testSec && !testSec.startsWith('sk_test_') && !testSec.startsWith('mock')) {
          alert('Note: Paystack Test Secret Key must begin with "sk_test_" to verify test transactions');
        }
      } else if (mode === 'live') {
        if (!livePub || !livePub.startsWith('pk_live_')) {
          alert('Note: Live Public Key must begin with "pk_live_" to charge live cards');
        }
        if (!liveSec || !liveSec.startsWith('sk_live_')) {
          alert('Note: Live Secret Key must begin with "sk_live_" to verify live transactions');
        }
      }

      const payload = {
        action: 'update_settings',
        paystack_enabled: isEnabled,
        paystack_mode: mode,
        paystack_test_public_key: testPub,
        paystack_test_secret_key: testSec,
        paystack_live_public_key: livePub,
        paystack_live_secret_key: liveSec,
        paystack_webhook_secret: webhookSec
      };

      try {
        const res = await fetch('/api/admin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          alert('✅ Paystack Gateway settings saved successfully!');
        } else {
          alert(data.error || 'Failed to save Paystack settings');
        }
      } catch (err) {
        alert('Network error while saving Paystack settings');
      }
    }

