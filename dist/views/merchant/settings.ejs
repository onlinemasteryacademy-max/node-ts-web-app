                            <option value="">-- Choose Nigerian Bank --</option>
                            <option value="044" <%= (store.bank_name || '').includes('Access') ? 'selected' : '' %>>Access Bank</option>
                            <option value="058" <%= (store.bank_name || '').includes('Guaranty') || (store.bank_name || '').includes('GTBank') ? 'selected' : '' %>>Guaranty Trust Bank (GTBank)</option>
                            <option value="057" <%= (store.bank_name || '').includes('Zenith') ? 'selected' : '' %>>Zenith Bank</option>
                            <option value="033" <%= (store.bank_name || '').includes('UBA') ? 'selected' : '' %>>United Bank for Africa (UBA)</option>
                            <option value="011" <%= (store.bank_name || '').includes('First Bank') ? 'selected' : '' %>>First Bank of Nigeria</option>
                            <option value="214" <%= (store.bank_name || '').includes('FCMB') ? 'selected' : '' %>>FCMB</option>
                            <option value="070" <%= (store.bank_name || '').includes('Fidelity') ? 'selected' : '' %>>Fidelity Bank</option>
                            <option value="221" <%= (store.bank_name || '').includes('Stanbic') ? 'selected' : '' %>>Stanbic IBTC Bank</option>
                            <option value="232" <%= (store.bank_name || '').includes('Sterling') ? 'selected' : '' %>>Sterling Bank</option>
                            <option value="032" <%= (store.bank_name || '').includes('Union') ? 'selected' : '' %>>Union Bank</option>
                            <option value="035" <%= (store.bank_name || '').includes('Wema') ? 'selected' : '' %>>Wema Bank</option>
                            <option value="076" <%= (store.bank_name || '').includes('Polaris') ? 'selected' : '' %>>Polaris Bank</option>
                            <option value="082" <%= (store.bank_name || '').includes('Keystone') ? 'selected' : '' %>>Keystone Bank</option>
                            <option value="50211" <%= (store.bank_name || '').includes('Kuda') ? 'selected' : '' %>>Kuda Bank</option>
                            <option value="999992" <%= (store.bank_name || '').includes('OPay') ? 'selected' : '' %>>OPay</option>
                            <option value="999991" <%= (store.bank_name || '').includes('PalmPay') ? 'selected' : '' %>>PalmPay</option>
                            <option value="50515" <%= (store.bank_name || '').includes('Moniepoint') ? 'selected' : '' %>>Moniepoint MFB</option>
                        </select>
                        <input type="text" id="bankName" value="<%= store.bank_name || '' %>" placeholder="e.g. Zenith Bank, GTBank, Kuda" class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] mt-2 text-xs font-medium">
                    </div>

                    <div>
                        <label class="block font-medium text-[#111827] mb-1">10-Digit NUBAN Account Number</label>
