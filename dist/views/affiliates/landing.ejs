        proBtn.className = 'px-3 py-1 text-xs font-medium rounded-md text-[#6B756F] transition hover:text-[#08110D]';
        subtitle.innerText = 'At 30% rate';
      }

      updateEarningsCalc(document.getElementById('merchantRange').value);
    }

    function updateEarningsCalc(val) {
      var stores = parseInt(val, 10);
      document.getElementById('merchantsCountDisplay').innerText = stores + (stores === 1 ? ' store' : ' stores');
      var rate = currentCalcTier === 'pro' ? 3500 : 1500;
      var monthly = stores * rate;
      var annual = monthly * 12;
      document.getElementById('monthlyEarningsDisplay').innerText = '₦' + monthly.toLocaleString();
      document.getElementById('annualEarningsDisplay').innerText = '₦' + annual.toLocaleString();
    }

    function switchAuthTab(tab) {
      document.getElementById('authAlert').classList.add('hidden');
      var tabReg = document.getElementById('tabBtnRegister');
      var tabLog = document.getElementById('tabBtnLogin');
      var formReg = document.getElementById('affiliateRegisterForm');
      var formLog = document.getElementById('affiliateLoginForm');

      if (tab === 'register') {
        tabReg.className = 'flex-1 py-2 text-xs sm:text-sm font-semibold rounded-md bg-[#08110D] text-white transition';
        tabLog.className = 'flex-1 py-2 text-xs sm:text-sm font-semibold rounded-md text-[#6B756F] transition hover:text-[#08110D]';
        formReg.classList.remove('hidden');
        formLog.classList.add('hidden');
      } else {
        tabLog.className = 'flex-1 py-2 text-xs sm:text-sm font-semibold rounded-md bg-[#08110D] text-white transition';
        tabReg.className = 'flex-1 py-2 text-xs sm:text-sm font-semibold rounded-md text-[#6B756F] transition hover:text-[#08110D]';
        formLog.classList.remove('hidden');
        formReg.classList.add('hidden');
      }
    }

    function showAlert(msg, isSuccess) {
      var box = document.getElementById('authAlert');
      box.innerText = msg;
      box.className = 'p-3 rounded-lg text-xs font-medium ' +
        (isSuccess ? 'bg-[#E8F8F0] text-[#087A50] border border-[#BDE8D2]' : 'bg-red-50 text-red-800 border border-red-200');
      box.classList.remove('hidden');
    }

    async function handleAffiliateRegister(e) {
      e.preventDefault();
      var form = e.target;
      var btn = document.getElementById('regSubmitBtn');
      btn.disabled = true;
      btn.innerText = 'Creating Account...';

      var data = {
        full_name: form.full_name.value.trim(),
        email: form.email.value.trim(),
        phone: form.phone.value.trim(),
        password: form.password.value.trim()
      };

      try {
        var res = await fetch('/api/affiliates/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        var json = await res.json();
        if (json.success) {
          showAlert('Account created! Redirecting to dashboard...', true);
          window.location.href = json.redirect || '/affiliates/dashboard';
        } else {
          showAlert(json.error || 'Registration failed. Please check your details.', false);
          btn.disabled = false;
          btn.innerText = 'Create Affiliate Account';
        }
      } catch (err) {
        showAlert('Network error. Please try again.', false);
        btn.disabled = false;
        btn.innerText = 'Create Affiliate Account';
      }
    }

    async function handleAffiliateLogin(e) {
      e.preventDefault();
      var form = e.target;
      var btn = document.getElementById('loginSubmitBtn');
      btn.disabled = true;
      btn.innerText = 'Signing in...';

      var data = {
        identifier: form.identifier.value.trim(),
        password: form.password.value.trim()
      };

      try {
        var res = await fetch('/api/affiliates/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        var json = await res.json();
        if (json.success) {
          showAlert('Welcome back! Redirecting...', true);
          window.location.href = json.redirect || '/affiliates/dashboard';
        } else {
          showAlert(json.error || 'Invalid credentials.', false);
          btn.disabled = false;
          btn.innerText = 'Sign In to Dashboard';
        }
      } catch (err) {
        showAlert('Network error. Please try again.', false);
        btn.disabled = false;
        btn.innerText = 'Sign In to Dashboard';
      }
    }
  </script>
</body>
</html>
