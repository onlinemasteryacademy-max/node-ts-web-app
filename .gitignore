# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables
.env
.env.local
.env.*.local

# Database Files (CRITICAL: Never commit database files to Git so production live stores/accounts are preserved)
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# User Uploaded Media (Preserve live uploaded images on server from being overwritten on deploy)
src/public/uploads/*
!src/public/uploads/.gitkeep
!src/public/uploads/logos/
!src/public/uploads/logos/.gitkeep
!src/public/uploads/products/
!src/public/uploads/products/.gitkeep
dist/public/uploads/*
!dist/public/uploads/.gitkeep

# OS / Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
