<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products & Inventory — <%= store.store_name %> | zlik</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        zlikDark: '#08110D',
                        zlikGreen: '#19D98B',
                        zlikDeep: '#087A50',
                        zlikBg: '#F8FAF8',
                        zlikWhite: '#FFFFFF',
                        zlikMuted: '#6B756F',
                        zlikBorder: '#E3E9E5'
                    },
                    fontFamily: {
                        display: ['Montserrat', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8FAF8; color: #08110D; }
        .font-display { font-family: 'Montserrat', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0.5rem); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

    <!-- Header -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-[#E3E9E5] shadow-2xs">
        <div class="max-w-7xl mx-auto px-3 sm:px-4 py-2.5 sm:py-3.5 flex items-center justify-between gap-2 sm:gap-4">
            <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <a href="/merchant" class="text-xs font-medium text-[#6B756F] hover:text-[#08110D] flex items-center gap-1 transition shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    <span class="hidden sm:inline">Dashboard</span>
                </a>
                <span class="text-gray-300 hidden sm:inline">/</span>
                <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
                    <h1 class="text-xs sm:text-sm font-semibold text-[#08110D] truncate">Products</h1>
                    <span class="text-[9px] sm:text-[10px] font-medium px-1.5 sm:px-2 py-0.5 rounded-full border border-[#E3E9E5] bg-[#F8FAF8] text-[#08110D] shrink-0">
                        <span><%= templateConfig ? templateConfig.name : 'General' %></span>
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-1.5 sm:gap-2">
                <button type="button" onclick="openDailyAutoPoster()" title="Daily Auto-Poster" class="bg-white hover:bg-gray-50 text-[#08110D] border border-[#E3E9E5] text-xs font-semibold p-2 sm:px-3 sm:py-2 rounded-xl transition flex items-center gap-1.5 shadow-2xs">
                    <span>🌟</span>
                    <span class="hidden sm:inline">Auto-Poster</span>
                </button>
                <% if (isPro) { %>
                    <button type="button" onclick="openBulkImportModal()" title="Bulk Import CSV" class="bg-white hover:bg-gray-50 text-[#08110D] border border-[#E3E9E5] text-xs font-semibold p-2 sm:px-3 sm:py-2 rounded-xl transition flex items-center gap-1.5 shadow-2xs">
                        <span>📥</span>
                        <span class="hidden sm:inline">Import</span>
                    </button>
                <% } else { %>
                    <button type="button" onclick="openProUpgradeModal('Bulk CSV Product Import')" title="Bulk Import (Pro)" class="bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] border border-[#E3E9E5] text-xs font-medium p-2 sm:px-3 sm:py-2 rounded-xl transition flex items-center gap-1.5">
                        <span>🔒</span>
                        <span class="hidden sm:inline">Import (Pro)</span>
                    </button>
                <% } %>
                <button type="button" onclick="openAddProductModal()" class="bg-[#08110D] hover:bg-black text-[#19D98B] font-semibold text-xs px-3 sm:px-4 py-2 rounded-xl transition flex items-center gap-1 shadow-2xs">
                    <span class="text-sm leading-none">+</span>
                    <span>Add</span>
                    <span class="hidden sm:inline">Product</span>
                </button>
            </div>
        </div>

        <div class="hidden sm:flex max-w-7xl mx-auto px-4 items-center gap-2 overflow-x-auto text-xs font-medium border-t border-[#E3E9E5]/60 pt-2 pb-2">
            <a href="/merchant" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Orders</a>
            <a href="/merchant/items" class="px-3.5 py-1.5 rounded-xl bg-[#08110D] text-white font-semibold">Products</a>
            <a href="/merchant/ledger" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Sales Ledger</a>
            <a href="/merchant/debts" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Debts</a>
            <a href="/merchant/messages" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Live Chat</a>
            <a href="/merchant/settings" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Settings</a>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-3 sm:px-4 py-4 sm:py-6 pb-24 sm:pb-8 flex-1 w-full space-y-5 sm:space-y-6">

        <!-- Plan Product Capacity Notice for Free Tier -->
        <% if (!isPro) { %>
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-2.5">
                    <span class="w-7 h-7 rounded-full bg-amber-200 text-amber-900 flex items-center justify-center text-xs font-mono font-bold shrink-0"><%= items.length %>/10</span>
                    <div>
                        <h4 class="font-semibold text-amber-950">Free Starter Capacity: <%= items.length %> / 10 Products Used</h4>
                        <p class="text-[11px] text-amber-800 mt-0.5">
                            Free plan includes 10 active products and 1 photo per item. Upgrade to Pro for 500 products, 5 photos per item, and bulk CSV imports.
                        </p>
                    </div>
                </div>
                <button type="button" onclick="openProUpgradeModal('500 Products & 5 Photos')" class="shrink-0 bg-[#08110D] hover:bg-black text-[#19D98B] font-semibold text-xs px-3.5 py-2 rounded-xl transition shadow-2xs">
                    Upgrade to Pro ⚡
                </button>
            </div>
        <% } %>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
                <h2 class="text-base font-extrabold text-[#08110D] font-display flex items-center gap-2">
                    <span>Store Products (<%= items.length %>)</span>
                    <span class="text-xs font-normal text-[#6B756F]">• Configured for <%= templateConfig ? templateConfig.name : 'General' %></span>
                </h2>
                <p class="text-xs text-[#6B756F]">Manage items, structured variants, customizable option groups, technical specs, and in-stock inventory</p>
            </div>
            <div class="flex items-center gap-2">
                <a href="/<%= store.slug %>" target="_blank" class="bg-white hover:bg-gray-50 text-[#08110D] border border-[#E3E9E5] text-xs font-bold px-3 py-1.5 rounded-xl transition flex items-center gap-1">
                    <span>View Storefront ↗</span>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <% if (items.length === 0) { %>
                <div class="col-span-full p-12 text-center bg-white rounded-3xl border border-[#E3E9E5] text-[#6B756F] text-xs space-y-3">
                    <div class="text-4xl"><%= templateConfig ? templateConfig.icon : '🛍️' %></div>
                    <div class="font-bold text-[#08110D] text-sm">No products added yet</div>
                    <p class="max-w-sm mx-auto text-xs text-[#6B756F]">Click the button below to add your first <%= templateConfig ? templateConfig.product_label_singular : 'product' %> with <%= templateConfig ? templateConfig.name : 'store' %> features.</p>
                    <button type="button" onclick="openAddProductModal()" class="bg-[#08110D] text-[#19D98B] font-bold text-xs px-4 py-2.5 rounded-xl transition shadow-2xs">
                        + Add First <%= templateConfig ? templateConfig.product_label_singular : 'Product' %>
                    </button>
                </div>
            <% } else { %>
                <% items.forEach(item => { 
                    let variantsList = [];
                    let optionGroupsList = [];
                    let specsList = [];
                    let attributesData = {};
                    try { if (item.variants_json) variantsList = typeof item.variants_json === 'string' ? JSON.parse(item.variants_json) : item.variants_json; } catch(e){}
                    try { if (item.option_groups_json) optionGroupsList = typeof item.option_groups_json === 'string' ? JSON.parse(item.option_groups_json) : item.option_groups_json; } catch(e){}
                    try { if (item.specs_json) specsList = typeof item.specs_json === 'string' ? JSON.parse(item.specs_json) : item.specs_json; } catch(e){}
                    try { if (item.attributes_json) attributesData = typeof item.attributes_json === 'string' ? JSON.parse(item.attributes_json) : item.attributes_json; } catch(e){}
                %>
                    <div class="bg-white rounded-2xl border border-[#E3E9E5] p-3.5 flex flex-col justify-between hover:shadow-md transition group">
                        <div>
                            <div class="aspect-square bg-[#F8FAF8] rounded-xl overflow-hidden mb-3 border border-[#E3E9E5]/50 flex items-center justify-center relative">
                                <% if (item.image_url) { %>
                                    <img src="<%= item.image_url %>" alt="<%= item.title %>" class="w-full h-full object-cover">
                                <% } else { %>
                                    <span class="text-3xl text-gray-300"><%= templateConfig ? templateConfig.icon : '🛍️' %></span>
                                <% } %>
                                <% if (item.badge) { %>
                                    <span class="absolute top-2 left-2 bg-[#08110D]/80 backdrop-blur-xs text-[#19D98B] text-[9px] font-bold px-2 py-0.5 rounded-md">
                                        <%= item.badge %>
                                    </span>
                                <% } %>
                                <% if (item.is_preorder) { %>
                                    <span class="absolute top-2 right-2 bg-purple-900/90 backdrop-blur-xs text-purple-200 text-[9px] font-bold px-2 py-0.5 rounded-md">
                                        PRE-ORDER
                                    </span>
                                <% } %>
                            </div>

                            <div class="flex items-center gap-1.5 flex-wrap mb-1">
                                <span class="text-[9px] font-bold uppercase bg-[#F8FAF8] text-[#6B756F] px-2 py-0.5 rounded-md border border-[#E3E9E5]"><%= item.category %></span>
                                <% if (variantsList && variantsList.length > 0) { %>
                                    <span class="text-[9px] font-bold bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded-md border border-purple-200">
                                        <%= variantsList.length %> Variants
                                    </span>
                                <% } %>
                                <% if (optionGroupsList && optionGroupsList.length > 0) { %>
                                    <span class="text-[9px] font-bold bg-amber-50 text-amber-700 px-1.5 py-0.5 rounded-md border border-amber-200">
                                        <%= optionGroupsList.length %> Option Groups
                                    </span>
                                <% } %>
                                <% if (specsList && specsList.length > 0) { %>
                                    <span class="text-[9px] font-bold bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded-md border border-blue-200">
                                        Specs Set
                                    </span>
                                <% } %>
                            </div>

                            <h3 class="font-bold text-xs text-[#08110D] line-clamp-1 group-hover:text-[#087A50] transition"><%= item.title %></h3>
                            <p class="text-[11px] text-[#6B756F] line-clamp-2 my-1"><%= item.description || 'No description provided' %></p>
                            
                            <div class="flex items-baseline gap-2 mt-1">
                                <span class="text-xs font-extrabold text-[#087A50] font-mono">₦<%= Number(item.price).toLocaleString('en-US', {minimumFractionDigits: 2}) %></span>
                                <% if (item.compare_price && item.compare_price > item.price) { %>
                                    <span class="text-[10px] text-[#6B756F] line-through font-mono">₦<%= Number(item.compare_price).toLocaleString('en-US') %></span>
                                <% } %>
                            </div>
                        </div>

                        <div class="pt-3 mt-3 border-t border-[#E3E9E5]/60 flex items-center justify-between text-xs">
                            <span class="text-[10px] font-bold <%= item.is_available ? 'text-emerald-700' : 'text-gray-400' %>">
                                <%= item.is_available ? '● Available' : '○ Hidden' %>
                            </span>
                            <div class="flex items-center gap-1.5">
                                <button type="button" onclick="openSocialPosterModal(<%= JSON.stringify(item) %>)" class="bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] font-bold text-[11px] px-2 py-1 rounded-lg border border-[#E3E9E5] transition" title="Create Social Status Poster">
                                    📸 Poster
                                </button>
                                <button type="button" onclick="openEditProductModal(<%= JSON.stringify(item) %>)" class="bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] font-bold text-[11px] px-2 py-1 rounded-lg border border-[#E3E9E5] transition">
                                    ✏️ Edit
                                </button>
                                <button type="button" onclick="deleteProduct(<%= item.id %>)" class="text-red-600 hover:text-red-700 font-bold p-1 rounded-lg hover:bg-red-50 transition" title="Delete Product">
                                    🗑️
                                </button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </main>

    <!-- Comprehensive Product Create & Edit Modal -->
    <div id="productModal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 hidden">
        <div class="bg-white rounded-3xl max-w-2xl w-full p-0 shadow-2xl border border-[#E3E9E5] overflow-hidden max-h-[92vh] flex flex-col">
            <!-- Modal Header -->
            <div class="px-5 py-4 border-b border-[#E3E9E5] flex items-center justify-between bg-[#F8FAF8] shrink-0">
                <div class="flex items-center gap-2">
                    <span class="p-1.5 rounded-xl bg-gray-100 text-base"><%= templateConfig ? templateConfig.icon : '🛍️' %></span>
                    <div>
                        <h3 id="productModalHeading" class="font-extrabold text-sm text-[#08110D] font-display">Add Product</h3>
                        <p class="text-[10.5px] text-[#6B756F]">Store Template: <%= templateConfig ? templateConfig.name : 'General' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeProductModal()" class="w-7 h-7 rounded-full bg-white border border-[#E3E9E5] text-[#6B756F] hover:text-black flex items-center justify-center font-bold text-xs">✕</button>
            </div>

            <!-- Modal Body Form (Scrollable) -->
            <form id="productForm" onsubmit="handleSaveProduct(event)" class="overflow-y-auto p-5 sm:p-6 space-y-5 flex-1 text-xs">
                <input type="hidden" id="prodId" value="">

                <!-- Tab 1: Core Product Information -->
                <div class="space-y-3.5">
                    <h4 class="text-[11px] font-extrabold uppercase tracking-wider text-[#6B756F] border-b border-[#E3E9E5] pb-1">1. Basic Details & Direct Photos</h4>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="sm:col-span-2">
                            <label class="block font-bold text-[#08110D] mb-1">Product Title *</label>
                            <input type="text" id="prodTitle" required placeholder="e.g. Classic Oxford Cotton Shirt" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                        </div>

                        <div>
                            <label class="block font-bold text-[#08110D] mb-1">Category</label>
                            <input type="text" id="prodCategory" placeholder="e.g. Apparel, Main Dish, Skincare" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                        </div>

                        <div>
                            <label class="block font-bold text-[#08110D] mb-1">Promotional Badge (Optional)</label>
                            <input type="text" id="prodBadge" placeholder="e.g. 20% OFF, Chef Special, Best Seller" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                        </div>

                        <div>
                            <label class="block font-bold text-[#08110D] mb-1">Base Price (₦) *</label>
                            <input type="number" step="0.01" id="prodPrice" required placeholder="5000" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D] font-mono font-bold">
                        </div>

                        <div>
                            <label class="block font-bold text-[#08110D] mb-1">Compare Price (₦ - Strikethrough)</label>
                            <input type="number" step="0.01" id="prodComparePrice" placeholder="7500" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D] font-mono">
                        </div>

                        <div>
                            <label class="block font-bold text-[#08110D] mb-1">Stock Quantity</label>
                            <input type="number" id="prodStock" placeholder="100" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]">
                        </div>

                        <div>
                            <label class="block font-bold text-[#08110D] mb-1">SKU / Item Code</label>
                            <input type="text" id="prodSku" placeholder="e.g. SHIRT-OXF-01" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D] font-mono">
                        </div>

                        <!-- Direct Multi-Image Uploader (Up to 10MB per file) -->
                        <div class="sm:col-span-2 space-y-2 pt-1">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                                <label class="block font-bold text-[#08110D]">
                                    Product Photos (Max <%= isPro ? '5' : '1' %> on <%= isPro ? 'Pro' : 'Free' %> Plan)
                                </label>
                                <span class="text-[10.5px] text-[#6B756F]">
                                    <%= isPro ? 'Upload up to 5 photos • First is main cover' : '🔒 Free includes 1 photo per item (5 on Pro)' %>
                                </span>
                            </div>
                            
                            <!-- Dropzone Box -->
                            <div id="productImageDropzone" onclick="document.getElementById('productImageFileInput').click()" class="border-2 border-dashed border-[#E3E9E5] hover:border-[#08110D] p-4 sm:p-5 rounded-2xl bg-[#F8FAF8] hover:bg-[#F0F4F1] transition cursor-pointer text-center space-y-1.5 group">
                                <input type="file" id="productImageFileInput" multiple accept="image/*" onchange="handleProductFilesUpload(this.files)" class="hidden">
                                <div class="text-2xl group-hover:scale-110 transition-transform">📸</div>
                                <div class="text-xs font-bold text-[#08110D]">Click to upload or drag & drop product photos</div>
                                <div class="text-[10.5px] text-[#6B756F]">Direct upload: JPG, PNG, WEBP, GIF, SVG (Up to 10MB each)</div>
                            </div>

                            <!-- Upload Spinner / Status -->
                            <div id="uploadStatusBox" class="hidden p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 font-bold flex items-center gap-2">
                                <span class="animate-spin">⏳</span>
                                <span id="uploadStatusText">Uploading images...</span>
                            </div>

                            <!-- Multi-Image Thumbnails Gallery -->
                            <div id="productGalleryContainer" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2.5 pt-1">
                                <!-- Injected via JavaScript -->
                            </div>

                            <input type="hidden" id="prodImageUrl" value="">
                            <input type="hidden" id="prodGalleryJson" value="[]">
                        </div>

                        <div class="sm:col-span-2">
                            <label class="block font-bold text-[#08110D] mb-1">Description</label>
                            <textarea id="prodDesc" rows="2" placeholder="Describe the item, ingredients, fit, features..." class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D]"></textarea>
                        </div>

                        <!-- Pre-Order Settings -->
                        <div class="sm:col-span-2 p-3 bg-[#F8FAF8] rounded-xl border border-[#E3E9E5] space-y-2">
                            <div class="flex items-center justify-between">
                                <div>
                                    <div class="font-bold text-[#08110D] text-xs">Accept Pre-Orders</div>
                                    <div class="text-[10px] text-[#6B756F]">Allow customers to purchase before stock arrives</div>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="prodIsPreorder" onchange="togglePreorderDateInput(this.checked)" class="sr-only peer">
                                    <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[#087A50]"></div>
                                </label>
                            </div>
                            <div id="preorderDateContainer" class="hidden pt-2 border-t border-[#E3E9E5]/60">
                                <label class="block font-bold text-[#08110D] text-[11px] mb-1">Estimated Dispatch / Availability Date</label>
                                <input type="date" id="prodPreorderDispatchDate" class="w-full bg-white border border-[#E3E9E5] rounded-xl p-2 outline-none text-xs">
                            </div>
                        </div>

                        <!-- Product Video Showcase (Business Plan) -->
                        <div class="sm:col-span-2">
                            <div class="flex items-center justify-between mb-1">
                                <label class="block font-bold text-[#08110D]">Product Showcase Video URL (Optional)</label>
                                <span class="text-[9.5px] font-semibold bg-[#08110D] text-[#19D98B] px-2 py-0.5 rounded-md font-mono">🔒 BUSINESS PLAN</span>
                            </div>
                            <input type="url" id="prodVideoUrl" placeholder="https://cdn.example.com/video.mp4 or YouTube / Vimeo URL" class="w-full bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl p-2.5 outline-none focus:border-[#08110D] font-mono text-xs">
                            <span class="text-[10px] text-[#6B756F] mt-0.5 block">Plays an interactive video showcase inside the product modal on your storefront.</span>
                        </div>
                    </div>
                </div>

                <!-- Tab 2: Template-Specific Dynamic Section -->
                <% const categoryId = (templateConfig && templateConfig.category_id) || 'general'; %>

                <% if (categoryId === 'fashion') { %>
                    <!-- Fashion: Sizes, Colors, and Variant Matrix with Optional Images -->
                    <div class="space-y-3.5 pt-3 border-t border-[#E3E9E5]">
                        <div class="flex items-center justify-between">
                            <h4 class="text-[11px] font-extrabold uppercase tracking-wider text-[#08110D] flex items-center gap-1.5">
                                <span>👗 Fashion Specifications (Sizes & Colors)</span>
                            </h4>
                            <span class="text-[10px] text-[#6B756F]">Configure combinations with photos</span>
                        </div>

