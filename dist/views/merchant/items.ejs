        // Social Status Poster Generator (Canvas)
        // ==========================================
        let currentPosterItem = null;
        let currentPosterFormat = 'story'; // 'story' (9:16) | 'square' (1:1)
        let currentPosterTheme = 'dark'; // 'dark' | 'light' | 'midnight' | 'sunset'
        const merchantStoreName = `<%= (store.store_name || "Official Store").replace(/"/g, '\\"') %>`;
        const merchantStoreSlug = `<%= store.slug %>`;

        const posterThemes = {
            dark: {
                bgStart: '#08110D',
                bgEnd: '#11211A',
                cardBg: 'rgba(255, 255, 255, 0.06)',
                cardBorder: 'rgba(25, 217, 139, 0.25)',
                textPrimary: '#FFFFFF',
                textSecondary: '#9AA6A0',
                accent: '#19D98B',
                accentBg: 'rgba(25, 217, 139, 0.15)',
                badgeBg: '#19D98B',
                badgeText: '#08110D'
            },
            light: {
                bgStart: '#F4F7F4',
                bgEnd: '#E4EDE5',
                cardBg: '#FFFFFF',
                cardBorder: 'rgba(8, 122, 80, 0.2)',
                textPrimary: '#08110D',
                textSecondary: '#6B756F',
                accent: '#087A50',
                accentBg: 'rgba(8, 122, 80, 0.1)',
                badgeBg: '#08110D',
                badgeText: '#19D98B'
            },
            midnight: {
                bgStart: '#080D1A',
                bgEnd: '#0F1E3D',
                cardBg: 'rgba(255, 255, 255, 0.07)',
                cardBorder: 'rgba(0, 229, 255, 0.3)',
                textPrimary: '#FFFFFF',
                textSecondary: '#8CA0C7',
                accent: '#00E5FF',
                accentBg: 'rgba(0, 229, 255, 0.15)',
                badgeBg: '#00E5FF',
                badgeText: '#080D1A'
            },
            sunset: {
                bgStart: '#1B0B1E',
                bgEnd: '#331238',
                cardBg: 'rgba(255, 255, 255, 0.08)',
                cardBorder: 'rgba(255, 107, 107, 0.35)',
                textPrimary: '#FFFFFF',
                textSecondary: '#CCA0B4',
                accent: '#FF6B6B',
                accentBg: 'rgba(255, 107, 107, 0.18)',
                badgeBg: '#FF6B6B',
                badgeText: '#FFFFFF'
            }
        };

        function openSocialPosterModal(item) {
            currentPosterItem = item;
            document.getElementById('posterModal').classList.remove('hidden');
            renderPosterCanvas();
        }

        function closeSocialPosterModal() {
            document.getElementById('posterModal').classList.add('hidden');
        }

        function setPosterFormat(fmt) {
            currentPosterFormat = fmt;
            const storyBtn = document.getElementById('fmtStoryBtn');
            const squareBtn = document.getElementById('fmtSquareBtn');
            if (fmt === 'story') {
                storyBtn.className = 'p-3 rounded-xl border-2 border-[#08110D] bg-[#08110D] text-white text-left transition flex flex-col justify-between';
                squareBtn.className = 'p-3 rounded-xl border border-[#E3E9E5] bg-[#F8FAF8] text-[#08110D] text-left hover:border-[#08110D] transition flex flex-col justify-between';
            } else {
                squareBtn.className = 'p-3 rounded-xl border-2 border-[#08110D] bg-[#08110D] text-white text-left transition flex flex-col justify-between';
                storyBtn.className = 'p-3 rounded-xl border border-[#E3E9E5] bg-[#F8FAF8] text-[#08110D] text-left hover:border-[#08110D] transition flex flex-col justify-between';
            }
            renderPosterCanvas();
        }

        function setPosterTheme(thm) {
            if (posterThemes[thm]) {
                currentPosterTheme = thm;
                renderPosterCanvas();
            }
        }

        function drawCanvasRoundRect(ctx, x, y, width, height, radius, fill, stroke) {
            ctx.beginPath();
            ctx.moveTo(x + radius, y);
            ctx.lineTo(x + width - radius, y);
            ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
            ctx.lineTo(x + width, y + height - radius);
            ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
            ctx.lineTo(x + radius, y + height);
            ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
            ctx.lineTo(x, y + radius);
            ctx.quadraticCurveTo(x, y, x + radius, y);
            ctx.closePath();
            if (fill) ctx.fill();
            if (stroke) ctx.stroke();
        }

        async function renderPosterCanvas() {
            if (!currentPosterItem) return;
            const canvas = document.getElementById('posterCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');

            const isStory = currentPosterFormat === 'story';
            const width = 1080;
            const height = isStory ? 1920 : 1080;
            canvas.width = width;
            canvas.height = height;

            const theme = posterThemes[currentPosterTheme] || posterThemes.dark;
            const showQr = document.getElementById('posterShowQr')?.checked ?? true;
            const showBadge = document.getElementById('posterShowBadge')?.checked ?? true;
            const showCompare = document.getElementById('posterShowComparePrice')?.checked ?? true;

            // 1. Background Gradient
            const bgGrad = ctx.createLinearGradient(0, 0, width, height);
            bgGrad.addColorStop(0, theme.bgStart);
            bgGrad.addColorStop(1, theme.bgEnd);
            ctx.fillStyle = bgGrad;
            ctx.fillRect(0, 0, width, height);

            // Ambient Glow Rings
            ctx.save();
            const glow = ctx.createRadialGradient(width * 0.85, height * 0.15, 10, width * 0.85, height * 0.15, 450);
            glow.addColorStop(0, theme.accentBg);
            glow.addColorStop(1, 'transparent');
            ctx.fillStyle = glow;
            ctx.fillRect(0, 0, width, height);
            ctx.restore();

            // 2. Header: Store Branding
            ctx.save();
            ctx.font = 'bold 36px Montserrat, Inter, sans-serif';
            ctx.fillStyle = theme.textPrimary;
            ctx.fillText(merchantStoreName.toUpperCase(), 70, isStory ? 130 : 90);

            ctx.font = 'bold 20px Inter, sans-serif';
            ctx.fillStyle = theme.accent;
            ctx.fillText('● OFFICIAL STOREFRONT', 70, isStory ? 170 : 125);
            ctx.restore();

            // 3. Product Image Card
            const imgBoxX = 70;
            const imgBoxY = isStory ? 230 : 160;
            const imgBoxW = width - 140;
            const imgBoxH = isStory ? 880 : 540;

            // Card background & shadow
            ctx.save();
            ctx.fillStyle = theme.cardBg;
            ctx.strokeStyle = theme.cardBorder;
            ctx.lineWidth = 2;
            ctx.shadowColor = 'rgba(0,0,0,0.35)';
            ctx.shadowBlur = 30;
            ctx.shadowOffsetY = 15;
            drawCanvasRoundRect(ctx, imgBoxX, imgBoxY, imgBoxW, imgBoxH, 36, true, true);
            ctx.restore();

            // Load and draw product image
            if (currentPosterItem.image_url) {
                try {
                    const img = new Image();
                    img.crossOrigin = 'anonymous';
                    await new Promise((resolve) => {
                        img.onload = resolve;
                        img.onerror = resolve;
                        img.src = currentPosterItem.image_url;
                    });

                    if (img.width > 0) {
                        ctx.save();
                        // Clip to inner card
                        const pad = 12;
                        drawCanvasRoundRect(ctx, imgBoxX + pad, imgBoxY + pad, imgBoxW - pad * 2, imgBoxH - pad * 2, 28, false, false);
                        ctx.clip();

                        // Cover fit math
                        const hRatio = (imgBoxW - pad * 2) / img.width;
                        const vRatio = (imgBoxH - pad * 2) / img.height;
                        const ratio = Math.max(hRatio, vRatio);
                        const centerShiftX = (imgBoxW - pad * 2 - img.width * ratio) / 2;
                        const centerShiftY = (imgBoxH - pad * 2 - img.height * ratio) / 2;

                        ctx.drawImage(img, 0, 0, img.width, img.height,
                            imgBoxX + pad + centerShiftX, imgBoxY + pad + centerShiftY, img.width * ratio, img.height * ratio);
                        ctx.restore();
                    }
                } catch(e) {}
            }

            // Promotional / Pre-Order Badge on Image
            if (showBadge && (currentPosterItem.is_preorder || currentPosterItem.badge)) {
                ctx.save();
                const badgeText = currentPosterItem.is_preorder ? 'PRE-ORDER NOW' : currentPosterItem.badge.toUpperCase();
                ctx.font = 'bold 22px Montserrat, Inter, sans-serif';
                const textWidth = ctx.measureText(badgeText).width;
                const bPadX = 26;
                const bH = 46;
                const bW = textWidth + bPadX * 2;
                const bX = imgBoxX + 30;
                const bY = imgBoxY + 30;

                ctx.fillStyle = currentPosterItem.is_preorder ? '#8B5CF6' : theme.badgeBg;
                ctx.shadowColor = 'rgba(0,0,0,0.3)';
                ctx.shadowBlur = 15;
                drawCanvasRoundRect(ctx, bX, bY, bW, bH, 14, true, false);

                ctx.fillStyle = currentPosterItem.is_preorder ? '#FFFFFF' : theme.badgeText;
                ctx.fillText(badgeText, bX + bPadX, bY + 32);
                ctx.restore();
            }

            // 4. Product Details Section
            const contentY = isStory ? 1170 : 740;

            // Category tag
            ctx.save();
            ctx.font = 'bold 20px Montserrat, Inter, sans-serif';
            ctx.fillStyle = theme.accent;
            ctx.fillText((currentPosterItem.category || 'STORE PRODUCT').toUpperCase(), 70, contentY);

            // Title (word wrapped)
            ctx.font = isStory ? 'bold 44px Montserrat, Inter, sans-serif' : 'bold 38px Montserrat, Inter, sans-serif';
            ctx.fillStyle = theme.textPrimary;
            const words = (currentPosterItem.title || 'Special Offer').split(' ');
            let line = '';
            let curY = contentY + 50;
            const maxLineWidth = showQr ? 620 : (width - 140);

            for (let n = 0; n < words.length; n++) {
                const testLine = line + words[n] + ' ';
                const metrics = ctx.measureText(testLine);
                if (metrics.width > maxLineWidth && n > 0) {
                    ctx.fillText(line, 70, curY);
                    line = words[n] + ' ';
                    curY += isStory ? 52 : 44;
                    if (curY > contentY + 120) { line += '...'; break; }
                } else {
                    line = testLine;
                }
            }
            ctx.fillText(line, 70, curY);

            // Price Tag
            const priceY = curY + (isStory ? 75 : 60);
            ctx.font = isStory ? 'bold 64px JetBrains Mono, Inter, monospace' : 'bold 50px JetBrains Mono, Inter, monospace';
            ctx.fillStyle = theme.accent;
            const priceFormatted = '₦' + Number(currentPosterItem.price).toLocaleString('en-US', { minimumFractionDigits: 2 });
            ctx.fillText(priceFormatted, 70, priceY);

            // Strikethrough compare price
            if (showCompare && currentPosterItem.compare_price && currentPosterItem.compare_price > currentPosterItem.price) {
                const priceWidth = ctx.measureText(priceFormatted).width;
                ctx.font = isStory ? 'bold 36px JetBrains Mono, Inter, monospace' : 'bold 30px JetBrains Mono, Inter, monospace';
                ctx.fillStyle = theme.textSecondary;
                const compText = '₦' + Number(currentPosterItem.compare_price).toLocaleString('en-US');
                const compX = 70 + priceWidth + 24;
                ctx.fillText(compText, compX, priceY - 6);
                
                // Strike line
                const compWidth = ctx.measureText(compText).width;
                ctx.strokeStyle = theme.textSecondary;
                ctx.lineWidth = 3;
                ctx.beginPath();
                ctx.moveTo(compX - 4, priceY - 18);
                ctx.lineTo(compX + compWidth + 4, priceY - 18);
                ctx.stroke();
            }

            // Pre-order dispatch date notice
            if (currentPosterItem.is_preorder && currentPosterItem.preorder_dispatch_date) {
                ctx.font = '600 20px Inter, sans-serif';
                ctx.fillStyle = theme.textSecondary;
                ctx.fillText('📦 Ships on or before: ' + currentPosterItem.preorder_dispatch_date, 70, priceY + 45);
            }
            ctx.restore();

            // 5. Footer & QR Code Box
            const footerY = isStory ? 1540 : 880;
            const fullStoreUrl = window.location.origin + '/' + merchantStoreSlug;

            if (showQr) {
                const qrSize = isStory ? 240 : 160;
                const qrX = width - 70 - qrSize;
                const qrY = isStory ? (height - 70 - qrSize - 40) : (height - 50 - qrSize);

                // QR Container Card
                ctx.save();
                ctx.fillStyle = '#FFFFFF';
                ctx.shadowColor = 'rgba(0,0,0,0.3)';
                ctx.shadowBlur = 20;
                drawCanvasRoundRect(ctx, qrX - 16, qrY - 16, qrSize + 32, qrSize + 54, 24, true, false);

                // Draw QR Code
                try {
                    const qrImg = new Image();
                    qrImg.crossOrigin = 'anonymous';
                    const qrApiUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=' + qrSize + 'x' + qrSize + '&data=' + encodeURIComponent(fullStoreUrl);
                    await new Promise((resolve) => {
                        qrImg.onload = resolve;
                        qrImg.onerror = resolve;
                        qrImg.src = qrApiUrl;
                    });
                    if (qrImg.width > 0) {
                        ctx.drawImage(qrImg, qrX, qrY, qrSize, qrSize);
                    }
                } catch(e) {}

                // Scan label under QR
                ctx.font = 'bold 13px Montserrat, Inter, sans-serif';
                ctx.fillStyle = '#08110D';
                ctx.textAlign = 'center';
                ctx.fillText('SCAN TO ORDER', qrX + (qrSize / 2), qrY + qrSize + 24);
                ctx.restore();
            }

            // Footer Callout Action Banner
            if (isStory) {
                ctx.save();
                const bannerY = height - 160;
                const bannerH = 90;
                const bannerW = showQr ? (width - 140 - 290) : (width - 140);

                ctx.fillStyle = theme.accentBg;
                ctx.strokeStyle = theme.cardBorder;
                ctx.lineWidth = 1.5;
                drawCanvasRoundRect(ctx, 70, bannerY, bannerW, bannerH, 20, true, true);

                ctx.font = 'bold 22px Montserrat, Inter, sans-serif';
                ctx.fillStyle = theme.accent;
                ctx.fillText('🛒 ORDER ON WHATSAPP & ONLINE', 95, bannerY + 38);

                ctx.font = '500 18px Inter, sans-serif';
                ctx.fillStyle = theme.textSecondary;
                ctx.fillText(fullStoreUrl.replace(/^https?:\/\//, ''), 95, bannerY + 68);
                ctx.restore();
            }
        }

        function downloadPoster() {
            const canvas = document.getElementById('posterCanvas');
            if (!canvas || !currentPosterItem) return;

            const link = document.createElement('a');
            const sanitizedTitle = (currentPosterItem.title || 'product').toLowerCase().replace(/[^a-z0-9]/g, '_');
            link.download = `${merchantStoreSlug}_${sanitizedTitle}_poster.png`;
            link.href = canvas.toDataURL('image/png');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // ==========================================
        // Daily WhatsApp Auto-Poster Opener
        // ==========================================
        async function openDailyAutoPoster() {
            try {
                const res = await fetch('/api/merchant/auto-poster/featured');
                const data = await res.json();
                if (data.success && data.featured_items && data.featured_items.length > 0) {
                    const topItem = data.featured_items[0];
                    openSocialPosterModal({
                        ...topItem,
                        badge: '🔥 TODAY\'S DROP'
                    });
                } else {
                    alert('Please add at least one product with a photo to generate your Daily Auto-Poster.');
                }
            } catch (e) {
                alert('Failed to load featured products for poster.');
            }
        }

        // ==========================================
        // Bulk CSV Import Controller
        // ==========================================
        let parsedCSVRows = [];

        function openBulkImportModal() {
            document.getElementById('bulkImportModal').classList.remove('hidden');
            document.getElementById('bulkCsvTextarea').value = '';
            document.getElementById('csvPreviewContainer').classList.add('hidden');
            const statusBox = document.getElementById('bulkImportStatusBox');
            statusBox.className = 'hidden';
            parsedCSVRows = [];
        }

        function closeBulkImportModal() {
            document.getElementById('bulkImportModal').classList.add('hidden');
        }

        function loadSampleCSVInTextarea() {
            const sampleText = `Title,Category,Price,Compare Price,Stock Quantity,Low Stock Threshold,SKU,Description,Image URL,Is Preorder,Preorder Date
"Classic Oxford Cotton Shirt","Fashion",15000,18000,50,5,"SHIRT-OXF-01","Premium breathable cotton casual shirt","https://images.unsplash.com/photo-1596755094514-f87e34085b2c",0,""
"Smoky Jollof & Grilled Chicken","Food & Restaurant",4500,5000,100,10,"FOOD-JOL-01","Authentic party jollof with spicy grilled quarter chicken","https://images.unsplash.com/photo-1604382355076-af4b0eb60143",0,""
"Glow Boost Niacinamide Serum","Beauty",8500,10000,40,4,"BEAUTY-SER-01","Hydrating and radiant serum with 10% niacinamide","https://images.unsplash.com/photo-1620916566398-39f1143ab7be",0,""
"Wireless ANC Earbuds Pro","Electronics",28000,35000,25,3,"TECH-EAR-01","Active noise cancelling bluetooth 5.3 earbuds","https://images.unsplash.com/photo-1590658268037-6bf12165a8df",1,"2026-11-20"`;
            document.getElementById('bulkCsvTextarea').value = sampleText;
            handleCSVTextChange();
        }

        function handleCSVFileSelect(files) {
            if (!files || files.length === 0) return;
            const file = files[0];
            const reader = new FileReader();
            reader.onload = function(e) {
                const text = e.target.result;
                document.getElementById('bulkCsvTextarea').value = text;
                handleCSVTextChange();
            };
            reader.readAsText(file);
        }

        function handleCSVTextChange() {
            const text = document.getElementById('bulkCsvTextarea').value.trim();
            if (!text) {
                document.getElementById('csvPreviewContainer').classList.add('hidden');
                parsedCSVRows = [];
                return;
            }

            // Simple line-by-line parser for preview
            const rawLines = text.split(/\r?\n/).filter(l => l.trim().length > 0);
            if (rawLines.length < 2) {
                document.getElementById('csvPreviewContainer').classList.add('hidden');
                return;
            }

            const header = rawLines[0].split(',').map(h => h.replace(/^["']|["']$/g, '').trim().toLowerCase());
            const titleIdx = header.findIndex(h => h.includes('title') || h.includes('name'));
            const catIdx = header.findIndex(h => h.includes('cat'));
            const priceIdx = header.findIndex(h => h.includes('price'));
            const stockIdx = header.findIndex(h => h.includes('stock') || h.includes('qty'));

            parsedCSVRows = [];
            const tbody = document.getElementById('csvPreviewTableBody');
            tbody.innerHTML = '';

            for (let i = 1; i < rawLines.length; i++) {
                // Match regex for quoted values or standard commas
                const cols = rawLines[i].match(/(".*?"|[^",\s]+)(?=\s*,|\s*$)/g) || rawLines[i].split(',');
                const cleanCols = cols.map(c => c.replace(/^["']|["']$/g, '').trim());
                const title = titleIdx !== -1 && cleanCols[titleIdx] ? cleanCols[titleIdx] : cleanCols[0];
                const cat = catIdx !== -1 && cleanCols[catIdx] ? cleanCols[catIdx] : (cleanCols[1] || 'General');
                const price = priceIdx !== -1 && cleanCols[priceIdx] ? cleanCols[priceIdx] : (cleanCols[2] || '0');
                const stock = stockIdx !== -1 && cleanCols[stockIdx] ? cleanCols[stockIdx] : (cleanCols[4] || '50');

                if (title) {
                    parsedCSVRows.push({ title, category: cat, price, stock });
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-gray-50';
                    tr.innerHTML = `
                        <td class="p-2 font-bold text-[#08110D] truncate max-w-[180px]">${title}</td>
                        <td class="p-2 text-[#6B756F]">${cat}</td>
                        <td class="p-2 font-mono font-bold text-[#087A50]">₦${Number(price.replace(/[^0-9.]/g, '') || 0).toLocaleString()}</td>
                        <td class="p-2 font-mono text-[#6B756F]">${stock}</td>
                    `;
                    tbody.appendChild(tr);
                }
            }

            document.getElementById('csvParsedRowCount').textContent = parsedCSVRows.length;
            if (parsedCSVRows.length > 0) {
                document.getElementById('csvPreviewContainer').classList.remove('hidden');
            } else {
                document.getElementById('csvPreviewContainer').classList.add('hidden');
            }
        }

        async function executeBulkImport() {
            const text = document.getElementById('bulkCsvTextarea').value.trim();
            if (!text) {
                alert('Please upload or paste CSV content first.');
                return;
            }

            const btn = document.getElementById('executeImportBtn');
            const statusBox = document.getElementById('bulkImportStatusBox');
            btn.disabled = true;
            btn.textContent = 'Importing...';

            try {
                const res = await fetch('/api/merchant/items/import-csv', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ csv: text })
                });
                const data = await res.json();

                if (data.success) {
                    statusBox.className = 'p-3 rounded-xl text-xs font-bold bg-emerald-50 border border-emerald-200 text-emerald-800';
                    statusBox.innerHTML = `✓ Successfully imported ${data.imported_count} products! Total catalog: ${data.total_products} items.`;
                    statusBox.classList.remove('hidden');
                    setTimeout(() => {
                        location.reload();
                    }, 1200);
                } else {
                    statusBox.className = 'p-3 rounded-xl text-xs font-bold bg-red-50 border border-red-200 text-red-800';
                    statusBox.innerHTML = `✕ Import failed: ${data.error || (data.errors && data.errors[0]) || 'Unknown error'}`;
                    statusBox.classList.remove('hidden');
                }
            } catch (err) {
                statusBox.className = 'p-3 rounded-xl text-xs font-bold bg-red-50 border border-red-200 text-red-800';
                statusBox.innerHTML = '✕ Network error while importing CSV.';
                statusBox.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Import Products ✓';
            }
        }
    </script>
    <%- include('components/bottom_nav.ejs', { activeTab: 'products' }) %>
</body>
