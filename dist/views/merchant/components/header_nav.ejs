<!-- Mobile App Spacing Styles (Strictly active only inside the Android WebView app, zero effect on website) -->
<style id="mobileAppSpacingStyles">
    html.is-mobile-app header {
        padding-top: max(1.125rem, env(safe-area-inset-top, 1.125rem)) !important;
    }
    html.is-mobile-app nav[aria-label="Merchant Mobile Navigation"] {
        padding-bottom: max(1.25rem, env(safe-area-inset-bottom, 1.25rem)) !important;
    }
    html.is-mobile-app main {
        padding-bottom: calc(max(1.25rem, env(safe-area-inset-bottom, 1.25rem)) + 4.75rem) !important;
    }
    html.is-mobile-app .mobile-app-fab {
        bottom: calc(max(1.25rem, env(safe-area-inset-bottom, 1.25rem)) + 4rem) !important;
    }
    html.is-mobile-app .merchant-drawer-header {
        padding-top: max(2rem, calc(env(safe-area-inset-top, 0px) + 1.25rem)) !important;
    }
    html.is-mobile-app .merchant-drawer-footer {
        padding-bottom: max(1.5rem, calc(env(safe-area-inset-bottom, 0px) + 1rem)) !important;
    }
</style>
<script>
    (function() {
        try {
            var isApp = <%= (typeof isMobileApp !== 'undefined' && isMobileApp) ? 'true' : 'false' %> ||
                        (typeof navigator !== 'undefined' && navigator.userAgent && navigator.userAgent.indexOf('ZlikMerchantApp') !== -1) ||
                        (typeof window !== 'undefined' && !!window.AndroidBridge);
            if (isApp) {
                document.documentElement.classList.add('is-mobile-app');
            }
        } catch(e) {}
    })();
</script>

<!-- Merchant Universal Header Component (Batch 2 & 3) -->
<header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-[#E3E9E5] shadow-2xs font-body select-none">
    <div class="max-w-7xl mx-auto px-3 sm:px-4 pt-3.5 pb-2.5 sm:py-3.5 flex items-center justify-between gap-2 sm:gap-4">
        
        <!-- Left: Brand / Store Identity or Contextual Back Button -->
        <div class="flex items-center gap-2 sm:gap-3 min-w-0">
            <% if (typeof backUrl !== 'undefined' && backUrl) { %>
                <!-- Contextual Back Button on Child Screens -->
                <a href="<%= backUrl %>" 
                   class="w-9 h-9 rounded-xl bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] flex items-center justify-center transition border border-[#E3E9E5] shrink-0"
                   aria-label="Back">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M15 19l-7-7 7-7"/>
                    </svg>
                </a>
            <% } %>

            <!-- Store Avatar / Logo -->
            <% if (typeof store !== 'undefined' && store && store.logo_url && store.logo_url !== 'null') { %>
                <img src="<%= store.logo_url %>" alt="Logo" class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl object-contain border border-[#E3E9E5] bg-white p-0.5 shrink-0 shadow-2xs" onerror="this.classList.add('hidden'); this.nextElementSibling?.classList.remove('hidden');">
                <div class="hidden w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#08110D] text-[#19D98B] font-bold text-sm sm:text-base flex items-center justify-center font-display shrink-0 shadow-2xs">
                    <%= (typeof store !== 'undefined' && store && store.store_name ? store.store_name.charAt(0).toUpperCase() : 'S') %>
                </div>
            <% } else { %>
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-[#08110D] text-[#19D98B] font-bold text-sm sm:text-base flex items-center justify-center font-display shrink-0 shadow-2xs">
                    <%= (typeof store !== 'undefined' && store && store.store_name ? store.store_name.charAt(0).toUpperCase() : 'S') %>
                </div>
            <% } %>

            <div class="min-w-0">
                <div class="flex items-center gap-1.5 sm:gap-2">
                    <h1 class="text-xs sm:text-sm font-bold text-[#08110D] truncate font-display max-w-[130px] sm:max-w-[200px]">
                        <%= (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : ((typeof store !== 'undefined' && store && store.store_name) ? store.store_name : 'Merchant') %>
                    </h1>
                    <span class="text-[9px] sm:text-[10px] font-extrabold px-1.5 sm:px-2 py-0.5 rounded-full uppercase shrink-0 <%= (typeof isPro !== 'undefined' && isPro) ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-700' %>">
                        <%= (typeof isPro !== 'undefined' && isPro) ? 'PRO' : 'FREE' %>
                    </span>
                    <% if (typeof isPro !== 'undefined' && !isPro) { %>
                        <button type="button" 
                                onclick="if(typeof triggerUpgradeModal === 'function') triggerUpgradeModal('Header Upgrade'); else window.location.href='/#pricing';"
                                class="text-[9px] sm:text-[10px] font-extrabold px-2 py-0.5 rounded-full bg-[#08110D] hover:bg-black text-[#19D98B] transition shrink-0 hidden sm:flex items-center gap-1 shadow-2xs font-display">
                            <svg class="w-3 h-3 text-[#19D98B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                            <span>Upgrade</span>
                        </button>
                    <% } %>
                </div>
                <p class="text-[11px] sm:text-xs text-[#6B756F] truncate">
                    <%= (typeof store !== 'undefined' && store) ? (store.email || store.whatsapp_number || store.slug + '.zlik.store') : 'Merchant Console' %>
                </p>
            </div>
        </div>

        <!-- Right Header Actions -->
        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
            
            <!-- Desktop-Only Utility Actions (Keeps Desktop Experience 100% Intact) -->
            <div class="hidden sm:flex items-center gap-1.5 sm:gap-2">
                <!-- Store QR Modal Trigger (Desktop) -->
                <button type="button" onclick="if(typeof openQrModal === 'function') openQrModal(); else window.location.href='/merchant/settings#qr';" title="Store QR Code" class="bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] text-xs font-semibold px-3 py-2 rounded-xl border border-[#E3E9E5] transition flex items-center gap-1.5 shadow-2xs">
                    <svg class="w-4 h-4 text-[#08110D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                    </svg>
                    <span>Store QR</span>
                </button>

                <!-- Sound Audio Chimes Toggle (Desktop) -->
                <button onclick="if(typeof toggleAudio === 'function') toggleAudio(); else handleDrawerToggleAudio();" id="soundToggle" title="Audio Chimes" class="bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] text-xs font-semibold px-3 py-2 rounded-xl border border-[#E3E9E5] transition flex items-center gap-1.5 shadow-2xs">
                    <svg id="soundToggleIcon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
                    <span id="soundToggleText">Sound: ON</span>
                </button>
            </div>

            <!-- Public Storefront Link (Available on Mobile & Desktop) -->
            <% if (typeof store !== 'undefined' && store && store.slug) { %>
                <a href="/<%= store.slug %>" 
                   target="_blank" 
                   title="View Public Storefront" 
                   class="bg-[#08110D] hover:bg-black text-[#19D98B] font-semibold text-xs p-2 sm:px-3.5 sm:py-2 rounded-xl transition flex items-center gap-1.5 shadow-2xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                    <span class="hidden sm:inline">Storefront ↗</span>
                </a>
            <% } %>

            <!-- Mobile Hamburger Menu Button (Triggers Secondary Drawer) -->
            <button type="button" 
                    onclick="openMerchantDrawer()" 
                    class="sm:hidden w-10 h-10 rounded-xl bg-[#F8FAF8] hover:bg-[#E3E9E5] border border-[#E3E9E5] text-[#08110D] flex items-center justify-center transition shadow-2xs active:scale-95 shrink-0"
                    aria-label="Open Navigation Menu">
                <svg class="w-5 h-5 text-[#08110D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>

            <!-- Desktop Sign Out Link -->
            <a href="/merchant/logout" 
               onclick="return confirm('Are you sure you want to sign out of zlik merchant?');"
               title="Sign Out" 
               class="hidden sm:flex text-[#6B756F] hover:text-red-600 p-2 rounded-xl transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
            </a>
        </div>
    </div>

    <!-- Desktop Navigation Tabs (Preserved on >= 640px screens; Sticky bottom bar is used on mobile) -->
    <div class="hidden sm:flex max-w-7xl mx-auto px-4 items-center gap-1.5 overflow-x-auto text-xs font-medium border-t border-[#EAEFEB]/80 pt-2.5 pb-2.5">
        <a href="/merchant" class="px-3.5 py-1.5 rounded-full transition <%= (typeof activeTab !== 'undefined' && activeTab === 'orders') ? 'bg-[#084C38] text-white font-semibold shadow-xs' : 'text-[#6B7280] hover:text-[#111827] hover:bg-gray-100/70' %>">Orders</a>
        <a href="/merchant/items" class="px-3.5 py-1.5 rounded-full transition <%= (typeof activeTab !== 'undefined' && activeTab === 'products') ? 'bg-[#084C38] text-white font-semibold shadow-xs' : 'text-[#6B7280] hover:text-[#111827] hover:bg-gray-100/70' %>">Products</a>
        <a href="/merchant/ledger" class="px-3.5 py-1.5 rounded-full transition <%= (typeof activeTab !== 'undefined' && activeTab === 'ledger') ? 'bg-[#084C38] text-white font-semibold shadow-xs' : 'text-[#6B7280] hover:text-[#111827] hover:bg-gray-100/70' %>">Sales & Wallet</a>
        <a href="/merchant/reviews" class="px-3.5 py-1.5 rounded-full transition <%= (typeof activeTab !== 'undefined' && activeTab === 'reviews') ? 'bg-[#084C38] text-white font-semibold shadow-xs' : 'text-[#6B7280] hover:text-[#111827] hover:bg-gray-100/70' %> flex items-center gap-1.5">
            <span>Reviews</span>
            <% if (typeof pending_count !== 'undefined' && pending_count > 0) { %>
                <span class="bg-[#19D98B] text-[#08110D] text-[10px] font-bold px-1.5 py-0.2 rounded-full"><%= pending_count %></span>
            <% } %>
        </a>
        <a href="/merchant/debts" class="px-3.5 py-1.5 rounded-full transition <%= (typeof activeTab !== 'undefined' && activeTab === 'debts') ? 'bg-[#084C38] text-white font-semibold shadow-xs' : 'text-[#6B7280] hover:text-[#111827] hover:bg-gray-100/70' %>">Debts</a>
        <a href="/merchant/messages" class="px-3.5 py-1.5 rounded-full transition <%= (typeof activeTab !== 'undefined' && activeTab === 'chat') ? 'bg-[#084C38] text-white font-semibold shadow-xs' : 'text-[#6B7280] hover:text-[#111827] hover:bg-gray-100/70' %> flex items-center gap-1.5">
            <span>Live Chat</span>
            <span id="navChatUnreadBadge" class="hidden bg-[#19D98B] text-[#08110D] text-[10px] font-semibold px-2 py-0.2 rounded-full animate-pulse shadow-2xs">0 new</span>
        </a>
        <a href="/merchant/settings" class="px-3.5 py-1.5 rounded-full transition <%= (typeof activeTab !== 'undefined' && activeTab === 'settings') ? 'bg-[#084C38] text-white font-semibold shadow-xs' : 'text-[#6B7280] hover:text-[#111827] hover:bg-gray-100/70' %>">Settings</a>
        <a href="/merchant/verification" class="px-3.5 py-1.5 rounded-full transition <%= (typeof activeTab !== 'undefined' && activeTab === 'verification') ? 'bg-[#084C38] text-white font-semibold shadow-xs' : 'text-[#6B7280] hover:text-[#111827] hover:bg-gray-100/70' %> flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#087A50]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span>Trust & Verification</span>
        </a>
    </div>
</header>
