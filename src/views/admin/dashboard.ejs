            </div>
            <span class="text-xl">🌱</span>
          </div>

          <div class="space-y-3 text-xs">
            <div>
              <label class="block text-white/70 font-semibold mb-1">Product Catalog Limit</label>
              <input type="number" id="limit_free_max_products" value="<%= plans.free.limits.max_products || 10 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
