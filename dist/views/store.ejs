        function quickAddToCart(productId) {
            const product = productsData.find(p => p.id === productId || p.id === parseInt(productId));
            if (!product) return;

            let hasRequiredOptions = false;
            try {
                let opt = product.option_groups_json ? (typeof product.option_groups_json === 'string' ? JSON.parse(product.option_groups_json) : product.option_groups_json) : [];
                if (Array.isArray(opt) && opt.some(g => g && g.required)) hasRequiredOptions = true;
            } catch(e){}

            // If product has required options, open modal for customization
            if (hasRequiredOptions) {
                openProductModal(productId);
                return;
            }

            const unitPrice = parseFloat(product.price || 0);
            const existing = cart.find(i => i.id === product.id && !i.variant && !i.selected_options);
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({
                    id: product.id,
                    title: product.title,
                    price: unitPrice,
                    quantity: 1,
                    image_url: product.image_url,
                    variant: null,
                    selected_options: null,
                    notes: null
                });
            }

            trackEvent('AddToCart', {
                content_name: product.title,
                content_ids: [String(product.id)],
                value: unitPrice,
                currency: 'NGN'
            });

            renderCart();
            toggleCartDrawer(true);
            showToast(`Added "${product.title}" to cart!`);
        }

