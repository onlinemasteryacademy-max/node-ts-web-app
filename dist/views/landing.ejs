  <!-- ==========================================
       REGISTRATION & ONBOARDING WIZARD MODAL
       ========================================== -->
  <div id="registerModal" class="fixed inset-0 bg-[#08110D]/70 backdrop-blur-xs z-50 flex items-center justify-center p-3 sm:p-4 hidden">
    <div class="bg-white w-full max-w-lg p-5 sm:p-8 rounded-3xl relative shadow-2xl border border-[#E3E9E5] max-h-[92vh] overflow-y-auto">
      <button onclick="closeRegisterModal()" class="absolute top-5 right-5 text-[#6B756F] hover:text-[#08110D] text-lg font-semibold w-8 h-8 rounded-full flex items-center justify-center hover:bg-gray-100 transition">✕</button>

      <!-- ==========================================
           STEP 1: STORE DETAILS & PLAN SELECTION
           ========================================== -->
      <div id="signupStep1">
        <div class="mb-5">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[10px] uppercase font-bold tracking-wider px-2.5 py-0.5 rounded-full bg-[#19D98B]/20 text-[#087A50] font-mono">Step 1 of 2</span>
            <span class="text-xs text-[#6B756F]">Quick Setup</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold font-display tracking-tight text-[#08110D]">Create your online store</h3>
          <p class="text-xs text-[#6B756F] mt-1">Get your store link and start taking orders directly with instant verification.</p>
        </div>

        <form id="initiateSignupForm" onsubmit="handleSignupInitiate(event)" class="space-y-4">
          <!-- Plan Tier Picker Pills -->
          <div>
            <label class="block text-xs font-semibold text-[#08110D] mb-1.5">Choose Your Plan</label>
            <div class="grid grid-cols-3 gap-2">
              <label onclick="selectModalPlan('free')" id="planOption-free" class="border-2 border-[#08110D] bg-[#F8FAF8] rounded-xl p-2.5 cursor-pointer text-center transition flex flex-col justify-between">
                <input type="radio" name="plan_tier" value="free" class="hidden" checked>
                <div class="text-xs font-bold text-[#08110D]">Starter</div>
                <div class="text-[11px] font-semibold text-[#087A50] mt-0.5">Free (₦0)</div>
                <div class="text-[9.5px] text-[#6B756F] mt-0.5">1 store &bull; 10 items</div>
              </label>

              <label onclick="selectModalPlan('pro')" id="planOption-pro" class="border border-[#E3E9E5] bg-white hover:border-gray-400 rounded-xl p-2.5 cursor-pointer text-center transition flex flex-col justify-between">
                <input type="radio" name="plan_tier" value="pro" class="hidden">
                <div class="text-xs font-bold text-[#08110D] flex items-center justify-center gap-1">
                  <span>Pro</span>
                  <span class="text-[9px] bg-[#19D98B]/30 text-[#087A50] px-1 rounded">HOT</span>
                </div>
                <div class="text-[11px] font-semibold text-[#08110D] mt-0.5" id="modalProPriceLabel">₦<%= Number(plans.pro.price_monthly).toLocaleString() %>/mo</div>
                <div class="text-[9.5px] text-[#6B756F] mt-0.5">3 stores &bull; 500 items</div>
              </label>

              <label onclick="selectModalPlan('business')" id="planOption-business" class="border border-[#E3E9E5] bg-white hover:border-gray-400 rounded-xl p-2.5 cursor-pointer text-center transition flex flex-col justify-between">
                <input type="radio" name="plan_tier" value="business" class="hidden">
                <div class="text-xs font-bold text-[#08110D]">Business</div>
                <div class="text-[11px] font-semibold text-[#08110D] mt-0.5" id="modalBizPriceLabel">₦<%= Number(plans.business.price_monthly).toLocaleString() %>/mo</div>
                <div class="text-[9.5px] text-[#6B756F] mt-0.5">10 stores &bull; Unlimited</div>
              </label>
            </div>

            <!-- Billing Cycle Toggle (Shown when Pro/Business is selected) -->
            <div id="modalBillingCycleBox" class="hidden mt-2.5 p-2.5 bg-[#F8FAF8] rounded-xl border border-[#E3E9E5] flex items-center justify-between">
              <span class="text-xs text-[#08110D] font-medium">Billing Cycle:</span>
              <div class="flex items-center gap-1.5 bg-white p-1 rounded-lg border border-[#E3E9E5]">
                <button type="button" onclick="setModalBillingCycle('monthly')" id="modalCycleBtn-monthly" class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-[#08110D] text-white transition">Monthly</button>
                <button type="button" onclick="setModalBillingCycle('yearly')" id="modalCycleBtn-yearly" class="px-2.5 py-1 rounded-md text-[11px] font-semibold text-[#6B756F] hover:text-[#08110D] transition">Yearly <span class="text-[9px] text-[#087A50] font-bold">(Save 2 mo)</span></button>
              </div>
              <input type="hidden" name="billing_cycle" id="modalHiddenBillingCycle" value="monthly">
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#08110D] mb-1">Store name</label>
            <input type="text" name="store_name" id="regStoreName" required placeholder="e.g. Luxe Aura Collections" class="w-full border border-[#E3E9E5] rounded-xl px-3.5 py-2.5 bg-white text-sm outline-none focus:border-[#08110D] transition">
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-[#08110D] mb-1">Your full name</label>
              <input type="text" name="owner_name" id="regOwnerName" required placeholder="Jane Doe" class="w-full border border-[#E3E9E5] rounded-xl px-3.5 py-2.5 bg-white text-sm outline-none focus:border-[#08110D] transition">
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#08110D] mb-1">Phone / WhatsApp</label>
              <input type="tel" name="whatsapp_number" id="regPhone" required placeholder="08012345678" class="w-full border border-[#E3E9E5] rounded-xl px-3.5 py-2.5 bg-white text-sm outline-none focus:border-[#08110D] transition">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-[#08110D] mb-1">Email address</label>
              <input type="email" name="email" id="regEmail" required placeholder="you@example.com" class="w-full border border-[#E3E9E5] rounded-xl px-3.5 py-2.5 bg-white text-sm outline-none focus:border-[#08110D] transition">
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#08110D] mb-1">Password</label>
              <input type="password" name="password" id="regPassword" required placeholder="••••••••" class="w-full border border-[#E3E9E5] rounded-xl px-3.5 py-2.5 bg-white text-sm outline-none focus:border-[#08110D] transition">
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#08110D] mb-1">Business category</label>
            <select id="industrySelect" name="industry_id" required onchange="handleIndustryChange(this.value)" class="w-full border border-[#E3E9E5] rounded-xl px-3.5 py-2.5 bg-white text-sm outline-none focus:border-[#08110D] transition">
              <option value="1">Fashion & Clothing</option>
              <option value="2">Beauty & Personal Care</option>
              <option value="3">Food & Restaurant</option>
              <option value="4">Phones & Electronics</option>
              <option value="5">Home & Living</option>
              <option value="6" selected>General Retail</option>
            </select>
          </div>
          
          <div>
            <label class="block text-xs font-semibold text-[#08110D] mb-1">Store layout design</label>
            <input type="hidden" name="template_slug" id="selectedTemplateSlug" value="general-store">
            <input type="hidden" name="template_id" id="selectedTemplateId" value="16">
            <input type="hidden" name="business_type" id="hiddenBusinessType" value="retail">
            
            <div id="templateCardsContainer" class="grid grid-cols-3 gap-2 mt-1">
              <!-- Populated dynamically via JS -->
            </div>
          </div>

          <div id="registerError" class="text-xs text-[#D94A4A] bg-red-50 border border-red-200 rounded-xl p-3 font-medium hidden"></div>

          <button type="submit" id="initiateSubmitBtn" class="w-full bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] text-sm font-bold font-display py-3.5 rounded-xl transition shadow-xs flex items-center justify-center gap-2">
            <span>Continue to Email Confirmation</span>
            <span>&rarr;</span>
          </button>
        </form>
      </div>

      <!-- ==========================================
           STEP 2: 6-DIGIT EMAIL OTP VERIFICATION
           ========================================== -->
      <div id="signupStep2" class="hidden">
        <div class="text-center space-y-2 mb-6">
          <div class="w-12 h-12 bg-[#19D98B]/20 text-[#087A50] rounded-2xl flex items-center justify-center mx-auto text-xl font-bold">
            ✉
          </div>
          <span class="text-[10px] uppercase font-bold tracking-wider px-2.5 py-0.5 rounded-full bg-[#19D98B]/20 text-[#087A50] font-mono">Step 2 of 2</span>
          <h3 class="text-xl font-bold font-display text-[#08110D]">Confirm your email</h3>
          <p class="text-xs text-[#6B756F]">
            We sent a 6-digit confirmation code to <strong id="step2TargetEmail" class="text-[#08110D]"></strong>
          </p>
        </div>

        <form id="verifyOtpForm" onsubmit="handleVerifyOtp(event)" class="space-y-4">
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-semibold text-[#08110D]">Enter 6-Digit Code</label>
              <!-- Live 59-Second Countdown Timer Badge -->
              <div id="otpTimerBadge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-[11px] font-mono font-semibold text-[#087A50] transition-colors">
                <span id="otpTimerIcon">⏱</span>
                <span>Expires in: <strong id="otpCountdownText" class="font-bold">00:59</strong></span>
              </div>
            </div>
            <div class="max-w-xs mx-auto">
              <input type="text" id="otpCodeInput" maxlength="6" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" required placeholder="123456" class="w-full text-center text-2xl sm:text-3xl font-bold tracking-[0.4em] font-mono border-2 border-[#08110D] rounded-2xl py-3 bg-[#F8FAF8] outline-none focus:bg-white focus:border-[#19D98B] transition">
            </div>
            <p id="otpTimerHint" class="text-[11px] text-[#6B756F] text-center mt-2">Only the code sent to your email is accepted.</p>
          </div>

          <div id="verifyError" class="text-xs text-[#D94A4A] bg-red-50 border border-red-200 rounded-xl p-3 font-medium text-center hidden"></div>

          <button type="submit" id="verifySubmitBtn" class="w-full bg-[#08110D] hover:bg-black text-[#19D98B] text-sm font-bold font-display py-3.5 rounded-xl transition shadow-xs flex items-center justify-center gap-2">
            <span id="verifySubmitBtnText">Verify & Activate Store</span>
            <span>&rarr;</span>
          </button>
        </form>

        <div class="mt-6 pt-4 border-t border-[#E3E9E5] flex items-center justify-between text-xs">
          <button type="button" onclick="goToStep1()" class="text-[#6B756F] hover:text-[#08110D] transition flex items-center gap-1 font-medium">
            <span>&larr;</span>
            <span>Edit details</span>
          </button>

          <button type="button" id="resendOtpBtn" onclick="handleResendOtp()" class="text-[#6B756F] font-semibold transition disabled:opacity-50 disabled:cursor-not-allowed">
            Resend Code (59s)
          </button>
        </div>
      </div>

      <!-- ==========================================
           STEP 3: PAYMENT WAITING / REDIRECTING
           ========================================== -->
      <div id="signupStep3" class="hidden text-center py-6 space-y-4">
        <div class="w-14 h-14 bg-[#08110D] text-[#19D98B] rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold shadow-lg animate-bounce">
          ⚡
        </div>
        <div>
          <h3 class="text-xl font-bold font-display text-[#08110D]" id="step3Title">Launching Paystack Checkout...</h3>
          <p class="text-xs text-[#6B756F] mt-1" id="step3Subtitle">Complete your subscription payment to activate your Pro tier.</p>
        </div>

        <div id="step3ActionBox" class="pt-2">
          <button type="button" id="paystackRetryBtn" onclick="triggerPaystackPopup()" class="w-full bg-[#08110D] hover:bg-black text-[#19D98B] text-sm font-bold font-display py-3.5 rounded-xl transition shadow-xs">
            Pay with Paystack Now &rarr;
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- ==========================================
       CONTACT / SUPPORT MODAL
       ========================================== -->
  <div id="contactModal" class="fixed inset-0 bg-[#08110D]/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white w-full max-w-md p-6 sm:p-8 rounded-2xl relative shadow-zlik border border-[#E3E9E5] max-h-[92vh] overflow-y-auto text-left">
      <button onclick="closeContactModal()" class="absolute top-5 right-5 text-[#6B756F] hover:text-[#08110D] text-lg font-semibold">✕</button>

      <div class="mb-6 space-y-1">
        <h3 class="text-xl font-bold font-display tracking-tight text-[#08110D]">Contact zlik Support</h3>
        <p class="text-xs text-[#6B756F]">We are here to help you get set up and scale your online sales.</p>
      </div>

      <div class="space-y-4">
        <a href="https://wa.me/2348012345678?text=Hello%20zlik%20Team,%20I%20need%20help%20with%20my%20store." target="_blank" class="p-4 rounded-xl border border-[#E3E9E5] hover:border-[#19D98B] bg-[#F8FAF8] hover:bg-emerald-50/40 transition flex items-center gap-3.5 group">
          <div class="w-10 h-10 rounded-lg bg-[#25D366]/15 text-[#25D366] flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 0C5.395 0 .01 5.385.01 12.022a11.96 11.96 0 0 0 1.608 6.002L.012 24l6.148-1.611a11.97 11.97 0 0 0 5.871 1.533h.005c6.635 0 12.02-5.385 12.02-12.022A12.02 12.02 0 0 0 12.031 0zm0 22.008h-.004a10.02 10.02 0 0 1-5.107-1.393l-.366-.217-3.794.995 1.013-3.699-.239-.38a9.98 9.98 0 0 1-1.533-5.292c0-5.526 4.498-10.024 10.03-10.024a9.97 9.97 0 0 1 7.087 2.935 9.97 9.97 0 0 1 2.938 7.087c0 5.526-4.498 10.024-10.024 10.024zm5.495-7.511c-.301-.151-1.782-.88-2.058-.98-.276-.101-.477-.151-.678.151-.201.301-.778.98-.954 1.181-.176.201-.351.226-.653.075-.301-.151-1.272-.469-2.423-1.496-.895-.798-1.5-1.784-1.676-2.086-.176-.301-.019-.464.132-.614.136-.135.301-.352.452-.527.151-.176.201-.301.301-.502.101-.201.05-.377-.025-.527-.075-.151-.678-1.633-.929-2.236-.245-.588-.493-.508-.678-.518l-.578-.01c-.201 0-.527.075-.803.377s-1.054 1.03-1.054 2.511c0 1.482 1.079 2.913 1.23 3.114.151.201 2.124 3.243 5.145 4.549.719.311 1.28.497 1.718.636.722.229 1.378.197 1.897.119.578-.087 1.782-.728 2.033-1.431.251-.703.251-1.306.176-1.431-.075-.125-.276-.201-.577-.352z"/>
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-[#08110D] group-hover:text-[#087A50] transition">Chat on WhatsApp</div>
            <div class="text-[11px] text-[#6B756F]">Instant live seller support & onboarding</div>
          </div>
        </a>

        <a href="mailto:support@zlik.store" class="p-4 rounded-xl border border-[#E3E9E5] hover:border-[#08110D] bg-[#F8FAF8] transition flex items-center gap-3.5 group">
          <div class="w-10 h-10 rounded-lg bg-gray-200 text-[#08110D] flex items-center justify-center shrink-0 text-sm font-bold">
            ✉
          </div>
          <div>
            <div class="text-xs font-bold text-[#08110D]">Email Support</div>
            <div class="text-[11px] text-[#6B756F]">support@zlik.store</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <script>
    const industryTemplatesData = {
      1: [
        { id: 1, name: 'Editorial', slug: 'fashion-editorial', btype: 'fashion', desc: 'Lookbook style' },
        { id: 2, name: 'Store', slug: 'fashion-store', btype: 'fashion', desc: 'Boutique grid' },
        { id: 3, name: 'Boutique', slug: 'fashion-boutique', btype: 'fashion', desc: 'Clean collection' }
      ],
      2: [
        { id: 4, name: 'Minimal', slug: 'beauty-minimal', btype: 'cosmetics', desc: 'Skincare grid' },
        { id: 5, name: 'Collection', slug: 'beauty-collection', btype: 'cosmetics', desc: 'Beauty catalogue' },
        { id: 6, name: 'Brand', slug: 'beauty-brand', btype: 'cosmetics', desc: 'Product focus' }
      ],
      3: [
        { id: 7, name: 'Menu', slug: 'restaurant-menu', btype: 'restaurant', desc: 'Dishes list' },
        { id: 8, name: 'Delivery', slug: 'food-delivery', btype: 'restaurant', desc: 'Takeout' },
        { id: 9, name: 'Bakery', slug: 'bakery-cakes', btype: 'restaurant', desc: 'Custom orders' }
      ],
      4: [
        { id: 10, name: 'Gadgets', slug: 'gadget-store', btype: 'retail', desc: 'Tech specs' },
        { id: 11, name: 'Electronics', slug: 'electronics-catalog', btype: 'retail', desc: 'Catalog' },
        { id: 12, name: 'Deals', slug: 'tech-deals', btype: 'retail', desc: 'Promos' }
      ],
      5: [
        { id: 13, name: 'Home', slug: 'home-store', btype: 'retail', desc: 'Lifestyle' },
        { id: 14, name: 'Living', slug: 'furniture-decor', btype: 'retail', desc: 'Artisan' },
        { id: 15, name: 'Catalogue', slug: 'lifestyle-catalog', btype: 'retail', desc: 'Essentials' }
      ],
      6: [
        { id: 16, name: 'General', slug: 'general-store', btype: 'retail', desc: 'All purpose' },
        { id: 17, name: 'Catalog', slug: 'product-catalog', btype: 'retail', desc: 'Fast scanning' },
        { id: 18, name: 'Social', slug: 'social-seller', btype: 'retail', desc: 'Bio link' }
      ]
    };

    function handleIndustryChange(indId) {
      const list = industryTemplatesData[indId] || industryTemplatesData[6];
      const container = document.getElementById('templateCardsContainer');
      
      container.innerHTML = list.map((t, idx) => `
        <div onclick="selectTemplateCard(${t.id}, '${t.slug}', '${t.btype}', this)" class="template-choice-card border ${idx === 0 ? 'border-[#08110D] bg-[#F8FAF8] font-semibold' : 'border-[#E3E9E5] bg-white'} p-2 rounded-lg cursor-pointer text-center hover:border-[#08110D] transition">
          <div class="text-xs text-[#08110D] line-clamp-1">${t.name}</div>
          <div class="text-[10px] text-[#6B756F] mt-0.5 line-clamp-1">${t.desc}</div>
        </div>
      `).join('');

      selectTemplateCard(list[0].id, list[0].slug, list[0].btype, container.firstElementChild);
    }

    function selectTemplateCard(id, slug, btype, el) {
      document.getElementById('selectedTemplateId').value = id;
      document.getElementById('selectedTemplateSlug').value = slug;
      document.getElementById('hiddenBusinessType').value = btype;
      
      document.querySelectorAll('.template-choice-card').forEach(c => {
        c.className = 'template-choice-card border border-[#E3E9E5] bg-white p-2 rounded-lg cursor-pointer text-center hover:border-[#08110D] transition';
      });
      if (el) {
        el.className = 'template-choice-card border-2 border-[#08110D] bg-[#F8FAF8] font-semibold p-2 rounded-lg cursor-pointer text-center transition';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      handleIndustryChange('6');
    });

    function toggleLandingBilling(cycle) {
      if (cycle === 'yearly') {
        document.getElementById('landingCycleBtn-yearly').className = 'px-5 py-2 rounded-lg text-xs font-bold font-display transition bg-[#08110D] text-white shadow-2xs flex items-center gap-1.5';
        document.getElementById('landingCycleBtn-monthly').className = 'px-5 py-2 rounded-lg text-xs font-bold font-display transition text-[#6B756F] hover:text-[#08110D]';
        document.querySelectorAll('.landing-monthly-view').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.landing-yearly-view').forEach(el => el.classList.remove('hidden'));
      } else {
        document.getElementById('landingCycleBtn-monthly').className = 'px-5 py-2 rounded-lg text-xs font-bold font-display transition bg-[#08110D] text-white shadow-2xs';
        document.getElementById('landingCycleBtn-yearly').className = 'px-5 py-2 rounded-lg text-xs font-bold font-display transition text-[#6B756F] hover:text-[#08110D] flex items-center gap-1.5';
        document.querySelectorAll('.landing-yearly-view').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.landing-monthly-view').forEach(el => el.classList.remove('hidden'));
      }
    }

    function toggleFeatureBreakdown() {
      const section = document.getElementById('featureBreakdownSection');
      const btnText = document.getElementById('breakdownBtnText');
      const btnIcon = document.getElementById('breakdownBtnIcon');
      
      if (section.classList.contains('hidden')) {
        section.classList.remove('hidden');
        btnText.textContent = 'Hide feature breakdown';
        btnIcon.textContent = '↑';
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        section.classList.add('hidden');
        btnText.textContent = 'Full feature breakdown';
        btnIcon.textContent = '↓';
      }
    }

    // ==========================================
    // MULTI-STEP REGISTRATION & PAYSTACK WIZARD
    // ==========================================
    let currentSignupPlan = 'free';
    let currentSignupCycle = 'monthly';
    let activeSignupToken = null;
    let activeSignupEmail = null;
    let activePaymentDetails = null;

    function selectModalPlan(plan) {
      currentSignupPlan = plan;
      ['free', 'pro', 'business'].forEach(p => {
        const el = document.getElementById('planOption-' + p);
        if (el) {
          if (p === plan) {
            el.className = 'border-2 border-[#08110D] bg-[#F8FAF8] rounded-xl p-2.5 cursor-pointer text-center transition flex flex-col justify-between';
            const radio = el.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;
          } else {
            el.className = 'border border-[#E3E9E5] bg-white hover:border-gray-400 rounded-xl p-2.5 cursor-pointer text-center transition flex flex-col justify-between';
          }
        }
      });

      const cycleBox = document.getElementById('modalBillingCycleBox');
      if (plan === 'free') {
        cycleBox.classList.add('hidden');
      } else {
        cycleBox.classList.remove('hidden');
      }
    }

    function setModalBillingCycle(cycle) {
      currentSignupCycle = cycle;
      document.getElementById('modalHiddenBillingCycle').value = cycle;
      if (cycle === 'yearly') {
        document.getElementById('modalCycleBtn-yearly').className = 'px-2.5 py-1 rounded-md text-[11px] font-bold bg-[#08110D] text-white transition';
        document.getElementById('modalCycleBtn-monthly').className = 'px-2.5 py-1 rounded-md text-[11px] font-semibold text-[#6B756F] hover:text-[#08110D] transition';
        document.getElementById('modalProPriceLabel').textContent = '₦<%= Number(plans.pro.price_yearly).toLocaleString() %>/yr';
        document.getElementById('modalBizPriceLabel').textContent = '₦<%= Number(plans.business.price_yearly).toLocaleString() %>/yr';
      } else {
        document.getElementById('modalCycleBtn-monthly').className = 'px-2.5 py-1 rounded-md text-[11px] font-bold bg-[#08110D] text-white transition';
        document.getElementById('modalCycleBtn-yearly').className = 'px-2.5 py-1 rounded-md text-[11px] font-semibold text-[#6B756F] hover:text-[#08110D] transition';
        document.getElementById('modalProPriceLabel').textContent = '₦<%= Number(plans.pro.price_monthly).toLocaleString() %>/mo';
        document.getElementById('modalBizPriceLabel').textContent = '₦<%= Number(plans.business.price_monthly).toLocaleString() %>/mo';
      }
    }

    function openRegisterModal(plan = 'free') {
      selectModalPlan(plan === 'enterprise' ? 'business' : plan);
      goToStep1();
      document.getElementById('registerModal').classList.remove('hidden');
    }

    function closeRegisterModal() {
      document.getElementById('registerModal').classList.add('hidden');
      document.getElementById('registerError').classList.add('hidden');
      document.getElementById('verifyError').classList.add('hidden');
    }

    function openContactModal() {
      document.getElementById('contactModal').classList.remove('hidden');
    }

    function closeContactModal() {
      document.getElementById('contactModal').classList.add('hidden');
    }

    let otpTimerInterval = null;
    let otpSecondsRemaining = 59;

    function startOtpCountdown(duration = 59) {
      if (otpTimerInterval) clearInterval(otpTimerInterval);
      otpSecondsRemaining = duration;
      updateOtpTimerDisplay();

      const resendBtn = document.getElementById('resendOtpBtn');
      if (resendBtn) {
        resendBtn.disabled = true;
        resendBtn.classList.remove('text-[#087A50]', 'hover:underline', 'font-bold');
        resendBtn.classList.add('text-[#6B756F]', 'opacity-60', 'cursor-not-allowed');
        resendBtn.textContent = `Resend Code (${otpSecondsRemaining}s)`;
      }

      otpTimerInterval = setInterval(() => {
        otpSecondsRemaining--;
        if (otpSecondsRemaining <= 0) {
          clearInterval(otpTimerInterval);
          otpSecondsRemaining = 0;
          updateOtpTimerDisplay();
          onOtpExpired();
        } else {
          updateOtpTimerDisplay();
          if (resendBtn) {
            resendBtn.textContent = `Resend Code (${otpSecondsRemaining}s)`;
          }
        }
      }, 1000);
    }

    function updateOtpTimerDisplay() {
      const text = document.getElementById('otpCountdownText');
      const badge = document.getElementById('otpTimerBadge');
      const hint = document.getElementById('otpTimerHint');
      if (!text || !badge) return;

      const min = Math.floor(otpSecondsRemaining / 60);
      const sec = otpSecondsRemaining % 60;
      text.textContent = `${String(min).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;

      if (otpSecondsRemaining > 15) {
        badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-[11px] font-mono font-semibold text-[#087A50] transition-colors';
        if (hint) hint.innerHTML = '<span class="text-[#6B756F]">Only the 6-digit code sent to your email is accepted.</span>';
      } else if (otpSecondsRemaining > 0) {
        badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-50 border border-amber-300 text-[11px] font-mono font-semibold text-amber-700 transition-colors animate-pulse';
        if (hint) hint.innerHTML = '<span class="text-amber-600 font-medium">Code expiring soon! Please enter the 6-digit code.</span>';
      } else {
        badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-red-50 border border-red-200 text-[11px] font-mono font-semibold text-red-600 transition-colors';
        if (hint) hint.innerHTML = '<span class="text-red-600 font-semibold">⚠️ Verification code has expired. Please click "Resend Code" below.</span>';
      }
    }

    function onOtpExpired() {
      const resendBtn = document.getElementById('resendOtpBtn');
      if (resendBtn) {
        resendBtn.disabled = false;
        resendBtn.textContent = 'Resend Fresh Code ↻';
        resendBtn.classList.remove('text-[#6B756F]', 'opacity-60', 'cursor-not-allowed');
        resendBtn.classList.add('text-[#087A50]', 'hover:underline', 'font-bold');
      }
      const err = document.getElementById('verifyError');
      if (err && !err.textContent) {
        err.textContent = 'Verification code has expired. Please request a new code.';
        err.classList.remove('hidden');
      }
    }

    function goToStep1() {
      if (otpTimerInterval) clearInterval(otpTimerInterval);
      document.getElementById('signupStep1').classList.remove('hidden');
      document.getElementById('signupStep2').classList.add('hidden');
      document.getElementById('signupStep3').classList.add('hidden');
    }

    function goToStep2(email, expiresIn = 59) {
      document.getElementById('signupStep1').classList.add('hidden');
      document.getElementById('signupStep2').classList.remove('hidden');
      document.getElementById('signupStep3').classList.add('hidden');
      document.getElementById('step2TargetEmail').textContent = email;
      
      const otpInput = document.getElementById('otpCodeInput');
      otpInput.value = '';
      const err = document.getElementById('verifyError');
      if (err) err.classList.add('hidden');

      startOtpCountdown(expiresIn || 59);
      setTimeout(() => otpInput.focus(), 150);
    }

    function goToStep3(title, subtitle) {
      if (otpTimerInterval) clearInterval(otpTimerInterval);
      document.getElementById('signupStep1').classList.add('hidden');
      document.getElementById('signupStep2').classList.add('hidden');
      document.getElementById('signupStep3').classList.remove('hidden');
      if (title) document.getElementById('step3Title').textContent = title;
      if (subtitle) document.getElementById('step3Subtitle').textContent = subtitle;
    }

    // Step 1: Initiate Signup
    async function handleSignupInitiate(e) {
      e.preventDefault();
      const btn = document.getElementById('initiateSubmitBtn');
      const err = document.getElementById('registerError');
      btn.disabled = true;
      btn.innerHTML = '<span>Sending verification code...</span>';
      err.classList.add('hidden');

      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());
      data.plan_tier = currentSignupPlan;
      data.billing_cycle = currentSignupCycle;

      try {
        const res = await fetch('/api/auth/signup/initiate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
          activeSignupToken = result.token;
          activeSignupEmail = result.email;
          goToStep2(result.email, result.expires_in || 59);
        } else {
          err.textContent = result.error || 'Registration failed. Please check your information.';
          err.classList.remove('hidden');
        }
      } catch (error) {
        err.textContent = 'Network error. Please try again.';
        err.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>Continue to Email Confirmation</span> <span>&rarr;</span>';
      }
    }

    // Step 2: Verify OTP
    async function handleVerifyOtp(e) {
      e.preventDefault();
      const btn = document.getElementById('verifySubmitBtn');
      const text = document.getElementById('verifySubmitBtnText');
      const err = document.getElementById('verifyError');
      const otpCode = document.getElementById('otpCodeInput').value.trim();

      if (!otpCode || otpCode.length < 6) {
        err.textContent = 'Please enter the complete 6-digit code sent to your email.';
        err.classList.remove('hidden');
        return;
      }

      btn.disabled = true;
      text.textContent = 'Verifying code...';
      err.classList.add('hidden');

      try {
        const res = await fetch('/api/auth/signup/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            token: activeSignupToken,
            email: activeSignupEmail,
            otp_code: otpCode
          })
        });
        const result = await res.json();

        if (result.success) {
          if (otpTimerInterval) clearInterval(otpTimerInterval);
          if (!result.requires_payment) {
            // Free Tier Success!
            text.textContent = 'Launching store...';
            window.location.href = result.redirect || '/merchant';
          } else {
            // Pro / Business Tier -> Trigger Paystack Checkout
            activePaymentDetails = result;
            goToStep3('Opening Paystack Checkout...', 'Complete payment to activate your ' + result.plan_tier.toUpperCase() + ' plan.');
            triggerPaystackPopup();
          }
        } else {
          err.textContent = result.error || 'Incorrect or expired verification code.';
          err.classList.remove('hidden');
          btn.disabled = false;
          text.textContent = 'Verify & Activate Store';
        }
      } catch (error) {
        err.textContent = 'Network error during verification. Please try again.';
        err.classList.remove('hidden');
        btn.disabled = false;
        text.textContent = 'Verify & Activate Store';
      }
    }

    // Step 3: Trigger Paystack Inline Popup
    function triggerPaystackPopup() {
      if (!activePaymentDetails) return;

      const p = activePaymentDetails;
      if (typeof PaystackPop === 'undefined') {
        alert('Paystack SDK is loading. Please click "Pay with Paystack Now" in a moment.');
        return;
      }

      const handler = PaystackPop.setup({
        key: p.paystack_public_key || 'pk_test_sample',
        email: p.email,
        amount: p.amount_kobo,
        ref: p.reference,
        currency: 'NGN',
        metadata: {
          custom_fields: [
            { display_name: 'Store Name', variable_name: 'store_name', value: p.store_slug },
            { display_name: 'Plan Tier', variable_name: 'plan_tier', value: p.plan_tier }
          ]
        },
        callback: function(response) {
          // Payment Successful -> Verify signature with backend
          goToStep3('Activating Subscription...', 'Verifying transaction reference with Paystack...');
          verifyBackendSubscription(response.reference);
        },
        onClose: function() {
          goToStep3(
            'Payment Incomplete',
            'Your store has been created in pending state. Click below whenever you are ready to complete payment.'
          );
        }
      });

      handler.openIframe();
    }

    // Backend Subscription Verification Callback
    async function verifyBackendSubscription(reference) {
      try {
        const res = await fetch('/api/billing/verify_subscription', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reference })
        });
        const result = await res.json();
        if (result.success) {
          goToStep3('🎉 Upgrade Successful!', 'Redirecting to your new merchant dashboard...');
          setTimeout(() => {
            window.location.href = result.redirect || '/merchant';
          }, 1200);
        } else {
          alert(result.error || 'Verification failed. Please contact support with reference: ' + reference);
          goToStep3('Payment Verification Issue', result.error);
        }
      } catch (e) {
        goToStep3('Verification Pending', 'We are verifying your payment in the background. You may proceed to your dashboard.');
        setTimeout(() => { window.location.href = '/merchant'; }, 2000);
      }
    }

    // Resend OTP
    async function handleResendOtp() {
      const btn = document.getElementById('resendOtpBtn');
      const err = document.getElementById('verifyError');
      btn.disabled = true;
      btn.textContent = 'Sending fresh code...';
      if (err) err.classList.add('hidden');

      try {
        const res = await fetch('/api/auth/signup/resend_otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: activeSignupToken, email: activeSignupEmail })
        });
        const result = await res.json();
        if (result.success) {
          startOtpCountdown(result.expires_in || 59);
          const otpInput = document.getElementById('otpCodeInput');
          if (otpInput) {
            otpInput.value = '';
            otpInput.focus();
          }
        } else {
          if (err) {
            err.textContent = result.error || 'Could not resend code. Please wait a moment.';
            err.classList.remove('hidden');
          }
          btn.disabled = false;
          btn.textContent = 'Resend Fresh Code ↻';
        }
      } catch (e) {
        if (err) {
          err.textContent = 'Network error resending code.';
          err.classList.remove('hidden');
        }
        btn.disabled = false;
        btn.textContent = 'Resend Fresh Code ↻';
      }
    }
  </script>
</body>
</html>

