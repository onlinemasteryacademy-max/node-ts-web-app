                    <div>
                        <h3 class="font-bold text-sm text-[#111827]">Payout Bank Details & Protection</h3>
                        <p class="text-[11px] text-[#6B7280] mt-0.5">Where customer direct bank transfers are received.</p>
                    </div>
                    <% if (store.bank_account_number) { %>
                        <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 flex items-center gap-1.5 font-mono">
                            <svg class="w-3.5 h-3.5 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>VERIFIED PAYOUT BANK</span>
                        </span>
                    <% } %>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-medium text-[#111827] mb-1">Select Bank</label>
