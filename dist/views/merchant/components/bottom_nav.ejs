<!-- Floating Live Customer Chat Action Button (Screenshot 1 Reference) -->
<% if (typeof activeTab === 'undefined' || activeTab !== 'chat') { %>
<a href="/merchant/messages" 
   id="merchantChatFab"
   class="mobile-app-fab sm:hidden fixed bottom-20 right-4 z-40 w-13 h-13 rounded-full bg-[#084C38] text-white shadow-[0_8px_24px_rgba(8,76,56,0.35)] flex items-center justify-center active:scale-95 transition-all duration-200 hover:bg-[#063e2e]"
   aria-label="Live Customer Messages">
    <div class="relative flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        <span id="mobileNavChatBadge" class="hidden absolute -top-1.5 -right-2 min-w-[18px] h-[18px] px-1 rounded-full bg-[#19D98B] text-[#08110D] text-[10px] font-extrabold flex items-center justify-center ring-2 ring-white font-mono animate-pulse">0</span>
    </div>
</a>
<% } %>

<!-- Signature 5-Tab Floating Bottom Navigation Bar (Screenshots 1-5 Reference) -->
<nav class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border-t border-[#EAEFEB] px-3 py-2 flex items-center justify-between shadow-[0_-4px_24px_rgba(8,17,13,0.06)] pb-safe font-body select-none"
     aria-label="Merchant Mobile Navigation">

    <!-- Tab 1: Orders (Screenshot 1 Reference) -->
    <% const isOrders = (typeof activeTab !== 'undefined' && activeTab === 'orders'); %>
    <% if (isOrders) { %>
        <a href="/merchant" 
           class="relative flex items-center gap-2 bg-[#084C38] text-white px-3.5 py-2 rounded-full font-semibold text-xs shadow-xs transition-all duration-200 shrink-0"
           aria-label="Orders">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span class="tracking-tight text-[12px]">Orders</span>
            <span id="mobileNavOrdersBadge" class="hidden min-w-[15px] h-[15px] px-1 rounded-full bg-[#19D98B] text-[#08110D] text-[9px] font-extrabold flex items-center justify-center font-mono"></span>
        </a>
    <% } else { %>
        <a href="/merchant" 
           class="relative flex items-center justify-center w-10 h-10 rounded-full text-[#6B7280] hover:text-[#08110D] hover:bg-gray-100/60 transition-colors duration-150"
           aria-label="Orders">
            <svg class="w-5 h-5 text-[#6B7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span id="mobileNavOrdersBadge" class="hidden absolute top-1 right-1 w-2 h-2 rounded-full bg-[#19D98B] ring-2 ring-white"></span>
        </a>
    <% } %>

    <!-- Tab 2: History (Screenshot 2 Reference) -->
    <% const isHistory = (typeof activeTab !== 'undefined' && activeTab === 'history'); %>
    <% if (isHistory) { %>
        <a href="/merchant/ledger#history" 
           class="relative flex items-center gap-2 bg-[#084C38] text-white px-3.5 py-2 rounded-full font-semibold text-xs shadow-xs transition-all duration-200 shrink-0"
           aria-label="History">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span class="tracking-tight text-[12px]">History</span>
        </a>
    <% } else { %>
        <a href="/merchant/ledger#history" 
           class="relative flex items-center justify-center w-10 h-10 rounded-full text-[#6B7280] hover:text-[#08110D] hover:bg-gray-100/60 transition-colors duration-150"
           aria-label="History">
            <svg class="w-5 h-5 text-[#6B7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
        </a>
    <% } %>

    <!-- Tab 3: Wallet (Screenshot 3 Reference) -->
    <% const isWallet = (typeof activeTab !== 'undefined' && (activeTab === 'ledger' || activeTab === 'wallet')); %>
    <% if (isWallet) { %>
        <a href="/merchant/ledger" 
           class="relative flex items-center gap-2 bg-[#084C38] text-white px-3.5 py-2 rounded-full font-semibold text-xs shadow-xs transition-all duration-200 shrink-0"
           aria-label="Wallet">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
            <span class="tracking-tight text-[12px]">Wallet</span>
        </a>
    <% } else { %>
        <a href="/merchant/ledger" 
           class="relative flex items-center justify-center w-10 h-10 rounded-full text-[#6B7280] hover:text-[#08110D] hover:bg-gray-100/60 transition-colors duration-150"
           aria-label="Wallet">
            <svg class="w-5 h-5 text-[#6B7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
        </a>
    <% } %>

    <!-- Tab 4: Products (Screenshot 5 Reference) -->
    <% const isProducts = (typeof activeTab !== 'undefined' && activeTab === 'products'); %>
    <% if (isProducts) { %>
        <a href="/merchant/items" 
           class="relative flex items-center gap-2 bg-[#084C38] text-white px-3.5 py-2 rounded-full font-semibold text-xs shadow-xs transition-all duration-200 shrink-0"
           aria-label="Products">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
            <span class="tracking-tight text-[12px]">Products</span>
        </a>
    <% } else { %>
        <a href="/merchant/items" 
           class="relative flex items-center justify-center w-10 h-10 rounded-full text-[#6B7280] hover:text-[#08110D] hover:bg-gray-100/60 transition-colors duration-150"
           aria-label="Products">
            <svg class="w-5 h-5 text-[#6B7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
        </a>
    <% } %>

    <!-- Tab 5: Profile (Screenshot 4 Reference) -->
    <% const isProfile = (typeof activeTab !== 'undefined' && (activeTab === 'settings' || activeTab === 'profile' || activeTab === 'verification' || activeTab === 'reviews' || activeTab === 'debts')); %>
    <% if (isProfile) { %>
        <a href="/merchant/settings" 
           class="relative flex items-center gap-2 bg-[#084C38] text-white px-3.5 py-2 rounded-full font-semibold text-xs shadow-xs transition-all duration-200 shrink-0"
           aria-label="Profile">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span class="tracking-tight text-[12px]">Profile</span>
        </a>
    <% } else { %>
        <a href="/merchant/settings" 
           class="relative flex items-center justify-center w-10 h-10 rounded-full text-[#6B7280] hover:text-[#08110D] hover:bg-gray-100/60 transition-colors duration-150"
           aria-label="Profile">
            <svg class="w-5 h-5 text-[#6B7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
        </a>
    <% } %>
</nav>

<!-- Automatic Inclusion of Secondary Navigation Drawer -->
<%- include('drawer_nav.ejs') %>
