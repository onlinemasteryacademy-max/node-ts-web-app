                    <div class="space-y-4 <%= isPro ? '' : 'blur-[1px] opacity-60 pointer-events-none select-none' %>">
                        <div>
                            <label class="block font-medium text-[#111827] mb-1">Receipt Custom Note / Payment Policy</label>
                            <input type="text" id="receiptCustomNote" value="<%= store.receipt_custom_note || '' %>" placeholder="e.g. Thank you for your order! Goods once sold are not refundable." class="w-full bg-[#F8FAF9] border border-[#EAEFEB] rounded-2xl p-3 outline-none focus:border-[#084C38] text-xs font-medium" <%= isPro ? '' : 'disabled' %>>
