<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Customer Reviews & Moderation — <%= store.store_name %> | zlik</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        zlikDark: '#08110D',
                        zlikGreen: '#19D98B',
                        zlikDeep: '#087A50',
                        zlikBg: '#F8FAF8',
                        zlikWhite: '#FFFFFF',
                        zlikMuted: '#6B756F',
                        zlikBorder: '#E3E9E5'
                    },
                    fontFamily: {
                        display: ['Montserrat', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8FAF9; color: #111827; }
        .font-display { font-family: 'Montserrat', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .pb-safe { padding-bottom: max(0.875rem, env(safe-area-inset-bottom, 0.875rem)); }
        .pt-safe { padding-top: max(0.75rem, env(safe-area-inset-top, 0.75rem)); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

    <!-- Merchant Header (Universal Component) -->
    <%- include('components/header_nav.ejs', { activeTab: 'reviews', pageTitle: 'Customer Reviews', backUrl: '/merchant' }) %>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-4 sm:py-6 pb-28 sm:pb-8 flex-1 w-full space-y-5 sm:space-y-6">

        <!-- Top Overview Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
            <!-- Pending Moderation Card -->
            <div class="p-4 sm:p-5 rounded-3xl bg-amber-50/70 border border-amber-200 shadow-xs">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] sm:text-xs uppercase font-bold text-amber-800">Pending Review</span>
                    <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div class="text-2xl sm:text-3xl font-extrabold text-amber-950 font-mono mt-1"><%= pending_count %></div>
                <span class="text-[11px] text-amber-700">Awaiting your approval</span>
            </div>

            <!-- Approved Reviews Card -->
            <% 
                const approvedCount = reviews.filter(r => r.status === 'approved').length;
                const rejectedCount = reviews.filter(r => r.status === 'rejected').length;
                const approvedWithRating = reviews.filter(r => r.status === 'approved' && r.rating);
                const avgApproved = approvedWithRating.length > 0 
                    ? (approvedWithRating.reduce((acc, r) => acc + Number(r.rating), 0) / approvedWithRating.length).toFixed(1) 
                    : '5.0';
            %>
            <div class="p-4 sm:p-5 rounded-3xl bg-[#EDF5F1] border border-[#084C38]/20 shadow-xs">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] sm:text-xs uppercase font-bold text-[#084C38]">Public Reviews</span>
                    <svg class="w-4 h-4 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                </div>
                <div class="text-2xl sm:text-3xl font-extrabold text-[#084C38] font-mono mt-1"><%= approvedCount %></div>
                <span class="text-[11px] text-[#084C38]/80">Live on your storefront</span>
            </div>

            <!-- Rejected Reviews Card -->
            <div class="p-4 sm:p-5 rounded-3xl bg-white border border-[#EAEFEB] shadow-xs">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] sm:text-xs uppercase font-bold text-[#6B7280]">Hidden / Rejected</span>
                    <svg class="w-4 h-4 text-[#6B7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                </div>
                <div class="text-2xl sm:text-3xl font-extrabold text-[#111827] font-mono mt-1"><%= rejectedCount %></div>
                <span class="text-[11px] text-[#6B7280]">Kept for audit history</span>
            </div>

            <!-- Store Average Card -->
            <div class="p-4 sm:p-5 rounded-3xl bg-white border border-[#EAEFEB] shadow-xs">
                <div class="flex items-center justify-between">
                    <span class="text-[10px] sm:text-xs uppercase font-bold text-[#6B7280]">Avg Rating</span>
                    <svg class="w-4 h-4 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                </div>
                <div class="text-2xl sm:text-3xl font-extrabold text-[#084C38] font-mono mt-1"><%= avgApproved %> ★</div>
                <span class="text-[11px] text-[#6B7280]">From verified buyers</span>
            </div>
        </div>

        <!-- Filter Controls -->
        <div class="bg-white rounded-3xl border border-[#EAEFEB] p-3.5 sm:p-4 space-y-3 shadow-xs">
            <form method="GET" action="/merchant/reviews" class="flex flex-wrap items-center justify-between gap-3 text-xs">
                <!-- Status Filter Pills -->
                <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
                    <a href="/merchant/reviews?status=all" class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition <%= (currentFilter.status === 'all' || !currentFilter.status) ? 'bg-[#084C38] text-white shadow-xs' : 'bg-[#F8FAF9] border border-[#EAEFEB] text-[#6B7280] hover:text-[#111827]' %>">
                        All (<%= reviews.length %>)
                    </a>
                    <a href="/merchant/reviews?status=pending_review" class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition flex items-center gap-1 <%= currentFilter.status === 'pending_review' ? 'bg-amber-600 text-white shadow-xs' : 'bg-[#F8FAF9] border border-[#EAEFEB] text-amber-700 hover:text-amber-900' %>">
                        <span>Pending</span>
                        <% if (pending_count > 0) { %>
                            <span class="px-1.5 py-0.2 rounded-full text-[10px] <%= currentFilter.status === 'pending_review' ? 'bg-white text-amber-800' : 'bg-amber-200 text-amber-900' %> font-bold"><%= pending_count %></span>
                        <% } %>
                    </a>
                    <a href="/merchant/reviews?status=approved" class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition <%= currentFilter.status === 'approved' ? 'bg-[#084C38] text-white shadow-xs' : 'bg-[#F8FAF9] border border-[#EAEFEB] text-[#084C38] hover:text-[#063b2c]' %>">
                        Approved
                    </a>
                    <a href="/merchant/reviews?status=rejected" class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition <%= currentFilter.status === 'rejected' ? 'bg-rose-600 text-white shadow-xs' : 'bg-[#F8FAF9] border border-[#EAEFEB] text-rose-700 hover:text-rose-900' %>">
                        Rejected
                    </a>
                </div>

                <!-- Dropdown Selectors -->
                <div class="flex items-center gap-2">
                    <select name="item_id" onchange="this.form.submit()" class="bg-[#F8FAF9] border border-[#EAEFEB] text-[#111827] rounded-2xl px-3 py-1.5 text-xs font-medium outline-none focus:border-[#084C38]">
                        <option value="">All Products</option>
                        <% (items || []).forEach(it => { %>
                            <option value="<%= it.id %>" <%= String(currentFilter.item_id) === String(it.id) ? 'selected' : '' %>><%= it.title %></option>
                        <% }) %>
                    </select>

                    <select name="rating" onchange="this.form.submit()" class="bg-[#F8FAF9] border border-[#EAEFEB] text-[#111827] rounded-2xl px-3 py-1.5 text-xs font-medium outline-none focus:border-[#084C38]">
                        <option value="">All Ratings</option>
                        <option value="5" <%= String(currentFilter.rating) === '5' ? 'selected' : '' %>>5 Stars ★★★★★</option>
                        <option value="4" <%= String(currentFilter.rating) === '4' ? 'selected' : '' %>>4 Stars ★★★★☆</option>
                        <option value="3" <%= String(currentFilter.rating) === '3' ? 'selected' : '' %>>3 Stars ★★★☆☆</option>
                        <option value="2" <%= String(currentFilter.rating) === '2' ? 'selected' : '' %>>2 Stars ★★☆☆☆</option>
                        <option value="1" <%= String(currentFilter.rating) === '1' ? 'selected' : '' %>>1 Star ★☆☆☆☆</option>
                    </select>
                </div>
            </form>
        </div>

        <!-- Reviews List -->
        <div class="space-y-3">
            <% if (reviews.length === 0) { %>
                <div class="bg-white rounded-3xl border border-[#EAEFEB] p-10 text-center space-y-3 shadow-xs">
                    <div class="w-14 h-14 rounded-full bg-[#EDF5F1] border border-[#084C38]/10 flex items-center justify-center mx-auto text-[#084C38]">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-[#111827]">No Reviews Found</h3>
                        <p class="text-xs text-[#6B7280] max-w-sm mx-auto mt-0.5">
                            <% if (currentFilter.status === 'pending_review') { %>
                                You're all caught up! No reviews are currently awaiting moderation.
                            <% } else { %>
                                Customer reviews will appear here once buyers verify their purchases on your product pages.
                            <% } %>
                        </p>
                    </div>
                </div>
            <% } else { %>
                <% reviews.forEach(r => { %>
                    <div class="bg-white rounded-3xl border border-[#EAEFEB] p-5 shadow-xs space-y-3.5 transition hover:border-[#084C38]/30" id="review-card-<%= r.id %>">
                        <!-- Top Row: Product info, Rating & Status -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pb-2.5 border-b border-[#EAEFEB]">
                            <div class="flex items-center gap-3 min-w-0">
                                <% if (r.product_image) { %>
                                    <img src="<%= r.product_image %>" alt="Product" class="w-11 h-11 rounded-2xl object-cover border border-[#EAEFEB] shrink-0">
                                <% } else { %>
                                    <div class="w-11 h-11 rounded-2xl bg-[#F8FAF9] border border-[#EAEFEB] flex items-center justify-center text-[#6B7280] shrink-0">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                    </div>
                                <% } %>
                                <div class="min-w-0">
                                    <h4 class="text-xs sm:text-sm font-bold text-[#111827] truncate"><%= r.product_title || 'General Product' %></h4>
                                    <div class="flex items-center gap-1.5 text-[11px] text-[#6B7280]">
                                        <span>Order <%= r.order_ref ? '#' + r.order_ref : 'Verified' %></span>
                                        <span>&bull;</span>
                                        <span><%= r.created_at ? new Date(r.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Recently' %></span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2 shrink-0">
                                <!-- Star Rating -->
                                <div class="text-amber-500 font-mono text-sm tracking-tight">
                                    <%= '★'.repeat(Math.max(1, Math.min(5, Number(r.rating || 5)))) %><%= '☆'.repeat(5 - Math.max(1, Math.min(5, Number(r.rating || 5)))) %>
                                </div>

                                <!-- Verified Purchase Badge -->
                                <% if (r.is_verified_purchase === 1) { %>
                                    <span class="text-[10px] font-bold bg-[#EDF5F1] text-[#084C38] border border-[#084C38]/20 px-2.5 py-0.5 rounded-full flex items-center gap-1 font-mono">
                                        <svg class="w-3 h-3 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                        <span>VERIFIED PURCHASE</span>
                                    </span>
                                <% } else { %>
                                    <span class="text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200 px-2.5 py-0.5 rounded-full flex items-center gap-1 font-mono">
                                        <span>FEEDBACK</span>
                                    </span>
                                <% } %>

                                <!-- Moderation Status Pill -->
                                <% if (r.status === 'approved') { %>
                                    <span class="text-[10px] font-bold bg-[#084C38] text-white px-2.5 py-0.5 rounded-full">Approved</span>
                                <% } else if (r.status === 'rejected') { %>
                                    <span class="text-[10px] font-bold bg-rose-600 text-white px-2.5 py-0.5 rounded-full">Rejected</span>
                                <% } else { %>
                                    <span class="text-[10px] font-bold bg-amber-500 text-white px-2.5 py-0.5 rounded-full animate-pulse">Pending Moderation</span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Review Content -->
                        <div class="space-y-1.5">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold text-[#111827]"><%= r.customer_name %></span>
                            </div>
                            <p class="text-xs text-[#111827]/90 leading-relaxed bg-[#F8FAF9] p-3.5 rounded-2xl border border-[#EAEFEB]">
                                "<%= r.comment %>"
                            </p>
                            <% if (r.rejection_reason) { %>
                                <p class="text-[11px] text-rose-700 italic">
                                    Rejection note: <%= r.rejection_reason %>
                                </p>
                            <% } %>
                        </div>

                        <!-- Moderation Controls -->
                        <div class="flex items-center justify-between gap-2 pt-1">
                            <span class="text-[10px] text-[#6B7280]">
                                <% if (r.moderated_at) { %>
                                    Moderated on <%= new Date(r.moderated_at).toLocaleDateString('en-GB') %> by <%= r.moderated_by || 'You' %>
                                <% } else { %>
                                    Awaiting your moderation decision
                                <% } %>
                            </span>

                            <div class="flex items-center gap-2">
                                <% if (r.status !== 'approved') { %>
                                    <button type="button" onclick="moderateReviewAction(<%= r.id %>, 'approve')" class="bg-[#084C38] hover:bg-[#063b2c] text-white font-semibold text-xs px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 shadow-xs">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                        <span>Approve & Publish</span>
                                    </button>
                                <% } %>

                                <% if (r.status !== 'rejected') { %>
                                    <button type="button" onclick="moderateReviewAction(<%= r.id %>, 'reject')" class="bg-[#F8FAF9] hover:bg-rose-50 text-rose-700 border border-rose-200 font-semibold text-xs px-3.5 py-2 rounded-xl transition flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                        <span>Reject & Hide</span>
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </main>

    <!-- Bottom Navigation Bar for Mobile -->
    <%- include('components/bottom_nav.ejs', { activeTab: 'reviews' }) %>

    <script>
        async function moderateReviewAction(reviewId, action) {
            let reason = null;
            if (action === 'reject') {
                reason = prompt('Optional: Reason for rejecting this review (internal note):', 'Feedback contains inappropriate content or dispute');
                if (reason === null) return; // user cancelled prompt
            }

            try {
                const res = await fetch(`/api/merchant/reviews/${reviewId}/moderate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action, reason })
                });

                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert(data.error || 'Failed to update review moderation status.');
                }
            } catch (err) {
                alert('Network error while moderating review.');
            }
        }
    </script>
</body>
</html>
