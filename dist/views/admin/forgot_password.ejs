<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Admin Password — zlik</title>
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            zlikDark: '#08110D',
            zlikGreen: '#19D98B',
            zlikDeep: '#087A50',
            zlikBg: '#F8FAF8',
            zlikWhite: '#FFFFFF',
            zlikMuted: '#6B756F',
            zlikBorder: '#E3E9E5'
          },
          fontFamily: {
            display: ['Montserrat', 'sans-serif'],
            body: ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #08110D; color: #FFFFFF; }
    .font-display { font-family: 'Montserrat', sans-serif; }
  </style>
</head>
<body class="bg-[#08110D] text-white antialiased flex items-center justify-center min-h-screen p-4">

  <div class="max-w-md w-full bg-white/5 rounded-2xl border border-white/10 p-8 sm:p-10 shadow-2xl backdrop-blur-md">
    <div class="text-center mb-8">
      <a href="/" class="text-3xl font-bold font-display tracking-tight text-white inline-block mb-3">
        zlik
      </a>
      <h1 class="text-xl font-bold font-display text-white">Reset Admin Password</h1>
      <p class="text-xs text-[#E3E9E5]/70 mt-1">Enter your admin email to receive recovery instructions</p>
    </div>

    <form onsubmit="handleForgotPassword(event)" class="space-y-4 text-xs">
      <div>
        <label class="block font-semibold text-[#E3E9E5]/90 mb-1.5">Admin Email Address</label>
        <input type="email" id="adminEmail" required placeholder="admin@zlik.store" class="w-full px-3.5 py-3 rounded-lg bg-white/10 border border-white/15 text-sm text-white placeholder-white/40 outline-none focus:border-[#19D98B] transition">
      </div>

      <div id="statusMsg" class="text-xs font-medium hidden"></div>

      <button type="submit" id="submitBtn" class="w-full bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] font-bold font-display text-sm py-3.5 rounded-lg shadow-sm transition duration-200 mt-2">
        Send Reset Link
      </button>
    </form>

    <div class="mt-6 text-center text-xs">
      <a href="/<%= typeof adminPath !== 'undefined' ? adminPath : 'admin' %>/login" class="text-[#19D98B] hover:underline">&larr; Back to Admin Sign In</a>
    </div>
  </div>

  <script>
    const currentAdminPath = '<%= typeof adminPath !== "undefined" ? adminPath : "admin" %>';

    async function handleForgotPassword(e) {
      e.preventDefault();
      const btn = document.getElementById('submitBtn');
      const msg = document.getElementById('statusMsg');
      btn.disabled = true;
      btn.textContent = 'Sending...';
      msg.classList.add('hidden');

      try {
        const res = await fetch('/' + currentAdminPath + '/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: document.getElementById('adminEmail').value })
        });
        const result = await res.json();
        msg.textContent = result.message;
        msg.className = 'text-xs font-medium p-3 rounded-lg ' + (result.success ? 'bg-[#19D98B]/20 text-[#19D98B]' : 'bg-rose-500/20 text-rose-400');
        msg.classList.remove('hidden');
      } catch (err) {
        msg.textContent = 'Error processing request.';
        msg.className = 'text-xs font-medium p-3 rounded-lg bg-rose-500/20 text-rose-400';
        msg.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send Reset Link';
      }
    }
  </script>
</body>
</html>
