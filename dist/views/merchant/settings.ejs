                        <div class="p-3 bg-amber-50 text-amber-900 rounded-xl text-[11px] border border-amber-200">
                            Your verification request has been submitted to the compliance team. We verify stores with completed sales and active products.
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Multi-Store Management (1 Free, 3 Pro, 10 Business) -->
