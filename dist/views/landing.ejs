<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>zlik — The easiest way to sell products & services online.</title>
  <meta name="description" content="Create a fast, beautiful online store in seconds. Share across Instagram, TikTok, WhatsApp, Facebook, and collect verified orders and payments effortlessly.">
  <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            zlikDark: '#08110D',
            zlikGreen: '#19D98B',
            zlikDeep: '#087A50',
            zlikBg: '#F8FAF8',
            zlikWhite: '#FFFFFF',
            zlikMuted: '#6B756F',
            zlikBorder: '#E3E9E5',
            zlikError: '#D94A4A',
            zlikWarning: '#C99221'
          },
          fontFamily: {
            display: ['Montserrat', 'sans-serif'],
            body: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          },
          borderRadius: {
            btn: '8px',
            input: '8px',
            card: '12px',
            container: '16px'
          },
          boxShadow: {
            zlik: '0 4px 20px rgba(8, 17, 13, 0.06)'
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #F8FAF8; color: #08110D; }
    .font-display { font-family: 'Montserrat', sans-serif; }
  </style>
</head>
<body class="bg-[#F8FAF8] text-[#08110D] antialiased selection:bg-[#08110D] selection:text-[#19D98B]">

  <!-- Header Navigation -->
  <header class="border-b border-[#E3E9E5] bg-[#F8FAF8]/95 backdrop-blur-md sticky top-0 z-40 transition-colors">
    <div class="max-w-[1240px] mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="hover:opacity-90 transition inline-flex items-center gap-1">
        <span class="inline-flex items-center font-display font-semibold text-2xl sm:text-[26px] tracking-[-0.03em] select-none leading-none text-[#08110D]">
          zlik
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-[#6B756F]">
        <a href="#features" class="transition-colors hover:text-[#08110D]">Features</a>
        <a href="#how-it-works" class="transition-colors hover:text-[#08110D]">How it works</a>
        <a href="#pricing" class="transition-colors hover:text-[#08110D]">Pricing</a>
        <a href="/marketplace" class="transition-colors hover:text-[#08110D] flex items-center gap-2">
          <span>Stores</span>
        </a>
      </nav>

      <!-- Action CTAs -->
      <div class="flex items-center gap-3 sm:gap-4">
        <a href="/merchant/login" class="text-sm font-semibold text-[#08110D] hover:opacity-75 transition-opacity px-3 py-2">
          Sign in
        </a>
        <button type="button" onclick="openRegisterModal()" class="bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] text-sm font-semibold font-display px-5 py-2.5 rounded-lg transition-all shadow-xs">
          Create store
        </button>
      </div>
    </div>
  </header>

  <!-- ==========================================
       SECTION 1 — HERO
       ========================================== -->
  <section class="relative pt-16 pb-20 lg:pt-24 lg:pb-28 overflow-hidden border-b border-[#E3E9E5]">
    <div class="max-w-[1240px] mx-auto px-6">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Left: Headline & Primary CTA -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <div class="inline-flex items-center gap-2 bg-white px-3.5 py-1.5 rounded-full border border-[#E3E9E5] text-xs font-medium text-[#6B756F]">
            <span class="w-2 h-2 rounded-full bg-[#19D98B]"></span>
            <span>The easiest way to sell online</span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-bold font-display tracking-tight text-[#08110D] leading-[1.08]">
            The easiest way to sell products & services online.
          </h1>

          <p class="text-base sm:text-lg text-[#6B756F] max-w-xl leading-relaxed font-normal">
            Create a fast, clean online store in seconds. Share across Instagram, TikTok, WhatsApp, Facebook, and collect orders with zero hassle.
          </p>

          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <button onclick="openRegisterModal()" class="bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] text-sm font-semibold font-display px-8 py-3.5 rounded-lg transition shadow-xs flex items-center justify-center gap-2">
              <span>Create store</span>
              <span>&rarr;</span>
            </button>
            <a href="/marketplace" class="bg-white hover:bg-gray-50 border border-[#E3E9E5] text-[#08110D] text-sm font-medium px-6 py-3.5 rounded-lg transition text-center">
              Explore stores
            </a>
          </div>

          <!-- Supported Channels Indicator -->
          <div class="pt-3 space-y-2">
            <div class="text-[11px] uppercase tracking-wider font-semibold text-[#6B756F]">Sell everywhere with one link:</div>
            <div class="flex flex-wrap items-center gap-2.5 text-xs font-semibold text-[#08110D]">
              <span class="bg-white px-3 py-1.5 rounded-lg border border-[#E3E9E5] flex items-center gap-2 shadow-2xs hover:border-gray-300 transition">
                <svg class="w-4 h-4 text-[#E1306C] shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                <span>Instagram Bio & DMs</span>
              </span>
              <span class="bg-white px-3 py-1.5 rounded-lg border border-[#E3E9E5] flex items-center gap-2 shadow-2xs hover:border-gray-300 transition">
                <svg class="w-4 h-4 text-[#08110D] shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.89 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3 15.67 6.34 6.34 0 0 0 9.34 22a6.34 6.34 0 0 0 6.34-6.33V9.05a8.28 8.28 0 0 0 4.91 1.59V7.19a4.86 4.86 0 0 1-1-.5z"/>
                </svg>
                <span>TikTok Profile</span>
              </span>
              <span class="bg-white px-3 py-1.5 rounded-lg border border-[#E3E9E5] flex items-center gap-2 shadow-2xs hover:border-gray-300 transition">
                <svg class="w-4 h-4 text-[#25D366] shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.031 0C5.395 0 .01 5.385.01 12.022a11.96 11.96 0 0 0 1.608 6.002L.012 24l6.148-1.611a11.97 11.97 0 0 0 5.871 1.533h.005c6.635 0 12.02-5.385 12.02-12.022A12.02 12.02 0 0 0 12.031 0zm0 22.008h-.004a10.02 10.02 0 0 1-5.107-1.393l-.366-.217-3.794.995 1.013-3.699-.239-.38a9.98 9.98 0 0 1-1.533-5.292c0-5.526 4.498-10.024 10.03-10.024a9.97 9.97 0 0 1 7.087 2.935 9.97 9.97 0 0 1 2.938 7.087c0 5.526-4.498 10.024-10.024 10.024zm5.495-7.511c-.301-.151-1.782-.88-2.058-.98-.276-.101-.477-.151-.678.151-.201.301-.778.98-.954 1.181-.176.201-.351.226-.653.075-.301-.151-1.272-.469-2.423-1.496-.895-.798-1.5-1.784-1.676-2.086-.176-.301-.019-.464.132-.614.136-.135.301-.352.452-.527.151-.176.201-.301.301-.502.101-.201.05-.377-.025-.527-.075-.151-.678-1.633-.929-2.236-.245-.588-.493-.508-.678-.518l-.578-.01c-.201 0-.527.075-.803.377s-1.054 1.03-1.054 2.511c0 1.482 1.079 2.913 1.23 3.114.151.201 2.124 3.243 5.145 4.549.719.311 1.28.497 1.718.636.722.229 1.378.197 1.897.119.578-.087 1.782-.728 2.033-1.431.251-.703.251-1.306.176-1.431-.075-.125-.276-.201-.577-.352z"/>
                </svg>
                <span>WhatsApp Orders</span>
              </span>
              <span class="bg-white px-3 py-1.5 rounded-lg border border-[#E3E9E5] flex items-center gap-2 shadow-2xs hover:border-gray-300 transition">
                <svg class="w-4 h-4 text-[#1877F2] shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                <span>Facebook Page</span>
              </span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-6 pt-1 text-xs text-[#6B756F]">
            <span class="flex items-center gap-1.5"><span class="text-[#19D98B] font-semibold">✓</span> Free starter plan</span>
            <span class="flex items-center gap-1.5"><span class="text-[#19D98B] font-semibold">✓</span> Direct bank payments</span>
            <span class="flex items-center gap-1.5"><span class="text-[#19D98B] font-semibold">✓</span> Zero platform fees</span>
          </div>
        </div>

        <!-- Right: Visual Interface Representation -->
        <div class="lg:col-span-5 relative">
          <div class="bg-white rounded-2xl border border-[#E3E9E5] shadow-zlik p-6 relative overflow-hidden">
            <!-- Store Header -->
            <div class="flex items-center justify-between pb-4 border-b border-[#E3E9E5] mb-5">
              <div>
                <div class="text-[11px] font-mono text-[#6B756F]">zlik.store/luxeaura</div>
                <h3 class="font-semibold text-base text-[#08110D] font-display mt-0.5">Luxe Aura Skincare</h3>
              </div>
              <span class="text-xs font-semibold text-[#087A50] bg-[#19D98B]/15 px-2.5 py-1 rounded-full">
                Open Online
              </span>
            </div>

            <!-- Product List in Cart -->
            <div class="space-y-3 mb-5">
              <div class="bg-[#F8FAF8] p-3.5 rounded-xl border border-[#E3E9E5] flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-white rounded-lg border border-[#E3E9E5] flex items-center justify-center text-base">
                    ✨
                  </div>
                  <div>
                    <div class="font-semibold text-xs text-[#08110D]">Vitamin C Serum (50ml)</div>
                    <div class="text-[11px] text-[#6B756F]">Qty: 1</div>
                  </div>
                </div>
                <div class="font-mono text-xs font-semibold text-[#08110D]">₦18,500</div>
              </div>

              <div class="bg-[#F8FAF8] p-3.5 rounded-xl border border-[#E3E9E5] flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-white rounded-lg border border-[#E3E9E5] flex items-center justify-center text-base">
                    🧴
                  </div>
                  <div>
                    <div class="font-semibold text-xs text-[#08110D]">Barrier Moisturizer</div>
                    <div class="text-[11px] text-[#6B756F]">Qty: 1</div>
                  </div>
                </div>
                <div class="font-mono text-xs font-semibold text-[#08110D]">₦14,000</div>
              </div>
            </div>

            <!-- Order Summary Box -->
            <div class="bg-[#08110D] text-white rounded-xl p-4 space-y-2.5">
              <div class="flex justify-between text-xs text-[#E3E9E5]/70">
                <span>Subtotal</span>
                <span class="font-mono">₦32,500</span>
              </div>
              <div class="flex justify-between text-xs text-[#E3E9E5]/70">
                <span>Delivery</span>
                <span class="font-mono">₦2,500</span>
              </div>
              <div class="flex justify-between text-sm font-semibold pt-2 border-t border-white/15">
                <span>Total</span>
                <span class="text-[#19D98B] font-mono font-bold text-base">₦35,000</span>
              </div>
              <div class="pt-2">
                <div class="w-full bg-[#19D98B] text-[#08110D] text-xs font-semibold font-display text-center py-2.5 rounded-lg flex items-center justify-center gap-2">
                  <span>Complete Order & Checkout</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION 2 — THE CORE IDEA
       ========================================== -->
  <section class="py-20 bg-white border-b border-[#E3E9E5]" id="features">
    <div class="max-w-[1240px] mx-auto px-6">
      <div class="max-w-2xl mx-auto text-center space-y-3 mb-16">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#6B756F]">
          Why zlik
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold font-display tracking-tight text-[#08110D]">
          Turn social traffic into paying customers.
        </h2>
        <p class="text-base text-[#6B756F] leading-relaxed">
          Stop losing sales in messy DMs. Give buyers one clean link to explore products, choose options, and checkout online instantly.
        </p>
      </div>

      <!-- 3 Core Cards -->
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white p-7 rounded-xl border border-[#E3E9E5] space-y-3 shadow-xs">
          <div class="text-xs font-mono font-bold text-[#6B756F]">01</div>
          <h3 class="text-lg font-semibold font-display text-[#08110D]">
            One link for all channels
          </h3>
          <p class="text-sm text-[#6B756F] leading-relaxed">
            Add your store link to your Instagram bio, TikTok profile, WhatsApp status, or Facebook page. One link sells everywhere.
          </p>
        </div>

        <div class="bg-white p-7 rounded-xl border border-[#E3E9E5] space-y-3 shadow-xs">
          <div class="text-xs font-mono font-bold text-[#6B756F]">02</div>
          <h3 class="text-lg font-semibold font-display text-[#08110D]">
            Seamless online orders
          </h3>
          <p class="text-sm text-[#6B756F] leading-relaxed">
            Customers select variants, enter delivery details, and submit orders with automated totals and clear itemization.
          </p>
        </div>

        <div class="bg-white p-7 rounded-xl border border-[#E3E9E5] space-y-3 shadow-xs">
          <div class="text-xs font-mono font-bold text-[#6B756F]">03</div>
          <h3 class="text-lg font-semibold font-display text-[#08110D]">
            Direct payments & proof
          </h3>
          <p class="text-sm text-[#6B756F] leading-relaxed">
            Receive bank transfer claims or card payments directly with zero middlemen deductions and automated digital receipts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION 3 — HOW IT WORKS
       ========================================== -->
  <section id="how-it-works" class="py-20 bg-[#F8FAF8] border-b border-[#E3E9E5]">
    <div class="max-w-[1240px] mx-auto px-6">
      <div class="max-w-2xl mx-auto text-center space-y-3 mb-14">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#6B756F]">
          How it works
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold font-display tracking-tight text-[#08110D]">
          Four simple steps to sell online.
        </h2>
      </div>

      <!-- Steps Grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-xl border border-[#E3E9E5] space-y-2.5 shadow-xs">
          <span class="text-xs font-mono font-bold text-[#6B756F]">Step 1</span>
          <h3 class="text-base font-semibold font-display text-[#08110D]">Create your store</h3>
          <p class="text-xs text-[#6B756F] leading-relaxed">
            Enter your store name and launch your custom online storefront in seconds.
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl border border-[#E3E9E5] space-y-2.5 shadow-xs">
          <span class="text-xs font-mono font-bold text-[#6B756F]">Step 2</span>
          <h3 class="text-base font-semibold font-display text-[#08110D]">Add products</h3>
          <p class="text-xs text-[#6B756F] leading-relaxed">
            Upload photos, set prices, inventory, and payment instructions.
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl border border-[#E3E9E5] space-y-2.5 shadow-xs">
          <span class="text-xs font-mono font-bold text-[#6B756F]">Step 3</span>
          <h3 class="text-base font-semibold font-display text-[#08110D]">Share everywhere</h3>
          <p class="text-xs text-[#6B756F] leading-relaxed">
            Put your zlik link in your Instagram bio, TikTok, WhatsApp, Facebook, or send directly.
          </p>
        </div>

        <div class="bg-white p-6 rounded-xl border border-[#E3E9E5] space-y-2.5 shadow-xs">
          <span class="text-xs font-mono font-bold text-[#6B756F]">Step 4</span>
          <h3 class="text-base font-semibold font-display text-[#08110D]">Receive orders</h3>
          <p class="text-xs text-[#6B756F] leading-relaxed">
            Get structured online orders with payment verification and digital receipts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================
       SECTION 4 — PRICING
       ========================================== -->
  <section id="pricing" class="py-20 bg-white border-b border-[#E3E9E5]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-xl mx-auto mb-10 space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#6B756F]">
          Pricing
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold font-display tracking-tight text-[#08110D]">
          Simple, transparent plans.
        </h2>
        <p class="text-sm text-[#6B756F]">
          Zero commissions on sales. You keep 100% of customer payments.
        </p>

        <!-- Billing Cycle Selector -->
        <div class="pt-4 inline-flex items-center bg-[#F8FAF8] p-1 rounded-xl border border-[#E3E9E5]">
          <button onclick="toggleLandingBilling('monthly')" id="landingCycleBtn-monthly" class="px-5 py-2 rounded-lg text-xs font-bold font-display transition bg-[#08110D] text-white shadow-2xs">
            Monthly Billing
          </button>
          <button onclick="toggleLandingBilling('yearly')" id="landingCycleBtn-yearly" class="px-5 py-2 rounded-lg text-xs font-bold font-display transition text-[#6B756F] hover:text-[#08110D] flex items-center gap-1.5">
            <span>Annual Billing</span>
            <span class="bg-[#19D98B] text-[#08110D] text-[9px] font-bold px-1.5 py-0.5 rounded">Up to 3 Mo Free</span>
          </button>
        </div>
      </div>

      <!-- 3 Plan Cards Grid -->
      <div class="grid md:grid-cols-3 gap-6 items-stretch mb-10">
        
        <!-- 1. Free Starter -->
        <div class="border border-[#E3E9E5] p-6 sm:p-7 rounded-2xl flex flex-col justify-between bg-white shadow-xs hover:border-gray-300 transition text-left">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono uppercase font-bold text-[#6B756F]">Free</span>
              <span class="text-[9px] uppercase font-bold px-2.5 py-0.5 rounded-full bg-[#F8FAF8] text-[#6B756F] border border-[#E3E9E5]">forever</span>
            </div>
            <div class="text-3xl font-bold font-display text-[#08110D] mb-1">₦0</div>
            <p class="text-xs text-[#6B756F] mb-6">For merchants getting started and building their customer base.</p>
            
            <div class="border-t border-[#E3E9E5] pt-5 mb-8">
              <ul class="space-y-3.5 text-xs text-[#4A5550] font-normal text-left">
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-[#19D98B] shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                  <span>1 online store & 10 products</span>
