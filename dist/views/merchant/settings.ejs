                            <div class="font-bold text-[#111827] text-xs flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#084C38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                                <span>Pay on Delivery (POD)</span>
                            </div>
                            <p class="text-[11px] text-[#6B7280]">Customers pay upon physical arrival. Bank account details are hidden at checkout.</p>
                        </div>
                        <input type="checkbox" id="allowPayOnDelivery" <%= store.allow_pay_on_delivery === 1 ? 'checked' : '' %> class="w-4 h-4 mt-1 accent-[#084C38]">
                    </label>
                </div>
            </div>

            <!-- Bank Transfer Details -->
