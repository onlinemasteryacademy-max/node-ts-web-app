        </div>
        <button type="button" onclick="savePlansMatrix(event)" class="bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] font-bold font-display text-xs px-5 py-2.5 rounded-lg transition shadow-sm flex items-center gap-2">
          <span>💾</span>
          <span>Save & Sync All Plans</span>
        </button>
