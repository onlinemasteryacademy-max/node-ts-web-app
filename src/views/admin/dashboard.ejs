  <!-- Client-side Scripts -->
  <script>
    const allTemplatesData = <%- JSON.stringify(allTemplates || {}) %>;
    const storeCategoriesData = <%- JSON.stringify(storeCategories || {}) %>;
    let currentAdminStoreSelectedTpl = 'general_clean';

    function openAdminTemplateModal(storeId, storeName, currentTemplateSlug) {
      document.getElementById('adminTemplateStoreId').value = storeId;
      document.getElementById('adminTemplateModalStoreName').textContent = `Assigning storefront design for "${storeName}"`;
      
      const tpl = allTemplatesData[currentTemplateSlug] || allTemplatesData.general_clean;
      currentAdminStoreSelectedTpl = tpl ? tpl.id : 'general_clean';
      document.getElementById('adminSelectedTemplateSlug').value = currentAdminStoreSelectedTpl;
      
      const catId = tpl ? tpl.category_id : 'general';
      const catSelect = document.getElementById('adminCategorySelect');
      if (catSelect) catSelect.value = catId;
      
      renderAdminTemplateOptions(catId);
      document.getElementById('adminTemplateModal').classList.remove('hidden');
    }

    function closeAdminTemplateModal() {
      document.getElementById('adminTemplateModal').classList.add('hidden');
    }

    function onAdminCategoryChange(catId) {
      const catTemplates = Object.values(allTemplatesData).filter(t => t.category_id === catId);
      if (catTemplates.length > 0) {
        currentAdminStoreSelectedTpl = catTemplates[0].id;
        document.getElementById('adminSelectedTemplateSlug').value = currentAdminStoreSelectedTpl;
      }
      renderAdminTemplateOptions(catId);
    }

    function renderAdminTemplateOptions(catId) {
      const container = document.getElementById('adminTemplatesOptionsList');
      if (!container) return;
      const catTemplates = Object.values(allTemplatesData).filter(t => t.category_id === catId);

      container.innerHTML = catTemplates.map(t => {
        const isSelected = currentAdminStoreSelectedTpl === t.id;
        const tierBadge = t.is_pro 
          ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#19D98B]/20 text-[#19D98B] border border-[#19D98B]/30">💎 PRO</span>'
          : '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-white/10 text-white/70">FREE</span>';

        return `
          <div onclick="selectAdminTemplate('${t.id}')" class="p-3 rounded-xl border transition cursor-pointer flex items-center justify-between ${isSelected ? 'border-[#19D98B] bg-[#19D98B]/10 ring-1 ring-[#19D98B]' : 'border-white/10 bg-white/5 hover:border-white/20'}">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-16 h-10 rounded-lg overflow-hidden border border-white/15 shrink-0 bg-[#08110D]">
