        async function uploadVariantPhoto(variantIndex, file) {
            if (!file) return;
            if (file.size > 10 * 1024 * 1024) {
                alert(`"${file.name}" exceeds 10MB limit. Please choose a file under 10MB.`);
                return;
            }

            const formData = new FormData();
            formData.append('file', file);

            try {
                const res = await fetch('/api/upload', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.url) {
                    customVariantsList[variantIndex].image_url = data.url;
                    renderVariantMatrix();
                } else {
                    alert(data.error || 'Failed to upload variant image');
                }
            } catch (err) {
                alert('Network error uploading image');
            }
        }

        function removeVariantImage(variantIndex) {
            if (customVariantsList[variantIndex]) {
                customVariantsList[variantIndex].image_url = null;
                renderVariantMatrix();
            }
        }

