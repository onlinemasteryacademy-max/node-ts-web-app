                        <button type="button" onclick="requestVerification()" id="reqVerifyBtn" class="bg-[#084C38] hover:bg-[#063b2c] text-white font-semibold text-xs px-4 py-2.5 rounded-xl transition shadow-xs">
                            Request Verification Badge
                        </button>
