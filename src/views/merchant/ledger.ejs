<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Ledger — <%= store.store_name %> | zlik</title>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        zlikDark: '#08110D',
                        zlikGreen: '#19D98B',
                        zlikDeep: '#087A50',
                        zlikBg: '#F8FAF8',
                        zlikWhite: '#FFFFFF',
                        zlikMuted: '#6B756F',
                        zlikBorder: '#E3E9E5'
                    },
                    fontFamily: {
                        display: ['Montserrat', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F8FAF8; color: #08110D; }
        .font-display { font-family: 'Montserrat', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0.5rem); }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-[#E3E9E5] shadow-2xs">
        <div class="max-w-7xl mx-auto px-3 sm:px-4 py-2.5 sm:py-3.5 flex items-center justify-between gap-2 sm:gap-4">
            <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                <a href="/merchant" class="text-xs font-medium text-[#6B756F] hover:text-[#08110D] flex items-center gap-1 transition shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    <span class="hidden sm:inline">Dashboard</span>
                </a>
                <span class="text-gray-300 hidden sm:inline">/</span>
                <h1 class="text-xs sm:text-sm font-semibold text-[#08110D] truncate">Sales Ledger</h1>
            </div>
            <div class="flex items-center gap-1.5 sm:gap-2">
                <button type="button" onclick="openDailySalesRecapModal()" title="Daily Sales Recap" class="bg-white hover:bg-gray-50 text-[#08110D] border border-[#E3E9E5] text-xs font-semibold p-2 sm:px-3 sm:py-2 rounded-xl transition flex items-center gap-1.5 shadow-2xs">
                    <span>📲</span>
                    <span class="hidden sm:inline">Daily Recap</span>
                </button>
                <button type="button" onclick="openCustomerBroadcastModal()" title="Customer Broadcasts" class="bg-white hover:bg-gray-50 text-[#08110D] border border-[#E3E9E5] text-xs font-semibold p-2 sm:px-3 sm:py-2 rounded-xl transition flex items-center gap-1.5 shadow-2xs">
                    <span>📢</span>
                    <span class="hidden sm:inline">Broadcasts</span>
                </button>
                <% if (isPro) { %>
                    <a href="/api/merchant/ledger/export" title="Export CSV" class="bg-[#08110D] hover:bg-black text-[#19D98B] text-xs font-semibold p-2 sm:px-3.5 sm:py-2 rounded-xl transition shadow-2xs flex items-center gap-1.5">
                        <span>📥</span>
                        <span class="hidden sm:inline">Export CSV</span>
                    </a>
                <% } else { %>
                    <button onclick="openProUpgradeModal('CSV Sales Ledger Export')" title="Export CSV (Pro)" class="bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] text-xs font-medium p-2 sm:px-3.5 sm:py-2 rounded-xl border border-[#E3E9E5] transition flex items-center gap-1.5">
                        <span>🔒</span>
                        <span class="hidden sm:inline">Export CSV (Pro)</span>
                    </button>
                <% } %>
            </div>
        </div>

        <div class="hidden sm:flex max-w-7xl mx-auto px-4 items-center gap-2 overflow-x-auto text-xs font-medium border-t border-[#E3E9E5]/60 pt-2 pb-2">
            <a href="/merchant" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Orders</a>
            <a href="/merchant/items" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Products</a>
            <a href="/merchant/ledger" class="px-3.5 py-1.5 rounded-xl bg-[#08110D] text-white font-semibold">Sales Ledger</a>
            <a href="/merchant/debts" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Debts</a>
            <a href="/merchant/messages" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Live Chat</a>
            <a href="/merchant/settings" class="px-3.5 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D]">Settings</a>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-3 sm:px-4 py-4 sm:py-6 pb-24 sm:pb-8 flex-1 w-full space-y-5 sm:space-y-6">

        <!-- Free Tier Timeframe Notice -->
        <% if (!isPro) { %>
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-2.5">
                    <span class="w-7 h-7 rounded-full bg-amber-200 text-amber-900 flex items-center justify-center text-xs font-mono font-bold shrink-0">Free</span>
                    <div>
                        <h4 class="font-semibold text-amber-950">Free Tier Sales Ledger (Up to Last Month)</h4>
                        <p class="text-[11px] text-amber-800 mt-0.5">
                            Free plan includes records for <strong>Today, Yesterday, This Week, This Month, and Last Month</strong>. Upgrade to Pro for full lifetime sales ledger history, 3M/6M/Yearly ranges, and 1-click CSV exports.
                        </p>
                    </div>
                </div>
                <button onclick="openProUpgradeModal('Full Lifetime Sales Ledger')" class="shrink-0 bg-[#08110D] hover:bg-black text-[#19D98B] font-semibold text-xs px-3.5 py-2 rounded-xl transition shadow-2xs">
                    Upgrade to Pro ⚡
                </button>
            </div>
        <% } %>

        <!-- Timeframe Filter Tabs (Today, Yesterday, This Week, This Month, Last Month, 3M, 6M, Yearly, Lifetime) -->
        <div class="bg-white rounded-2xl border border-[#E3E9E5] p-3 shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2">
                <span class="text-[10px] uppercase font-bold text-[#6B756F] tracking-wider">Timeframe:</span>
            </div>
            <div class="flex items-center gap-1 overflow-x-auto no-scrollbar pb-1 sm:pb-0 font-medium">
                <button type="button" onclick="switchLedgerPeriod('today')" id="ltab-today" class="ledger-tab-btn px-3 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D] transition whitespace-nowrap">Today</button>
                <button type="button" onclick="switchLedgerPeriod('yesterday')" id="ltab-yesterday" class="ledger-tab-btn px-3 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D] transition whitespace-nowrap">Yesterday</button>
                <button type="button" onclick="switchLedgerPeriod('this_week')" id="ltab-this_week" class="ledger-tab-btn px-3 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D] transition whitespace-nowrap">This Week</button>
                <button type="button" onclick="switchLedgerPeriod('this_month')" id="ltab-this_month" class="ledger-tab-btn px-3 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D] transition whitespace-nowrap">This Month</button>
                <button type="button" onclick="switchLedgerPeriod('last_month')" id="ltab-last_month" class="ledger-tab-btn px-3 py-1.5 rounded-xl text-[#6B756F] hover:text-[#08110D] transition whitespace-nowrap">Last Month</button>
                <button type="button" onclick="switchLedgerPeriod('3months')" id="ltab-3months" class="ledger-tab-btn px-3 py-1.5 rounded-xl <%= isPro ? 'text-[#6B756F] hover:text-[#08110D]' : 'text-gray-400 bg-gray-50' %> transition whitespace-nowrap">Last 3 Months <%= !isPro ? '🔒' : '' %></button>
                <button type="button" onclick="switchLedgerPeriod('6months')" id="ltab-6months" class="ledger-tab-btn px-3 py-1.5 rounded-xl <%= isPro ? 'text-[#6B756F] hover:text-[#08110D]' : 'text-gray-400 bg-gray-50' %> transition whitespace-nowrap">Last 6 Months <%= !isPro ? '🔒' : '' %></button>
                <button type="button" onclick="switchLedgerPeriod('yearly')" id="ltab-yearly" class="ledger-tab-btn px-3 py-1.5 rounded-xl <%= isPro ? 'text-[#6B756F] hover:text-[#08110D]' : 'text-gray-400 bg-gray-50' %> transition whitespace-nowrap">This Year <%= !isPro ? '🔒' : '' %></button>
                <button type="button" onclick="switchLedgerPeriod('lifetime')" id="ltab-lifetime" class="ledger-tab-btn px-3 py-1.5 rounded-xl <%= isPro ? 'bg-[#08110D] text-white font-semibold' : 'text-gray-400 bg-gray-50' %> transition whitespace-nowrap">Lifetime <%= !isPro ? '🔒' : '' %></button>
            </div>
        </div>

        <!-- Ledger Financial Summary Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Total Revenue (Paid)</span>
                <div class="text-lg font-bold text-[#087A50] mt-1 font-mono" id="sumTotalRevenue">
                    ₦<%= (summary.total_revenue || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                </div>
                <span class="text-[10px] text-[#6B756F]"><span id="sumPaidCount"><%= summary.paid_orders_count || 0 %></span> confirmed order(s)</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Average Order Value</span>
                <div class="text-lg font-bold text-[#08110D] mt-1 font-mono" id="sumAov">
                    ₦<%= (summary.average_order_value || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                </div>
                <span class="text-[10px] text-[#6B756F]">Per paid transaction</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Order Volume</span>
                <div class="text-lg font-bold text-[#08110D] mt-1 font-mono" id="sumTotalOrders">
                    <%= summary.total_orders || 0 %>
                </div>
                <span class="text-[10px] text-[#6B756F]"><span id="sumPendingCount"><%= summary.pending_orders_count || 0 %></span> pending verification</span>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-[#E3E9E5] shadow-xs">
                <span class="text-[10px] text-[#6B756F] uppercase font-semibold">Ledger Window</span>
                <div class="text-lg font-bold text-[#08110D] mt-1" id="sumWindowLabel">
                    <%= isPro ? 'Lifetime' : 'Up to Last Month' %>
                </div>
                <span class="text-[10px] text-[#6B756F]"><%= isPro ? 'Pro / Business History' : 'Free Plan Window' %></span>
            </div>
        </div>

        <!-- Ledger Table Card -->
        <div class="bg-white rounded-3xl border border-[#E3E9E5] p-5 sm:p-6 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#E3E9E5] pb-4">
                <div>
                    <h3 class="font-semibold text-sm text-[#08110D]">Sales Transactions Ledger</h3>
                    <p class="text-[11px] text-[#6B756F]">Itemized record of all customer orders, payments, and delivery statuses.</p>
                </div>
                <div class="flex items-center gap-2">
                    <input type="text" id="ledgerSearchInput" onkeyup="filterLedgerTable()" placeholder="Search customer, ref..." class="bg-[#F8FAF8] border border-[#E3E9E5] rounded-xl px-3 py-1.5 text-xs outline-none focus:border-[#08110D]">
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse font-body" id="ledgerTable">
                    <thead>
                        <tr class="border-b border-[#E3E9E5] text-[10px] font-bold uppercase text-[#6B756F] bg-[#F8FAF8]">
                            <th class="p-3 rounded-l-xl">Order Ref</th>
                            <th class="p-3">Date</th>
                            <th class="p-3">Customer</th>
                            <th class="p-3">Fulfillment</th>
                            <th class="p-3 text-right">Amount</th>
                            <th class="p-3 text-center">Payment</th>
                            <th class="p-3 text-center">Status</th>
                            <th class="p-3 text-right rounded-r-xl">Receipt</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#E3E9E5]/60">
                        <% if (!orders || orders.length === 0) { %>
                            <tr>
                                <td colspan="8" class="p-8 text-center text-[#6B756F]">
                                    No sales transactions recorded in this period.
                                </td>
                            </tr>
                        <% } else { %>
                            <% orders.forEach(o => { 
                                const isPaid = o.payment_status === 'paid';
                            %>
                                <tr class="hover:bg-[#F8FAF8]/60 transition ledger-row">
                                    <td class="p-3 font-mono font-bold text-[#08110D]">
                                        #<%= o.order_ref %>
                                    </td>
                                    <td class="p-3 text-[#6B756F] whitespace-nowrap">
                                        <%= new Date(o.created_at).toLocaleDateString() %> <span class="text-[10px] opacity-75"><%= new Date(o.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                                    </td>
                                    <td class="p-3">
                                        <div class="font-semibold text-[#08110D]"><%= o.customer_name %></div>
                                        <div class="text-[10px] text-[#6B756F]"><%= o.customer_phone %></div>
                                    </td>
                                    <td class="p-3 capitalize text-[#6B756F]">
                                        <%= o.fulfillment_type === 'pickup' ? 'Store Pickup' : 'Delivery' %>
                                    </td>
                                    <td class="p-3 text-right font-mono font-bold <%= isPaid ? 'text-[#087A50]' : 'text-[#08110D]' %>">
                                        ₦<%= Number(o.total_amount).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                                    </td>
                                    <td class="p-3 text-center">
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold uppercase <%= isPaid ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                                            <%= o.payment_status %>
                                        </span>
                                    </td>
                                    <td class="p-3 text-center">
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-gray-100 text-gray-700 capitalize">
                                            <%= o.order_status %>
                                        </span>
                                    </td>
                                    <td class="p-3 text-right">
                                        <a href="/receipt/<%= o.order_ref %>" target="_blank" class="text-[#087A50] hover:underline font-semibold text-xs">
                                            Receipt ↗
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Pro Upgrade Modal -->
    <div id="proUpgradeModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 space-y-5 border border-[#E3E9E5] shadow-2xl text-center">
            <div class="space-y-1.5">
                <span class="text-[10px] font-semibold uppercase tracking-widest px-2.5 py-0.5 rounded-full bg-[#19D98B]/20 text-[#087A50] font-mono">
                    Pro Feature
                </span>
                <h3 class="text-base font-semibold text-[#08110D]" id="proModalTitle">Unlock Pro Sales Ledger</h3>
                <p class="text-xs text-[#6B756F]">
                    Full lifetime sales ledger history, custom date range filtering, and 1-click CSV/Excel exports are available on Zlik Pro.
                </p>
            </div>

            <div class="bg-[#F8FAF8] rounded-2xl p-4 border border-[#E3E9E5] text-left space-y-2 text-xs">
                <div class="font-semibold text-[11px] text-[#08110D] uppercase tracking-wider">Included in Zlik Pro (₦5,000/mo or ₦50,000/yr):</div>
                <ul class="space-y-1.5 text-xs text-[#08110D]">
                    <li class="flex items-center gap-2">
                        <span class="text-[#087A50] font-bold">•</span>
                        <span>Full sales ledger history and 1-click CSV export</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="text-[#087A50] font-bold">•</span>
                        <span>Up to 3 stores & 500 products (5 photos/item)</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="text-[#087A50] font-bold">•</span>
                        <span>Unlock all 15 industry storefront designs</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="text-[#087A50] font-bold">•</span>
                        <span>Unlimited debt records & WhatsApp reminders</span>
                    </li>
                </ul>
            </div>

            <div class="flex items-center gap-2 pt-1">
                <button type="button" onclick="closeProUpgradeModal()" class="w-1/2 bg-[#F8FAF8] hover:bg-[#E3E9E5] text-[#08110D] font-medium text-xs py-3 rounded-xl border border-[#E3E9E5] transition">
                    Cancel
                </button>
                <a href="/merchant/settings" class="w-1/2 bg-[#08110D] hover:bg-black text-[#19D98B] font-semibold text-xs py-3 rounded-xl transition shadow-2xs flex items-center justify-center">
                    Upgrade to Pro
                </a>
            </div>
        </div>
    </div>

    <!-- Daily Sales WhatsApp Recap Modal -->
    <div id="dailyRecapModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 hidden">
        <div class="bg-white rounded-3xl max-w-lg w-full p-0 shadow-2xl border border-[#E3E9E5] overflow-hidden max-h-[92vh] flex flex-col text-xs">
            <div class="px-5 py-4 border-b border-[#E3E9E5] flex items-center justify-between bg-[#F8FAF8] shrink-0">
                <div class="flex items-center gap-2">
                    <span class="p-1.5 rounded-xl bg-emerald-100 text-emerald-900 text-base">📲</span>
                    <div>
                        <h3 class="font-extrabold text-sm text-[#08110D] font-display">Daily Sales WhatsApp Recap</h3>
                        <p class="text-[10.5px] text-[#6B756F]">Formatted summary of today's sales & top items</p>
                    </div>
                </div>
                <button type="button" onclick="closeDailySalesRecapModal()" class="w-7 h-7 rounded-full bg-white border border-[#E3E9E5] text-[#6B756F] hover:text-black flex items-center justify-center font-bold text-xs">✕</button>
            </div>

            <div class="p-5 overflow-y-auto flex-1 space-y-4">
                <!-- Summary Metrics Grid -->
                <div class="grid grid-cols-2 gap-2.5">
                    <div class="bg-[#F8FAF8] p-3 rounded-2xl border border-[#E3E9E5]">
                        <span class="text-[10px] text-[#6B756F] uppercase font-bold">Gross Revenue Today</span>
                        <div id="recapGrossRevenue" class="text-base font-extrabold text-[#087A50] font-mono mt-0.5">₦0.00</div>
                    </div>
                    <div class="bg-[#F8FAF8] p-3 rounded-2xl border border-[#E3E9E5]">
                        <span class="text-[10px] text-[#6B756F] uppercase font-bold">Orders Placed</span>
                        <div id="recapOrdersCount" class="text-base font-extrabold text-[#08110D] font-mono mt-0.5">0</div>
                    </div>
                </div>

                <!-- Top Items Section -->
                <div>
                    <span class="font-bold text-[#08110D] text-[11px] block mb-1">Top Selling Products:</span>
                    <div id="recapTopItemsList" class="space-y-1.5 bg-[#F8FAF8] p-3 rounded-2xl border border-[#E3E9E5] text-[11px] text-[#6B756F]">
                        Loading breakdown...
                    </div>
                </div>

                <!-- WhatsApp Formatted Preview Box -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-[#08110D] text-[11px]">WhatsApp Message Output:</span>
                        <button type="button" onclick="copyRecapText()" id="copyRecapBtn" class="text-[10.5px] font-bold text-[#087A50] hover:underline">📋 Copy Text</button>
                    </div>
                    <pre id="recapTextPreview" class="bg-[#08110D] text-[#19D98B] p-3.5 rounded-2xl font-mono text-[11px] whitespace-pre-wrap max-h-48 overflow-y-auto border border-emerald-900"></pre>
                </div>
            </div>

            <div class="px-5 py-3 border-t border-[#E3E9E5] bg-[#F8FAF8] flex items-center justify-end gap-2 shrink-0">
                <button type="button" onclick="closeDailySalesRecapModal()" class="bg-white hover:bg-gray-100 text-[#08110D] font-bold text-xs px-4 py-2.5 rounded-xl border border-[#E3E9E5] transition">
                    Close
                </button>
                <button type="button" onclick="openRecapInWhatsApp()" class="bg-[#08110D] hover:bg-black text-[#19D98B] font-bold text-xs px-5 py-2.5 rounded-xl transition shadow-2xs font-display flex items-center gap-1.5">
                    <span>📲 Send to WhatsApp</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Customer Marketing Broadcasts Modal -->
    <div id="customerBroadcastModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 hidden">
        <div class="bg-white rounded-3xl max-w-2xl w-full p-0 shadow-2xl border border-[#E3E9E5] overflow-hidden max-h-[95vh] flex flex-col text-xs">
            <div class="px-5 py-4 border-b border-[#E3E9E5] flex items-center justify-between bg-[#F8FAF8] shrink-0">
                <div class="flex items-center gap-2">
                    <span class="p-1.5 rounded-xl bg-purple-100 text-purple-900 text-base">📢</span>
                    <div>
                        <h3 class="font-extrabold text-sm text-[#08110D] font-display">Customer Marketing Broadcasts</h3>
                        <p class="text-[10.5px] text-[#6B756F]">Reach past buyers with personalized WhatsApp promos</p>
                    </div>
                </div>
                <button type="button" onclick="closeCustomerBroadcastModal()" class="w-7 h-7 rounded-full bg-white border border-[#E3E9E5] text-[#6B756F] hover:text-black flex items-center justify-center font-bold text-xs">✕</button>
            </div>

            <div class="p-5 overflow-y-auto flex-1 space-y-4">
                <!-- 1. Segment Selector -->
                <div>
                    <label class="block font-bold text-[#08110D] mb-1.5">1. Target Customer Segment</label>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                        <button type="button" onclick="selectBroadcastSegment('all')" id="segBtnAll" class="p-2.5 rounded-xl border-2 border-[#08110D] bg-[#08110D] text-white text-left font-bold text-[11px] transition">
                            <div>All Customers</div>
                            <div class="text-[10px] text-gray-300 font-mono" id="segCountAll">0</div>
                        </button>
                        <button type="button" onclick="selectBroadcastSegment('repeat')" id="segBtnRepeat" class="p-2.5 rounded-xl border border-[#E3E9E5] bg-[#F8FAF8] text-[#08110D] text-left font-bold text-[11px] transition">
                            <div>Repeat Buyers</div>
                            <div class="text-[10px] text-[#6B756F] font-mono" id="segCountRepeat">0</div>
                        </button>
                        <button type="button" onclick="selectBroadcastSegment('vip')" id="segBtnVip" class="p-2.5 rounded-xl border border-[#E3E9E5] bg-[#F8FAF8] text-[#08110D] text-left font-bold text-[11px] transition">
                            <div>VIP (>₦20k)</div>
                            <div class="text-[10px] text-[#6B756F] font-mono" id="segCountVip">0</div>
                        </button>
                        <button type="button" onclick="selectBroadcastSegment('recent')" id="segBtnRecent" class="p-2.5 rounded-xl border border-[#E3E9E5] bg-[#F8FAF8] text-[#08110D] text-left font-bold text-[11px] transition">
                            <div>Recent (30d)</div>
                            <div class="text-[10px] text-[#6B756F] font-mono" id="segCountRecent">0</div>
                        </button>
                    </div>
                </div>

                <!-- 2. Campaign Template -->
                <div>
                    <label class="block font-bold text-[#08110D] mb-1.5">2. Campaign Type</label>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                        <button type="button" onclick="selectBroadcastTemplate('promo_discount')" id="tplBtnPromo" class="p-2.5 rounded-xl border-2 border-[#087A50] bg-emerald-50 text-[#087A50] font-bold text-[11px] transition">
                            🎁 Promo Discount
                        </button>
                        <button type="button" onclick="selectBroadcastTemplate('new_arrivals')" id="tplBtnArrivals" class="p-2.5 rounded-xl border border-[#E3E9E5] bg-[#F8FAF8] text-[#08110D] font-bold text-[11px] transition">
                            ✨ New Arrivals
                        </button>
                        <button type="button" onclick="selectBroadcastTemplate('thank_you')" id="tplBtnThankYou" class="p-2.5 rounded-xl border border-[#E3E9E5] bg-[#F8FAF8] text-[#08110D] font-bold text-[11px] transition">
                            🙏 Thank You
                        </button>
                        <button type="button" onclick="selectBroadcastTemplate('custom')" id="tplBtnCustom" class="p-2.5 rounded-xl border border-[#E3E9E5] bg-[#F8FAF8] text-[#08110D] font-bold text-[11px] transition">
                            ✍️ Custom Text
                        </button>
                    </div>
                </div>

                <!-- Discount Settings (Visible when promo_discount) -->
                <div id="promoInputsRow" class="grid grid-cols-2 gap-3 bg-[#F8FAF8] p-3 rounded-2xl border border-[#E3E9E5]">
                    <div>
                        <label class="block font-bold text-[#08110D] mb-1 text-[11px]">Coupon Code</label>
                        <input type="text" id="broadcastCouponCode" value="SAVE10" oninput="updateBroadcastPreview()" class="w-full bg-white border border-[#E3E9E5] rounded-xl p-2 font-mono font-bold uppercase text-xs">
                    </div>
                    <div>
                        <label class="block font-bold text-[#08110D] mb-1 text-[11px]">Discount Value</label>
                        <input type="text" id="broadcastDiscountValue" value="10%" oninput="updateBroadcastPreview()" class="w-full bg-white border border-[#E3E9E5] rounded-xl p-2 font-bold text-xs">
                    </div>
                </div>

                <!-- Live Message Preview -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-[#08110D] text-[11px]">Message Template Preview:</span>
                        <span class="text-[10px] text-[#6B756F]">Personalized per customer</span>
                    </div>
                    <pre id="broadcastMessagePreview" class="bg-[#F8FAF8] border border-[#E3E9E5] text-[#08110D] p-3 rounded-2xl font-mono text-[11px] whitespace-pre-wrap max-h-36 overflow-y-auto"></pre>
                </div>

                <!-- Targeted Customer List -->
                <div>
                    <span class="font-bold text-[#08110D] text-[11px] block mb-1">Target Audience (<span id="targetListCount">0</span> customers):</span>
                    <div id="broadcastCustomerList" class="max-h-48 overflow-y-auto divide-y divide-[#E3E9E5] border border-[#E3E9E5] rounded-2xl bg-white">
                        <!-- Injected via JS -->
                    </div>
                </div>
            </div>

            <div class="px-5 py-3 border-t border-[#E3E9E5] bg-[#F8FAF8] flex items-center justify-end gap-2 shrink-0">
                <button type="button" onclick="closeCustomerBroadcastModal()" class="bg-white hover:bg-gray-100 text-[#08110D] font-bold text-xs px-4 py-2.5 rounded-xl border border-[#E3E9E5] transition">
                    Done
                </button>
            </div>
        </div>
    </div>

    <script>
        function openProUpgradeModal(featureName) {
            if (featureName) {
                document.getElementById('proModalTitle').textContent = `Unlock "${featureName}"`;
            }
            document.getElementById('proUpgradeModal').classList.remove('hidden');
        }

        function closeProUpgradeModal() {
            document.getElementById('proUpgradeModal').classList.add('hidden');
        }

        const isProStore = <%= isPro ? 'true' : 'false' %>;
        let currentLedgerPeriod = 'all_free';

        async function switchLedgerPeriod(period) {
            const proPeriods = ['3months', '6months', 'yearly', 'lifetime'];
            if (!isProStore && proPeriods.includes(period)) {
                openProUpgradeModal('Extended & Lifetime Sales Ledger');
                return;
            }

            currentLedgerPeriod = period;
            document.querySelectorAll('.ledger-tab-btn').forEach(btn => {
                btn.classList.remove('bg-[#08110D]', 'text-white', 'font-semibold');
                if (!btn.textContent.includes('🔒')) {
                    btn.classList.add('text-[#6B756F]');
                }
            });

            const activeBtn = document.getElementById('ltab-' + period);
            if (activeBtn) {
                activeBtn.classList.remove('text-[#6B756F]', 'text-gray-400', 'bg-gray-50');
                activeBtn.classList.add('bg-[#08110D]', 'text-white', 'font-semibold');
            }

            try {
                const res = await fetch(`/api/merchant/ledger?timeframe=${period}`);
                const data = await res.json();
                if (data.success && data.summary) {
                    document.getElementById('sumTotalRevenue').textContent = data.summary.total_revenue_formatted || `₦${Number(data.summary.total_revenue).toLocaleString('en-US', {minimumFractionDigits: 2})}`;
                    document.getElementById('sumPaidCount').textContent = data.summary.paid_orders_count;
                    document.getElementById('sumAov').textContent = data.summary.average_order_value_formatted || `₦${Number(data.summary.average_order_value).toLocaleString('en-US', {minimumFractionDigits: 2})}`;
                    document.getElementById('sumTotalOrders').textContent = data.summary.total_orders;
                    document.getElementById('sumPendingCount').textContent = data.summary.pending_orders_count;

                    const periodLabels = {
                        today: 'Today',
                        yesterday: 'Yesterday',
                        this_week: 'This Week',
                        this_month: 'This Month',
                        last_month: 'Last Month',
                        '3months': 'Last 3 Months',
                        '6months': 'Last 6 Months',
                        yearly: 'This Year',
                        lifetime: 'Lifetime'
                    };
                    const label = periodLabels[period] || 'Filtered Period';
                    document.getElementById('sumWindowLabel').textContent = label;

                    // Re-render Table
                    const tbody = document.querySelector('#ledgerTable tbody');
                    if (tbody) {
                        if (!data.orders || data.orders.length === 0) {
                            tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-[#6B756F]">No sales transactions recorded in ${label}.</td></tr>`;
                        } else {
                            tbody.innerHTML = data.orders.map(o => {
                                const isPaid = o.payment_status === 'paid';
                                const d = new Date(o.created_at);
                                const dateStr = d.toLocaleDateString() + ' <span class="text-[10px] opacity-75">' + d.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) + '</span>';
                                return `
                                    <tr class="hover:bg-[#F8FAF8]/60 transition ledger-row">
                                        <td class="p-3 font-mono font-bold text-[#08110D]">#${o.order_ref}</td>
                                        <td class="p-3 text-[#6B756F] whitespace-nowrap">${dateStr}</td>
                                        <td class="p-3">
                                            <div class="font-semibold text-[#08110D]">${o.customer_name}</div>
                                            <div class="text-[10px] text-[#6B756F]">${o.customer_phone || ''}</div>
                                        </td>
                                        <td class="p-3 capitalize text-[#6B756F]">${o.fulfillment_type === 'pickup' ? 'Store Pickup' : 'Delivery'}</td>
                                        <td class="p-3 text-right font-mono font-bold ${isPaid ? 'text-[#087A50]' : 'text-[#08110D]'}">₦${Number(o.total_amount).toLocaleString('en-US', {minimumFractionDigits: 2})}</td>
                                        <td class="p-3 text-center">
                                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold uppercase ${isPaid ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">${o.payment_status}</span>
                                        </td>
                                        <td class="p-3 text-center">
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-gray-100 text-gray-700 capitalize">${o.order_status}</span>
                                        </td>
                                        <td class="p-3 text-right">
                                            <a href="/receipt/${o.order_ref}" target="_blank" class="text-[#087A50] hover:underline font-semibold text-xs">Receipt ↗</a>
                                        </td>
                                    </tr>
                                `;
                            }).join('');
                        }
                    }
                }
            } catch (err) {
                console.error('Error switching timeframe', err);
            }
        }

        function filterLedgerTable() {
            const query = document.getElementById('ledgerSearchInput').value.toLowerCase();
            const rows = document.querySelectorAll('.ledger-row');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(query)) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
        }

        // ==========================================
        // Daily Sales WhatsApp Recap Handler
        // ==========================================
        let currentRecapData = null;

        async function openDailySalesRecapModal() {
            document.getElementById('dailyRecapModal').classList.remove('hidden');
            try {
                const res = await fetch('/api/merchant/sales-summary/today');
                const data = await res.json();
                if (data.success && data.summary) {
                    currentRecapData = data.summary;
                    document.getElementById('recapGrossRevenue').textContent = data.summary.gross_revenue_formatted;
                    document.getElementById('recapOrdersCount').textContent = data.summary.total_orders;
                    document.getElementById('recapTextPreview').textContent = data.summary.whatsapp_text;

                    const topItemsContainer = document.getElementById('recapTopItemsList');
                    if (data.summary.top_items && data.summary.top_items.length > 0) {
                        topItemsContainer.innerHTML = data.summary.top_items.map((it, idx) => `
                            <div class="flex items-center justify-between font-medium">
                                <span class="text-[#08110D] font-bold">${idx + 1}. ${it.title}</span>
                                <span class="font-mono text-[#087A50] font-bold">${it.count} sold (₦${Number(it.revenue).toLocaleString()})</span>
                            </div>
                        `).join('');
                    } else {
                        topItemsContainer.innerHTML = '<div>No products sold yet today.</div>';
                    }
                }
            } catch (err) {
                alert('Failed to load daily sales recap.');
            }
        }

        function closeDailySalesRecapModal() {
            document.getElementById('dailyRecapModal').classList.add('hidden');
        }

        function openRecapInWhatsApp() {
            if (currentRecapData && currentRecapData.whatsapp_url) {
                window.open(currentRecapData.whatsapp_url, '_blank');
            }
        }

        function copyRecapText() {
            if (currentRecapData && currentRecapData.whatsapp_text) {
                navigator.clipboard.writeText(currentRecapData.whatsapp_text);
                const btn = document.getElementById('copyRecapBtn');
                btn.textContent = '✓ Copied!';
                setTimeout(() => { btn.textContent = '📋 Copy Text'; }, 1500);
            }
        }

        // ==========================================
        // Customer Marketing Broadcasts Handler
        // ==========================================
        let currentBroadcastSegment = 'all';
        let currentBroadcastTemplate = 'promo_discount';
        let broadcastCustomers = [];
        let broadcastTemplateText = '';

        async function openCustomerBroadcastModal() {
            document.getElementById('customerBroadcastModal').classList.remove('hidden');
            await loadBroadcastCustomers('all');
            await updateBroadcastPreview();
        }

        function closeCustomerBroadcastModal() {
            document.getElementById('customerBroadcastModal').classList.add('hidden');
        }

        async function selectBroadcastSegment(seg) {
            currentBroadcastSegment = seg;
            ['all', 'repeat', 'vip', 'recent'].forEach(s => {
                const btn = document.getElementById(`segBtn${s.charAt(0).toUpperCase() + s.slice(1)}`);
                if (btn) {
                    if (s === seg) {
                        btn.className = 'p-2.5 rounded-xl border-2 border-[#08110D] bg-[#08110D] text-white text-left font-bold text-[11px] transition';
                    } else {
                        btn.className = 'p-2.5 rounded-xl border border-[#E3E9E5] bg-[#F8FAF8] text-[#08110D] text-left font-bold text-[11px] transition';
                    }
                }
            });
            await loadBroadcastCustomers(seg);
        }

        async function selectBroadcastTemplate(tpl) {
            currentBroadcastTemplate = tpl;
            const promoRow = document.getElementById('promoInputsRow');
            if (promoRow) {
                if (tpl === 'promo_discount') promoRow.classList.remove('hidden');
                else promoRow.classList.add('hidden');
            }
            await updateBroadcastPreview();
        }

        async function loadBroadcastCustomers(seg) {
            try {
                const res = await fetch(`/api/merchant/customers?segment=${seg}`);
                const data = await res.json();
                if (data.success) {
                    broadcastCustomers = data.customers || [];
                    document.getElementById('targetListCount').textContent = broadcastCustomers.length;

                    if (data.counts) {
                        document.getElementById('segCountAll').textContent = `${data.counts.all} buyers`;
                        document.getElementById('segCountRepeat').textContent = `${data.counts.repeat} buyers`;
                        document.getElementById('segCountVip').textContent = `${data.counts.vip} buyers`;
                        document.getElementById('segCountRecent').textContent = `${data.counts.recent} buyers`;
                    }

                    renderBroadcastCustomerList();
                }
            } catch (err) {}
        }

        async function updateBroadcastPreview() {
            const code = document.getElementById('broadcastCouponCode')?.value || 'SAVE10';
            const val = document.getElementById('broadcastDiscountValue')?.value || '10%';

            try {
                const res = await fetch('/api/merchant/broadcasts/generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        template_type: currentBroadcastTemplate,
                        discount_code: code,
                        discount_value: val
                    })
                });
                const data = await res.json();
                if (data.success) {
                    broadcastTemplateText = data.template_text;
                    document.getElementById('broadcastMessagePreview').textContent = data.template_text;
                    renderBroadcastCustomerList();
                }
            } catch (e) {}
        }

        function renderBroadcastCustomerList() {
            const container = document.getElementById('broadcastCustomerList');
            if (!container) return;

            if (broadcastCustomers.length === 0) {
                container.innerHTML = '<div class="p-4 text-center text-[#6B756F] text-[11px]">No customer records found in this segment.</div>';
                return;
            }

            container.innerHTML = broadcastCustomers.map(c => {
                const personalizedMsg = broadcastTemplateText.replace(/\{\{customer_name\}\}/g, c.customer_name);
                const phoneClean = c.customer_phone.replace(/[^0-9]/g, '');
                const waLink = `https://wa.me/${phoneClean.startsWith('0') ? '234' + phoneClean.slice(1) : phoneClean}?text=${encodeURIComponent(personalizedMsg)}`;

                return `
                    <div class="p-2.5 flex items-center justify-between gap-2 hover:bg-[#F8FAF8] transition">
                        <div>
                            <div class="font-bold text-[#08110D]">${c.customer_name} ${c.is_vip ? '<span class="text-[9px] bg-amber-100 text-amber-900 px-1.5 py-0.2 rounded font-bold">VIP</span>' : ''}</div>
                            <div class="text-[10px] text-[#6B756F] font-mono">${c.customer_phone} • ${c.orders_count} orders (${c.total_spent_formatted})</div>
                        </div>
                        <a href="${waLink}" target="_blank" class="bg-[#08110D] hover:bg-black text-[#19D98B] font-bold text-[10.5px] px-3 py-1.5 rounded-lg transition shadow-2xs shrink-0 flex items-center gap-1">
                            <span>📲 Message ↗</span>
                        </a>
                    </div>
                `;
            }).join('');
        }
    </script>
    <%- include('components/bottom_nav.ejs', { activeTab: 'ledger' }) %>
</body>
</html>
