              <input type="number" id="limit_free_themes" value="<%= plans.free.limits.storefront_designs || 5 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Sales Ledger History (Days)</label>
              <input type="number" id="limit_free_ledger_days" value="<%= plans.free.limits.sales_ledger_days || 7 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Active Debt Records Limit</label>
              <input type="number" id="limit_free_debts" value="<%= plans.free.limits.active_debts_limit || 3 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Weekly Status Posters Quota</label>
              <input type="number" id="limit_free_posters" value="<%= settings.free_weekly_posters || 3 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
          </div>
        </div>

        <!-- 2. Pro Merchant Tier -->
        <div class="bg-[#19D98B]/5 border-2 border-[#19D98B]/30 rounded-2xl p-6 space-y-5 relative">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <div>
              <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase bg-[#19D98B]/20 text-[#19D98B]">Pro Merchant</span>
              <div class="text-xs text-white/60 mt-1">Most Popular Seller Tier</div>
            </div>
            <span class="text-xl">⚡</span>
          </div>

          <div class="space-y-3 text-xs">
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-white/70 font-semibold mb-1">Monthly Price (₦)</label>
                <input type="number" id="price_pro_monthly" value="<%= settings.pro_monthly_price || plans.pro.price_monthly || 5000 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
              </div>
              <div>
                <label class="block text-white/70 font-semibold mb-1">Yearly Price (₦)</label>
                <input type="number" id="price_pro_yearly" value="<%= settings.pro_yearly_price || plans.pro.price_yearly || 50000 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
              </div>
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Max Stores per Account</label>
              <input type="number" id="limit_pro_stores" value="<%= plans.pro.limits.max_stores || 3 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Product Catalog Limit (-1 = Unlimited)</label>
              <input type="number" id="limit_pro_max_products" value="<%= plans.pro.limits.max_products || 500 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Photos per Product</label>
              <input type="number" id="limit_pro_photos" value="<%= plans.pro.limits.photos_per_product || 5 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Additional Staff Accounts</label>
              <input type="number" id="limit_pro_staff" value="<%= plans.pro.limits.staff_accounts || 1 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
          </div>
        </div>

        <!-- 3. Business Growth Tier -->
        <div class="bg-blue-500/5 border border-blue-500/30 rounded-2xl p-6 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <div>
              <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase bg-blue-500/20 text-blue-400">Business Growth</span>
              <div class="text-xs text-white/60 mt-1">Multi-Store & Teams Tier</div>
            </div>
            <span class="text-xl">🚀</span>
          </div>

          <div class="space-y-3 text-xs">
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-white/70 font-semibold mb-1">Monthly Price (₦)</label>
                <input type="number" id="price_biz_monthly" value="<%= settings.business_monthly_price || plans.business.price_monthly || 9000 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
              </div>
              <div>
                <label class="block text-white/70 font-semibold mb-1">Yearly Price (₦)</label>
                <input type="number" id="price_biz_yearly" value="<%= settings.business_yearly_price || plans.business.price_yearly || 90000 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
              </div>
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Max Stores per Account</label>
              <input type="number" id="limit_biz_stores" value="<%= plans.business.limits.max_stores || 10 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Product Catalog Limit (-1 = Unlimited)</label>
              <input type="number" id="limit_biz_max_products" value="<%= plans.business.limits.max_products ?? -1 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Photos per Product</label>
              <input type="number" id="limit_biz_photos" value="<%= plans.business.limits.photos_per_product || 10 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
            <div>
              <label class="block text-white/70 font-semibold mb-1">Staff Accounts with Roles</label>
              <input type="number" id="limit_biz_staff" value="<%= plans.business.limits.staff_accounts || 5 %>" class="w-full px-3 py-2 rounded-lg bg-white/10 border border-white/15 text-white outline-none focus:border-[#19D98B]">
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Feature Selection Checkboxes Grid -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-6 sm:p-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/10">
          <div>
            <h3 class="text-base font-bold font-display text-white">Live Feature Permission Checkboxes</h3>
            <p class="text-xs text-white/60">Tick or untick any feature box to grant or lock capabilities across merchant dashboards and storefronts</p>
          </div>
          <div class="flex items-center gap-6 text-xs">
            <span class="inline-flex items-center gap-1.5 font-medium"><span class="w-3 h-3 rounded bg-white/30 inline-block"></span> Free</span>
            <span class="inline-flex items-center gap-1.5 font-semibold text-[#19D98B]"><span class="w-3 h-3 rounded bg-[#19D98B] inline-block"></span> Pro</span>
            <span class="inline-flex items-center gap-1.5 font-semibold text-blue-400"><span class="w-3 h-3 rounded bg-blue-500 inline-block"></span> Business</span>
          </div>
        </div>

        <!-- Grouped Feature Rows -->
        <% 
          const categories = ['Branding & Storefront', 'Catalog & Inventory', 'Sales, Ledger & Debts', 'Marketing, Pixels & Growth', 'Teams, Multi-Store & Branches', 'Support & Onboarding'];
          categories.forEach(cat => {
            const featsInCat = (featureDefinitions || []).filter(f => f.category === cat);
            if (featsInCat.length === 0) return;
        %>
          <div class="space-y-3 pt-2">
            <h4 class="text-xs uppercase tracking-wider font-bold text-[#19D98B] font-display flex items-center gap-2">
              <span>●</span>
              <span><%= cat %></span>
            </h4>

            <div class="bg-white/5 rounded-xl border border-white/10 overflow-hidden divide-y divide-white/5">
              <% featsInCat.forEach(feat => { %>
                <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-white/5 transition">
                  <div class="space-y-0.5 max-w-xl">
                    <div class="font-semibold text-white text-xs flex items-center gap-2">
                      <span><%= feat.name %></span>
                      <code class="text-[10px] text-white/40 font-mono"><%= feat.key %></code>
                    </div>
                    <p class="text-[11px] text-white/50 leading-relaxed"><%= feat.description %></p>
                  </div>

                  <div class="flex items-center gap-8 shrink-0">
                    <!-- Free Checkbox -->
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                      <input type="checkbox" id="feat_free_<%= feat.key %>" class="feat-box w-4 h-4 rounded bg-white/10 border-white/20 text-[#19D98B] focus:ring-0 focus:ring-offset-0 cursor-pointer" <%= (plans.free.features && plans.free.features[feat.key]) ? 'checked' : '' %>>
                      <span class="text-xs font-medium text-white/70">Free</span>
                    </label>

                    <!-- Pro Checkbox -->
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                      <input type="checkbox" id="feat_pro_<%= feat.key %>" class="feat-box w-4 h-4 rounded bg-white/10 border-white/20 text-[#19D98B] focus:ring-0 focus:ring-offset-0 cursor-pointer" <%= (plans.pro.features && plans.pro.features[feat.key]) ? 'checked' : '' %>>
                      <span class="text-xs font-semibold text-[#19D98B]">Pro</span>
                    </label>

                    <!-- Business Checkbox -->
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                      <input type="checkbox" id="feat_biz_<%= feat.key %>" class="feat-box w-4 h-4 rounded bg-white/10 border-white/20 text-blue-400 focus:ring-0 focus:ring-offset-0 cursor-pointer" <%= (plans.business.features && plans.business.features[feat.key]) ? 'checked' : '' %>>
                      <span class="text-xs font-semibold text-blue-400">Business</span>
                    </label>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% }); %>

        <!-- Save Button Bottom Bar -->
        <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-white/60">
            Changes will take effect instantly across merchant dashboards, checkout, and feature lock screens.
          </div>
          <button type="button" onclick="savePlansMatrix(event)" class="w-full sm:w-auto bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] font-bold font-display px-8 py-3 rounded-xl transition shadow-md flex items-center justify-center gap-2">
            <span>💾</span>
            <span>Save & Sync All Plans</span>
          </button>
        </div>
      </div>
    </div>

    <!-- TAB 5: GATEWAYS & SMTP -->
    <div id="tab-integrations" class="tab-content space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Paystack Config -->
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 sm:p-8">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2.5">
              <span class="text-xl">💳</span>
              <div>
                <h2 class="text-base font-bold font-display text-white">Paystack Gateway</h2>
                <p class="text-xs text-white/60">Subscription checkout & live card processing</p>
              </div>
            </div>
            <label class="flex items-center gap-2 cursor-pointer bg-white/10 px-3 py-1.5 rounded-lg border border-white/15">
              <input type="checkbox" id="paystackEnabled" <%= settings.paystack_enabled ? 'checked' : '' %> class="rounded accent-[#19D98B]">
              <span class="text-xs font-semibold text-white">Gateway Active</span>
            </label>
          </div>

          <form onsubmit="savePaystackSettings(event)" class="space-y-4 text-xs mt-4">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="block font-semibold text-white/80">Environment Mode</label>
                <span id="paystackModeBadge" class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full <%= settings.paystack_mode === 'live' ? 'bg-emerald-500/20 text-[#19D98B] border border-emerald-500/30' : 'bg-amber-500/20 text-amber-400 border border-amber-500/30' %>">
                  <%= settings.paystack_mode === 'live' ? '● LIVE PRODUCTION' : '● TEST SANDBOX' %>
                </span>
              </div>
              <select id="paystackMode" onchange="updatePaystackModeUI()" class="w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white outline-none">
                <option value="test" <%= settings.paystack_mode === 'test' ? 'selected' : '' %>>Test Mode (Sandbox - fake cards)</option>
                <option value="live" <%= settings.paystack_mode === 'live' ? 'selected' : '' %>>Live Production (Real Card & Transfer Processing)</option>
              </select>
            </div>

            <!-- Test Credentials -->
            <div class="p-4 rounded-xl border border-white/10 bg-white/[0.03] space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-amber-300 flex items-center gap-1.5">
                  <span>🧪</span> Test Keys (Sandbox)
                </span>
                <span class="text-[10px] text-white/40">Active when in Test Mode</span>
              </div>
              <div>
                <label class="block text-[11px] font-medium text-white/70 mb-1">Test Public Key (pk_test_...)</label>
                <input type="text" id="paystackTestPub" value="<%= settings.paystack_test_public_key || '' %>" placeholder="pk_test_..." class="w-full px-3.5 py-2 rounded-lg bg-white/10 border border-white/15 text-white font-mono text-xs outline-none focus:border-[#19D98B]">
              </div>
              <div>
                <label class="block text-[11px] font-medium text-white/70 mb-1">Test Secret Key (sk_test_...)</label>
                <div class="relative">
                  <input type="password" id="paystackTestSec" value="<%= settings.paystack_test_secret_key || '' %>" placeholder="sk_test_..." class="w-full px-3.5 py-2 pr-10 rounded-lg bg-white/10 border border-white/15 text-white font-mono text-xs outline-none focus:border-[#19D98B]">
                  <button type="button" onclick="togglePasswordVisibility('paystackTestSec')" class="absolute right-2.5 top-2 text-white/50 hover:text-white text-xs">👁</button>
                </div>
              </div>
            </div>

            <!-- Live Credentials -->
            <div class="p-4 rounded-xl border border-emerald-500/20 bg-emerald-500/[0.03] space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-[#19D98B] flex items-center gap-1.5">
                  <span>🚀</span> Live Production Keys
                </span>
                <span class="text-[10px] text-white/40">Required to charge real money</span>
              </div>
              <div>
                <label class="block text-[11px] font-medium text-white/70 mb-1">Live Public Key (pk_live_...)</label>
                <input type="text" id="paystackLivePub" value="<%= settings.paystack_live_public_key || '' %>" placeholder="pk_live_..." class="w-full px-3.5 py-2 rounded-lg bg-white/10 border border-white/15 text-white font-mono text-xs outline-none focus:border-[#19D98B]">
              </div>
              <div>
                <label class="block text-[11px] font-medium text-white/70 mb-1">Live Secret Key (sk_live_...)</label>
                <div class="relative">
                  <input type="password" id="paystackLiveSec" value="<%= settings.paystack_live_secret_key || '' %>" placeholder="sk_live_..." class="w-full px-3.5 py-2 pr-10 rounded-lg bg-white/10 border border-white/15 text-white font-mono text-xs outline-none focus:border-[#19D98B]">
                  <button type="button" onclick="togglePasswordVisibility('paystackLiveSec')" class="absolute right-2.5 top-2 text-white/50 hover:text-white text-xs">👁</button>
                </div>
              </div>
            </div>

            <!-- Webhook URL & Secret -->
            <div class="p-4 rounded-xl border border-white/10 bg-white/[0.02] space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-white/90">Webhook Configuration</span>
                <span class="text-[10px] text-white/40">Paystack Dashboard &gt; Webhooks</span>
              </div>
              <div>
                <label class="block text-[11px] font-medium text-white/70 mb-1">Platform Webhook URL</label>
                <div class="flex items-center gap-2">
                  <input type="text" id="paystackWebhookUrl" readonly value="/api/webhooks/paystack" class="w-full px-3.5 py-2 rounded-lg bg-white/5 border border-white/10 text-white/80 font-mono text-xs select-all outline-none">
                  <button type="button" onclick="copyWebhookUrl()" class="px-3 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg font-semibold text-xs whitespace-nowrap transition">Copy URL</button>
                </div>
              </div>
              <div>
                <label class="block text-[11px] font-medium text-white/70 mb-1">Webhook Secret Key (Optional HMAC)</label>
                <input type="password" id="paystackWebhookSec" value="<%= settings.paystack_webhook_secret || '' %>" placeholder="sk_live_... or custom secret" class="w-full px-3.5 py-2 rounded-lg bg-white/10 border border-white/15 text-white font-mono text-xs outline-none focus:border-[#19D98B]">
              </div>
            </div>

            <button type="submit" class="w-full bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] font-bold font-display py-3 rounded-lg transition shadow-xs">
              Save Paystack Configuration
            </button>
          </form>
        </div>

        <!-- SMTP Config -->
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 sm:p-8">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h2 class="text-base font-bold font-display text-white mb-1">SMTP Transactional Mailer</h2>
              <p class="text-xs text-white/60">High-reliability transactional email engine</p>
            </div>
            <label class="flex items-center gap-2 cursor-pointer bg-white/10 px-3 py-1.5 rounded-lg border border-white/15">
              <input type="checkbox" id="smtpEnabled" <%= settings.smtp_enabled ? 'checked' : '' %> class="rounded accent-[#19D98B]">
              <span class="text-xs font-semibold text-white">Live SMTP Active</span>
            </label>
          </div>

          <!-- Quick Provider Presets -->
          <div class="mb-5 p-3 rounded-xl bg-white/5 border border-white/10 flex flex-wrap items-center gap-2">
            <span class="text-[11px] text-white/60 font-semibold mr-1">Quick Presets:</span>
            <button type="button" onclick="applySmtpPreset('zoho_ssl')" class="px-2.5 py-1 rounded bg-[#19D98B]/20 hover:bg-[#19D98B]/30 text-[#19D98B] font-semibold text-[11px] transition">
              Zoho (SSL 465)
            </button>
            <button type="button" onclick="applySmtpPreset('zoho_tls')" class="px-2.5 py-1 rounded bg-white/10 hover:bg-white/20 text-white font-semibold text-[11px] transition">
              Zoho (TLS 587)
            </button>
            <button type="button" onclick="applySmtpPreset('gmail')" class="px-2.5 py-1 rounded bg-white/10 hover:bg-white/20 text-white font-semibold text-[11px] transition">
              Gmail / Google
            </button>
          </div>

          <form onsubmit="saveSmtpSettings(event)" class="space-y-4 text-xs">
            <div>
              <label class="block font-semibold text-white/80 mb-1.5">SMTP Host</label>
              <input type="text" id="smtpHost" value="<%= settings.smtp_host || 'smtppro.zoho.com' %>" placeholder="smtppro.zoho.com or smtp.zoho.com" class="w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white outline-none font-mono">
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block font-semibold text-white/80 mb-1.5">Port</label>
                <input type="number" id="smtpPort" value="<%= settings.smtp_port || 465 %>" placeholder="465" class="w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white outline-none font-mono">
              </div>
              <div>
                <label class="block font-semibold text-white/80 mb-1.5">Encryption</label>
                <select id="smtpEnc" class="w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white outline-none">
                  <option value="ssl" <%= settings.smtp_encryption === 'ssl' || (!settings.smtp_encryption && settings.smtp_port === 465) ? 'selected' : '' %>>SSL / Direct TLS (Port 465 - Recommended)</option>
                  <option value="tls" <%= settings.smtp_encryption === 'tls' ? 'selected' : '' %>>TLS / STARTTLS (Port 587)</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-semibold text-white/80 mb-1.5">SMTP Username / Email</label>
                <input type="text" id="smtpUsername" value="<%= settings.smtp_username || '' %>" placeholder="zlik@omastery.com" class="w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white outline-none font-mono">
              </div>
              <div>
                <label class="block font-semibold text-white/80 mb-1.5">SMTP Password / App Password</label>
                <div class="relative">
                  <input type="password" id="smtpPassword" value="<%= settings.smtp_password || '' %>" placeholder="••••••••••••" class="w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white outline-none font-mono pr-10">
                  <button type="button" onclick="togglePasswordVisibility('smtpPassword')" class="absolute right-3 top-2.5 text-white/50 hover:text-white text-xs">👁</button>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-semibold text-white/80 mb-1.5">Sender Name (From Name)</label>
                <input type="text" id="smtpFromName" value="<%= settings.smtp_from_name || 'Zlik' %>" placeholder="Zlik" class="w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white outline-none">
              </div>
              <div>
                <label class="block font-semibold text-white/80 mb-1.5">Sender Email (From Address)</label>
                <input type="email" id="smtpFromEmail" value="<%= settings.smtp_from_email || settings.smtp_username || 'zlik@omastery.com' %>" placeholder="zlik@omastery.com" class="w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white outline-none font-mono">
              </div>
            </div>

            <div>
              <label class="block font-semibold text-white/80 mb-1.5">Reply-To Email (Optional)</label>
              <input type="email" id="smtpReplyTo" value="<%= settings.smtp_reply_to || '' %>" placeholder="zlik@omastery.com" class="w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white outline-none font-mono">
            </div>

            <div class="p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl text-[11px] text-amber-200/90 leading-relaxed">
              <strong>💡 Zoho Mail Setup Note:</strong> For custom domain mailboxes (e.g. <code>zlik@omastery.com</code>), use <strong>Host:</strong> <code>smtppro.zoho.com</code> (or <code>smtp.zoho.com</code>), <strong>Port:</strong> <code>465</code>, <strong>Encryption:</strong> <code>SSL</code>. If 2-Factor Authentication (2FA) is turned on in your Zoho account, generate and enter a dedicated <strong>Application-Specific Password</strong> from Zoho Accounts &rarr; Security &rarr; App Passwords.
            </div>

            <div class="flex items-center gap-3 pt-2">
              <button type="submit" id="saveSmtpBtn" class="bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] font-bold font-display px-5 py-2.5 rounded-lg transition">
                Save SMTP Settings
              </button>
              <button type="button" id="testSmtpBtn" onclick="testSmtp()" class="bg-white/10 hover:bg-white/20 text-white font-semibold px-4 py-2.5 rounded-lg transition">
                Test Dispatch ✉️
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- TAB 6: ADMIN TEAM -->
    <div id="tab-team" class="tab-content space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold font-display text-white">Platform Administrators</h2>
          <p class="text-xs text-white/60">Manage staff access and granular role-based permissions</p>
        </div>
        <button onclick="openNewAdminModal()" class="bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] font-bold font-display text-xs px-4 py-2.5 rounded-lg transition">
          + Add Admin User
        </button>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <table class="w-full text-left text-xs">
          <thead class="bg-white/5 border-b border-white/10 text-white/60 font-semibold">
            <tr>
              <th class="p-4">Name & Email</th>
              <th class="p-4">Role</th>
              <th class="p-4">Last Login</th>
              <th class="p-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% adminUsers.forEach(u => { %>
              <tr>
                <td class="p-4">
                  <div class="font-bold text-white text-sm"><%= u.name %></div>
                  <div class="text-white/60 text-xs"><%= u.email %></div>
                </td>
                <td class="p-4">
                  <span class="px-2.5 py-1 rounded text-[10px] font-bold uppercase bg-[#19D98B]/20 text-[#19D98B]">
                    <%= u.role || 'super_admin' %>
                  </span>
                </td>
                <td class="p-4 text-white/60"><%= u.last_login_at || 'Never' %></td>
                <td class="p-4 text-right">
                  <% if (currentAdmin && currentAdmin.id !== u.id) { %>
                    <button onclick="deleteAdminUser(<%= u.id %>)" class="text-rose-400 hover:underline font-semibold">
                      Remove
                    </button>
                  <% } else { %>
                    <span class="text-white/40 text-[11px]">(Current user)</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- TAB 7: LEADS -->
    <div id="tab-leads" class="tab-content space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold font-display text-white">Enterprise Inbound Inquiries</h2>
          <p class="text-xs text-white/60">High-volume brands and enterprise sales inquiries submitted from the landing page</p>
        </div>
        <span class="text-xs px-3 py-1 rounded-full bg-purple-500/20 text-purple-300 font-semibold border border-purple-500/30">
          <%= enterpriseLeads.length %> Total Inquiries
        </span>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <table class="w-full text-left text-xs">
          <thead class="bg-white/5 border-b border-white/10 text-white/60 font-semibold">
            <tr>
              <th class="p-4">Contact</th>
              <th class="p-4">Business / Brand</th>
              <th class="p-4">Requirements & Notes</th>
              <th class="p-4">Volume</th>
              <th class="p-4">Status</th>
              <th class="p-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% if (enterpriseLeads.length === 0) { %>
              <tr><td colspan="6" class="p-8 text-center text-white/50">No enterprise inquiries yet.</td></tr>
            <% } else { %>
              <% enterpriseLeads.forEach(l => { %>
                <tr class="hover:bg-white/[0.02] transition">
                  <td class="p-4">
                    <div class="font-bold text-white text-sm"><%= l.name %></div>
                    <div class="text-white/60 mt-0.5">
                      <a href="mailto:<%= l.email %>" class="hover:text-[#19D98B] underline-offset-2 hover:underline"><%= l.email %></a>
                    </div>
                    <% if (l.phone) { %>
                      <div class="flex items-center gap-2 mt-1">
                        <a href="tel:<%= l.phone %>" class="text-white/70 hover:text-white"><%= l.phone %></a>
                        <span class="text-white/20">&bull;</span>
                        <a href="https://wa.me/<%= l.phone.replace(/[^0-9]/g, '') %>" target="_blank" class="text-emerald-400 hover:underline font-semibold flex items-center gap-1">
                          WhatsApp
                        </a>
                      </div>
                    <% } %>
                    <div class="text-[10px] text-white/40 mt-1"><%= l.created_at ? l.created_at.slice(0, 16).replace('T', ' ') : '' %></div>
                  </td>
                  <td class="p-4">
                    <div class="font-bold text-white"><%= l.business_name || 'N/A' %></div>
                  </td>
                  <td class="p-4 max-w-xs">
                    <% if (l.notes) { %>
                      <div class="text-xs text-white/80 whitespace-pre-wrap leading-relaxed bg-white/5 p-2.5 rounded-xl border border-white/5 font-normal"><%= l.notes %></div>
                    <% } else { %>
                      <span class="text-white/40 italic">No notes provided</span>
                    <% } %>
                  </td>
                  <td class="p-4">
                    <span class="px-2.5 py-1 rounded-lg bg-white/5 border border-white/10 text-white/80 font-mono text-[11px] whitespace-nowrap">
                      <%= l.store_volume || 'Not specified' %>
                    </span>
                  </td>
                  <td class="p-4">
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider <%= l.status === 'contacted' ? 'bg-blue-500/20 text-blue-400 border border-blue-500/30' : 'bg-amber-500/20 text-amber-400 border border-amber-500/30' %>">
                      <%= l.status || 'new' %>
                    </span>
                  </td>
                  <td class="p-4 text-right space-y-1">
                    <% if (l.status !== 'contacted') { %>
                      <button onclick="updateLeadStatus(<%= l.id %>, 'contacted')" class="block w-full text-right text-xs text-[#19D98B] hover:underline font-semibold">
                        Mark Contacted
                      </button>
                    <% } else { %>
                      <button onclick="updateLeadStatus(<%= l.id %>, 'new')" class="block w-full text-right text-xs text-amber-400 hover:underline font-semibold">
                        Mark New
                      </button>
                    <% } %>
                    <button onclick="deleteEnterpriseLead(<%= l.id %>)" class="block w-full text-right text-[11px] text-red-400/70 hover:text-red-400 hover:underline">
                      Delete
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- TAB 8: AUDIT LOGS & MAINTENANCE -->
    <div id="tab-audit" class="tab-content space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold font-display text-white">System Operations & Audit Trail</h2>
          <p class="text-xs text-white/60">Live immutable record of platform configuration updates</p>
        </div>
        <div class="flex items-center gap-3">
          <button onclick="clearCache()" class="px-3.5 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-xs transition">
            Purge Cache 🧹
          </button>
          <button onclick="backupDb()" class="px-3.5 py-2 rounded-lg bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] font-bold font-display text-xs transition">
            Database Snapshot 💾
          </button>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
        <h3 class="text-sm font-bold font-display uppercase tracking-wider text-white mb-4">Recent Audit Records</h3>
        <div id="auditLogsContainer" class="text-xs space-y-2 text-white/70">
          <div class="text-white/40 italic">Loading audit records...</div>
        </div>
      </div>
    </div>

    <!-- TAB 9: AFFILIATES & PAYOUTS -->
    <div id="tab-affiliates" class="tab-content space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#19D98B] bg-[#19D98B]/10 px-3 py-1 rounded-full mb-1">
            <span>Official Partner: The Online Mastery</span>
          </div>
          <h2 class="text-lg font-bold font-display text-white">Affiliate Program CRM & Payout Desk</h2>
          <p class="text-xs text-white/60">Manage partner affiliates, track 70% 12-month recurring commissions, and approve bank withdrawals.</p>
        </div>
        <div class="flex items-center gap-3">
          <a href="/affiliates" target="_blank" class="px-3.5 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-xs transition flex items-center gap-1.5">
            <span>View Landing Page</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </div>
      </div>

      <!-- Affiliate Metric Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <div class="text-xs text-white/60 font-semibold mb-1">REGISTERED AFFILIATES</div>
          <div class="text-3xl font-extrabold font-display text-white"><%= (typeof affiliates !== 'undefined' ? affiliates.length : 0) %></div>
          <div class="text-xs text-[#19D98B] mt-2 font-medium">● 60-day cookie window tracking</div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <div class="text-xs text-white/60 font-semibold mb-1">COMMISSIONS GENERATED (70%)</div>
          <div class="text-3xl font-extrabold font-display text-[#19D98B]">₦<%= Number((typeof metrics !== 'undefined' && metrics.totalAffiliateCommissions) || 0).toLocaleString() %></div>
          <div class="text-xs text-white/60 mt-2 font-medium"><%= (typeof metrics !== 'undefined' && metrics.totalAffiliateSalesCount) || 0 %> subscription renewal payments</div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <div class="text-xs text-white/60 font-semibold mb-1">WALLET BALANCES ACCRUED</div>
          <div class="text-3xl font-extrabold font-display text-white">₦<%= Number((typeof metrics !== 'undefined' && metrics.totalAffiliatesOwed) || 0).toLocaleString() %></div>
          <div class="text-xs text-white/60 mt-2 font-medium">Earned by partners (Min. ₦10k to withdraw)</div>
        </div>

        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 <%= (typeof metrics !== 'undefined' && metrics.pendingPayoutsCount > 0) ? 'border-amber-400/50 bg-amber-400/5' : '' %>">
          <div class="text-xs font-semibold mb-1 <%= (typeof metrics !== 'undefined' && metrics.pendingPayoutsCount > 0) ? 'text-amber-400' : 'text-white/60' %>">PENDING PAYOUT REQUESTS</div>
          <div class="text-3xl font-extrabold font-display text-amber-400">₦<%= Number((typeof metrics !== 'undefined' && metrics.pendingPayoutsTotal) || 0).toLocaleString() %></div>
          <div class="text-xs text-amber-300/80 mt-2 font-medium"><%= (typeof metrics !== 'undefined' && metrics.pendingPayoutsCount) || 0 %> withdrawal(s) awaiting approval</div>
        </div>
      </div>

      <!-- PAYOUT APPROVAL DESK -->
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <div class="p-6 border-b border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h3 class="text-sm font-bold font-display uppercase tracking-wider text-white">Bank Payout Requests & Approval Desk</h3>
            <p class="text-xs text-white/60">Review submitted bank withdrawal requests, verify NUBAN details, and approve disbursements</p>
          </div>
          <span class="text-xs text-white/60 font-mono">Min. ₦10,000 Threshold</span>
        </div>

        <% 
          var allPayoutList = (typeof affiliatePayouts !== 'undefined') ? affiliatePayouts : [];
          var pendingList = allPayoutList.filter(function(p) { return p.status === 'pending'; });
          var completedList = allPayoutList.filter(function(p) { return p.status !== 'pending'; });
        %>

        <% if (pendingList.length === 0) { %>
          <div class="p-8 text-center text-xs text-white/40">
            No pending affiliate payout requests at this time. All disbursements are up to date!
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-white/80">
              <thead class="bg-white/5 border-b border-white/10 uppercase tracking-wider text-[10px] text-white/60">
                <tr>
                  <th class="py-3 px-4 font-bold">Request Date</th>
                  <th class="py-3 px-4 font-bold">Affiliate Partner</th>
                  <th class="py-3 px-4 font-bold">Withdrawal Amount</th>
                  <th class="py-3 px-4 font-bold">Bank & Account Details</th>
                  <th class="py-3 px-4 font-bold text-center">Desk Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 font-medium">
                <% pendingList.forEach(function(p) { %>
                  <tr class="hover:bg-white/5 transition">
                    <td class="py-3.5 px-4 font-mono text-[11px] text-white/50">
                      <%= new Date(p.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </td>
                    <td class="py-3.5 px-4">
                      <div class="font-bold text-white"><%= p.affiliate_name %></div>
                      <div class="text-[11px] text-white/60"><%= p.affiliate_email %> &bull; <%= p.affiliate_phone %></div>
                      <span class="inline-block px-1.5 py-0.5 rounded text-[10px] bg-[#19D98B]/10 text-[#19D98B] font-mono mt-0.5">Code: <%= p.affiliate_code %></span>
                    </td>
                    <td class="py-3.5 px-4 font-mono font-bold text-lg text-[#19D98B]">
                      ₦<%= Number(p.amount).toLocaleString() %>
                    </td>
                    <td class="py-3.5 px-4">
                      <div class="font-bold text-white"><%= p.bank_name %></div>
                      <div class="font-mono text-sm text-[#19D98B] tracking-wider font-bold"><%= p.account_number %></div>
                      <div class="text-[11px] text-white/70"><%= p.account_name %></div>
                    </td>
                    <td class="py-3.5 px-4 text-center">
                      <div class="flex items-center justify-center gap-2">
                        <button 
                          onclick="openApprovePayoutModal(<%= p.id %>, '<%= p.amount %>', '<%= (p.affiliate_name || '').replace(/'/g, '\\\'') %>', '<%= p.bank_name %>', '<%= p.account_number %>', '<%= (p.account_name || '').replace(/'/g, '\\\'') %>')" 
                          class="px-3 py-1.5 rounded-lg bg-[#19D98B] hover:bg-[#16C47D] text-[#08110D] font-bold text-xs transition"
                        >
                          Approve & Mark Paid
                        </button>
                        <button 
                          onclick="openRejectPayoutModal(<%= p.id %>, '<%= p.amount %>', '<%= (p.affiliate_name || '').replace(/'/g, '\\\'') %>')" 
                          class="px-3 py-1.5 rounded-lg bg-red-500/20 hover:bg-red-500/30 text-red-300 font-semibold text-xs border border-red-500/30 transition"
                        >
                          Reject & Refund
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>

        <!-- Historical Payouts Accordion -->
        <% if (completedList.length > 0) { %>
          <div class="p-4 border-t border-white/10 bg-white/2">
            <details class="text-xs">
              <summary class="font-bold text-white/70 cursor-pointer hover:text-white py-1">
                View Settled & Rejected Payout History (<%= completedList.length %>)
              </summary>
              <div class="overflow-x-auto mt-3">
                <table class="w-full text-left text-xs text-white/70">
                  <thead class="bg-white/5 uppercase text-[10px] text-white/50">
                    <tr>
                      <th class="py-2 px-3">Date</th>
                      <th class="py-2 px-3">Affiliate</th>
                      <th class="py-2 px-3">Amount</th>
                      <th class="py-2 px-3">Bank Details</th>
                      <th class="py-2 px-3">Status</th>
                      <th class="py-2 px-3">Reference / Reason</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-white/5">
                    <% completedList.forEach(function(p) { %>
                      <tr>
                        <td class="py-2.5 px-3 font-mono text-[11px]"><%= new Date(p.created_at).toLocaleDateString() %></td>
                        <td class="py-2.5 px-3 font-semibold text-white"><%= p.affiliate_name %></td>
                        <td class="py-2.5 px-3 font-mono font-bold text-white">₦<%= Number(p.amount).toLocaleString() %></td>
                        <td class="py-2.5 px-3"><%= p.bank_name %> - <%= p.account_number %></td>
                        <td class="py-2.5 px-3">
                          <% if (p.status === 'paid') { %>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400">Paid</span>
                          <% } else { %>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/20 text-red-400">Rejected</span>
                          <% } %>
                        </td>
                        <td class="py-2.5 px-3 text-[11px] text-white/60"><%= p.transaction_reference || p.rejection_reason || p.admin_notes || '—' %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </details>
          </div>
        <% } %>
      </div>

      <!-- ACTIVE AFFILIATES DIRECTORY -->
      <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
        <div class="p-6 border-b border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h3 class="text-sm font-bold font-display uppercase tracking-wider text-white">All Registered Affiliates (<%= (typeof affiliates !== 'undefined' ? affiliates.length : 0) %>)</h3>
            <p class="text-xs text-white/60">Standard (30%) &bull; Pro Academy Partners (70%) &bull; 12-Month Expiry</p>
          </div>
          <div class="flex items-center gap-3">
            <button 
              type="button" 
              onclick="openAddAffiliateModal()" 
              class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs flex items-center gap-1.5 transition border border-white/10"
            >
              <span>➕</span>
              <span>Add Single Affiliate</span>
            </button>
            <button 
              type="button" 
              onclick="openBulkAffiliateModal()" 
              class="px-3.5 py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 font-bold text-xs flex items-center gap-1.5 transition border border-amber-500/30"
            >
              <span>📂</span>
              <span>Bulk Upload (CSV)</span>
            </button>
          </div>
        </div>

        <% if (!affiliates || affiliates.length === 0) { %>
          <div class="p-8 text-center text-xs text-white/40">
            No affiliates registered yet. Share the landing page link: <code>/affiliates</code> or click "Add Single Affiliate" above.
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-white/80">
              <thead class="bg-white/5 border-b border-white/10 uppercase tracking-wider text-[10px] text-white/60">
                <tr>
                  <th class="py-3 px-4 font-bold">Partner Details</th>
                  <th class="py-3 px-4 font-bold">Tier / Cut</th>
                  <th class="py-3 px-4 font-bold">Referral Code</th>
                  <th class="py-3 px-4 font-bold text-center">Referrals (Active / Total)</th>
                  <th class="py-3 px-4 font-bold text-right">Total Earned</th>
                  <th class="py-3 px-4 font-bold text-right">Available Balance</th>
                  <th class="py-3 px-4 font-bold">Bank Account</th>
                  <th class="py-3 px-4 font-bold text-center">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 font-medium">
                <% affiliates.forEach(function(aff) { %>
                  <tr class="hover:bg-white/5 transition">
                    <td class="py-3.5 px-4">
                      <div class="font-bold text-white"><%= aff.full_name %></div>
                      <div class="text-[11px] text-white/60"><%= aff.email %></div>
                      <div class="text-[11px] text-white/40"><%= aff.phone || 'No phone' %></div>
                    </td>
                    <td class="py-3.5 px-4">
                      <% const isPro = aff.tier === 'pro'; %>
                      <% const cutPct = Math.round((aff.commission_rate !== undefined && aff.commission_rate !== null ? aff.commission_rate : (isPro ? 0.70 : 0.30)) * 100); %>
                      <% if (isPro) { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 shadow-sm">
                          <span>💎</span>
                          <span>Pro (<%= cutPct %>%)</span>
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-white/10 text-white/70 border border-white/15">
                          <span>Standard (<%= cutPct %>%)</span>
                        </span>
                      <% } %>
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="px-2 py-1 rounded bg-[#19D98B]/10 text-[#19D98B] font-mono font-bold text-xs select-all">
                        <%= aff.referral_code %>
                      </span>
                      <div class="text-[10px] text-white/40 mt-1">zlik.store/?ref=<%= aff.referral_code %></div>
                    </td>
                    <td class="py-3.5 px-4 text-center">
                      <div class="font-bold text-white text-sm">
                        <span class="text-[#19D98B]"><%= aff.active_referral_count %></span>
                        <span class="text-white/40 font-normal"> / <%= aff.referral_count %></span>
                      </div>
                      <div class="text-[10px] text-white/50"><%= aff.total_sales_count %> renewal payments</div>
                    </td>
                    <td class="py-3.5 px-4 text-right font-mono font-bold text-white">
                      ₦<%= Number(aff.total_earned || 0).toLocaleString() %>
                    </td>
                    <td class="py-3.5 px-4 text-right font-mono font-bold <%= Number(aff.wallet_balance || 0) >= 10000 ? 'text-[#19D98B]' : 'text-white/80' %>">
                      ₦<%= Number(aff.wallet_balance || 0).toLocaleString() %>
                    </td>
                    <td class="py-3.5 px-4">
                      <% if (aff.account_number && aff.bank_name) { %>
                        <div class="font-bold text-white text-[11px]"><%= aff.bank_name %></div>
                        <div class="font-mono text-[11px] text-[#19D98B]"><%= aff.account_number %></div>
                        <div class="text-[10px] text-white/50"><%= aff.account_name %></div>
                      <% } else { %>
                        <span class="text-[11px] text-white/30 italic">Not set</span>
                      <% } %>
                    </td>
                    <td class="py-3.5 px-4 text-center">
                      <button 
                        type="button" 
                        onclick="showAffiliateReferralsModal(<%= JSON.stringify(aff.full_name) %>, <%= JSON.stringify(aff.referrals || []) %>)" 
                        class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-xs transition"
                      >
                        View Stores (<%= aff.referral_count %>)
                      </button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>
